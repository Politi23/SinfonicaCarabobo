---
import { getConcertPosts } from '../config/wp';

// Fetch concert posts from WordPress
const concertPosts = await getConcertPosts({ perPage: 100 });

// Transform WordPress posts to concert format
const conciertos = concertPosts.map(post => {
  // Extract date information
  const date = new Date(post.date);
  const fechaCorta = date.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' }).toUpperCase();
  const dia = date.toLocaleDateString('es-ES', { weekday: 'long' });
  const hora = date.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

  return {
    fechaCorta,
    dia,
    hora,
    titulo: post.title,
    lugar: post.category || 'Por definir',
    tipo: 'Concierto',
    descripcion: post.excerpt.substring(0, 150) + (post.excerpt.length > 150 ? '...' : ''),
    slug: post.slug
  };
});

// Limit to 9 concerts to have multiple sets of 3 for carousel
const displayedConcerts = conciertos.slice(0, 9);
---

<section id="conciertos" class="py-20 bg-background-light">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-2xl tracking-[0.08em] uppercase text-primary mb-2">Próximos conciertos</p>
    </header>

    <!-- Carousel Container -->
    <div class="relative">
      <!-- Navigation Arrows -->
      <button
        id="prevBtn"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 bg-white rounded-full p-2 shadow-lg hover:bg-gray-100 transition-colors"
        aria-label="Ver conciertos anteriores"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="nextBtn"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 bg-white rounded-full p-2 shadow-lg hover:bg-gray-100 transition-colors"
        aria-label="Ver más conciertos"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Carousel Track -->
      <div class="carousel-track overflow-hidden">
        <div class="carousel-slides flex transition-transform duration-300 ease-in-out">
          {displayedConcerts.map((concierto) => (
            <div class="carousel-slide flex-shrink-0 px-3">
              <article class="bg-surface-light border border-border-light p-5 grid grid-cols-[120px_1fr] gap-x-5 items-start h-full">
                <div class="border-r border-border-light pr-4 text-left">
                  <span class="block font-serif text-lg font-bold text-primary mb-1">{concierto.fechaCorta}</span>
                  <span class="block mt-1 text-sm text-text-muted">{concierto.dia}</span>
                </div>

                <div class="flex flex-col gap-2">
                  <h3 class="font-serif text-base md:text-lg text-text-dark m-0">{concierto.titulo}</h3>
                  <p class="m-0 text-sm text-text-muted flex flex-wrap gap-2">
                    <span>{concierto.tipo}</span>
                    <span>·</span>
                    <span>{concierto.hora}</span>
                  </p>
                  <p class="m-0 text-sm text-secondary">{concierto.lugar}</p>
                  <p class="m-2 mb-4 text-sm text-text-muted">{concierto.descripcion}</p>

                  <div class="flex gap-2.5 flex-wrap mt-auto">
                    <a
                      href={`/blog/${concierto.slug}`}
                      class="inline-flex items-center justify-center py-2.5 px-5 text-sm font-serif border border-text-dark text-text-dark hover:bg-text-dark hover:text-white transition-colors duration-200 rounded-sm"
                    >
                      Ver detalles
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Carousel Indicators -->
    <div class="flex justify-center mt-8 space-x-2 carousel-indicators">
      {Array.from({ length: Math.ceil(displayedConcerts.length / 3) }, (_, i) => (
        <button class={`indicator w-3 h-3 rounded-full bg-gray-300 hover:bg-primary transition-colors ${i === 0 ? 'bg-primary' : ''}`}></button>
      ))}
    </div>

    <!-- View All Events Button -->
    <div class="text-center mt-10">
      <a
        href="/blog"
        class="inline-block px-6 py-3 bg-transparent border border-primary text-primary font-medium rounded hover:bg-primary hover:text-white transition-colors duration-300"
      >
        Ver todos los eventos
      </a>
    </div>
  </div>

  <style>
    .carousel-slide {
      width: 100%; /* Mobile: 1 slide */
    }

    @media (min-width: 768px) {
      .carousel-slide {
        width: calc(100% / 2); /* Tablet: 2 slides */
      }
    }

    @media (min-width: 1024px) {
      .carousel-slide {
        width: calc(100% / 3); /* Desktop: 3 slides */
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const track = document.querySelector('.carousel-slides');
      const slides = document.querySelectorAll('.carousel-slide');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const indicators = document.querySelectorAll('.indicator');

      let currentIndex = 0;
      let slidesToShow = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3; // Adjust based on screen size
      const totalSlides = slides.length;

      // Update slide position
      function updateSlidePosition() {
        const currentSlidesToShow = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
        const slideWidth = 100 / currentSlidesToShow;
        track.style.transform = `translateX(-${currentIndex * slideWidth}%)`;

        // Update active indicator
        indicators.forEach((indicator, index) => {
          indicator.classList.toggle('bg-primary', Math.floor(currentIndex / currentSlidesToShow) === index);
          indicator.classList.toggle('bg-gray-300', Math.floor(currentIndex / currentSlidesToShow) !== index);
        });
      }

      // Handle window resize
      window.addEventListener('resize', () => {
        const newSlidesToShow = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
        if (newSlidesToShow !== slidesToShow) {
          slidesToShow = newSlidesToShow;
          // Recalculate positions based on new screen size
          updateSlidePosition();
        }
      });

      // Next button event
      nextBtn.addEventListener('click', () => {
        const currentSlidesToShow = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
        if (currentIndex < totalSlides - currentSlidesToShow) {
          currentIndex += currentSlidesToShow;
          updateSlidePosition();
        } else {
          // Loop back to the beginning
          currentIndex = 0;
          updateSlidePosition();
        }
      });

      // Previous button event
      prevBtn.addEventListener('click', () => {
        const currentSlidesToShow = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
        if (currentIndex > 0) {
          currentIndex -= currentSlidesToShow;
          updateSlidePosition();
        } else {
          // Go to the last set of slides
          currentIndex = Math.max(0, totalSlides - currentSlidesToShow);
          updateSlidePosition();
        }
      });

      // Indicator click events
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          const currentSlidesToShow = window.innerWidth < 768 ? 1 : window.innerWidth < 1024 ? 2 : 3;
          currentIndex = index * currentSlidesToShow;
          updateSlidePosition();
        });
      });

      // Initialize
      updateSlidePosition();
    });
  </script>
</section>