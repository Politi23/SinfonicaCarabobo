---
const conciertos = [
  {
    fechaCorta: "24 MAR",
    dia: "Domingo",
    hora: "7:00 p.m.",
    titulo: "Gran Gala Sinfónica",
    lugar: "Teatro Municipal de Carabobo",
    tipo: "Concierto de Temporada",
    descripcion: "Obras de Beethoven, Brahms y Tchaikovsky.",
  },
  {
    fechaCorta: "06 ABR",
    dia: "Sábado",
    hora: "6:30 p.m.",
    titulo: "Noches de Música Venezolana",
    lugar: "Centro Cultural Carabobo",
    tipo: "Programa Especial",
    descripcion:
      "Selección de obras de compositores venezolanos contemporáneos.",
  },
  {
    fechaCorta: "20 ABR",
    dia: "Sábado",
    hora: "5:00 p.m.",
    titulo: "Concierto para la Juventud",
    lugar: "Auditorio Universidad de Carabobo",
    tipo: "Concierto Educativo",
    descripcion:
      "Programa pensado para jóvenes y familias, con obras guiadas y explicadas.",
  },
];
---

<section id="conciertos" class="concerts-section bg-white">
  <div class="container">
    <header class="concerts-header">
      <p class="concerts-kicker">Próximos conciertos</p>
      
    </header>

    <div class="concerts-grid">
      {conciertos.map((concierto) => (
        <article class="concert-card">
          <div class="concert-date">
            <span class="concert-date-main">{concierto.fechaCorta}</span>
            <span class="concert-date-sub">{concierto.dia}</span>
          </div>

          <div class="concert-info">
            <h3 class="concert-title">{concierto.titulo}</h3>
            <p class="concert-meta">
              <span>{concierto.tipo}</span>
              <span>·</span>
              <span>{concierto.hora}</span>
            </p>
            <p class="concert-venue">{concierto.lugar}</p>
            <p class="concert-description">{concierto.descripcion}</p>

            <div class="concert-actions">
              
              <a
                href="#detalle-concierto"
                class="concert-btn concert-btn-secondary"
              >
                Ver detalles
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  :root {
    /* Paleta aplicada */
    --color-white: #ffffff;
    --color-black: #000000;
    --color-red: #82181a;
    --color-yellow: #ffb900;

    --accent-yellow: var(--color-yellow);
    --accent-yellow-dark: #d99900;
    --text-light: var(--color-white);
    --text-muted: #e0e0e0;
    --text-hero-title: #f6e3b5;
    --header-height: 80px;
    --max-width: 1200px;
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  .concerts-section {
    padding: 80px 0 96px;
    border-top: 1px solid #e0e0e0;
  }

  .concerts-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .concerts-kicker {
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C28F24;
    margin-bottom: 8px;
  }

  .concerts-title {
    font-family: "Merriweather", serif;
    font-size: 2.4rem;
    color: #1a1a1a;
    margin: 0 0 12px;
  }

  .concerts-subtitle {
    font-size: 0.98rem;
    color: #666666;
    margin: 0;
  }

  .concerts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .concert-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    background: #f9f9f9;
    border: 1px solid #e0e0e0;
    padding: 20px 22px;
    column-gap: 20px;
    align-items: start;
  }

  .concert-date {
    border-right: 1px solid #e0e0e0;
    padding-right: 16px;
    text-align: left;
  }

  .concert-date-main {
    display: block;
    font-family: "Merriweather", serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #C28F24;
  }

  .concert-date-sub {
    display: block;
    margin-top: 4px;
    font-size: 0.9rem;
    color: #666666;
  }

  .concert-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .concert-title {
    font-family: "Merriweather", serif;
    font-size: 1.2rem;
    margin: 0;
    color: #1a1a1a;
  }

  .concert-meta {
    margin: 0;
    font-size: 0.9rem;
    color: #666666;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .concert-venue {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-red);
  }

  .concert-description {
    margin: 6px 0 14px;
    font-size: 0.9rem;
    color: #666666;
  }

  .concert-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Botones rectangulares, serios y profesionales */
  .concert-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-size: 0.9rem;
    font-family: "Merriweather", serif;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.18s ease, color 0.18s ease,
      border-color 0.18s ease, transform 0.08s ease;
    letter-spacing: 0.01em;
  }

  .concert-btn-primary {
    background-color: var(--accent-yellow);
    color: #000;
    border-color: var(--accent-yellow);
    font-weight: 700;
  }

  .concert-btn-primary:hover {
    background-color: var(--accent-yellow-dark);
    border-color: var(--accent-yellow-dark);
    transform: translateY(-1px);
  }

  .concert-btn-secondary {
    background-color: transparent;
    color: #1a1a1a;
    border-color: #1a1a1a;
    font-weight: 400;
  }

  .concert-btn-secondary:hover {
    background-color: #1a1a1a;
    color: #ffffff;
    border-color: #1a1a1a;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .concert-card {
      grid-template-columns: 1fr;
      row-gap: 12px;
    }

    .concert-date {
      border-right: none;
      border-bottom: 1px solid #e0e0e0;
      padding-right: 0;
      padding-bottom: 10px;
      margin-bottom: 6px;
    }

    .concert-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .concert-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
