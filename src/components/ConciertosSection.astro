---
const conciertos = [
  {
    fechaCorta: "24 MAR",
    dia: "Domingo",
    hora: "7:00 p.m.",
    titulo: "Gran Gala Sinfónica",
    lugar: "Teatro Municipal de Carabobo",
    tipo: "Concierto de Temporada",
    descripcion: "Obras de Beethoven, Brahms y Tchaikovsky.",
  },
  {
    fechaCorta: "24 MAR",
    dia: "Domingo",
    hora: "7:00 p.m.",
    titulo: "Gran Gala Sinfónica",
    lugar: "Teatro Municipal de Carabobo",
    tipo: "Concierto de Temporada",
    descripcion: "Obras de Beethoven, Brahms y Tchaikovsky.",
  },
  {
    fechaCorta: "24 MAR",
    dia: "Domingo",
    hora: "7:00 p.m.",
    titulo: "Gran Gala Sinfónica",
    lugar: "Teatro Municipal de Carabobo",
    tipo: "Concierto de Temporada",
    descripcion: "Obras de Beethoven, Brahms y Tchaikovsky.",
  },
  {
    fechaCorta: "24 MAR",
    dia: "Domingo",
    hora: "7:00 p.m.",
    titulo: "Gran Gala Sinfónica",
    lugar: "Teatro Municipal de Carabobo",
    tipo: "Concierto de Temporada",
    descripcion: "Obras de Beethoven, Brahms y Tchaikovsky.",
  },
  {
    fechaCorta: "06 ABR",
    dia: "Sábado",
    hora: "6:30 p.m.",
    titulo: "Noches de Música Venezolana",
    lugar: "Centro Cultural Carabobo",
    tipo: "Programa Especial",
    descripcion:
      "Selección de obras de compositores venezolanos contemporáneos.",
  },
  {
    fechaCorta: "20 ABR",
    dia: "Sábado",
    hora: "5:00 p.m.",
    titulo: "Concierto para la Juventud",
    lugar: "Auditorio Universidad de Carabobo",
    tipo: "Concierto Educativo",
    descripcion:
      "Programa pensado para jóvenes y familias, con obras guiadas y explicadas.",
  },
];
---

<section id="conciertos" class="py-20 bg-background-light">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="text-center max-w-3xl mx-auto mb-12">
      <p class="text-2xl tracking-[0.08em] uppercase text-primary mb-2">Próximos conciertos</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        conciertos.map((concierto) => (
          <article class="bg-surface-light border border-border-light p-5 grid grid-cols-[120px_1fr] gap-x-5 items-start">
            <div class="border-r border-border-light pr-4 text-left">
              <span class="block font-serif text-lg font-bold text-primary mb-1">{concierto.fechaCorta}</span>
              <span class="block mt-1 text-sm text-text-muted">{concierto.dia}</span>
            </div>

            <div class="flex flex-col gap-2">
              <h3 class="font-serif text-base md:text-lg text-text-dark m-0">{concierto.titulo}</h3>
              <p class="m-0 text-sm text-text-muted flex flex-wrap gap-2">
                <span>{concierto.tipo}</span>
                <span>·</span>
                <span>{concierto.hora}</span>
              </p>
              <p class="m-0 text-sm text-secondary">{concierto.lugar}</p>
              <p class="m-2 mb-4 text-sm text-text-muted">{concierto.descripcion}</p>

              <div class="flex gap-2.5 flex-wrap">
                <a
                  href="#detalle-concierto"
                  class="inline-flex items-center justify-center py-2.5 px-5 text-sm font-serif border border-text-dark text-text-dark hover:bg-text-dark hover:text-white transition-colors duration-200 rounded-sm"
                >
                  Ver detalles
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>