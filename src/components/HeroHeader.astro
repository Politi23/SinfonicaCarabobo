---
// HeroHeader.astro
// Header elegante y profesional con Hero Section para la Orquesta Sinfónica
const navLinks = [
  { href: "#", label: "Inicio", active: true },
  { href: "#nosotros", label: "Nosotros", active: false },
  { href: "#programas", label: "Programas", active: false },
  { href: "#apoyanos", label: "Apóyanos", active: false },
  { href: "#contacto", label: "Contacto", active: false },
];
---

<!-- Header con efecto glassmorphism -->
<header class="header" id="main-header">
  <div class="header-backdrop"></div>
  <div class="header-container">
    <!-- Logo -->
    <a href="#" class="logo-link">
      <img
        src="/logo.png"
        alt="Logo de la Orquesta Sinfónica de Carabobo"
        class="logo-image"
      />
    </a>

    <!-- Navegación principal -->
    <nav class="main-nav" id="main-nav">
      <!-- Botón hamburguesa para móvil -->
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Enlaces de navegación -->
      <ul class="nav-list" id="nav-list">
        {
          navLinks.map((link) => (
            <li class="nav-item">
              <a
                href={link.href}
                class={`nav-link ${link.active ? "nav-link-active" : ""}`}
              >
                <span class="nav-link-text">{link.label}</span>
                <span class="nav-link-underline" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Línea decorativa dorada -->
  <div class="header-accent-line"></div>
</header>

<main>
  <!-- Sección de hero -->
        <section
            class="relative h-screen flex flex-col justify-center items-center text-center overflow-hidden"
        >
            <video
                autoplay
                loop
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover z-0"
                poster="/sinfonica.jpg"
            >
                <source src="/video-fondo.mp4" type="video/mp4" />
            </video>

            <!-- Overlay con gradiente suave hacia el color crema -->
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[#FDFBF7] z-0"
            >
            </div>

    <div class="hero-content">
      <h1 class="hero-title">Fundación Orquesta Sinfónica de Carabobo</h1>

      <div class="hero-actions">
        <a href="#apoyanos" class="hero-btn hero-btn-primary">
          <span class="btn-icon">♥</span>
          Apóyanos
        </a>

        <a href="#historia" class="hero-btn hero-btn-secondary">
          Conoce Nuestra Historia
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  /* Variables CSS */
  :root {
    --header-height: 80px;
    --header-height-mobile: 64px;
    --gold: #c28f24;
    --gold-light: #ddb850;
    --gold-dark: #9a7219;
    --red-accent: #82181a;
    --black: #000000;
    --black-soft: #0a0a0a;
    --white: #ffffff;
    --gray-light: #e0e0e0;
    --gray: #888888;
  }

  /* ============================================
     HEADER STYLES
  ============================================ */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: 1000;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.85) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(194, 143, 36, 0.15);
    transition: all 0.4s ease;
  }

  .header-container {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Línea decorativa dorada animada */
  .header-accent-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--gold) 20%,
      var(--gold-light) 50%,
      var(--gold) 80%,
      transparent 100%
    );
    opacity: 0.6;
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* Logo styles */
  .logo-link {
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
    z-index: 10;
  }

  .logo-image {
    height: 56px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* Navigation */
  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 100;
  }

  .nav-toggle:hover {
    border-color: var(--gold);
    background: rgba(194, 143, 36, 0.1);
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .nav-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--gray-light);
    font-family: "Merriweather", serif;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .nav-link-text {
    position: relative;
    z-index: 1;
    transition: all 0.3s ease;
  }

  .nav-link-underline {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 30px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    transition: transform 0.3s ease;
    border-radius: 2px;
  }

  .nav-link:hover {
    color: var(--white);
  }

  .nav-link:hover .nav-link-underline {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-link-active {
    color: var(--gold);
    background: rgba(194, 143, 36, 0.1);
    border-radius: 6px;
  }

  .nav-link-active .nav-link-underline {
    transform: translateX(-50%) scaleX(1);
    background: var(--gold);
  }

  /* CTA Button in nav */
  .nav-item-cta {
    margin-left: 16px;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
    color: var(--black);
    text-decoration: none;
    font-family: "Merriweather", serif;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 6px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(194, 143, 36, 0.3);
  }

  .nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(194, 143, 36, 0.4);
    background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold) 100%);
  }

  .cta-icon {
    font-size: 1rem;
  }

  /* ============================================
     HERO SECTION STYLES (Original)
  ============================================ */
  .hero-section {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    margin-top: var(--header-height);
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--white);
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0.85) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .hero-title {
    margin: 0 0 32px;
    font-family: "Playfair Display", "Merriweather", serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--white);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero-actions {
    display: inline-flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 38px;
    font-family: "Merriweather", serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    letter-spacing: 0.02em;
  }

  .hero-btn-primary {
    background: linear-gradient(
      135deg,
      var(--gold-light) 0%,
      var(--gold) 50%,
      var(--gold-dark) 100%
    );
    color: var(--black);
    border: none;
    box-shadow:
      0 4px 15px rgba(194, 143, 36, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .hero-btn-primary::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.6s ease;
  }

  .hero-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 25px rgba(194, 143, 36, 0.5),
      0 4px 10px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .hero-btn-primary:hover::before {
    left: 100%;
  }

  .btn-icon {
    font-size: 1.1rem;
    transition: transform 0.3s ease;
  }

  .hero-btn-primary:hover .btn-icon {
    transform: scale(1.2);
  }

  .hero-btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-btn-secondary::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transition: width 0.4s ease;
    z-index: -1;
  }

  .hero-btn-secondary:hover {
    border-color: var(--gold);
    color: var(--gold-light);
    transform: translateY(-3px);
    box-shadow:
      0 8px 25px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(194, 143, 36, 0.2);
  }

  .hero-btn-secondary:hover::before {
    width: 100%;
  }

  /* ============================================
     RESPONSIVE STYLES
  ============================================ */
  @media (max-width: 1024px) {
    .nav-list {
      gap: 4px;
    }

    .nav-link {
      padding: 10px 14px;
      font-size: 0.85rem;
    }

    .nav-item-cta {
      margin-left: 8px;
    }

    .nav-cta {
      padding: 10px 18px;
    }
  }

  @media (max-width: 768px) {
    .header {
      height: var(--header-height-mobile);
    }

    .header-container {
      padding: 0 20px;
    }

    .logo-image {
      height: 44px;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-list {
      position: fixed;
      top: var(--header-height-mobile);
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      background: rgba(0, 0, 0, 0.98);
      backdrop-filter: blur(20px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px);
      transition: all 0.4s ease;
    }

    .nav-list.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-link {
      font-size: 1.1rem;
      padding: 16px 24px;
    }

    .nav-item-cta {
      margin-left: 0;
      margin-top: 16px;
    }

    .nav-cta {
      padding: 14px 32px;
      font-size: 1rem;
    }

    /* Hero mobile adjustments */
    .hero-section {
      margin-top: var(--header-height-mobile);
      min-height: calc(100vh - var(--header-height-mobile));
    }

    .hero-title {
      font-size: 2.1rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Toggle mobile navigation
  const navToggle = document.getElementById("nav-toggle");
  const navList = document.getElementById("nav-list");

  if (navToggle && navList) {
    navToggle.addEventListener("click", () => {
      navToggle.classList.toggle("active");
      navList.classList.toggle("active");
      const isExpanded = navToggle.getAttribute("aria-expanded") === "true";
      navToggle.setAttribute("aria-expanded", (!isExpanded).toString());
    });

    // Close menu when clicking a link
    const navLinks = navList.querySelectorAll(".nav-link, .nav-cta");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        navToggle.classList.remove("active");
        navList.classList.remove("active");
        navToggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
