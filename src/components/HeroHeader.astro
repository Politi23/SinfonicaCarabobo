---
// HeroHeader.astro
// Componente principal de HEADER + HERO en Astro con Tailwind CSS
import Header from "./Header.astro";
---

<!-- Sección de header --><!-- Sección de header -->
<Header />

<main>
  <!-- Sección de hero -->
  <section
    class="relative min-h-[calc(100vh-5rem)] mt-20 flex flex-col justify-center text-white overflow-hidden bg-cover bg-center bg-no-repeat"
    style="background-image: url('/sinfonica.jpg');"
  >
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-black/85 z-[1]"
    >
    </div>

    <div
      class="container mx-auto px-6 relative z-[2] text-center max-w-3xl py-24 pb-20"
    >
      <h1
        class="m-0 mb-4 font-display text-5xl leading-tight text-white font-bold"
        style="text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);"
      >
        Fundación Orquesta Sinfónica de Carabobo
      </h1>

      <div class="inline-flex gap-4 flex-wrap justify-center">
        <a
          href="#apoyanos"
          class="inline-flex items-center justify-center py-2.5 px-7 rounded bg-primary text-black border border-primary text-sm cursor-pointer no-underline transition-all duration-200 font-serif font-semibold hover:bg-[#B07F1F] hover:border-[#B07F1F] hover:shadow-[0_0_0_1px_rgba(0,0,0,0.2)]"
        >
          <span class="mr-2 text-sm">♥</span>
          Apóyanos
        </a>

        <a
          href="#historia"
          class="inline-flex items-center justify-center py-2.5 px-7 rounded bg-transparent text-white border border-white/70 text-sm cursor-pointer no-underline transition-all duration-200 font-serif font-normal hover:bg-white/10 hover:border-white hover:shadow-[0_0_0_1px_rgba(255,255,255,0.2)]"
        >
          Conoce Nuestra Historia
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  @media (max-width: 768px) {
    h1 {
      font-size: 2.1rem;
    }

    h2 {
      font-size: 1.1rem;
    }

    p {
      font-size: 0.95rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions a {
      width: 100%;
      justify-content: center;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    h1 {
      font-size: 2.6rem;
    }

    h2 {
      font-size: 1.25rem;
    }
  }
</style>
