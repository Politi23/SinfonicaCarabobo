---
// HeroHeader.astro
// Header elegante y profesional con Hero Section para la Orquesta Sinfónica
const { showVideo = true } = Astro.props;

const navLinks = [
  { href: "/", label: "Inicio", active: false },
  { href: "/nosotros", label: "Nosotros", active: false },
  { href: "#programas", label: "Programas", active: false },
  { href: "/apoyanos", label: "Apóyanos", active: false },
  { href: "#contacto", label: "Contacto", active: false },
];
---

<!-- Header con efecto glassmorphism -->
<header class="header" id="main-header">
  <div class="header-backdrop"></div>
  <div class="header-container">
    <!-- Logo -->
      <a href="http://localhost:4321" class="logo-link group">
      <div class="flex items-center gap-4">
        <img
          src="/logosimple.png"
          alt="Logo de la Fundación Orquesta Sinfónica de Carabobo"
          class="logo-image drop-shadow-lg transition-transform duration-300 group-hover:scale-105"
        />
        <div class="hidden md:flex flex-col">
          <span class="text-xs font-light tracking-widest text-gray-300 uppercase leading-tight">
            Fundación
          </span>
          <span class="text-sm font-bold tracking-wide text-white leading-tight font-serif">
            Orquesta Sinfónica
          </span>
          <span class="text-xs font-medium tracking-wider text-accent-yellow uppercase leading-tight">
            de Carabobo
          </span>
        </div>
      </div>
    </a>

    <!-- Navegación principal -->
    <nav class="main-nav" id="main-nav">
      <!-- Botón hamburguesa para móvil -->
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Enlaces de navegación -->
      <ul class="nav-list" id="nav-list">
        {
          navLinks.map((link) => (
            <li class="nav-item">
              <a
                href={link.href}
                class={`nav-link ${link.active ? "nav-link-active" : ""}`}
              >
                <span class="nav-link-text">{link.label}</span>
                <span class="nav-link-underline" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<main>
  <!-- Sección de hero -->
  <section
    class="relative h-screen flex flex-col justify-center items-center text-center overflow-hidden"
  >
    {showVideo ? (
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 w-full h-full object-cover z-0"
        poster="/sinfonica.jpg"
        transition:persist
      >
        <source src="/video-fondo.mp4" type="video/mp4" />
      </video>
    ) : (
      <!-- Imagen de fondo estática para cuando no hay video -->
      <div class="absolute inset-0 z-0">
        <img
          src="/sinfonica.jpg"
          alt="Orquesta Sinfónica"
          class="w-full h-full object-cover"
        />
      </div>
    )}


    <!-- Overlay con gradiente suave hacia el color crema -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-background-light z-0"
    >
    </div>

    <div class="hero-content">
      <h1 class="hero-title">Fundación Orquesta Sinfónica de Carabobo</h1>

      <div class="hero-actions">
        <a href="#apoyanos" class="hero-btn hero-btn-primary">
          <span class="btn-icon">♥</span>
          Apóyanos
        </a>

        <a href="#historia" class="hero-btn hero-btn-secondary">
          Conoce Nuestra Historia
        </a>
      </div>
    </div>
  </section>
</main>

<style>
  /* Variables CSS */
  :root {
    --gold: #c28f24; /* primary */
    --gold-light: #ddb850; /* primary-light */
    --gold-dark: #9a7219; /* tono oscuro del dorado */
    --white: #ffffff; /* text-light o white */
    --black: #000000; /* background-dark */
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .hero-title {
    margin: 0 0 32px;
    font-family: "Playfair Display", "Merriweather", serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--white);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero-actions {
    display: inline-flex;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 38px;
    font-family: "Merriweather", serif;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    letter-spacing: 0.02em;
  }

  .hero-btn-primary {
    background: linear-gradient(
      135deg,
      var(--gold-light) 0%,
      var(--gold) 50%,
      var(--gold-dark) 100%
    );
    color: var(--black);
    border: none;
    box-shadow:
      0 4px 15px rgba(194, 143, 36, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .hero-btn-primary::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transition: left 0.6s ease;
  }

  .hero-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 25px rgba(194, 143, 36, 0.5),
      0 4px 10px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .hero-btn-primary:hover::before {
    left: 100%;
  }

  .btn-icon {
    font-size: 1.1rem;
    transition: transform 0.3s ease;
  }

  .hero-btn-primary:hover .btn-icon {
    transform: scale(1.2);
  }

  .hero-btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero-btn-secondary::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transition: width 0.4s ease;
    z-index: -1;
  }

  .hero-btn-secondary:hover {
    border-color: var(--gold);
    color: var(--gold-light);
    transform: translateY(-3px);
    box-shadow:
      0 8px 25px rgba(0, 0, 0, 0.3),
      0 0 20px rgba(194, 143, 36, 0.2);
  }

  .hero-btn-secondary:hover::before {
    width: 100%;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.1rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
