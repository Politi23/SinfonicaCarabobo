---
// HeroHeader.astro
// Componente principal de HEADER + HERO en Astro con Tailwind CSS
import Header from "./Header.astro";
---

<!-- Sección de header --><!-- Sección de header -->
<Header />

<main>
  <!-- Sección de hero -->
        <section
            class="relative h-screen flex flex-col justify-center items-center text-center overflow-hidden"
        >
            <video
                autoplay
                loop
                muted
                playsinline
                class="absolute inset-0 w-full h-full object-cover z-0"
                poster="/sinfonica.jpg"
            >
                <source src="/video-fondo.mp4" type="video/mp4" />
            </video>

            <!-- Overlay con gradiente suave hacia el color crema -->
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[#FDFBF7] z-0"
            >
            </div>

            <div
                class="relative z-10 container mx-auto px-6 animate-fade-in-up"
            >
                <h1
                    class="font-display text-6xl md:text-8xl font-bold mb-6 text-white tracking-tight drop-shadow-md"
                >
                    Nosotros
                </h1>
                <p
                    class="text-xl md:text-3xl font-serif text-white/90 max-w-3xl mx-auto leading-relaxed drop-shadow-sm"
                >
                    Fundación Orquesta Sinfónica de Carabobo
                </p>
                <div
                    class="w-24 h-1 bg-accent-yellow mx-auto mt-8 rounded-full"
                >
                </div>
            </div>

            <div
                class="absolute bottom-12 left-1/2 -translate-x-1/2 z-10 animate-bounce"
            >
                <svg
                    class="w-8 h-8 text-white/80"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </div>
        </section>
</main>

<style>
  @media (max-width: 768px) {
    h1 {
      font-size: 2.1rem;
    }

    h2 {
      font-size: 1.1rem;
    }

    p {
      font-size: 0.95rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions a {
      width: 100%;
      justify-content: center;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    h1 {
      font-size: 2.6rem;
    }

    h2 {
      font-size: 1.25rem;
    }
  }
</style>
