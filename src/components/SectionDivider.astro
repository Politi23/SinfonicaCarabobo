---
// SectionDivider.astro
// Separador elegante con ondas sonoras doradas entre secciones
---

<div class="section-divider">
    <div class="divider-container">
        <!-- Onda sonora SVG -->
        <svg
            class="wave-svg"
            viewBox="0 0 1200 80"
            preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <!-- Líneas de onda múltiples para efecto de profundidad -->
            <defs>
                <linearGradient
                    id="goldGradient"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                >
                    <stop
                        offset="0%"
                        style="stop-color:transparent;stop-opacity:0"></stop>
                    <stop
                        offset="15%"
                        style="stop-color:#C28F24;stop-opacity:0.3"></stop>
                    <stop offset="50%" style="stop-color:#9a7219;stop-opacity:1"
                    ></stop>
                    <stop
                        offset="85%"
                        style="stop-color:#C28F24;stop-opacity:0.3"></stop>
                    <stop
                        offset="100%"
                        style="stop-color:transparent;stop-opacity:0"></stop>
                </linearGradient>
                <linearGradient
                    id="goldGradient2"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                >
                    <stop
                        offset="0%"
                        style="stop-color:transparent;stop-opacity:0"></stop>
                    <stop
                        offset="20%"
                        style="stop-color:#C28F24;stop-opacity:0.2"></stop>
                    <stop
                        offset="50%"
                        style="stop-color:#C28F24;stop-opacity:0.5"></stop>
                    <stop
                        offset="80%"
                        style="stop-color:#C28F24;stop-opacity:0.2"></stop>
                    <stop
                        offset="100%"
                        style="stop-color:transparent;stop-opacity:0"></stop>
                </linearGradient>
            </defs>

            <!-- Onda principal (centro) -->
            <path
                class="wave wave-1"
                d="M0,40 
           Q75,40 150,35 
           Q225,30 300,40 
           Q375,50 450,40 
           Q525,30 600,40 
           Q675,50 750,40 
           Q825,30 900,40 
           Q975,50 1050,40 
           Q1125,30 1200,40"
                fill="none"
                stroke="url(#goldGradient)"
                stroke-width="3"
                stroke-linecap="round"></path>

            <!-- Onda superior (más suave) -->
            <path
                class="wave wave-2"
                d="M0,30 
           Q100,30 200,28 
           Q300,26 400,32 
           Q500,38 600,30 
           Q700,22 800,28 
           Q900,34 1000,30 
           Q1100,26 1200,30"
                fill="none"
                stroke="url(#goldGradient2)"
                stroke-width="2"
                stroke-linecap="round"></path>

            <!-- Onda inferior (más suave) -->
            <path
                class="wave wave-3"
                d="M0,50 
           Q100,50 200,52 
           Q300,54 400,48 
           Q500,42 600,50 
           Q700,58 800,52 
           Q900,46 1000,50 
           Q1100,54 1200,50"
                fill="none"
                stroke="url(#goldGradient2)"
                stroke-width="2"
                stroke-linecap="round"></path>

            <!-- Líneas de staff musical sutiles -->
            <line
                x1="200"
                y1="25"
                x2="1000"
                y2="25"
                stroke="url(#goldGradient2)"
                stroke-width="0.5"
                opacity="0.3"></line>
            <line
                x1="150"
                y1="55"
                x2="1050"
                y2="55"
                stroke="url(#goldGradient2)"
                stroke-width="0.5"
                opacity="0.3"></line>
        </svg>
    </div>
</div>

<style>
    .section-divider {
        position: relative;
        width: 100%;
        padding: 40px 0;
        background: #ffffff;
        overflow: hidden;
    }

    .divider-container {
        position: relative;
        width: 100%;
        margin: 0 auto;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
    }

    .wave-svg {
        width: 100%;
        height: 80px;
        overflow: visible;
    }

    /* Animación sutil de las ondas */
    .wave {
        animation: waveFlow 4s ease-in-out infinite;
    }

    .wave-1 {
        animation-delay: 0s;
    }

    .wave-2 {
        animation-delay: 0.5s;
        animation-duration: 5s;
    }

    .wave-3 {
        animation-delay: 1s;
        animation-duration: 5s;
    }

    @keyframes waveFlow {
        0%,
        100% {
            opacity: 1;
            transform: translateX(0);
        }
        50% {
            opacity: 0.8;
            transform: translateX(5px);
        }
    }

    /* Brillo central */
    .center-glow {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 120px;
        height: 40px;
        background: radial-gradient(
            ellipse,
            rgba(221, 184, 80, 0.3) 0%,
            transparent 70%
        );
        pointer-events: none;
        animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.5;
            transform: translate(-50%, -50%) scale(1);
        }
        50% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.2);
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .section-divider {
            padding: 15px 0;
        }

        .divider-container {
            height: 60px;
        }

        .wave-svg {
            height: 60px;
        }

        .center-glow {
            width: 80px;
            height: 30px;
        }
    }

    @media (max-width: 480px) {
        .section-divider {
            padding: 10px 0;
        }

        .divider-container {
            height: 50px;
        }

        .wave-svg {
            height: 50px;
        }
    }
</style>
