---
import imageGrid from "@assets/images/organizacion/OSC en TTC 3.webp";

// Extraemos los beneficios a un arreglo para mantener el código HTML súper limpio
const benefits = [
    {
        title: "Difusión Digital",
        desc: "Presencia estratégica como patrocinante oficial en nuestro ecosistema de redes y medios digitales.",
    },
    {
        title: "Exclusividad",
        desc: "Ubicación preferencial y privilegios de acceso en nuestra cartelera de conciertos de temporada.",
    },
    {
        title: "Activación",
        desc: "Espacios de networking y stands de marca en los foyers de las salas de conciertos.",
    },
    {
        title: "Multimedia",
        desc: "Producción de contenido audiovisual de alta gama vinculando los valores de su marca.",
    },
    {
        title: "Presencia en Vivo",
        desc: "Reconocimiento público y menciones de honor durante el desarrollo de nuestras galas.",
    },
    {
        title: "Identidad Aliada",
        desc: "Material promocional físico de gran formato compartiendo la identidad visual de su empresa.",
    },
];
---

<section class="relative py-16 text-zinc-850 overflow-hidden">
    <div
        class="absolute inset-0 z-0 opacity-20 bg-cover bg-fixed bg-center"
        style={`background-image: url('${imageGrid.src}');`}
    >
    </div>

    <div
        class="absolute inset-0 bg-gradient-to-b from-white/95 via-gray-50/90 to-white/95 z-0"
    >
    </div>

    <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-8"
        >
            <div class="max-w-2xl">
                <h2
                    class="text-4xl md:text-[3.5rem] font-display font-bold leading-tight text-gray-900"
                >
                    Propuesta de <br />
                    <span class="font-bold text-secondary"
                        >valor empresarial</span
                    >
                </h2>
            </div>
        </div>

        <div
            class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-gray-200 border border-gray-200 overflow-hidden backdrop-blur-md rounded-sm shadow"
        >
            {
                benefits.map((item) => (
                    <div class="group relative p-10 bg-white hover:bg-gray-50 transition-all duration-500 flex flex-col">
                        <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-transparent via-secondary to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                        <h3 class="text-2xl font-display font-bold mb-4 tracking-tight uppercase text-gray-900 group-hover:text-secondary-light transition-colors">
                            {item.title}
                        </h3>

                        <p class="text-lg text-gray-600 leading-relaxed font-medium group-hover:text-gray-900 transition-colors">
                            {item.desc}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
