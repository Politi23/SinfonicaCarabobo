---
import imageGrid from "@assets/images/organizacion/OSC en TTC 3.webp";

// Extraemos los beneficios a un arreglo para mantener el código HTML súper limpio
const benefits = [
    {
        title: "Difusión Digital",
        desc: "Presencia estratégica como patrocinante oficial en nuestro ecosistema de redes y medios digitales.",
    },
    {
        title: "Exclusividad",
        desc: "Ubicación preferencial y privilegios de acceso en nuestra cartelera de conciertos de temporada.",
    },
    {
        title: "Activación",
        desc: "Espacios de networking y stands de marca en los foyers de las salas de conciertos.",
    },
    {
        title: "Multimedia",
        desc: "Producción de contenido audiovisual de alta gama vinculando los valores de su marca.",
    },
    {
        title: "Presencia en Vivo",
        desc: "Reconocimiento público y menciones de honor durante el desarrollo de nuestras galas.",
    },
    {
        title: "Identidad Aliada",
        desc: "Material promocional físico de gran formato compartiendo la identidad visual de su empresa.",
    },
];
---

<section class="relative py-24 bg-gray-950 text-white overflow-hidden">
    <div
        class="absolute inset-0 z-0 opacity-40 bg-cover bg-fixed bg-center"
        style={`background-image: url('${imageGrid.src}');`}
    >
    </div>

    <div
        class="absolute inset-0 bg-gradient-to-b from-black/95 via-black/70 to-black/95 z-0"
    >
    </div>

    <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8"
        >
            <div class="max-w-2xl">
                <h2
                    class="text-4xl md:text-6xl font-display font-bold leading-tight"
                >
                    Propuesta de <br />
                    <span class="font-bold text-primary italic"
                        >valor empresarial</span
                    >
                </h2>
            </div>
            <p
                class="text-gray-300 text-lg max-w-sm font-light border-l-2 border-primary/50 pl-6 leading-relaxed"
            >
                Una alianza donde el arte y la excelencia elevan el prestigio y
                el alcance de su empresa.
            </p>
        </div>

        <div
            class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 border border-white/20 overflow-hidden backdrop-blur-md rounded-2xl shadow-2xl"
        >
            {
                benefits.map((item) => (
                    <div class="group relative p-10 bg-black/85 hover:bg-black/40 transition-all duration-500 flex flex-col">
                        <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-secondary to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

                        <h3 class="text-xl font-display font-bold mb-4 tracking-tighter uppercase text-white transition-colors">
                            {item.title}
                        </h3>

                        <p class="text-gray-400 leading-relaxed font-light group-hover:text-gray-100 transition-colors">
                            {item.desc}
                        </p>
                    </div>
                ))
            }
        </div>

        <div class="mt-16 flex items-center gap-4">
            <div
                class="h-[1px] flex-grow bg-gradient-to-r from-primary/50 to-transparent"
            >
            </div>
            <p
                class="text-gray-500 text-[10px] tracking-[0.3em] uppercase italic"
            >
                * Beneficios sujetos a nivel de patrocinio
            </p>
        </div>
    </div>
</section>
