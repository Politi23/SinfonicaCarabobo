---

---

<section class="py-24 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-16">
            <h2
                class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-6"
            >
                ¿Qué tenemos para <span class="text-primary">su empresa?</span>
            </h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto">
                Ofrecemos un paquete de beneficios exclusivos diseñados para
                potenciar la visibilidad de su marca a través de la cultura.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Benefit 1 -->
            <div
                class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-100"
            >
                <div
                    class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-primary"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Difusión de marca
                </h3>
                <p class="text-gray-600 mb-2">
                    Como patrocinante oficial en redes sociales y medios
                    digitales. *
                </p>
            </div>

            <!-- Benefit 2 -->
            <div
                class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-100"
            >
                <div
                    class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-primary"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Puestos preferenciales
                </h3>
                <p class="text-gray-600 mb-2">
                    Ubicación privilegiada en los conciertos de la temporada del
                    año. *
                </p>
            </div>

            <!-- Benefit 3 -->
            <div
                class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-100"
            >
                <div
                    class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-primary"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Activación de marca
                </h3>
                <p class="text-gray-600 mb-2">
                    Área para stand en la entrada de las salas de conciertos. *
                </p>
            </div>

            <!-- Benefit 4 -->
            <div
                class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-100"
            >
                <div
                    class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-primary"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Contenido Multimedia
                </h3>
                <p class="text-gray-600 mb-2">
                    Diseño y promoción de video tipo Reel informativo vinculando
                    su marca. *
                </p>
            </div>

            <!-- Benefit 5 -->
            <div
                class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-100"
            >
                <div
                    class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-primary"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Mención en vivo
                </h3>
                <p class="text-gray-600 mb-2">
                    Reconocimiento público y mención de la empresa durante los
                    conciertos. *
                </p>
            </div>

            <!-- Benefit 6 -->
            <!-- Benefit 6 -->
            <div
                class="group p-8 bg-gray-50 rounded-2xl hover:bg-white hover:shadow-xl transition-all duration-300 border border-transparent hover:border-gray-100"
            >
                <div
                    class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300 text-primary"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3">
                    Pendón de vinculación
                </h3>
                <p class="text-gray-600 mb-2">
                    Realización de pendón compartido Aliado-OSC para difusión en
                    eventos. *
                </p>
            </div>
        </div>

        <div class="mt-8 text-center border-t border-gray-100 pt-8">
            <p class="text-gray-400 text-sm italic">
                * Según nivel de patrocinio / intereses de la empresa.
            </p>
        </div>
    </div>
</section>
