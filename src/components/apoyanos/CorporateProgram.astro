---

---

<section class="py-24 bg-white overflow-hidden border-t border-gray-100">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex flex-col md:flex-row items-center gap-16">
            <!-- Content -->
            <div class="w-full md:w-1/2">
                <span
                    class="inline-block py-2 px-4 border border-gray-200 text-gray-500 text-[10px] font-bold tracking-[0.3em] uppercase mb-10"
                >
                    Beneficios Adicionales
                </span>
                <h2
                    class="text-5xl md:text-7xl font-display font-bold text-black mb-12 leading-none tracking-tighter"
                >
                    Programa <br /><span class="text-secondary font-bold italic"
                        >Aliados</span
                    >
                </h2>

                <ul class="space-y-2">
                    <li
                        class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
                    >
                        <div class="pt-1">
                            <div class="w-2 h-2 bg-secondary"></div>
                        </div>
                        <div>
                            <h4
                                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
                            >
                                15% Descuento en Presentaciones
                            </h4>
                            <p
                                class="text-gray-500 text-base leading-relaxed max-w-md"
                            >
                                En contrataciones de la Orquesta o sus ensambles
                                para eventos corporativos o sociales.
                            </p>
                        </div>
                    </li>

                    <li
                        class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
                    >
                        <div class="pt-1">
                            <div class="w-2 h-2 bg-secondary"></div>
                        </div>
                        <div>
                            <h4
                                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
                            >
                                50% Descuento Académico
                            </h4>
                            <p
                                class="text-gray-500 text-base leading-relaxed max-w-md"
                            >
                                Beca en nuestro programa académico musical para
                                los hijos del personal de su empresa.
                            </p>
                        </div>
                    </li>

                    <li
                        class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
                    >
                        <div class="pt-1">
                            <div class="w-2 h-2 bg-secondary"></div>
                        </div>
                        <div>
                            <h4
                                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
                            >
                                Beneficios Fiscales
                            </h4>
                            <p
                                class="text-gray-500 text-base leading-relaxed max-w-md"
                            >
                                Deducción de impuestos en el marco de la
                                responsabilidad social empresarial.
                            </p>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Visual/Image Area -->
            <div
                class="w-full md:w-1/2 relative mt-12 md:mt-0 md:-translate-y-10"
            >
                <div
                    class="relative z-10 bg-white p-10 md:p-14 rounded-2xl shadow-md border border-gray-100"
                >
                    <div class="w-12 h-1 bg-secondary mb-8 rounded-full"></div>

                    <h3
                        class="text-3xl md:text-4xl font-display font-bold mb-8 uppercase tracking-tighter text-black"
                    >
                        Nuestra <br /><span
                            class="font-bold text-secondary italic"
                            >Propuesta</span
                        >
                    </h3>

                    <p
                        class="text-gray-600 mb-6 leading-relaxed text-lg font-light"
                    >
                        Forjar una alianza estratégica que impulse el desarrollo
                        a través de iniciativas <strong
                            class="font-medium text-gray-900"
                            >artísticas, académicas y sociales</strong
                        >.
                    </p>

                    <p class="text-gray-600 leading-relaxed text-lg font-light">
                        Con su respaldo, transformamos el futuro de cientos de
                        jóvenes talentos carabobeños, consolidando a su empresa
                        como un <strong class="font-medium text-gray-900"
                            >pilar fundamental</strong
                        > de la cultura en nuestra región.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
