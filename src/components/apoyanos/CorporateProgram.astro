---

---

<section class="py-24 bg-white overflow-hidden border-t border-gray-100">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex flex-col md:flex-row items-center gap-16">
            <!-- Content -->
            <div class="w-full md:w-1/2">
                <span
                    class="inline-block py-2 px-4 border border-gray-200 text-gray-500 text-[10px] font-bold tracking-[0.3em] uppercase mb-10"
                >
                    Beneficios Adicionales
                </span>
                <h2
                    class="text-5xl md:text-7xl font-display font-medium text-black mb-12 leading-none tracking-tighter"
                >
                    Programa <br /><span class="text-secondary font-bold italic"
                        >Aliados</span
                    >
                </h2>

                <ul class="space-y-2">
                    <li
                        class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
                    >
                        <div class="pt-1">
                            <div class="w-2 h-2 bg-secondary"></div>
                        </div>
                        <div>
                            <h4
                                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
                            >
                                15% Descuento en Presentaciones
                            </h4>
                            <p
                                class="text-gray-500 text-sm leading-relaxed max-w-md"
                            >
                                En contrataciones de la Orquesta o sus ensambles
                                para eventos corporativos o sociales.
                            </p>
                        </div>
                    </li>

                    <li
                        class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
                    >
                        <div class="pt-1">
                            <div class="w-2 h-2 bg-secondary"></div>
                        </div>
                        <div>
                            <h4
                                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
                            >
                                50% Descuento Académico
                            </h4>
                            <p
                                class="text-gray-500 text-sm leading-relaxed max-w-md"
                            >
                                Medio beca en nuestro programa académico musical
                                para los hijos del personal de su empresa.
                            </p>
                        </div>
                    </li>

                    <li
                        class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
                    >
                        <div class="pt-1">
                            <div class="w-2 h-2 bg-secondary"></div>
                        </div>
                        <div>
                            <h4
                                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
                            >
                                Beneficios Fiscales
                            </h4>
                            <p
                                class="text-gray-500 text-sm leading-relaxed max-w-md"
                            >
                                Deducción de impuestos en el marco de la
                                responsabilidad social empresarial.
                            </p>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Visual/Image Area -->
            <div class="w-full md:w-1/2 relative">
                <div
                    class="absolute -top-4 -right-4 w-full h-full border-2 border-secondary z-0"
                >
                </div>
                <div
                    class="relative z-10 bg-black p-12 text-white border border-black"
                >
                    <div class="w-12 h-1 bg-secondary mb-8"></div>
                    <h3
                        class="text-3xl font-display font-medium mb-8 uppercase tracking-tighter"
                    >
                        Nuestra <br /><span
                            class="font-bold text-secondary italic"
                            >Propuesta</span
                        >
                    </h3>
                    <p
                        class="text-gray-400 mb-8 leading-relaxed text-lg font-light"
                    >
                        Establecer una alianza que traiga consigo innovaciones y
                        grandes actividades entorno a lo artístico, académico y
                        social.
                    </p>
                    <p class="text-gray-400 leading-relaxed text-lg font-light">
                        Al apoyarnos, brindas oportunidades a centenas de
                        jóvenes y grandes músicos pertenecientes a nuestra
                        institución.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
