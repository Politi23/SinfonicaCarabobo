---

---

<section class="py-24 bg-surface-dark text-white relative overflow-hidden">
    <!-- Background Accents -->
    <div
        class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-black/20 to-transparent"
    >
    </div>
    <div
        class="absolute bottom-0 left-0 w-64 h-64 bg-primary/15 rounded-full blur-3xl transform -translate-x-1/2 translate-y-1/2"
    >
    </div>
    <div
        class="absolute top-1/4 right-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl"
    >
    </div>

    <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
        <h2 class="text-4xl md:text-5xl font-display font-bold mb-8 text-white">
            Donaciones
        </h2>

        <p
            class="text-xl text-white/80 mb-10 leading-relaxed max-w-2xl mx-auto"
        >
            Todas las donaciones son bienvenidas, tanto en aportes económicos
            como apoyo logístico, financiamiento de actividades, reparación y
            compra de instrumentos musicales.
        </p>

        <div
            class="flex flex-col md:flex-row items-center justify-center gap-6 mb-16"
        >
            <a
                href="mailto:gerencia@sinfocarabobo.com"
                class="group flex items-center gap-4 bg-primary hover:bg-primary-dark px-8 py-5 transition-all duration-300 border border-primary-light/30 hover:border-primary-light/60 hover:shadow-lg hover:shadow-primary/20"
            >
                <div
                    class="w-11 h-11 bg-white/20 flex items-center justify-center group-hover:bg-white/30 transition-colors"
                >
                    <svg
                        class="w-5 h-5 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path></svg
                    >
                </div>
                <div class="text-left">
                    <div
                        class="text-xs uppercase tracking-wider text-white/70 font-bold"
                    >
                        Escríbenos
                    </div>
                    <div class="font-bold text-white">
                        gerencia@sinfocarabobo.com
                    </div>
                </div>
            </a>

            <a
                href="tel:04143410642"
                class="group flex items-center gap-4 bg-primary hover:bg-primary-dark px-8 py-5 transition-all duration-300 border border-primary-light/30 hover:border-primary-light/60 hover:shadow-lg hover:shadow-primary/20"
            >
                <div
                    class="w-11 h-11 bg-white/20 flex items-center justify-center group-hover:bg-white/30 transition-colors"
                >
                    <svg
                        class="w-5 h-5 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                        ></path></svg
                    >
                </div>
                <div class="text-left">
                    <div
                        class="text-xs uppercase tracking-wider text-white/70 font-bold"
                    >
                        Llámanos
                    </div>
                    <div class="font-bold text-white">0414-3410642</div>
                </div>
            </a>
        </div>

        <div class="inline-block relative">
            <p
                class="text-2xl md:text-3xl font-serif italic text-white/90 relative z-10"
            >
                ¡Gracias por ser parte de nuestra melodía!
            </p>
        </div>
    </div>
</section>
