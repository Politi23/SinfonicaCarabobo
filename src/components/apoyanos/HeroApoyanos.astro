---
import imageGrid from "@assets/images/backgrounds/image-grid.webp";
---

<section
    class="relative h-[60vh] min-h-[500px] flex items-center justify-center bg-gradient-to-br from-background-light to-secondary/10 overflow-hidden"
>
    <div
        class="absolute inset-0 z-0 bg-cover bg-center opacity-10"
        style={`background-image: url('${imageGrid.src}');`}
    >
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center">
        <h1
            class="text-[clamp(2.2rem,5vw,3.5rem)] font-display font-bold text-text-dark mb-8 leading-tight"
        >
            ¡Sé parte de <span class="text-secondary">nuestra melodía!</span>
        </h1>

        <div class="max-w-2xl mx-auto">
            <p
                class="text-xl md:text-2xl text-gray-600 font-serif leading-relaxed"
            >
                "¡Juntos podemos crear un legado musical mucho más grande!"
            </p>
        </div>
    </div>
</section>
