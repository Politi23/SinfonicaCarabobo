---

---

<section
    class="relative h-[60vh] min-h-[500px] flex items-center justify-center bg-gray-900 overflow-hidden"
>
    <!-- Background Image with Overlay -->
    <div
        class="absolute inset-0 z-0 opacity-40 bg-[url('/sinfonica.jpg')] bg-fixed bg-cover bg-center"
    >
    </div>
    <div
        class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/50 to-black/90 z-0"
    >
    </div>

    <!-- Content -->
    <div class="container mx-auto px-6 relative z-10 text-center pt-32 md:pt-0">
        <span
            class="inline-block py-1 px-3 border border-primary/50 rounded-full text-primary text-sm font-bold tracking-widest uppercase mb-6 backdrop-blur-sm bg-black/30"
        >
            Propuestas de Vinculación
        </span>

        <h1
            class="text-5xl md:text-6xl lg:text-7xl font-display font-bold text-white mb-8 leading-tight"
        >
            ¡Sé parte de <br /><span class="text-primary relative inline-block"
                >nuestra melodía!</span
            >
        </h1>

        <div class="max-w-3xl mx-auto">
            <p
                class="text-xl md:text-2xl text-gray-200 font-serif italic leading-relaxed"
            >
                "¡Juntos podemos crear un legado musical mucho más grande!"
            </p>
            <div class="w-24 h-1 bg-primary mx-auto mt-8 rounded-full"></div>
        </div>
    </div>
</section>
