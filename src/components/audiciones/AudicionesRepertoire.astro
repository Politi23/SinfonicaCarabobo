---
import SectionTitle from "@components/ui/SectionTitle.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";
import type { InstrumentGroup } from "@config/wp-audiciones";

interface Props {
    instruments: InstrumentGroup[];
    offline: boolean;
}

const { instruments, offline } = Astro.props;

const withCounts = instruments.map((instrument) => ({
    ...instrument,
    available: instrument.files.filter((f) => f.link).length,
}));
---

<section id="instrumentos" class="py-16 md:py-24 bg-white text-gray-800">
    <div class="container mx-auto px-6 max-w-4xl">
        <SectionTitle>Materiales de audición</SectionTitle>
        <p class="text-gray-500 mt-2 max-w-2xl">
            Selecciona tu instrumento para ver los materiales disponibles por
            nivel.
        </p>

        {
            offline ? (
                <div class="mt-10">
                    <WpOfflineError
                        title="No hay materiales disponibles"
                        message="No pudimos cargar los materiales de audición en este momento. Por favor, inténtalo más tarde."
                    />
                </div>
            ) : withCounts.length === 0 ? (
                <div class="mt-10">
                    <WpOfflineError
                        title="Aún no hay materiales publicados"
                        message="Todavía no se han cargado los materiales de audición para ningún instrumento."
                    />
                </div>
            ) : (
                <div class="mt-10 divide-y divide-gray-200 border border-gray-200 rounded-sm shadow-sm shadow-gray-900/5">
                    {withCounts.map((instrument, i) => (
                        <details class="group" open={i === 0}>
                            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none bg-white group-open:bg-gray-50/70 hover:bg-gray-50 transition-colors">
                                <span class="flex items-center gap-4 min-w-0">
                                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary ring-1 ring-primary/20">
                                        <i class="ph-fill ph-music-notes text-xl" />
                                    </span>
                                    <span class="min-w-0">
                                        <span class="block font-serif font-bold text-lg text-gray-900 truncate">
                                            {instrument.name}
                                        </span>
                                        <span class="block text-xs text-gray-400 mt-0.5">
                                            {instrument.files.length}{" "}
                                            {instrument.files.length === 1
                                                ? "nivel"
                                                : "niveles"}
                                        </span>
                                    </span>
                                </span>
                                <span class="flex items-center gap-4 shrink-0">
                                    {instrument.available > 0 && (
                                        <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-secondary/10 px-3 py-1 text-xs font-bold text-secondary">
                                            <i class="ph-fill ph-check-circle text-sm" />
                                            {instrument.available} disponible
                                            {instrument.available === 1
                                                ? ""
                                                : "s"}
                                        </span>
                                    )}
                                    <i class="ph ph-caret-down text-gray-400 transition-transform duration-300 group-open:rotate-180" />
                                </span>
                            </summary>
                            <div class="px-6 pb-6 pt-1 bg-gray-50/50">
                                <ul class="grid gap-2.5 sm:grid-cols-2">
                                    {instrument.files.map((file) =>
                                        file.link ? (
                                            <li>
                                                <a
                                                    href={file.link}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="flex items-center gap-3 rounded border border-gray-200 bg-white px-4 py-3.5 shadow-sm shadow-gray-900/5 hover:border-primary hover:shadow-md hover:shadow-primary/10 transition-all"
                                                >
                                                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                                                        <i class="ph-fill ph-file-zip text-base" />
                                                    </span>
                                                    <span class="min-w-0">
                                                        <span class="block truncate text-sm font-semibold text-gray-800">
                                                            {file.title}
                                                        </span>
                                                        <span class="block text-xs text-gray-400">
                                                            Descargar archivo
                                                        </span>
                                                    </span>
                                                    <i class="ph ph-download-simple ml-auto shrink-0 text-lg text-gray-300" />
                                                </a>
                                            </li>
                                        ) : (
                                            <li>
                                                <span class="flex items-center gap-3 rounded border border-dashed border-gray-200 bg-white/60 px-4 py-3.5">
                                                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-300">
                                                        <i class="ph ph-file-zip text-base" />
                                                    </span>
                                                    <span class="min-w-0">
                                                        <span class="block truncate text-sm font-semibold text-gray-400">
                                                            {file.title}
                                                        </span>
                                                        <span class="block text-xs text-gray-300">
                                                            Próximamente
                                                        </span>
                                                    </span>
                                                </span>
                                            </li>
                                        ),
                                    )}
                                </ul>
                            </div>
                        </details>
                    ))}
                </div>
            )
        }
    </div>
</section>
