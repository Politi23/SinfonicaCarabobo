---
export interface Props {
    showContact?: boolean;
}

const { showContact = true } = Astro.props;
---

<section class="py-16 md:py-24 bg-background-dark text-text-light">
    <div class="container mx-auto px-6 max-w-5xl">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <!-- Información principal -->
            <div class="space-y-6">
                <h2
                    class="text-3xl md:text-4xl font-display font-bold text-white"
                >
                    Proceso de
                    <span class="text-primary">Audición</span>
                </h2>
                <p class="text-gray-300 leading-relaxed font-serif">
                    La Orquesta Sinfónica de Carabobo invita a todos los músicos
                    interesados a formar parte de nuestra agrupación. Realizamos
                    audiciones periódicas para incorporar nuevos talentos a
                    nuestras filas.
                </p>

                <div class="space-y-4">
                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 flex-shrink-0 bg-primary/20 rounded-full flex items-center justify-center"
                        >
                            <span class="text-primary font-bold">1</span>
                        </div>
                        <div>
                            <h3 class="text-white font-semibold mb-1">
                                Descarga el repertorio
                            </h3>
                            <p class="text-gray-400 text-sm">
                                Revisa las obras requeridas para tu instrumento
                                y nivel de interés.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 flex-shrink-0 bg-primary/20 rounded-full flex items-center justify-center"
                        >
                            <span class="text-primary font-bold">2</span>
                        </div>
                        <div>
                            <h3 class="text-white font-semibold mb-1">
                                Prepara tu audición
                            </h3>
                            <p class="text-gray-400 text-sm">
                                Estudia los fragmentos indicados según la
                                posición a la que aspiras.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4">
                        <div
                            class="w-10 h-10 flex-shrink-0 bg-primary/20 rounded-full flex items-center justify-center"
                        >
                            <span class="text-primary font-bold">3</span>
                        </div>
                        <div>
                            <h3 class="text-white font-semibold mb-1">
                                Completa tu inscripción
                            </h3>
                            <p class="text-gray-400 text-sm">
                                Descarga y llena la planilla de inscripción,
                                luego contáctanos para agendar tu audición.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información de contacto -->
            {
                showContact && (
                    <div class="bg-gradient-to-br from-gray-800 to-gray-900 p-8 rounded-2xl border border-gray-700">
                        <h3 class="text-xl font-display font-bold text-white mb-6">
                            Información de Contacto
                        </h3>
                        <div class="space-y-4">
                            <a
                                href="mailto:audiciones@sinfocarabobo.com"
                                class="flex items-center gap-4 p-4 rounded-lg bg-gray-700/50 hover:bg-gray-700 transition-colors group"
                            >
                                <div class="w-12 h-12 flex items-center justify-center bg-primary/20 rounded-full group-hover:bg-primary/30 transition-colors">
                                    <svg
                                        class="w-6 h-6 text-primary"
                                        fill="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                                    </svg>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                                        Email
                                    </div>
                                    <div class="text-white font-medium">
                                        audiciones@sinfocarabobo.com
                                    </div>
                                </div>
                            </a>

                            <a
                                href="tel:02418329876"
                                class="flex items-center gap-4 p-4 rounded-lg bg-gray-700/50 hover:bg-gray-700 transition-colors group"
                            >
                                <div class="w-12 h-12 flex items-center justify-center bg-primary/20 rounded-full group-hover:bg-primary/30 transition-colors">
                                    <svg
                                        class="w-6 h-6 text-primary"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                        />
                                    </svg>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                                        Teléfono
                                    </div>
                                    <div class="text-white font-medium">
                                        0241-832-9876
                                    </div>
                                </div>
                            </a>

                            <div class="flex items-center gap-4 p-4 rounded-lg bg-gray-700/50">
                                <div class="w-12 h-12 flex items-center justify-center bg-primary/20 rounded-full">
                                    <svg
                                        class="w-6 h-6 text-primary"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        />
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                        />
                                    </svg>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                                        Ubicación
                                    </div>
                                    <div class="text-white font-medium">
                                        Valencia, Estado Carabobo
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                )
            }
        </div>
    </div>
</section>
