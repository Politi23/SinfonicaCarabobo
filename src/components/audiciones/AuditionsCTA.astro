---
import sinfonica from "@assets/images/orquesta/OSC.webp";
import SectionTitle from "@components/ui/SectionTitle.astro";

interface Props {
    basePath: string;
}

const { basePath } = Astro.props;
---

<!-- CTA Final -->
<section class="py-16 md:py-24 bg-black text-white relative">
    <div
        class="absolute inset-0 opacity-10 bg-cover bg-fixed bg-center filter grayscale contrast-150"
        style={`background-image: url('${sinfonica.src}');`}
    >
    </div>

    <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
        <SectionTitle
            variant="red"
            class="text-3xl md:text-5xl font-display font-bold leading-tight text-white"
            wrapperClass="text-center"
            dividerClass="hidden"
        >
            ¿Listo para formar parte de la orquesta?
        </SectionTitle>
        <p
            class="text-xl text-gray-300 mt-4 mb-12 max-w-2xl mx-auto font-light leading-relaxed italic"
        >
            Completa tu planilla de inscripción y contáctanos para agendar tu
            audición
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
                href={`${basePath}/planilla de Audición OSC.pdf`}
                download
                class="px-8 py-3 border border-white/40 text-white font-bold text-sm uppercase tracking-widest hover:border-white hover:bg-white/10 transition-colors"
            >
                Descargar Planilla
            </a>
            <a
                href="mailto:audiciones@sinfocarabobo.com"
                class="px-8 py-3 bg-primary text-white font-bold text-sm uppercase tracking-widest hover:bg-primary/90 transition-colors"
            >
                Contactar por Email
            </a>
        </div>
    </div>
</section>
