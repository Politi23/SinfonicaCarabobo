---
export interface Props {
    planillaPath: string;
}

const { planillaPath } = Astro.props;
---

<section
    id="descargar-planilla"
    class="py-16 md:py-24 bg-gradient-to-br from-primary/20 via-primary/10 to-secondary/10 dark:from-primary/30 dark:via-primary/20 dark:to-secondary/20"
>
    <div class="container mx-auto px-6">
        <div
            class="max-w-4xl mx-auto bg-white dark:bg-gray-800 rounded-3xl shadow-2xl overflow-hidden"
        >
            <div class="grid md:grid-cols-2">
                <!-- Contenido izquierdo -->
                <div class="p-8 md:p-12 flex flex-col justify-center">
                    <span
                        class="text-primary font-bold text-sm uppercase tracking-wider mb-2"
                    >
                        Paso Importante
                    </span>
                    <h2
                        class="text-3xl md:text-4xl font-display font-bold text-gray-900 dark:text-white mb-4"
                    >
                        Descarga la Planilla de Inscripción
                    </h2>
                    <p
                        class="text-gray-600 dark:text-gray-300 mb-8 font-serif leading-relaxed"
                    >
                        Para participar en el proceso de audición, es necesario
                        completar este formulario con tus datos personales y
                        información musical.
                    </p>

                    <div class="space-y-4 mb-8">
                        <div
                            class="flex items-center gap-3 text-gray-700 dark:text-gray-300"
                        >
                            <svg
                                class="w-5 h-5 text-primary flex-shrink-0"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path>
                            </svg>
                            <span class="text-sm"
                                >Datos personales y de contacto</span
                            >
                        </div>
                        <div
                            class="flex items-center gap-3 text-gray-700 dark:text-gray-300"
                        >
                            <svg
                                class="w-5 h-5 text-primary flex-shrink-0"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path>
                            </svg>
                            <span class="text-sm"
                                >Formación musical y experiencia</span
                            >
                        </div>
                        <div
                            class="flex items-center gap-3 text-gray-700 dark:text-gray-300"
                        >
                            <svg
                                class="w-5 h-5 text-primary flex-shrink-0"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path>
                            </svg>
                            <span class="text-sm"
                                >Instrumento y nivel de aspiración</span
                            >
                        </div>
                    </div>

                    <a
                        href={planillaPath}
                        download
                        class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-primary text-white font-semibold rounded-xl hover:bg-primary/90 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-primary/50"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                            ></path>
                        </svg>
                        Descargar Planilla PDF
                    </a>
                </div>

                <!-- Lado derecho con decoración -->
                <div
                    class="bg-gradient-to-br from-primary to-secondary p-8 md:p-12 flex flex-col justify-center items-center text-white"
                >
                    <div
                        class="w-32 h-32 bg-white/20 rounded-full flex items-center justify-center mb-6 backdrop-blur-sm"
                    >
                        <svg
                            class="w-16 h-16"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                            ></path>
                        </svg>
                    </div>
                    <p class="text-center text-white/90 font-serif italic">
                        "La música es el lenguaje universal que nos une en
                        armonía"
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
