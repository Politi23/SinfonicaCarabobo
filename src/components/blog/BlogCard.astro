---
export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  category: string;
  slug?: string;
}
const { title, excerpt, image, date, category, slug } = Astro.props as Props;
---

<article class="group flex flex-col bg-surface-light dark:bg-card-dark rounded-lg overflow-hidden shadow-md hover:shadow-xl dark:shadow-none dark:hover:shadow-2xl dark:hover:shadow-black/50 transition-all duration-300 border border-border-light dark:border-gray-800">
  <div class="relative w-full aspect-[4/3] overflow-hidden">
    <img alt={title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out" src={image} />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80"></div>
    <span class="absolute top-4 left-4 bg-black/100 backdrop-blur-sm border border-primary/40 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest shadow-sm">
      {category}
    </span>
    <span class="absolute bottom-4 left-4 text-white text-sm font-medium flex items-center gap-1 drop-shadow-md">
      <span class="material-icons text-base text-primary/80">calendar_today</span>
      {(() => {
        try {
          const d = new Date(date);
          if (!Number.isNaN(d.getTime())) {
            return d.toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' });
          }
        } catch (e) {
        }
        return date;
      })()}
    </span>
  </div>
  <div class="p-6 md:p-8 flex flex-col flex-grow">
    <h2 class="text-2xl font-bold mb-3 text-text-dark dark:text-text-light group-hover:text-primary transition-colors leading-tight">{title}</h2>
    <p class="text-text-dark dark:text-gray-400 mb-6 flex-grow leading-relaxed line-clamp-3">{excerpt}</p>
    <a class="inline-flex items-center text-primary font-bold uppercase text-xs tracking-widest hover:text-primary-dark dark:hover:text-yellow-300 transition-colors group-hover:gap-2 gap-1" href={`/blog/${slug ?? '#'}`}>
      Leer más <span class="material-icons text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
    </a>
  </div>
</article>