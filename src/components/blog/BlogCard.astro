---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";

export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  category: string;
  slug?: string;
}
const { title, excerpt, image, date, category, slug } = Astro.props;

// Formateo de fecha seguro
const formattedDate = (() => {
  try {
    return new Date(date).toLocaleDateString("es-VE", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    });
  } catch {
    return date;
  }
})();
---

<article
  class="group flex flex-col bg-white dark:bg-card-dark rounded-lg overflow-hidden shadow-md border border-border-light"
>
  <div class="relative w-full aspect-[4/3] overflow-hidden">
    <a href={`/blog/${slug || "#"}`} class="block w-full h-full">
      <img
        src={image || logoSimpleBbg.src}
        alt={title}
        class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
        width={logoSimpleBbg.width}
        height={logoSimpleBbg.height}
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80"
      >
      </div>
    </a>
    {
      category && (
        <span class="absolute top-4 left-4 bg-black/80 backdrop-blur-sm border border-primary/40 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest shadow-sm z-10">
          {category}
        </span>
      )
    }
    <span
      class="absolute bottom-4 left-4 text-white text-sm font-medium flex items-center gap-1 drop-shadow-md z-10"
    >
      <span class="material-icons text-base text-primary/80"
        >calendar_today</span
      >
      {formattedDate}
    </span>
  </div>

  <div class="p-6 flex flex-col flex-grow">
    <h2
      class="text-2xl font-bold mb-3 text-text-dark group-hover:text-primary transition-colors leading-tight line-clamp-2"
    >
      {title}
    </h2>
    <p class="text-text-dark/80 mb-6 flex-grow leading-relaxed line-clamp-3">
      {excerpt}
    </p>
    <a
      href={`/blog/${slug || "#"}`}
      class="inline-flex items-center text-primary font-bold uppercase text-xs tracking-widest hover:text-primary-dark transition-all group-hover:gap-2 gap-1"
    >
      Leer más <span class="material-icons text-sm">arrow_forward</span>
    </a>
  </div>
</article>
