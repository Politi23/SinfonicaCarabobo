---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";
import { Image } from "astro:assets";

export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  category: string;
  slug?: string;
}
const { title, excerpt, image, date, category, slug } = Astro.props;

// Formateo de fecha seguro
const formattedDate = (() => {
  try {
    return new Date(date).toLocaleDateString("es-VE", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    });
  } catch {
    return date;
  }
})();
---

<article
  class="group bg-white rounded shadow transition-all duration-300 overflow-hidden flex flex-col h-full relative"
>
  <a
    href={`/blog/${slug || "#"}`}
    class="absolute inset-0 z-10"
    aria-label={`Leer más sobre ${title}`}></a>

  <div class="relative h-56 w-full overflow-hidden bg-gray-100">
    <img
      src={image || logoSimpleBbg.src}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-300"
    >
    </div>

    {
      category && (
        <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 text-xs font-bold uppercase tracking-widest text-primary shadow-sm z-20 rounded-sm">
          {category}
        </span>
      )
    }
  </div>

  <div class="p-6 flex flex-col flex-grow relative z-20 pointer-events-none">
    <div
      class="flex items-center gap-2 mb-3 text-xs text-gray-500 uppercase tracking-wider font-medium"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4 text-primary"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        ></path>
      </svg>
      {formattedDate}
    </div>

    <h3
      class="text-xl font-serif font-medium text-gray-900 mb-3 group-hover:text-primary transition-colors line-clamp-2"
    >
      {title}
    </h3>

    <p
      class="text-gray-600 text-sm flex-grow line-clamp-3 mb-6 leading-relaxed"
    >
      {excerpt}
    </p>

    <div
      class="pt-4 border-t border-gray-100 flex justify-between items-center mt-auto"
    >
      <span
        class="text-xs uppercase tracking-widest text-gray-500 font-medium group-hover:text-primary transition-colors"
        >Leer artículo</span
      >
      <span
        class="w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors duration-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </span>
    </div>
  </div>
</article>
