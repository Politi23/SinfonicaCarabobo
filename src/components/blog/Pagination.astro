---
export interface Props {
  currentPage?: number;
  totalPages?: number;
  baseUrl?: string;
}

const { 
  currentPage = 1, 
  totalPages = 5, 
  baseUrl = '' 
} = Astro.props as Props;
---

<div class="mt-16 flex justify-center">
  <nav aria-label="Pagination" class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px">
    <a 
      class:list={[
        "relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-card-dark text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800",
        { "pointer-events-none opacity-50": currentPage === 1 }
      ]}
      href={currentPage > 1 ? `${baseUrl}/${currentPage - 1}` : '#'}
      aria-label="Previous"
    >
      <span class="sr-only">Previous</span>
      <span class="material-icons">chevron_left</span>
    </a>
    
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
      <a
        key={page}
        aria-current={currentPage === page ? "page" : undefined}
        class:list={[
          "relative inline-flex items-center px-4 py-2 border text-sm font-medium",
          { "z-10 bg-primary/10 border-primary text-primary": currentPage === page },
          { "bg-white dark:bg-card-dark border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800": currentPage !== page },
          { "hidden md:inline-flex": page > 3 && page < totalPages -1 }
        ]}
        href={`${baseUrl}/${page}`}
      >
        {page}
      </a>
    ))}
    
    {totalPages > 5 && (
      <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-card-dark text-sm font-medium text-gray-700 dark:text-gray-500">
        ...
      </span>
    )}
    
    <a 
      class:list={[
        "relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-card-dark text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800",
        { "pointer-events-none opacity-50": currentPage === totalPages }
      ]}
      href={currentPage < totalPages ? `${baseUrl}/${currentPage + 1}` : '#'}
      aria-label="Next"
    >
      <span class="sr-only">Next</span>
      <span class="material-icons">chevron_right</span>
    </a>
  </nav>
</div>