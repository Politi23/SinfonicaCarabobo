---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";
import { formatDateToDMY } from "../../utils/date";

export interface Props {
    title: string;
    excerpt: string;
    image: string;
    date: string;
    category: string;
    slug?: string;
}
const { title, excerpt, image, date, category, slug } = Astro.props;

const formattedDate = formatDateToDMY(date);

const EXCERPT_FALLBACK_MAX_CHARS = 110;
const normalizedExcerpt = (excerpt || "").replace(/\s+/g, " ").trim();
const excerptWithFallback =
    normalizedExcerpt.length > EXCERPT_FALLBACK_MAX_CHARS
        ? `${normalizedExcerpt.slice(0, EXCERPT_FALLBACK_MAX_CHARS).replace(/\s+\S*$/, "").trim()} (...)`
        : normalizedExcerpt;
---

<a href={`/blog/${slug || "#"}`} class="block group">
    <article
        class="flex flex-col bg-white rounded-lg overflow-hidden shadow-md border border-border-light h-full"
    >
        <div class="relative w-full aspect-video overflow-hidden">
            <img
                src={image || logoSimpleBbg.src}
                alt={title}
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 ease-out"
                width={logoSimpleBbg.width}
                height={logoSimpleBbg.height}
                loading="lazy"
                decoding="async"
            />
            {
                category && (
                    <span class="absolute top-2 left-2 bg-black/80 backdrop-blur-sm border border-primary/40 text-primary px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider z-10">
                        {category}
                    </span>
                )
            }
        </div>

        <div class="p-3 flex flex-col flex-grow">
            <h3
                class="text-sm font-bold text-text-dark group-hover:text-primary transition-colors leading-snug line-clamp-2 mb-1"
            >
                {title}
            </h3>
            <p
                class="text-[11px] text-text-dark/70 line-clamp-3 leading-relaxed mb-2 h-[calc(1.625em*3)] overflow-hidden"
            >
                {excerptWithFallback}
            </p>
            <span
                class="text-[10px] text-text-muted flex items-center gap-1 mt-auto"
            >
                <span class="material-icons text-[12px]">calendar_today</span>
                {formattedDate}
            </span>
        </div>
    </article>
</a>
