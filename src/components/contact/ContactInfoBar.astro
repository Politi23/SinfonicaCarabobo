---
export interface Props {
    phones: Array<{
        name: string;
        number: string;
        link: string;
    }>;
    emails: Array<{
        name: string;
        email: string;
        link: string;
    }>;
    addresses: Array<{
        name: string;
        location: string;
        mapLink: string;
    }>;
}

const { phones, emails, addresses } = Astro.props;
---

<section class="bg-surface-dark border-y border-primary/10">
    <div class="container mx-auto px-6">
        <div
            class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-primary/10"
        >
            <!-- Teléfonos -->
            <div class="py-8 md:py-10 md:pr-8">
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-10 h-10 border border-primary/30 rounded flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                class="text-primary"
                                ><path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs text-gray-500 uppercase tracking-wider mb-1"
                            >
                                Teléfonos
                            </p>
                        </div>
                    </div>
                    <div class="ml-14 space-y-2">
                        {
                            phones.map((phone) => (
                                <div>
                                    <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">
                                        {phone.name}
                                    </p>
                                    <a
                                        href={phone.link}
                                        class="text-white font-medium hover:text-primary transition-colors block"
                                    >
                                        {phone.number}
                                    </a>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Correos -->
            <div class="py-8 md:py-10 md:px-8">
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-10 h-10 border border-primary/30 rounded flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                class="text-primary"
                                ><path
                                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                ></path><polyline points="22,6 12,13 2,6"
                                ></polyline></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs text-gray-500 uppercase tracking-wider mb-1"
                            >
                                Correos Electrónicos
                            </p>
                        </div>
                    </div>
                    <div class="ml-14 space-y-2">
                        {
                            emails.map((email) => (
                                <div>
                                    <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">
                                        {email.name}
                                    </p>
                                    <a
                                        href={email.link}
                                        class="text-white font-medium hover:text-primary transition-colors block"
                                    >
                                        {email.email}
                                    </a>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Sedes -->
            <div class="py-8 md:py-10 md:pl-8">
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-10 h-10 border border-primary/30 rounded flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                class="text-primary"
                                ><path
                                    d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                                ></path><circle cx="12" cy="10" r="3"
                                ></circle></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs text-gray-500 uppercase tracking-wider mb-1"
                            >
                                Nuestras Sedes
                            </p>
                        </div>
                    </div>
                    <div class="ml-14 space-y-2">
                        {
                            addresses.map((address) => (
                                <div>
                                    <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">
                                        {address.name}
                                    </p>
                                    <a
                                        href={address.mapLink}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-white font-medium hover:text-primary transition-colors text-sm block"
                                    >
                                        {address.location}
                                    </a>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
