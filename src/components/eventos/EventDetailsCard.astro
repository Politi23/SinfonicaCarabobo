---
import PrimaryButton from "@components/ui/PrimaryButton.astro";

export interface Props {
  date?: string;
  time?: string;
  venue?: string;
  price?: string;
  contactHref?: string;
  class?: string;
}

const {
  date = "Por confirmar",
  time = "Por confirmar",
  venue = "Por confirmar",
  price,
  contactHref = "/contacto",
  class: className,
} = Astro.props as Props;

const rows = [
  { icon: "ph-calendar-blank", label: "Fecha", value: date, capitalize: true },
  { icon: "ph-clock", label: "Hora", value: time },
  { icon: "ph-map-pin-simple", label: "Lugar", value: venue },
  ...(price ? [{ icon: "ph-ticket", label: "Entrada", value: price }] : []),
];
---

<div
  class:list={[
    "bg-surface-dark p-6 rounded shadow-sm border border-primary",
    className,
  ]}
>
  <h3
    class="text-xl font-bold text-text-light mb-6 border-b border-primary/40 pb-2"
  >
    Detalles del Evento
  </h3>

  <ul class="space-y-4">
    {
      rows.map((row) => (
        <li class="flex items-start">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 ring-1 ring-primary/20 mr-4 text-primary">
            <i class={`ph ${row.icon} text-lg`} aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm text-text-secondary font-semibold">
              {row.label}
            </p>
            <p class:list={["text-text-light", row.capitalize && "capitalize"]}>
              {row.value}
            </p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-8">
    <PrimaryButton class="w-full" variant="outline" href={contactHref}>
      <span>Contáctanos</span>
    </PrimaryButton>
  </div>
</div>
