---
import { formatDateToDMY } from "../../utils/date";

export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  time: string;
  venue: string;
  slug: string;
}

const { title, excerpt, image, date, venue, slug } = Astro.props as Props;

const formattedDate = formatDateToDMY(date);
---

<article
  class="group relative border border-zinc-200 hover:border-primary/50 bg-white rounded shadow-sm transition-all duration-300 overflow-hidden flex flex-col h-full"
>
  <a
    href={`/eventos/${slug}`}
    class="absolute inset-0 z-10"
    aria-label={`Ver detalles de ${title}`}></a>

  <div class="relative h-56 w-full overflow-hidden bg-gray-100">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-300"
    >
    </div>
  </div>

  <div class="p-4 flex flex-col flex-grow relative z-20 pointer-events-none">
    <h3
      class="text-xl font-serif font-semibold text-gray-900 mb-3 group-hover:text-primary transition-colors"
    >
      {title}
    </h3>

    <p
      class="text-zinc-600 text-sm text-justify leading-relaxed line-clamp-4 mb-6"
    >
      {excerpt}
    </p>

    <div class="mb-3 text-sm text-gray-800 flex items-center gap-2">
      <div class="flex items-center justify-center gap-1">
        <i class="ph ph-calendar-blank text-primary"></i>
        <span class="capitalize tracking-wide">
          {formattedDate}
        </span>
      </div>

      <div class="flex items-center gap-1">
        <i class="ph ph-map-pin-simple text-primary"></i>
        <span class="tracking-wide line-clamp-1">{venue}</span>
      </div>
    </div>

    <div
      class="pt-4 p-2 border-t border-gray-100 flex justify-between items-center mt-auto"
    >
      <span class="text-xs uppercase tracking-widest text-gray-500 font-medium"
        >Más información</span
      >
    </div>
  </div>
</article>
