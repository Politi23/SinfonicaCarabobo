---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";

export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  time: string;
  venue: string;
  slug: string;
}

const { title, excerpt, image, date, time, venue, slug } = Astro.props;

// Formateo de fecha seguro
const formatAcfDate = (dateString: string) => {
  if (!dateString || dateString.length !== 8) return dateString;
  const year = dateString.substring(0, 4);
  const month = dateString.substring(4, 6);
  const day = dateString.substring(6, 8);
  const dateObj = new Date(Number(year), Number(month) - 1, Number(day));
  return dateObj.toLocaleDateString("es-VE", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

// Limitar el excerpt a 25 palabras
const truncateExcerpt = (text: string, wordLimit: number = 25): string => {
  if (!text) return "";
  const words = text.split(" ");
  if (words.length <= wordLimit) return text;
  return words.slice(0, wordLimit).join(" ") + "...";
};

const formattedDate = formatAcfDate(date);
const truncatedExcerpt = truncateExcerpt(excerpt, 25);
const imageUrl = image || logoSimpleBbg.src;
---

<article
  class="group bg-white rounded-lg shadow transition-all duration-300 overflow-hidden flex flex-col h-full relative"
>
  <a
    href={`/eventos/${slug}`}
    class="absolute inset-0 z-10"
    aria-label={`Ver detalles de ${title}`}></a>

  {/* Imagen */}
  <div class="relative h-56 w-full overflow-hidden bg-gray-100">
    <img
      src={imageUrl}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-300"
    >
    </div>
  </div>

  <div class="p-6 flex flex-col flex-grow relative z-20 pointer-events-none">
    <h3
      class="text-xl font-serif font-medium text-gray-900 mb-3 group-hover:text-primary transition-colors"
      set:html={title}
    />

    <div class="space-y-3 mb-6 text-sm text-gray-600 flex-grow">
      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        <span class="capitalize tracking-wide">
          {formattedDate}
        </span>
      </div>

      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="tracking-wide">{time.slice(0, 5)} hrs</span>
      </div>

      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 text-primary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="tracking-wide line-clamp-1">{venue}</span>
      </div>
    </div>

    <div
      class="pt-4 border-t border-gray-100 flex justify-between items-center"
    >
      <span class="text-xs uppercase tracking-widest text-gray-500 font-medium"
        >Más información</span
      >
      <!-- <span
        class="w-8 h-8 rounded-full bg-gray-50 flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors duration-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </span> -->
    </div>
  </div>
</article>
