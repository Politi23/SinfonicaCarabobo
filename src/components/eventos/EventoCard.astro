---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";

export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  time: string;
  venue: string;
  slug: string;
}

const { title, excerpt, image, date, time, venue, slug } = Astro.props;

// Formateo de fecha seguro
const formatAcfDate = (dateString: string) => {
  if (!dateString || dateString.length !== 8) return dateString;
  const year = dateString.substring(0, 4);
  const month = dateString.substring(4, 6);
  const day = dateString.substring(6, 8);
  const dateObj = new Date(Number(year), Number(month) - 1, Number(day));
  return dateObj.toLocaleDateString("es-VE", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

// Limitar el excerpt a 25 palabras
const truncateExcerpt = (text: string, wordLimit: number = 25): string => {
  if (!text) return "";
  const words = text.split(" ");
  if (words.length <= wordLimit) return text;
  return words.slice(0, wordLimit).join(" ") + "...";
};

const formattedDate = formatAcfDate(date);
const truncatedExcerpt = truncateExcerpt(excerpt, 25);
const imageUrl = image || logoSimpleBbg.src;
---

<article class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col h-full">
  {/* Imagen */}
  <div class="relative h-48 w-full overflow-hidden bg-gray-200">
    <a href={`/eventos/${slug}`} class="block w-full h-full">
      <img
        src={imageUrl}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  <div class="p-6 flex flex-col flex-grow">
    <h3
      class="text-xl font-bold text-gray-800 mb-2"
      set:html={title}
    />

    <div class="space-y-2 mb-4 text-sm text-gray-600">
      <div class="flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-primary-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          />
        </svg>
        <span class="capitalize">
          {formattedDate}
        </span>
      </div>

      <div class="flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-primary-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span>{time.slice(0, 5)} hrs</span>
      </div>

      <div class="flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-primary-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
        <span>{venue}</span>
      </div>
    </div>

    <hr class="border-gray-100 my-2" />
    <p class="text-gray-600 text-sm flex-grow line-clamp-2">
      {truncatedExcerpt}
    </p>

    <div class="mt-4 pt-4">
      <a
        href={`/eventos/${slug}`}
        class="block w-full text-center bg-gray-900 text-white py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium"
      >
        Ver detalles
      </a>
    </div>
  </div>
</article>
