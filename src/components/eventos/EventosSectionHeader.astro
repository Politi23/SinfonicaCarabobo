---
import SectionTitle from "@components/ui/SectionTitle.astro";

interface Props {
  title?: string;
}

const {
  title = "Eventos",
} = Astro.props;
---

<div class="max-w-4xl mx-auto mb-12">
  <SectionTitle
    title={title}
    variant="red"
    class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-4"
    wrapperClass="text-left"
    dividerClass="h-1 w-16"
  />
</div>
