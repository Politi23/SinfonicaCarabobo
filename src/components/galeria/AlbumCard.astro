---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";
import { formatDateToDMY } from "../../utils/date";

export interface Props {
	title: string;
	excerpt: string;
	coverImage: string;
	date: string;
	dateTaken?: string;
	category?: string;
	slug: string;
	basePath?: string;
	photoCount?: number;
}

const {
	title,
	coverImage,
	date,
	dateTaken = "",
	category = "",
	slug,
	basePath = "/multimedia/albumes",
	photoCount = 0,
} = Astro.props;

const formattedDate = formatDateToDMY(dateTaken || date);
const backgroundImage = coverImage || logoSimpleBbg.src;
---

<article
	class="group relative aspect-square overflow-hidden rounded-sm bg-gray-900"
>
	<a
		href={`${basePath}/${slug}`}
		class="absolute inset-0 z-30"
		aria-label={`Ver album ${title}`}></a>

	<div
		class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-[102%]"
		style={`background-image: url('${backgroundImage}')`}
	>
	</div>

	<div
		class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-black/10 group-hover:from-black/80 transition-colors duration-300"
	>
	</div>

	{
		category && (
			<span class="absolute top-4 left-4 z-20 rounded-sm bg-white/90 px-3 py-1 text-xs font-bold uppercase tracking-widest text-primary pointer-events-none">
				{category}
			</span>
		)
	}

	<div class="absolute inset-x-0 bottom-0 z-20 p-4 pointer-events-none">
		<h3
			class="line-clamp-2 text-2xl font-titles font-semibold leading-tight text-white"
		>
			{title}
		</h3>

		<div class="mt-3 flex items-center justify-between gap-3 text-white/90">
			<div
				class="flex items-center gap-2 text-xs uppercase tracking-wide font-medium"
			>
				<i class="ph ph-calendar-blank"></i>
				<span>{formattedDate}</span>
			</div>

			<div class="flex items-center gap-1 text-xs font-bold">
				<i class="ph ph-images"></i>
				<span>{photoCount}</span>
			</div>
		</div>
	</div>
</article>
