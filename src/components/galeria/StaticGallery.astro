---
import { getImage } from "astro:assets";

interface Image {
  src: ImageMetadata;
  alt?: string;
}

interface Props {
  images: Image[];
  columns?: number;
  title: string;
  isOpen?: boolean;
}

const { images, columns = 3, title = "Galería", isOpen = false } = Astro.props;

// Generar columnas para Tailwind (1-12)
const getColumnClass = (cols: number) => {
  const map: Record<number, string> = {
    1: "grid-cols-1",
    2: "grid-cols-2",
    3: "grid-cols-3",
    4: "grid-cols-4",
    5: "grid-cols-5",
    6: "grid-cols-6",
    7: "grid-cols-7",
    8: "grid-cols-8",
    9: "grid-cols-9",
    10: "grid-cols-10",
    11: "grid-cols-11",
    12: "grid-cols-12",
  };
  return map[cols] || "grid-cols-3";
};
---

<div class="static-gallery">
  {
    images.length > 0 ? (
      <details class="group static-gallery-details" open={isOpen}>
        <summary class="cursor-pointer list-none">
          <div class="flex items-center justify-between bg-primary hover:bg-primary-dark text-white transition-colors px-6 py-4">
            <h2 class="text-2xl font-bold font-display">{title}</h2>
            <span class="material-icons transition-transform duration-300 group-open:rotate-180">
              expand_more
            </span>
          </div>
        </summary>

        <div class="bg-white border-t-0 border border-gray-200 p-6">
          <div class={`grid ${getColumnClass(columns)} gap-4`}>
            {images.map(async ({ src, alt }) => {
              const optimizedImage = await getImage({
                src,
                width: 800,
                format: "webp",
                quality: 80,
              });
              return (
                <div class="relative group overflow-hidden rounded-lg aspect-square bg-gray-100">
                  <img
                    data-src={optimizedImage.src}
                    alt={alt || "Imagen de galería"}
                    width={optimizedImage.attributes.width}
                    height={optimizedImage.attributes.height}
                    class="gallery-img w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-110 opacity-0"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300" />
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none loading-spinner transition-opacity duration-300">
                    <span class="material-icons animate-spin text-primary/30">
                      sync
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </details>
    ) : (
      <div class="text-center py-12 border-2 border-dashed border-gray-300 rounded bg-gray-50">
        <p class="text-gray-500">No hay imágenes en esta galería.</p>
      </div>
    )
  }
</div>

<style>
  details > summary {
    list-style: none;
  }

  details > summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary ~ * {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const details = document.querySelector(".static-gallery-details");
  const images = document.querySelectorAll(".gallery-img");

  const loadImages = () => {
    images.forEach((img) => {
      if (img instanceof HTMLImageElement && img.dataset.src) {
        img.src = img.dataset.src;
        img.removeAttribute("data-src");
        img.onload = () => {
          img.classList.remove("opacity-0");
          img.classList.add("opacity-100");
          // Hide spinner
          const spinner = img.parentElement?.querySelector(".loading-spinner");
          if (spinner) spinner.classList.add("opacity-0");
        };
      }
    });
  };

  // If initially open
  if (details && (details as HTMLDetailsElement).open) {
    loadImages();
  }

  // Listen for toggle
  details?.addEventListener("toggle", () => {
    if ((details as HTMLDetailsElement).open) {
      loadImages();
    }
  });
</script>
