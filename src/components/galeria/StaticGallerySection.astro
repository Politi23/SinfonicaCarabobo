---
import { Picture } from "astro:assets";
import SectionTitle from "@components/ui/SectionTitle.astro";

interface Image {
  src: ImageMetadata;
  alt?: string;
}

interface Props {
  images: Image[];
  columns?: number;
  title: string;
  sectionId?: string;
}

const {
  images,
  columns = 3,
  title = "Galería",
  sectionId = "",
} = Astro.props;

// Generar columnas para Tailwind (1-12)
const getColumnClass = (cols: number) => {
  const map: Record<number, string> = {
    1: "grid-cols-1",
    2: "grid-cols-2",
    3: "grid-cols-3",
    4: "grid-cols-4",
    5: "grid-cols-5",
    6: "grid-cols-6",
    7: "grid-cols-7",
    8: "grid-cols-8",
    9: "grid-cols-9",
    10: "grid-cols-10",
    11: "grid-cols-11",
    12: "grid-cols-12",
  };
  return map[cols] || "grid-cols-3";
};
---

<section
  id={sectionId}
  class="static-gallery-section py-16 md:py-24 bg-white"
  data-gallery-id={sectionId}
>
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="max-w-4xl mx-auto mb-8">
      <div class="flex items-center justify-between gap-4">
        <SectionTitle
          title={title}
          variant="red"
          class="text-3xl md:text-5xl font-display font-bold text-gray-900"
          wrapperClass="flex flex-col text-left"
          dividerClass="h-1 w-16 mt-4"
        />
        <button
          class="toggle-gallery-btn flex items-center gap-2 px-4 py-2 bg-secondary text-white text-xs font-bold uppercase tracking-wider rounded-lg hover:bg-primary transition-colors shrink-0"
          aria-expanded="false"
          aria-label="Toggle gallery visibility"
        >
          <span class="toggle-text">Mostrar</span>
          <span
            class="material-icons toggle-icon transition-transform duration-300 rotated"
          >
            expand_less
          </span>
        </button>
      </div>
    </div>

    <!-- Gallery Grid (Collapsible) -->
    <div
      class="gallery-content overflow-hidden transition-all duration-500 ease-in-out"
      hidden
    >
      {
        images.length > 0 ? (
          <div class={`grid ${getColumnClass(columns)} gap-6`}>
            {images.map(({ src, alt }) => (
              <div class="relative group overflow-hidden rounded aspect-square bg-gray-100 shadow-sm">
                <Picture
                  src={src}
                  formats={["webp"]}
                  fallbackFormat="webp"
                  alt={alt || "Imagen de galería"}
                  width={800}
                  height={800}
                  sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                  class="gallery-img w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300" />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12 border-2 border-dashed border-gray-300 rounded bg-gray-50">
            <p class="text-gray-500">No hay imágenes en esta galería.</p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .gallery-content[hidden] {
    display: block;
    max-height: 0 !important;
    opacity: 0;
    visibility: hidden;
  }

  .gallery-content:not([hidden]) {
    max-height: 5000px;
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  const sections = document.querySelectorAll(".static-gallery-section");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  sections.forEach((section) => {
    observer.observe(section);

    const toggleBtn = section.querySelector(".toggle-gallery-btn");
    const galleryContent = section.querySelector(".gallery-content");
    const toggleText = toggleBtn?.querySelector(".toggle-text");
    const toggleIcon = toggleBtn?.querySelector(".toggle-icon");

    if (toggleBtn && galleryContent) {
      toggleBtn.addEventListener("click", () => {
        const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
        const newExpandedState = !isExpanded;

        toggleBtn.setAttribute("aria-expanded", newExpandedState.toString());

        if (newExpandedState) {
          galleryContent.removeAttribute("hidden");
          if (toggleText) toggleText.textContent = "Ocultar";
          if (toggleIcon) toggleIcon.classList.remove("rotated");
        } else {
          galleryContent.setAttribute("hidden", "");
          if (toggleText) toggleText.textContent = "Mostrar";
          if (toggleIcon) toggleIcon.classList.add("rotated");
        }
      });
    }
  });
</script>
