---
import Logo from "@assets/svg/sinfonica.svg";

const navLinks = [
    { href: "/", label: "Inicio" },
    { href: "/nosotros", label: "Nosotros" },
    { href: "/agrupaciones", label: "Agrupaciones" },
    { href: "/nosotros/academia", label: "Academia" },
    { href: "/eventos", label: "Eventos" },
    { href: "/apoyanos/donaciones", label: "Donaciones" },
    { href: "/blog", label: "Blog" },
    { href: "/apoyanos/empresarial", label: "Plan empresarial" },
    { href: "/audiciones", label: "Audiciones" },
    { href: "/galeria/eventos/page/1", label: "Galería" },
    { href: "/contacto", label: "Contacto" },
];

const socialLinks = [
    {
        href: "https://www.facebook.com/sinfonicarabobo/",
        label: "Facebook",
        icon: "ph-facebook-logo",
    },
    {
        href: "https://www.instagram.com/sinfocarabobo",
        label: "Instagram",
        icon: "ph-instagram-logo",
    },
    {
        href: "https://www.youtube.com/@sinfocarabobo",
        label: "YouTube",
        icon: "ph-youtube-logo",
    },
    {
        href: "#",
        label: "Spotify",
        icon: "ph-spotify-logo",
    },
];
---

<footer class="bg-black text-zinc-50 pb-16 footer-root">
    <div class="footer-divider">
        <div class="divider-line"></div>
    </div>

    <div class="container mx-auto max-w-6xl px-6 py-14">
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
            <div class="space-y-5">
                <!-- <p class="max-w-xs font-serif text-sm leading-relaxed text-zinc-50 md:max-w-sm">
                    Mas de 40 anos llevando la musica clasica a los corazones de
                    Venezuela.
                </p> -->

                <div class="mx-auto flex justify-center">
                    <Logo width={300} height={100} />
                </div>

                <div class="flex flex-wrap justify-center gap-3">
                    {
                        socialLinks.map((social) => (
                            <a
                                href={social.href}
                                aria-label={social.label}
                                class="flex h-10 w-10 items-center justify-center rounded-sm border border-zinc-700 text-zinc-50 transition-colors hover:border-zinc-50 hover:bg-zinc-700"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <i
                                    class={`text-2xl ph ${social.icon} text-white`}
                                />
                            </a>
                        ))
                    }
                </div>
            </div>

            <div class="space-y-4 min-w-[40%]">
                <h2
                    class="font-display text-base font-bold uppercase tracking-[0.08em] text-zinc-50"
                >
                    Navegación
                </h2>
                <nav class="grid grid-cols-2 gap-y-3 gap-x-10">
                    {
                        navLinks.map((link) => (
                            <a
                                href={link.href}
                                class="font-serif font-light text-[1rem] text-zinc-300 transition-colors hover:text-zinc-50"
                            >
                                {link.label}
                            </a>
                        ))
                    }
                </nav>
            </div>

            <div class="space-y-4">
                <h2
                    class="font-display text-base font-bold uppercase tracking-[0.08em] text-zinc-50"
                >
                    Contacto
                </h2>
                <div class="space-y-4">
                    <div
                        class="flex items-center gap-3 font-serif text-sm text-zinc-300"
                    >
                        <i class="ph ph-envelope-simple text-lg"></i>
                        <a
                            href="mailto:gerencia@sinfocarabobo.com"
                            class="text-zinc-300 transition-colors hover:text-zinc-50"
                        >
                            gerencia@sinfocarabobo.com
                        </a>
                    </div>

                    <div
                        class="flex items-center gap-3 font-serif text-sm text-zinc-300"
                    >
                        <i class="ph ph-phone text-lg"></i>
                        <a
                            href="tel:04143410642"
                            class="text-zinc-300 transition-colors hover:text-zinc-50"
                        >
                            +58 0414-424-8861
                        </a>
                    </div>

                    <div
                        class="flex items-start gap-3 font-serif text-[0.8rem] font-light text-zinc-300"
                    >
                        <i class="ph ph-map-pin text-lg"></i>
                        <div class="flex-col gap-x-10">
                            <a
                                href="https://maps.app.goo.gl/SJNfCHHdVyTuy3hL6"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block leading-relaxed text-zinc-300 transition-colors hover:text-zinc-50"
                            >
                                Salon MZ-08, Hotel Hesperia WTC, Naguanagua,
                                Estado Carabobo.
                            </a>
                            <!-- <a
                                href="https://maps.app.goo.gl/SJNfCHHdVyTuy3hL6"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block leading-relaxed text-zinc-300 transition-colors hover:text-zinc-50"
                            >
                                Universidad José Antonio Páez, Edif. 4, Piso 1,
                                Ofic. 4164.
                            </a> -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Divisor */
        .footer-root {
            position: relative;
        }

        .footer-divider {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
        }

        .divider-line {
            width: 100%;
            height: 2px;
            background: linear-gradient(
                90deg,
                transparent,
                var(--color-primary),
                transparent
            );
        }

        .divider-ornament {
            color: var(--color-primary);
            font-size: 2rem;
            opacity: 0.8;
        }

        .ornament-treble {
            font-family: serif;
        }
    </style>
</footer>
