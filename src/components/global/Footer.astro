---
// Footer.astro
// Footer elegante y profesional para la Orquesta Sinfónica de Carabobo
const currentYear = new Date().getFullYear();

const navLinks = [
    { href: "#", label: "Inicio" },
    { href: "#nosotros", label: "Nosotros" },
    { href: "#programas", label: "Programas" },
    { href: "#apoyanos", label: "Apóyanos" },
    { href: "#contacto", label: "Contacto" },
];

const socialLinks = [
    {
        href: "https://facebook.com",
        label: "Facebook",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
    },
    {
        href: "https://instagram.com",
        label: "Instagram",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
    },
    {
        href: "https://twitter.com",
        label: "X (Twitter)",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
    },
    {
        href: "https://youtube.com",
        label: "YouTube",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
    },
];
---

<footer class="footer">
    <div class="footer-container">
        <!-- Sección principal del footer -->
        <div class="footer-main">
            <!-- Logo y descripción -->
            <div class="footer-brand">
                <a href="#" class="footer-logo">
                    <img
                        src="/logo.png"
                        alt="Logo Orquesta Sinfónica de Carabobo"
                    />
                </a>
                <p class="footer-tagline">
                    Más de 40 años llevando la música clásica a los corazones de
                    Venezuela.
                </p>

                <!-- Redes sociales -->
                <div class="footer-social">
                    {
                        socialLinks.map((social) => (
                            <a
                                href={social.href}
                                aria-label={social.label}
                                class="social-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Fragment set:html={social.icon} />
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Navegación rápida -->
            <div class="footer-nav-section">
                <h4 class="footer-heading">Navegación</h4>
                <nav class="footer-nav">
                    {
                        navLinks.map((link) => (
                            <a href={link.href} class="footer-link">
                                {link.label}
                            </a>
                        ))
                    }
                </nav>
            </div>

            <!-- Información de contacto -->
            <div class="footer-contact-section">
                <h4 class="footer-heading">Contacto</h4>
                <div class="footer-contact">
                    <div class="contact-item">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                            ></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span>Valencia, Estado Carabobo, Venezuela</span>
                    </div>
                    <div class="contact-item">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                            ></path>
                        </svg>
                        <span>+58 (241) 123-4567</span>
                    </div>
                    <div class="contact-item">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                            ></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <span>info@orquestasinfonicacarabobo.org</span>
                    </div>
                </div>
            </div>

            <!-- Newsletter / Suscripción -->
            <div class="footer-newsletter-section">
                <h4 class="footer-heading">Mantente Informado</h4>
                <p class="newsletter-text">
                    Suscríbete para recibir noticias sobre próximos conciertos y
                    eventos especiales.
                </p>
                <form class="newsletter-form" onsubmit="return false;">
                    <input
                        type="email"
                        placeholder="Tu correo electrónico"
                        class="newsletter-input"
                        aria-label="Correo electrónico"
                    />
                    <button type="submit" class="newsletter-btn">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"
                            ></polygon>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        <!-- Línea divisoria elegante -->
        <div class="footer-divider">
            <div class="divider-line"></div>
        </div>

        <!-- Copyright y enlaces legales -->
        <div class="footer-bottom">
            <p class="footer-copyright">
                © {currentYear} Fundación Orquesta Sinfónica de Carabobo. Todos los
                derechos reservados.
            </p>
            <div class="footer-legal">
                <a href="#privacidad" class="legal-link"
                    >Política de Privacidad</a
                >
                <span class="legal-separator">|</span>
                <a href="#terminos" class="legal-link">Términos de Uso</a>
            </div>
        </div>
    </div>

    <!-- Decoración inferior: onda musical animada -->
    <div class="footer-wave">
        <svg
            viewBox="0 0 1200 60"
            preserveAspectRatio="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M0,30 Q150,0 300,30 T600,30 T900,30 T1200,30 L1200,60 L0,60 Z"
                fill="rgba(194, 143, 36, 0.15)"></path>
            <path
                d="M0,35 Q150,10 300,35 T600,35 T900,35 T1200,35 L1200,60 L0,60 Z"
                fill="rgba(194, 143, 36, 0.08)"></path>
        </svg>
    </div>
</footer>

<style>
    .footer {
        /* background: linear-gradient(180deg, #0a0a0a 0%, #000000 100%); */
        background-color: #000000;
        color: #ffffff;
        position: relative;
        overflow: hidden;
    }

    /* Decoración superior */
    .footer-decoration {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 24px 0;
        gap: 16px;
    }

    .decoration-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c28f24, transparent);
        max-width: 200px;
    }

    .decoration-notes {
        display: flex;
        gap: 12px;
        color: #c28f24;
        font-size: 1.2rem;
    }

    .note {
        opacity: 0.8;
    }

    /* Contenedor principal */
    .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 48px 24px 32px;
    }

    .footer-main {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
        gap: 48px;
    }

    /* Sección de marca */
    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .footer-logo {
        display: inline-block;
        text-decoration: none;
    }

    .footer-logo img {
        height: 60px;
        width: auto;
        filter: brightness(1.1);
        transition: filter 0.3s ease;
    }

    .footer-logo:hover img {
        filter: brightness(1.3);
    }

    .footer-tagline {
        font-family: "Merriweather", serif;
        font-size: 0.95rem;
        color: #ffffff;
        line-height: 1.6;
        margin: 0;
        max-width: 280px;
    }

    /* Redes sociales */
    .footer-social {
        display: flex;
        gap: 12px;
        margin-top: 8px;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(194, 143, 36, 0.3);
        border-radius: 50%;
        color: #c28f24;
        transition: all 0.3s ease;
    }

    .social-link:hover {
        background: #c28f24;
        color: #000000;
        border-color: #c28f24;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(194, 143, 36, 0.3);
    }

    /* Encabezados de secciones */
    .footer-heading {
        font-family: "Merriweather", serif;
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        margin: 0 0 20px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        position: relative;
        padding-bottom: 12px;
    }

    .footer-heading::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 40px;
        height: 2px;
        background: linear-gradient(90deg, #c28f24, transparent);
    }

    /* Navegación */
    .footer-nav {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .footer-link {
        font-family: "Merriweather", serif;
        font-size: 0.9rem;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
        padding-left: 0;
    }

    .footer-link::before {
        content: "→";
        position: absolute;
        left: -20px;
        opacity: 0;
        color: #c28f24;
        transition: all 0.3s ease;
    }

    .footer-link:hover {
        color: #c28f24;
        padding-left: 20px;
    }

    .footer-link:hover::before {
        opacity: 1;
        left: 0;
    }

    /* Contacto */
    .footer-contact {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-family: "Merriweather", serif;
        font-size: 0.88rem;
        color: #ffffff;
    }

    .contact-item svg {
        color: #c28f24;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .contact-item span {
        line-height: 1.5;
    }

    /* Newsletter */
    .newsletter-text {
        font-family: "Merriweather", serif;
        font-size: 0.88rem;
        color: #ffffff;
        margin: 0 0 16px;
        line-height: 1.5;
    }

    .newsletter-form {
        display: flex;
        gap: 0;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid rgba(194, 143, 36, 0.3);
        background: rgba(255, 255, 255, 0.03);
        transition: border-color 0.3s ease;
    }

    .newsletter-form:focus-within {
        border-color: #c28f24;
    }

    .newsletter-input {
        flex: 1;
        padding: 12px 16px;
        background: transparent;
        border: none;
        color: #ffffff;
        font-family: "Merriweather", serif;
        font-size: 0.88rem;
        outline: none;
    }

    .newsletter-input::placeholder {
        color: #666666;
    }

    .newsletter-btn {
        padding: 12px 18px;
        background: #c28f24;
        border: none;
        color: #000000;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .newsletter-btn:hover {
        background: #d9a52e;
    }

    /* Divisor */
    .footer-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 40px 0 24px;
        gap: 24px;
    }

    .divider-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(194, 143, 36, 0.4),
            transparent
        );
    }

    .divider-ornament {
        color: #c28f24;
        font-size: 2rem;
        opacity: 0.8;
    }

    .ornament-treble {
        font-family: serif;
    }

    /* Bottom */
    .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 30px;
        gap: 16px;
    }

    .footer-copyright {
        font-family: "Merriweather", serif;
        font-size: 0.85rem;
        color: #666666;
        margin: 0;
    }

    .footer-legal {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .legal-link {
        font-family: "Merriweather", serif;
        font-size: 0.85rem;
        color: #666666;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .legal-link:hover {
        color: #c28f24;
    }

    .legal-separator {
        color: #444444;
    }

    /* Wave decoration */
    .footer-wave {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        pointer-events: none;
        opacity: 0.6;
    }

    .footer-wave svg {
        width: 100%;
        height: 60px;
        display: block;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .footer-main {
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .footer-brand {
            grid-column: span 2;
            align-items: center;
            text-align: center;
        }

        .footer-tagline {
            max-width: 400px;
        }

        .footer-heading::after {
            left: 50%;
            transform: translateX(-50%);
        }

        .footer-nav-section,
        .footer-contact-section,
        .footer-newsletter-section {
            text-align: center;
        }

        .footer-nav {
            align-items: center;
        }

        .footer-link::before {
            display: none;
        }

        .footer-link:hover {
            padding-left: 0;
        }

        .contact-item {
            justify-content: center;
        }

        .newsletter-form {
            max-width: 320px;
            margin: 0 auto;
        }
    }

    @media (max-width: 640px) {
        .footer-main {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .footer-brand {
            grid-column: span 1;
        }

        .footer-bottom {
            flex-direction: column;
            text-align: center;
        }

        .decoration-notes {
            font-size: 1rem;
            gap: 8px;
        }

        .footer-container {
            padding: 32px 20px 24px;
        }
    }
</style>
