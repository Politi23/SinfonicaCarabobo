---
const navLinks = [
  { href: "/", label: "Inicio", active: false },
  { href: "/nosotros", label: "Nosotros", active: false },
  { href: "/programas", label: "Programas", active: false },
  { href: "/blog", label: "Blog", active: false },
  { href: "/libro", label: "Libro", active: false },
  { href: "/apoyanos", label: "Apóyanos", active: false },
  { href: "/contacto", label: "Contacto", active: false },
];
---

<!-- Header con efecto glassmorphism -->
<header class="header" id="main-header">
  <div class="header-backdrop"></div>
  <div class="header-container">
    <!-- Logo -->
    <a href="http://localhost:4321" class="logo-link group">
      <div class="flex items-center gap-4">
        <img
          src="/logosimple.png"
          alt="Logo de la Fundación Orquesta Sinfónica de Carabobo"
          class="logo-image drop-shadow-lg transition-transform duration-300 group-hover:scale-105"
        />
        <div class="hidden md:flex flex-col">
          <span
            class="text-xs font-light tracking-widest text-gray-300 uppercase leading-tight"
          >
            Fundación
          </span>
          <span
            class="text-sm font-bold tracking-wide text-white leading-tight font-serif"
          >
            Orquesta Sinfónica
          </span>
          <span
            class="text-xs font-medium tracking-wider text-accent-yellow uppercase leading-tight"
          >
            de Carabobo
          </span>
        </div>
      </div>
    </a>

    <!-- Navegación principal -->
    <nav class="main-nav" id="main-nav">
      <!-- Botón hamburguesa para móvil -->
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Enlaces de navegación -->
      <ul class="nav-list" id="nav-list">
        {
          navLinks.map((link) => (
            <li class="nav-item">
              <a
                href={link.href}
                class={`nav-link ${link.active ? "nav-link-active" : ""}`}
              >
                <span class="nav-link-text">{link.label}</span>
                <span class="nav-link-underline" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Variables CSS */
  :root {
    --header-height: 80px;
    --header-height-mobile: 64px;
    --gold: #c28f24; /* primary */
    --gold-light: #ddb850; /* primary-light */
    --gold-dark: #9a7219; /* tono oscuro del dorado */
    --red-accent: #82181a; /* secondary */
    --black: #000000; /* background-dark */
    --black-soft: #0a0a0a; /* surface-dark más claro */
    --white: #ffffff; /* text-light */
    --gray-light: #e0e0e0; /* text-muted */
    --gray: #888888; /* color de texto alternativo */
  }

  /* ============================================
     HEADER STYLES
  ============================================ */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: 1000;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.85) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.4s ease;
  }

  .header-container {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo styles */
  .logo-link {
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
    z-index: 10;
  }

  .logo-image {
    height: 56px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* Navigation */
  .main-nav {
    display: flex;
    align-items: center;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 100;
  }

  .nav-toggle:hover {
    border-color: var(--gold);
    background: rgba(194, 143, 36, 0.1);
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .nav-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 18px;
    text-decoration: none;
    color: var(--gray-light);
    font-family: "Merriweather", serif;
    font-size: 0.9rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .nav-link-text {
    position: relative;
    z-index: 1;
    transition: all 0.3s ease;
  }

  .nav-link-underline {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 30px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    transition: transform 0.3s ease;
    border-radius: 2px;
  }

  .nav-link:hover {
    color: var(--white);
  }

  .nav-link:hover .nav-link-underline {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-link-active {
    color: var(--gold);
  }

  .nav-link-active .nav-link-underline {
    transform: translateX(-50%) scaleX(0);
  }

  /* ============================================
     RESPONSIVE STYLES
  ============================================ */
  @media (max-width: 1024px) {
    .nav-list {
      gap: 4px;
    }

    .nav-link {
      padding: 10px 14px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 768px) {
    .header {
      height: var(--header-height-mobile);
    }

    .header-container {
      padding: 0 20px;
    }

    .logo-image {
      height: 44px;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-list {
      position: fixed;
      top: var(--header-height-mobile);
      left: 0;
      right: 0;
      bottom: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      background: rgba(0, 0, 0, 0.98);
      backdrop-filter: blur(20px);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-20px);
      transition: all 0.4s ease;
    }

    .nav-list.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .nav-link {
      font-size: 1.1rem;
      padding: 16px 24px;
    }
  }
</style>

<script>
  // Toggle mobile navigation
  const navToggle = document.getElementById("nav-toggle");
  const navList = document.getElementById("nav-list");

  if (navToggle && navList) {
    navToggle.addEventListener("click", () => {
      navToggle.classList.toggle("active");
      navList.classList.toggle("active");
      const isExpanded = navToggle.getAttribute("aria-expanded") === "true";
      navToggle.setAttribute("aria-expanded", (!isExpanded).toString());
    });

    // Close menu when clicking a link
    const navLinks = navList.querySelectorAll(".nav-link");
    navLinks.forEach((link) => {
      link.addEventListener("click", () => {
        navToggle.classList.remove("active");
        navList.classList.remove("active");
        navToggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
