---
import { getBlogs } from "../../config/wp-blogs";
import SimpleBlogCard from "../blog/SimpleBlogCard.astro";
import Button from "../ui/GoldenButton.astro";

export interface Props {
  subtitle?: string;
  numberOfPosts?: number;
  showViewAllButton?: boolean;
  viewAllButtonText?: string;
}

const {
  subtitle = "Últimas Entradas del Blog",
  numberOfPosts = 5,
  showViewAllButton = true,
  viewAllButtonText = "Ver todos los artículos",
} = Astro.props;

// Fetch the latest blog posts
const latestPosts = await getBlogs({ perPage: numberOfPosts, page: 1 });
---

<section class="py-16 bg-surface-light">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <span
        class="text-text-muted text-sm font-bold tracking-[0.2em] uppercase block"
      >
        {subtitle}
      </span>
    </div>

    {
      latestPosts.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-6">
          {latestPosts.map((post) => (
            <SimpleBlogCard
              title={post.title}
              excerpt={post.excerpt}
              image={post.image}
              date={post.date}
              category={post.category}
              slug={post.slug}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-6">
          <p class="text-text-muted text-sm">
            No hay entradas del blog disponibles.
          </p>
        </div>
      )
    }

    {
      showViewAllButton && (
        <div class="text-center mt-12">
          <Button href="/blog" class="px-6 py-2 text-sm">
            {viewAllButtonText}
          </Button>
        </div>
      )
    }
  </div>
</section>
