---
import { getBlogs } from "../../config/wp-blogs";
import SimpleBlogCard from "../blog/SimpleBlogCard.astro";
import SecondaryButton from "../ui/SecondaryButton.astro";

export interface Props {
  subtitle?: string;
  numberOfPosts?: number;
  showViewAllButton?: boolean;
  viewAllButtonText?: string;
}

const {
  subtitle = "Últimas Entradas del Blog",
  numberOfPosts = 5,
  showViewAllButton = true,
  viewAllButtonText = "Ver todos",
} = Astro.props;

const latestPosts = await getBlogs({ perPage: numberOfPosts, page: 1 });
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <span
        class="text-zinc-700 text-sm font-bold tracking-[0.1rem] uppercase block"
      >
        {subtitle}
      </span>
    </div>

    {
      latestPosts.length > 0 ? (
        <>
          <div class="hidden lg:grid lg:grid-cols-4 xl:grid-cols-5 gap-4 lg:gap-6">
            {latestPosts.map((post) => (
              <SimpleBlogCard
                title={post.title}
                excerpt={post.excerpt}
                image={post.image}
                date={post.date}
                category={post.category}
                slug={post.slug}
              />
            ))}
          </div>

          {/* Tablet/Mobile Grid Carousel */}
          <div class="lg:hidden relative">
            <div class="overflow-x-auto py-2">
              <div class="grid grid-flow-col auto-cols-[minmax(15.5rem,1fr)] md:auto-cols-[minmax(19rem,1fr)] gap-4 snap-x snap-mandatory">
                {latestPosts.map((post) => (
                  <div class="snap-start h-full">
                    <SimpleBlogCard
                      title={post.title}
                      excerpt={post.excerpt}
                      image={post.image}
                      date={post.date}
                      category={post.category}
                      slug={post.slug}
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="text-center py-6">
          <p class="text-text-muted text-sm">
            No hay entradas del blog disponibles.
          </p>
        </div>
      )
    }

    {
      showViewAllButton && (
        <div class="text-center mt-12">
          <SecondaryButton href="/blog" class="px-6 py-2 text-sm">
            {viewAllButtonText}
          </SecondaryButton>
        </div>
      )
    }
  </div>
</section>
