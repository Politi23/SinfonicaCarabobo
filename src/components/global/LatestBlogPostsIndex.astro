---
import { getBlogs } from "../../config/wp-blogs";
import BlogCard from "../blog/BlogCard.astro";
import SecondaryButton from "../ui/SecondaryButton.astro";
import SectionTitle from "../ui/SectionTitle.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  numberOfPosts?: number;
  showViewAllButton?: boolean;
  viewAllButtonText?: string;
}

const {
  title = "Últimas Entradas del Blog",
  numberOfPosts = 3,
  showViewAllButton = true,
  viewAllButtonText = "Ver todos",
} = Astro.props;

const latestPosts = await getBlogs({ perPage: numberOfPosts, page: 1 });
---

<section class="bg-white py-5 md:py-7">
  <div class="container mx-auto">
    <div class="flex justify-between items-center">
      <SectionTitle title={title} />
    </div>

    {
      latestPosts.length > 0 ? (
        <>
          <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 mt-7">
            {latestPosts.map((post) => (
              <div class="h-full">
                <BlogCard
                  title={post.title}
                  excerpt={post.excerpt}
                  image={post.image}
                  date={post.date}
                  category={post.category}
                  slug={post.slug}
                />
              </div>
            ))}
          </div>

          <div class="md:hidden relative mt-7">
            <div class="overflow-x-auto py-2">
              <div
                data-carousel-track
                class="grid grid-flow-col auto-cols-[minmax(17rem,1fr)] gap-4 snap-x snap-mandatory"
              >
                {latestPosts.map((post) => (
                  <div class="snap-start h-full">
                    <BlogCard
                      title={post.title}
                      excerpt={post.excerpt}
                      image={post.image}
                      date={post.date}
                      category={post.category}
                      slug={post.slug}
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="text-center py-8">
          <p class="text-gray-500 text-lg">
            No hay entradas del blog disponibles por el momento.
          </p>
        </div>
      )
    }

    {
      showViewAllButton && (
        <div class="text-center mt-5">
          <SecondaryButton href="/blog">{viewAllButtonText}</SecondaryButton>
        </div>
      )
    }
  </div>
</section>
