---
interface Props {
  groups: {
    id: string;
    items: {
      href: string;
      label: string;
    }[];
  }[];
}

const { groups } = Astro.props;
---

<div
  id="global-submenu"
  class="submenu-container fixed top-[var(--header-height)] left-0 w-full z-[900] invisible opacity-0 -translate-y-5 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]"
>
  <div
    class="absolute inset-0 bg-black/95 backdrop-blur-xl border-b border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.5)]"
  >
  </div>
  
  <div class="relative max-w-[1280px] mx-auto h-[100px] overflow-hidden">
    {groups.map((group) => (
      <ul
        id={group.id}
        class="submenu-content absolute top-1/2 left-0 w-full -translate-y-1/2 flex justify-center gap-12 transition-all duration-300 ease-out opacity-0 pointer-events-none scale-95"
      >
        {
          group.items.map((item) => (
            <li>
              <a
                href={item.href}
                class={`nav-link group relative flex flex-col items-center px-[18px] py-[10px] no-underline text-text-secondary font-serif text-[0.95rem] font-normal tracking-[0.02em] transition-all duration-300 overflow-hidden hover:text-text-light max-lg:text-[1.1rem] max-lg:px-6 max-lg:py-4 max-lg:w-full max-lg:text-center`}
              >
                <span class="nav-link-text relative z-10 transition-all duration-300">
                  {item.label}
                </span>
                <span
                  class={`nav-link-underline absolute bottom-[6px] left-1/2 -translate-x-1/2 scale-x-0 w-[30px] h-[2px] bg-gradient-to-r from-transparent via-primary to-transparent transition-transform duration-300 rounded-[2px] group-hover:scale-x-100`}
                />
              </a>
            </li>
          ))
        }
      </ul>
    ))}
  </div>
</div>
