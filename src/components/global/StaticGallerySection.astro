---
import { getImage } from "astro:assets";

interface Image {
  src: ImageMetadata;
  alt?: string;
}

interface Props {
  images: Image[];
  columns?: number;
  title: string;
  subtitle?: string;
  sectionId?: string;
}

const {
  images,
  columns = 3,
  title = "Galería",
  subtitle = "",
  sectionId = "",
} = Astro.props;

// Generar columnas para Tailwind (1-12)
const getColumnClass = (cols: number) => {
  const map: Record<number, string> = {
    1: "grid-cols-1",
    2: "grid-cols-2",
    3: "grid-cols-3",
    4: "grid-cols-4",
    5: "grid-cols-5",
    6: "grid-cols-6",
    7: "grid-cols-7",
    8: "grid-cols-8",
    9: "grid-cols-9",
    10: "grid-cols-10",
    11: "grid-cols-11",
    12: "grid-cols-12",
  };
  return map[cols] || "grid-cols-3";
};
---

<section id={sectionId} class="static-gallery-section py-16 md:py-24 bg-white" data-gallery-id={sectionId}>
  <div class="container mx-auto px-6 max-w-7xl">
    <!-- Section Header -->
    <div class="max-w-4xl mx-auto mb-12">
      {
        subtitle && (
          <span class="text-secondary text-xs font-bold uppercase tracking-[0.4em] mb-4 block italic">
            {subtitle}
          </span>
        )
      }
      <h2
        class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-4"
      >
        {title}
      </h2>
      <div class="w-16 h-1 bg-secondary"></div>
    </div>

    <!-- Gallery Grid -->
    {
      images.length > 0 ? (
        <div class={`grid ${getColumnClass(columns)} gap-6`}>
          {images.map(async ({ src, alt }) => {
            const optimizedImage = await getImage({
              src,
              width: 800,
              format: "webp",
              quality: 80,
            });
            return (
              <div class="relative group overflow-hidden rounded-xl aspect-square bg-gray-100 shadow-sm">
                <img
                  data-src={optimizedImage.src}
                  alt={alt || "Imagen de galería"}
                  width={optimizedImage.attributes.width}
                  height={optimizedImage.attributes.height}
                  class="gallery-img w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-110 opacity-0"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300" />
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none loading-spinner transition-opacity duration-300">
                  <span class="material-icons animate-spin text-primary/30">
                    sync
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12 border-2 border-dashed border-gray-300 rounded-xl bg-gray-50">
          <p class="text-gray-500">No hay imágenes en esta galería.</p>
        </div>
      )
    }
  </div>
</section>

<style>
  @keyframes fadeIn {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // Find all gallery sections and load their images independently
  const sections = document.querySelectorAll(".static-gallery-section");

  const loadImages = (section: Element) => {
    const images = section.querySelectorAll(".gallery-img");
    images.forEach((img) => {
      if (img instanceof HTMLImageElement && img.dataset.src) {
        img.src = img.dataset.src;
        img.removeAttribute("data-src");
        img.onload = () => {
          img.classList.remove("opacity-0");
          img.classList.add("opacity-100");
          // Hide spinner
          const spinner = img.parentElement?.querySelector(".loading-spinner");
          if (spinner) spinner.classList.add("opacity-0");
        };
      }
    });
  };

  // Use Intersection Observer to load images when each section is visible
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          loadImages(entry.target);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );

  sections.forEach((section) => {
    observer.observe(section);
  });
</script>
