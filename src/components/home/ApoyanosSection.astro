---
import apoyanos from "@assets/images/historia/jose_carmelo_6.webp";
import SecondaryButton from "../ui/SecondaryButton.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
---

<section class="py-12 md:py-[8rem] bg-black text-white relative">
  <div
    class="absolute inset-0 opacity-10 bg-cover bg-top filter grayscale"
    style={`background-image: url('${apoyanos.src}');`}
  >
  </div>

  <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
    <SectionTitle
      variant="red"
      class="text-3xl md:text-5xl font-display font-bold leading-tight text-white"
      wrapperClass="text-center"
      dividerClass="h-1 w-16 mx-auto mb-8"
    >
      ¡Sé parte de nuestra Melodía!
    </SectionTitle>
    <p
      class="text-xl text-gray-300 mb-8 md:mb-10 max-w-2xl mx-auto font-light leading-relaxed italic"
    >
      Nuestra historia se escribe junto al apoyo de quienes creen en el poder
      transformador de la música.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <SecondaryButton href="/apoyanos/donaciones"> Apóyanos </SecondaryButton>
    </div>
  </div>
</section>
