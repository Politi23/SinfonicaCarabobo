---
import PrimaryButton from "@components/ui/PrimaryButton.astro";
import libroImage from "@assets/images/book/libro_osc.webp";
import backgroundImage from "@assets/images/historia/23_enero_osc.webp";
import { Picture } from "astro:assets";
---

<section class="relative bg-[#0a0a0a] overflow-hidden py-20">
  <!-- Fondo con la imagen solo en una parte y desvanecida -->
  <div class="absolute inset-0 z-0 opacity-40">
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-[#0a0a0a]/80 to-transparent z-10"
    >
    </div>
    <img
      src={backgroundImage.src}
      class="w-full h-full object-cover object-center"
      alt="Fondo OSC"
    />
  </div>

  <div class="container mx-auto px-6 relative z-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Columna de Texto -->
      <div class="order-2 lg:order-1 space-y-10">
        <div class="space-y-4">
          <span
            class="text-primary uppercase tracking-[0.3em] text-sm font-bold"
            >Edición Especial</span
          >
          <h2 class="text-5xl lg:text-7xl font-bold text-white leading-tight">
            45 Años <br />
            <span class="font-light italic text-zinc-400">De Historia</span>
          </h2>
          <p class="text-lg text-zinc-400 max-w-md leading-relaxed">
            Una pieza de colección que recorre la evolución musical y cultural
            de la
            <span class="text-white font-medium"
              >Orquesta Sinfónica de Carabobo</span
            >.
          </p>
        </div>

        <div class="bg-white/5 border-l-2 border-primary p-8 backdrop-blur-sm">
          <p class="text-zinc-300 italic text-lg leading-relaxed">
            "Un testimonio vivo de pasión, disciplina y excelencia musical
            plasmado en cada página."
          </p>
        </div>

        <div class="flex items-center gap-8">
          <PrimaryButton href="/contacto" variant="outline">
            Solicitar Ejemplar
          </PrimaryButton>
          <div class="hidden sm:block h-[1px] w-20 bg-zinc-700"></div>
        </div>
      </div>

      <!-- Columna del Libro (Visual más "limpio") -->
      <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="relative group">
          <!-- Sombra proyectada -->
          <div
            class="absolute -inset-4 bg-primary/20 blur-[100px] rounded-full opacity-0 group-hover:opacity-100 transition-duration-700"
          >
          </div>

          <!-- Contenedor del Libro -->
          <div
            class="relative transition-transform duration-500 group-hover:-rotate-2 group-hover:scale-105"
          >
            <Picture
              src={libroImage}
              alt="Libro OSC"
              class="w-[300px] md:w-[400px] rounded-r-lg shadow-[20px_20px_50px_rgba(0,0,0,0.5)] border-l-[12px] border-zinc-900"
              width="450"
              height="600"
            />
            <!-- Reflejo sobre el libro -->
            <div
              class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-transparent pointer-events-none"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
