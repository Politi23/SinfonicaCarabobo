---
import { getFoundationYears } from "../../utils/foundation";

const yearsOfHistory = getFoundationYears();
---

<section class="py-24 bg-background-light overflow-hidden">
  <div class="container mx-auto px-6 max-w-6xl">
    <div
      class="bg-surface-light rounded-xl p-8 md:p-12 shadow-md border border-border-light"
    >
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="md:text-left text-center flex-1">
          <h2
            class="text-3xl md:text-4xl font-display font-bold text-text-dark mb-4"
          >
            <span class="text-primary">{yearsOfHistory} años</span> de historia
          </h2>
          <p class="text-lg text-text-dark max-w-2xl mx-auto md:mx-0">
            Descubre nuestro libro conmemorativo que narra la extraordinaria
            trayectoria de la Orquesta Sinfónica de Carabobo
          </p>
        </div>

        <div class="flex-shrink-0">
          <a
            href="/libro"
            class="inline-block px-8 py-3 border-2 border-primary text-primary font-bold bg-white hover:bg-primary hover:text-white transition-colors duration-300"
          >
            <span>Ver Libro Conmemorativo</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
