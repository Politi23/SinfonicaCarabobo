---
import PrimaryButton from "@components/ui/PrimaryButton.astro";
import libroImage from "@assets/images/book/libro_osc.webp";
import backgroundImage from "@assets/images/historia/23_enero_osc.webp";
import { Picture } from "astro:assets";
---

<section
  class="bg-gradient-to-br bg-cover overflow-hidden"
  style={`background-image: url(${backgroundImage.src});`}
>
  <div
    class="flex flex-col items-center bg-zinc-950/95 backdrop-contrast-200 backdrop-blur-[3px] text-shadow-sm"
  >
    <div
      class="relative overflow-hidden pt-10 md:pt-12 lg:pt-16 pb-10 md:pb-12"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center"
        >
          <div class="order-2 lg:order-1 space-y-8 animate-fade-in-up">
            <div class="space-y-4">
              <h1
                class="font-display text-5xl lg:text-7xl font-bold text-white leading-tight"
              >
                <span class="text-primary">45 años</span>
                <br />
                <span class="font-semibold text-4xl lg:text-6xl"
                  >De Historia</span
                >
              </h1>
              <p
                class="text-[1.2rem] text-zinc-100 max-w-lg leading-relaxed font-light text-justify"
              >
                Una recopilación a través de los años de la evolución musical y
                cultural de la Orquesta Sinfónica de Carabobo.
              </p>
            </div>
            <div class="border-l-4 border-primary pl-6 py-2">
              <p class="italic text-white text-lg">
                "Si quieres conocer toda nuestra historia en detalle te
                invitamos a leer nuestro libro, testimonio vivo de pasión y
                excelencia."
              </p>
            </div>
            <div class="ml-12">
              <PrimaryButton variant="outline" href="/contacto">
                <span>Solicita una copia</span>
              </PrimaryButton>
            </div>
          </div>
          <div class="order-1 lg:order-2 relative flex justify-center">
            <div
              class="absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent blur-3xl rounded-full transform scale-75"
            >
            </div>
            <div
              class="relative z-10 transform hover:scale-[1.02] transition-transform duration-500 ease-out perspective-1000 group cursor-pointer"
            >
              <div
                class="absolute inset-0 bg-zinc-600/20 rounded-r-sm transform translate-x-4 translate-y-4 blur-md"
              >
              </div>
              <Picture
                alt="Portada del libro 45 Años de Historia"
                class="rounded-r-md shadow-2xl w-[280px] md:w-[350px] object-cover relative z-20 border-l-8 border-gray-900"
                src={libroImage}
                width="400"
                height="500"
                formats={["webp"]}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
              />
              <!-- <div
                class="absolute left-0 top-0 bottom-0 w-6 bg-gradient-to-r from-gray-900 to-gray-800 z-30 rounded-l-sm border-l border-border-dark opacity-90"
              >
              </div> -->
              <div
                class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/10 to-white/0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none z-40 rounded-r-xl"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
