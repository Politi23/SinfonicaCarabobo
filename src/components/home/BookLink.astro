<section class="py-24 bg-background-light overflow-hidden">
  <div class="container mx-auto px-6 max-w-6xl">
    <div
      class="bg-surface-light rounded-xl p-8 md:p-12 shadow-md border border-border-light"
    >
      <div class="flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="md:text-left text-center flex-1">
          <h2
            class="text-3xl md:text-4xl font-display font-bold text-text-dark mb-4"
          >
            <span class="text-primary">45 años</span> de historia
          </h2>
          <p class="text-lg text-text-dark max-w-2xl mx-auto md:mx-0">
            Descubre nuestro libro conmemorativo que narra la extraordinaria
            trayectoria de la Orquesta Sinfónica de Carabobo
          </p>
        </div>

        <div class="flex-shrink-0">
          <a
            href="/libro"
            class="inline-flex items-center gap-4 px-8 py-4 bg-white border-2 border-primary font-semibold text-black hover:bg-gray-100 transition-all duration-300"
          >
            <span>Ver Libro Conmemorativo</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
