---
import Hero from "@components/libro/Hero.astro";
import { getFoundationYears } from "../../utils/foundation";
import PrimaryButton from "@components/ui/PrimaryButton.astro";

getFoundationYears();
---

<section
  class="flex flex-col items-center pb-12 md:pb-14 bg-gradient-to-br from-black via-black to-gray-900"
>
  <Hero />
  <div class="flex-shrink-0">
    <PrimaryButton variant="outline" href="/contacto">
      <span>Solicita una copia</span>
    </PrimaryButton>
  </div>
</section>
