---
import { getEventos } from "src/config/wp-eventos";

import SecondaryButton from "../ui/SecondaryButton.astro";
import EventoCard from "@components/eventos/EventoCard.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";

interface Props {
  perPage?: number;
}

const { perPage = 9 } = Astro.props as Props;
const eventos = await getEventos(perPage);
const carouselId = `conciertos-${Math.random().toString(36).slice(2, 9)}`;
const errorLoading = eventos.length === 0 || !eventos;
---

<section class="bg-white py-5 md:py-12" data-conciertos-carousel={carouselId}>
  <div class="container w-full mx-auto px-6">
    <div class="flex justify-between items-center">
      <SectionTitle title="Próximos Eventos" />

      <div class="hidden md:flex gap-2">
        <button
          data-carousel-prev
          class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center text-gray-600 hover:border-primary hover:text-primary transition-all duration-300 focus:outline-none"
          aria-label="Previous"
        >
          <i class="ph ph-caret-left"></i>
        </button>

        <button
          data-carousel-next
          class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center text-gray-600 hover:border-primary hover:text-primary transition-all duration-300 focus:outline-none"
          aria-label="Next"
        >
          <i class="ph ph-caret-right"></i>
        </button>
      </div>
    </div>

    <div class="relative mt-4">
      <div
        data-carousel-viewport
        class="overflow-x-auto md:overflow-hidden py-2"
      >
        <div
          data-carousel-track
          class="grid grid-flow-col auto-cols-[minmax(17rem,1fr)] md:auto-cols-[minmax(20rem,1fr)] lg:auto-cols-[minmax(22rem,1fr)] gap-4 md:gap-6 snap-x snap-mandatory md:snap-none"
        >
          {
            eventos.map((evento) => (
              <div class="snap-start h-full">
                <EventoCard
                  title={evento.title.rendered}
                  excerpt={evento.acf.event_description}
                  image={
                    evento._embedded?.["wp:featuredmedia"]?.[0]?.source_url ||
                    ""
                  }
                  date={evento.acf.event_date}
                  time={evento.acf.event_time}
                  venue={evento.acf.event_venue}
                  slug={evento.slug}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {
      errorLoading && (
        <div class="text-center py-8">
          <p class="flex items-center justify-center text-gray-500 text-lg min-h-[30vh]">
            Hubo un error consiguiendo los elementos.
          </p>
        </div>
      )
    }

    <div class="text-center mt-5">
      <SecondaryButton href="/eventos"> Ver todos </SecondaryButton>
    </div>
  </div>

  <script is:inline define:vars={{ totalItems: eventos.length, carouselId }}>
    if (totalItems === 0) return;

    const section = document.querySelector(
      `[data-conciertos-carousel="${carouselId}"]`,
    );

    if (!section) return;

    const viewport = section.querySelector("[data-carousel-viewport]");
    const track = section.querySelector("[data-carousel-track]");
    const prevBtn = section.querySelector("[data-carousel-prev]");
    const nextBtn = section.querySelector("[data-carousel-next]");
    if (!track || !viewport) return;

    const getStep = () => {
      const firstItem = track.firstElementChild;
      if (!firstItem) return viewport.clientWidth;

      const trackStyles = window.getComputedStyle(track);
      const gap = Number.parseFloat(
        trackStyles.columnGap || trackStyles.gap || "0",
      );

      return firstItem.getBoundingClientRect().width + gap;
    };

    const scrollByStep = (direction) => {
      viewport.scrollBy({
        left: direction * getStep(),
        behavior: "smooth",
      });
    };

    prevBtn?.addEventListener("click", () => scrollByStep(-1));
    nextBtn?.addEventListener("click", () => scrollByStep(1));
  </script>
</section>
