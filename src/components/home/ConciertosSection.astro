---
import logoSimpleBbg from "@assets/images/logo/logosimplebbg.webp";

import { getEventos } from "src/config/wp-eventos";

import SecondaryButton from "../ui/SecondaryButton.astro";
import EventoCard from "@components/eventos/EventoCard.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";

interface Props {
  perPage?: number;
}

const { perPage = 9 } = Astro.props as Props;
const eventos = await getEventos(perPage);
const carouselId = `conciertos-${Math.random().toString(36).slice(2, 9)}`;
const showPlaceholders = eventos.length === 0;
// const showPlaceholders = true;
const placeholderItems = Array.from({ length: 6 });
---

<section class="bg-white py-12" data-conciertos-carousel={carouselId}>
  <div class="container mx-auto px-6">
    <div class="flex justify-between items-center">
      <SectionTitle title="Próximos Eventos" />

      <div class="hidden md:flex gap-2">
        <button
          data-carousel-prev
          class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center text-gray-600 hover:border-primary hover:text-primary transition-all duration-300 focus:outline-none"
          aria-label="Previous"
        >
          <i class="ph ph-caret-left"></i>
        </button>

        <button
          data-carousel-next
          class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center text-gray-600 hover:border-primary hover:text-primary transition-all duration-300 focus:outline-none"
          aria-label="Next"
        >
          <i class="ph ph-caret-right"></i>
        </button>
      </div>
    </div>

    <div class="relative">
      <div class="overflow-hidden py-2">
        <div
          data-carousel-track
          class="flex transition-transform duration-700 ease-out"
        >
          {
            showPlaceholders
              ? placeholderItems.map(() => (
                  <div
                    class="flex-none w-full md:w-1/2 lg:w-1/3 px-4 box-border"
                    aria-hidden="true"
                  >
                    <article class="border border-zinc-200 bg-white rounded shadow-sm overflow-hidden flex flex-col h-full animate-pulse">
                      <div class="h-56 w-full bg-gray-200" />
                      <div class="p-4 flex flex-col flex-grow">
                        <div class="h-6 w-4/5 bg-gray-200 rounded mb-3" />
                        <div class="h-3 w-full bg-gray-200 rounded mb-2" />
                        <div class="h-3 w-11/12 bg-gray-200 rounded mb-2" />
                        <div class="h-3 w-3/4 bg-gray-200 rounded mb-6" />
                        <div class="h-4 w-2/3 bg-gray-200 rounded mb-3" />
                        <div class="pt-4 p-2 border-t border-gray-100 mt-auto">
                          <div class="h-3 w-1/3 bg-gray-200 rounded" />
                        </div>
                      </div>
                    </article>
                  </div>
                ))
              : eventos.map((evento) => (
                  <div class="flex-none w-full md:w-1/2 lg:w-1/3 px-4 box-border">
                    <EventoCard
                      title={evento.title.rendered}
                      excerpt={evento.acf.event_description}
                      image={
                        evento._embedded?.["wp:featuredmedia"]?.[0]
                          ?.source_url || logoSimpleBbg.src
                      }
                      date={evento.acf.event_date}
                      time={evento.acf.event_time}
                      venue={evento.acf.event_venue}
                      slug={evento.slug}
                    />
                  </div>
                ))
          }
        </div>
      </div>

      <div data-carousel-dots class="flex justify-center mt-4 space-x-2"></div>
    </div>

    {
      showPlaceholders && (
        <div class="text-center py-10">
          <p class="text-gray-500 text-lg">
            No hay eventos programados por el momento.
          </p>
        </div>
      )
    }

    <div class="text-center mt-6">
      <SecondaryButton href="/eventos"> Ver todos </SecondaryButton>
    </div>
  </div>

  <script is:inline define:vars={{ totalItems: eventos.length, carouselId }}>
    if (totalItems === 0) return;

    const section = document.querySelector(
      `[data-conciertos-carousel="${carouselId}"]`,
    );

    if (!section) return;

    const track = section.querySelector("[data-carousel-track]");
    const prevBtn = section.querySelector("[data-carousel-prev]");
    const nextBtn = section.querySelector("[data-carousel-next]");
    const dotsContainer = section.querySelector("[data-carousel-dots]");

    if (!track || !dotsContainer) return;

    let currentIndex = 0;
    let itemsPerView = 1;
    let totalPages = 1;

    const updateDimensions = () => {
      const width = window.innerWidth;
      if (width >= 1024) itemsPerView = 3;
      else if (width >= 768) itemsPerView = 2;
      else itemsPerView = 1;

      totalPages = Math.ceil(totalItems / itemsPerView);
      if (currentIndex >= totalPages) currentIndex = totalPages - 1;
      if (currentIndex < 0) currentIndex = 0;

      renderDots();
      updateCarousel();
    };

    const renderDots = () => {
      dotsContainer.innerHTML = "";

      for (let i = 0; i < totalPages; i++) {
        const btn = document.createElement("button");
        btn.className = `indicator-dot w-3 h-3 rounded-full transition-colors duration-300 ${i === currentIndex ? "bg-primary" : "bg-gray-300"}`;
        btn.ariaLabel = `Go to slide ${i + 1}`;
        btn.addEventListener("click", () => goToSlide(i));
        dotsContainer.appendChild(btn);
      }
    };

    const updateCarousel = () => {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      const dots = dotsContainer.querySelectorAll(".indicator-dot");
      dots.forEach((dot, i) => {
        if (i === currentIndex) {
          dot.classList.remove("bg-gray-300");
          dot.classList.add("bg-primary");
        } else {
          dot.classList.remove("bg-primary");
          dot.classList.add("bg-gray-300");
        }
      });
    };

    const goToSlide = (index) => {
      if (index < 0) currentIndex = totalPages - 1;
      else if (index >= totalPages) currentIndex = 0;
      else currentIndex = index;
      updateCarousel();
    };

    prevBtn?.addEventListener("click", () => goToSlide(currentIndex - 1));
    nextBtn?.addEventListener("click", () => goToSlide(currentIndex + 1));
    window.addEventListener("resize", updateDimensions);

    updateDimensions();
  </script>
</section>
