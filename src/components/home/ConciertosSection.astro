---
import { getEventos } from "src/config/wp-eventos";
import type { WPEvento } from "src/config/wp-eventos";
import Button from "../ui/GoldenButton.astro";

interface Props {
  perPage?: number;
}

const { perPage = 9 } = Astro.props as Props;
const eventos = await getEventos(perPage);

const formatAcfDate = (dateString: string) => {
  if (!dateString || dateString.length !== 8) return dateString;
  const year = dateString.substring(0, 4);
  const month = dateString.substring(4, 6);
  const day = dateString.substring(6, 8);
  const dateObj = new Date(Number(year), Number(month) - 1, Number(day));
  return dateObj.toLocaleDateString("es-VE", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const getImageUrl = (evento: WPEvento) => {
  return (
    evento._embedded?.["wp:featuredmedia"]?.[0]?.source_url ||
    "/logosimplebbg.webp"
  );
};
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        Próximos Eventos
      </h2>
      <p class="mt-4 text-gray-600">
        Acompáñanos en nuestros próximos eventos.
      </p>
    </div>

    <div class="relative group">
      <div class="overflow-hidden">
        <div
          id="concert-track"
          class="flex transition-transform duration-500 ease-in-out"
        >
          {
            eventos.map((evento) => (
              <div class="flex-none w-full md:w-1/2 lg:w-1/3 px-4 box-border">
                <article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
                  {/* Imagen */}
                  <div class="relative h-48 w-full overflow-hidden bg-gray-200">
                    <img
                      src={getImageUrl(evento)}
                      alt={evento.title.rendered}
                      class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                    />
                  </div>

                  <div class="p-6 flex flex-col flex-grow">
                    <h3
                      class="text-xl font-bold text-gray-800 mb-2"
                      set:html={evento.title.rendered}
                    />

                    <div class="space-y-2 mb-4 text-sm text-gray-600">
                      <div class="flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 text-primary-500"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                          />
                        </svg>
                        <span class="capitalize">
                          {formatAcfDate(evento.acf.event_date)}
                        </span>
                      </div>

                      <div class="flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 text-primary-500"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <span>{evento.acf.event_time.slice(0, 5)} hrs</span>
                      </div>

                      <div class="flex items-center gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-5 w-5 text-primary-500"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        <span>{evento.acf.event_venue}</span>
                      </div>
                    </div>

                    <hr class="border-gray-100 my-2" />
                    <p class="text-gray-600 text-sm flex-grow line-clamp-2">
                      {/* Función para limitar el excerpt a 25 palabras */}
                      {(() => {
                        const text = evento.acf.event_description;
                        if (!text) return "";
                        const words = text.split(" ");
                        if (words.length <= 25) return text;
                        return words.slice(0, 25).join(" ") + "...";
                      })()}
                    </p>

                    <div class="mt-4 pt-4">
                      <a
                        href={`/eventos/${evento.slug}`}
                        class="block w-full text-center bg-gray-900 text-white py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium"
                      >
                        Ver detalles
                      </a>
                    </div>
                  </div>
                </article>
              </div>
            ))
          }
        </div>
      </div>

      <button
        id="prev-btn"
        class="absolute top-1/2 left-0 transform -translate-y-1/2 -translate-x-1/3 md:-translate-x-1/4 bg-white text-gray-800 rounded-full p-3 shadow-lg hover:bg-gray-100 focus:outline-none z-10 border border-primary hidden md:block"
        aria-label="Previous"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <button
        id="next-btn"
        class="absolute top-1/2 right-0 transform -translate-y-1/2 translate-x-1/3 md:translate-x-1/4 bg-white text-gray-800 rounded-full p-3 shadow-lg hover:bg-gray-100 focus:outline-none z-10 border border-primary hidden md:block"
        aria-label="Next"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div id="carousel-dots" class="flex justify-center mt-8 space-x-2"></div>
    </div>

    {
      eventos.length === 0 && (
        <div class="text-center py-10">
          <p class="text-gray-500 text-lg">
            No hay eventos programados por el momento.
          </p>
        </div>
      )
    }

    <div class="text-center mt-12">
      <Button href="/eventos"> Ver todos los eventos </Button>
    </div>
  </div>

  <script define:vars={{ totalItems: eventos.length }}>
    document.addEventListener("DOMContentLoaded", () => {
      if (totalItems === 0) return;

      const track = document.getElementById("concert-track");
      const prevBtn = document.getElementById("prev-btn");
      const nextBtn = document.getElementById("next-btn");
      const dotsContainer = document.getElementById("carousel-dots");

      let currentIndex = 0;
      let itemsPerView = 1;
      let totalPages = 1;

      // Calcular cuántos items se ven según el ancho de pantalla
      const updateDimensions = () => {
        const width = window.innerWidth;
        if (width >= 1024)
          itemsPerView = 3; // lg
        else if (width >= 768)
          itemsPerView = 2; // md
        else itemsPerView = 1; // mobile

        totalPages = Math.ceil(totalItems / itemsPerView);

        // Reiniciar índice si excede el nuevo total de páginas
        if (currentIndex >= totalPages) currentIndex = totalPages - 1;
        if (currentIndex < 0) currentIndex = 0;

        renderDots();
        updateCarousel();
      };

      const renderDots = () => {
        if (!dotsContainer) return;
        dotsContainer.innerHTML = "";

        for (let i = 0; i < totalPages; i++) {
          const btn = document.createElement("button");
          btn.className = `indicator-dot w-3 h-3 rounded-full transition-colors duration-300 ${i === currentIndex ? "bg-primary" : "bg-gray-300"}`;
          btn.ariaLabel = `Go to slide ${i + 1}`;
          btn.addEventListener("click", () => goToSlide(i));
          dotsContainer.appendChild(btn);
        }
      };

      const updateCarousel = () => {
        if (!track) return;
        // Movemos el track en porcentaje (100% = 1 vista completa de items)
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        // Actualizar dots visualmente
        const dots = dotsContainer.querySelectorAll(".indicator-dot");
        dots.forEach((dot, i) => {
          if (i === currentIndex) {
            dot.classList.remove("bg-gray-300");
            dot.classList.add("bg-primary");
          } else {
            dot.classList.remove("bg-primary");
            dot.classList.add("bg-gray-300");
          }
        });
      };

      const goToSlide = (index) => {
        if (index < 0) currentIndex = totalPages - 1;
        else if (index >= totalPages) currentIndex = 0;
        else currentIndex = index;
        updateCarousel();
      };

      prevBtn?.addEventListener("click", () => goToSlide(currentIndex - 1));
      nextBtn?.addEventListener("click", () => goToSlide(currentIndex + 1));

      window.addEventListener("resize", updateDimensions);

      // Inicializar
      updateDimensions();
    });
  </script>
</section>
