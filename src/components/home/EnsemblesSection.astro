---
import { Picture } from "astro:assets";
import SecondaryButton from "@components/ui/SecondaryButton.astro";
import orquestaSinfonica from "@assets/images/agrupaciones/orquesta.webp";
import orquestaCamara from "@assets/images/orquesta/DSC_1676.webp";
import jazzEnsamble from "@assets/images/orquesta/DSC_5305.webp";
import cuartetoCuerdas from "@assets/images/orquesta/DSC_5276.webp";

const ensembles = [
  {
    nombre: "Orquesta Sinfónica de Carabobo",
    imagen: orquestaSinfonica,
  },
  {
    nombre: "Orquesta de Cámara Sinfocarabobo",
    imagen: orquestaCamara,
  },
  {
    nombre: "Sinfocarabobo Jazz Ensamble",
    imagen: jazzEnsamble,
  },
  {
    nombre: "Cuarteto Sinfocarabobo",
    imagen: cuartetoCuerdas,
  },
];
---

<section class="py-20 md:py-20 bg-white relative overflow-hidden">
  <div class="container mx-auto px-6 max-w-7xl relative z-10">
    <div class="text-center mb-20">
      <div
        class="text-secondary text-base font-semibold tracking-[0.15rem] uppercase mb-3"
      >
        ¡Somos la música para tu evento!
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-text-dark mb-6">
        Nuestras <span class="text-secondary">Agrupaciones</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {
        ensembles.map((ensemble) => (
          <div class="group bg-background-light flex flex-col hover:shadow-lg transition-all duration-500 border border-border-light">
            <div class="relative overflow-hidden aspect-[4/3]">
              <div class="absolute inset-0 bg-text-dark/10 group-hover:bg-transparent transition-colors duration-500 z-10" />

              <Picture
                src={ensemble.imagen}
                alt={ensemble.nombre}
                class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-in-out"
                width="600"
                height="450"
                formats={["webp"]}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
              />

              <div class="absolute inset-4 border border-white/40 z-20 pointer-events-none scale-95 group-hover:scale-100 opacity-0 group-hover:opacity-100 transition-all duration-500" />
            </div>

            <div class="p-8 flex flex-col flex-grow relative bg-background-light">
              <div class="w-8 h-[2px] bg-primary mb-5 transition-all duration-300 group-hover:w-16" />

              <h3 class="text-lg font-bold text-text-dark leading-snug uppercase tracking-wide min-h-20">
                {ensemble.nombre}
              </h3>
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-12 flex justify-center">
      <SecondaryButton
        href="/agrupaciones"
        class="px-10 py-4 uppercase tracking-[0.2em] text-sm font-bold transition-all duration-300 hover:shadow-lg"
      >
        Ver Todas las Agrupaciones
      </SecondaryButton>
    </div>
  </div>
</section>
