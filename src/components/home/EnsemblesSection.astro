---
import { Image } from 'astro:assets';
import SecondaryButton from "@components/ui/SecondaryButton.astro";
import orquestaSinfonica from "@assets/images/orchestra/orquestaSinfonica.webp";
import orquestaCamara from "@assets/images/orchestra/DSC_1140.webp";
import jazzEnsamble from "@assets/images/orchestra/DSC_0471.webp";
import cuartetoCuerdas from "@assets/images/orchestra/cuarteto-cuerdas.webp";

const ensembles = [
    {
        nombre: "Orquesta Sinfónica de Carabobo",
        imagen: orquestaSinfonica,
        descripcion: "Orquesta Sinfónica conformada por músicos profesionales, para repertorios y eventos que requieran este formato musical."
    },
    {
        nombre: "Orquesta de Cámara Sinfocarabobo",
        imagen: orquestaCamara,
        descripcion: "Agrupación musical conformada entre 15 y 25 músicos, de las secciones de cuerdas, vientos, percusión, bajo eléctrico y voz."
    },
    {
        nombre: "Sinfocarabobo Jazz Ensamble",
        imagen: jazzEnsamble,
        descripcion: "Agrupación musical, conformada por diferentes instrumentos acústicos, eléctricos, electrónicos y voz, en diferentes formatos instrumentales."
    },
    {
        nombre: "Cuarteto Sinfocarabobo",
        imagen: cuartetoCuerdas,
        descripcion: "Cuarteto de cuerdas conformado por dos violines, viola y violonchelo, con amplia experiencia musical y artística."
    }
];
---

<section class="py-16 md:py-24 bg-gradient-to-br from-black via-gray-900 to-black">
    <div class="container mx-auto px-6 max-w-6xl">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <span class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block">
                Música a tu Medida
            </span>
            <h2 class="text-3xl md:text-5xl font-display font-bold text-white">
                Nuestras <span class="text-primary italic">Agrupaciones</span>
            </h2>
        </div>

        <!-- Ensembles Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            {ensembles.map((ensemble) => (
                <div class="group bg-white/5 rounded-xl overflow-hidden backdrop-blur-sm border border-white/10 hover:border-primary/50 transition-all duration-300">
                    <div class="aspect-[4/3] overflow-hidden">
                        <Image
                            src={ensemble.imagen}
                            alt={ensemble.nombre}
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            width="400"
                            height="300"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <div class="p-5">
                        <h3 class="text-lg font-bold text-white mb-2 line-clamp-2">
                            {ensemble.nombre}
                        </h3>
                        <p class="text-gray-400 text-sm leading-relaxed line-clamp-3">
                            {ensemble.descripcion}
                        </p>
                    </div>
                </div>
            ))}
        </div>

        <!-- CTA Button -->
        <div class="text-center">
            <SecondaryButton href="/agrupaciones">
                Ver Todas las Agrupaciones
            </SecondaryButton>
        </div>
    </div>
</section>
