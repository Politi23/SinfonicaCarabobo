---
import violinHeader from "@assets/images/orchestra/violin-header.webp";

const { showVideo = true } = Astro.props;
---
<main>
  <!-- Sección de hero -->
  <section
    class="relative h-screen flex flex-col justify-center items-center text-center overflow-hidden"
  >
    {showVideo ? (
      <video
        autoplay
        loop
        muted
        playsinline
        class="absolute inset-0 w-full h-full object-cover z-0"
        poster={violinHeader.src}
        width={violinHeader.width}
        height={violinHeader.height}
        loading="eager"
        fetchpriority="high"
        transition:persist
      >
        <source src="/video-fondo.mp4" type="video/mp4" />
      </video>
    ) : (
      <!-- Imagen de fondo estática para cuando no hay video -->
      <div class="absolute inset-0 z-0">
        <img
          src={violinHeader.src}
          alt="Orquesta Sinfónica"
          class="w-full h-full object-cover"
          width={violinHeader.width}
          height={violinHeader.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}


    <!-- Overlay con gradiente suave hacia el color crema -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-background-light z-0"
    >
    </div>

    <div class="hero-content">
      <h1 class="hero-title">Fundación Orquesta Sinfónica de Carabobo</h1>
    </div>
  </section>
</main>

<style>
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .hero-title {
    margin: 0 0 32px;
    font-family: "Playfair Display", "Merriweather", serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-light);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.1rem;
    }
  }
</style>
