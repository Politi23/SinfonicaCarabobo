---
import { Picture } from "astro:assets";
import slide1 from "@assets/images/carrousel/1.webp";
import slide2 from "@assets/images/carrousel/2.webp";
import slide3 from "@assets/images/carrousel/3.webp";
import slide4 from "@assets/images/carrousel/4.webp";
import slide5 from "@assets/images/carrousel/5.webp";
import slide6 from "@assets/images/carrousel/6.jpg";
import aniversario from "@assets/images/logo/aniversario/logo_dorado.png";

const images = [slide3, slide6, slide5, slide2, slide4];
---

<main>
  <section
    class="relative h-[95vh] flex flex-col justify-center text-center bg-black"
  >
    <div class="absolute inset-0 overflow-hidden backdrop-invert">
      <div class="absolute inset-0 overflow-hidden">
        <Picture
          src={images[0]}
          alt="Orquesta Sinfónica"
          class="first-c-slide-image w-full h-full object-cover"
          width="1920"
          height="1080"
          formats={["webp"]}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {
        images.map((item, index) => (
          <div
            class="c-slide-layer absolute inset-0 overflow-hidden animate-pulse z-1"
            style={`--i: ${index}`}
          >
            <Picture
              src={item}
              alt="Orquesta Sinfónica"
              class="c-slide-image w-full h-full object-cover"
              width="1920"
              height="1080"
              formats={["webp"]}
              fallbackFormat="webp"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    <div
      class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/40 to-white/30 z-0"
    >
    </div>

    <div
      class="absolute inset-0 bg-gradient-to-b md:bg-gradient-to-r from-transparent via-black/30 to-black md:from-transparent md:via-black/10 md:to-black z-0"
    >
    </div>

    <div
      class="w-full h-full hero-content flex items-end justify-center md:items-center md:justify-end"
    >
      <div>
        <Picture
          src={aniversario}
          alt={"logo_aniversario"}
          width={1000}
          height={1000}
          class="w-[300px] md:w-[500px] md:mr-10"
          loading={"eager"}
        />
      </div>
    </div>
  </section>
</main>

<style>
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 24px;
  }

  .hero-title {
    margin: 0 0 32px;
    font-family: var(--font-cinzel), serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-light);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .hero-logo {
    filter: drop-shadow(0 10px 10px rgba(0, 0, 0, 1));
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.1rem;
    }
  }

  @keyframes fade-in-out {
    0% {
      opacity: 0;
    }

    12% {
      opacity: 1;
    }

    20% {
      opacity: 1;
    }

    30% {
      opacity: 0;
    }

    40% {
      opacity: 0;
    }

    100% {
      opacity: 0;
    }
  }

  .c-slide-layer {
    opacity: 0;
    animation: fade-in-out 20s infinite;
    animation-delay: calc(var(--i) * 4s);
  }

  .c-slide-image {
    transform: scale(1.05) translate3d(0, 0, 0);
    animation: slide-pan-left 20s infinite;
    animation-delay: calc(var(--i) * 4s);
    will-change: transform;
  }

  @keyframes slide-pan-left {
    0% {
      transform: scale(1.05) translate3d(0, 0, 0);
    }

    40% {
      transform: scale(1.05) translate3d(-2.5%, 0, 0);
    }

    100% {
      transform: scale(1.05) translate3d(-2.5%, 0, 0);
    }
  }

  @keyframes first-fade-out {
    0% {
      opacity: 1;
      transform: scale(1.05) translate3d(0, 0, 0);
    }

    40% {
      opacity: 1;
      transform: scale(1.05) translate3d(-2.5%, 0, 0);
    }

    42% {
      opacity: 0%;
    }

    100% {
      opacity: 0;
      transform: scale(1.05) translate3d(-2.5%, 0, 0);
    }
  }

  .first-c-slide-image {
    opacity: 1;
    transform: scale(1.05) translate3d(0, 0, 0);
    animation: first-fade-out 20s forwards;
    will-change: transform;
  }
</style>
