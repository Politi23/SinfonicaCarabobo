---
import PrimaryButton from "@components/ui/PrimaryButton.astro";
// import logo from "@assets/images/logo/logo-large.png";
import background from "@assets/images/galeria/academia/recitales_finales1.webp";
---

<section class="bg-white max-h-[60vh] p-10">
    <div class="grid grid-cols-1 md:grid-cols-10">
        <div
            class="h-fit md:col-span-5 px-6 py-12 md:px-8 lg:px-12 border-b-[0.05rem] md:border-b-0 md:border-r-[0.05rem] border-primary"
        >
            <h2
                class="text-3xl md:text-5xl font-titles font-bold text-gray-900"
            >
                Unete a nuestro
                <span class="text-primary">Programa Musical</span>
            </h2>
            <!-- <p class="text-gray-600 mt-6 text-lg leading-relaxed">
                Unete a nuestro programa academico de la Academia Internacional
                Maestro Jose Calabrese y desarrolla tu talento en un entorno de
                excelencia musical, disciplina y crecimiento humano.
            </p> -->

            <div class="mt-8 mx-auto w-full max-w-[400px] image-shadow p-4">
                <!-- <img
                    src={logo.src}
                    alt="Logo Academia Internacional Maestro Jose Calabrese"
                    class="w-full h-auto object-contain"
                    loading="lazy"
                /> -->
            </div>

            <div class="mt-8 flex">
                <PrimaryButton
                    href="https://academiajosecalabrese.com"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Conoce la Academia
                </PrimaryButton>
            </div>
        </div>

        <div
            class={`mask-l-from-50% mask-l-to-90% background bg-cover md:col-span-5 sm:hidden md:grid`}
            style={`background-image: url(${background.src});`}
        >
        </div>
    </div>

    <style>
        .background {
            /* background-position: -50px -100px; */
        }

        .image-shadow {
            filter: drop-shadow(5px 5px 1px rgba(255, 255, 255, 1));
        }
    </style>
</section>
