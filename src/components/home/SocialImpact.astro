---
import { Image } from "astro:assets";
import PrimaryButton from "@components/ui/PrimaryButton.astro";
import SecondaryButton from "@components/ui/SecondaryButton.astro";
import academiaMain from "@assets/images/organizacion/academia.webp";
import violinStudent from "@assets/images/orchestra/violin.webp";
import orchestraEducation from "@assets/images/orchestra/orquestaSinfonica.webp";
import masterclassViolin from "@assets/images/galeria/academia/masterclass_violin12.webp";
---

<section class="py-20 md:py-24 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <span
                class="text-secondary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
            >
                Formación Musical
            </span>
            <h2
                class="text-3xl md:text-5xl font-display font-bold text-gray-900"
            >
                Academia Internacional <br />
                <span class="text-primary italic">Maestro José Calabrese</span>
            </h2>
            <p
                class="text-gray-600 max-w-2xl mx-auto mt-6 text-lg leading-relaxed"
            >
                Formando el futuro de la música con excelencia académica e
                inclusión social
            </p>
        </div>

        <!-- Bento Box Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
            <!-- Main Large Image - Academia -->
            <div
                class="col-span-2 row-span-2 relative group overflow-hidden rounded-2xl"
            >
                <Image
                    src={academiaMain}
                    alt="Academia Internacional Maestro José Calabrese"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    width="800"
                    height="600"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
                >
                </div>
                <div class="absolute bottom-0 left-0 p-6 md:p-8">
                    <h3 class="text-white text-xl md:text-2xl font-bold mb-2">
                        Educación Musical de Excelencia
                    </h3>
                    <p
                        class="text-gray-200 text-sm md:text-base leading-relaxed"
                    >
                        Más de 500 estudiantes formados con el aval de la UNESCO
                    </p>
                </div>
            </div>

            <!-- Stats Card -->
            <div
                class="col-span-1 row-span-1 bg-gradient-to-br from-primary to-primary-dark rounded-2xl p-6 flex flex-col justify-center text-white"
            >
                <span class="text-4xl md:text-5xl font-bold mb-2">300+</span>
                <span class="text-sm md:text-base text-white/90">
                    Estudiantes <br />activos
                </span>
            </div>

            <!-- UNESCO Badge -->
            <div
                class="col-span-1 row-span-1 bg-gray-50 rounded-2xl p-6 flex flex-col justify-center border border-gray-100"
            >
                <div
                    class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-3"
                >
                    <svg
                        class="w-6 h-6 text-primary"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 2L1 21h22L12 2zm0 3.83L19.17 19H4.83L12 5.83zM12 9v6m-3-3h6"
                        ></path>
                    </svg>
                </div>
                <span
                    class="text-xs font-bold text-gray-700 uppercase tracking-wide"
                >
                    Aval UNESCO
                </span>
                <span class="text-xs text-gray-500 mt-1">
                    Certificación internacional
                </span>
            </div>

            <!-- Student Image 1 -->
            <div
                class="col-span-1 row-span-1 relative group overflow-hidden rounded-2xl"
            >
                <Image
                    src={violinStudent}
                    alt="Estudiante de violín"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    width="400"
                    height="400"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-primary/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
                >
                    <span class="text-white font-bold text-sm"
                        >Cátedras Especializadas</span
                    >
                </div>
            </div>

            <!-- Student Image 2 -->
            <div
                class="col-span-1 row-span-1 relative group overflow-hidden rounded-2xl"
            >
                <Image
                    src={masterclassViolin}
                    alt="Clase magistral"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    width="400"
                    height="400"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-primary/80 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center"
                >
                    <span class="text-white font-bold text-sm"
                        >Clases Magistrales</span
                    >
                </div>
            </div>

            <!-- Wide Image - Orchestra Education -->
            <div
                class="col-span-2 row-span-1 relative group overflow-hidden rounded-2xl"
            >
                <Image
                    src={orchestraEducation}
                    alt="Orquesta juvenil en formación"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    width="800"
                    height="400"
                    loading="lazy"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"
                >
                </div>
                <div class="absolute bottom-0 left-0 p-6">
                    <h3 class="text-white text-lg font-bold">
                        Inclusión Social
                    </h3>
                    <p class="text-gray-200 text-sm">
                        Programa para niños con Síndrome de Down
                    </p>
                </div>
            </div>

            <!-- Second Stats Card -->
            <div
                class="col-span-1 row-span-1 bg-gray-900 rounded-2xl p-6 flex flex-col justify-center text-white text-center"
            >
                <span class="text-4xl md:text-5xl font-bold mb-2">30+</span>
                <span class="text-sm md:text-base text-gray-300">
                    Cátedras <br />especializadas
                </span>
            </div>

            <!-- CTA Card -->
            <div
                class="col-span-1 row-span-1 bg-gray-100 rounded-2xl p-6 flex flex-col justify-center border border-gray-100"
            >
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-primary rounded-full"></span>
                        <span class="text-xs font-medium text-gray-700"
                            >Niños y jóvenes</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-primary rounded-full"></span>
                        <span class="text-xs font-medium text-gray-700"
                            >Capacidades especiales</span
                        >
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-primary rounded-full"></span>
                        <span class="text-xs font-medium text-gray-700"
                            >Becas disponibles</span
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- CTA Buttons -->
        <div
            class="flex flex-col sm:flex-row gap-4 justify-center items-center"
        >
            <PrimaryButton href="/nosotros/academia">
                Conoce la Academia
            </PrimaryButton>
            <SecondaryButton href="/contacto">
                Solicitar Información
            </SecondaryButton>
        </div>
    </div>
</section>
