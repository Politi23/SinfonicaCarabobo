---
import { Picture } from "astro:assets";
import PrimaryButton from "@components/ui/PrimaryButton.astro";
import background from "@assets/images/academia/recitales_finales1.webp";
---

<section class="bg-white py-16 md:py-32">
    <div class="container mx-auto px-6 md:px-12 max-w-7xl">
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-12 lg:gap-16"
        >
            <!-- Left side: Text Content -->
            <div class="w-full md:w-3/5 flex flex-col items-start space-y-8">
                <div class="space-y-4">
                    <h2
                        class="text-3xl md:text-5xl lg:text-6xl font-titles font-bold text-gray-900 leading-tight"
                    >
                        Conoce nuestro
                        <span class="text-primary">Programa Musical</span>
                    </h2>
                </div>
                <p
                    class="text-lg md:text-xl text-muted font-serif font-light leading-relaxed max-w-xl"
                >
                    Únete a nuestro programa académico de la Academia
                    Internacional Maestro Jose Calabrese y desarrolla tu talento
                    en un entorno de excelencia musical, disciplina y
                    crecimiento humano.
                </p>
                <div class="pt-4">
                    <PrimaryButton
                        href="https://academiajosecalabrese.com"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Conoce la Academia
                    </PrimaryButton>
                </div>
            </div>

            <!-- Right side: Visual Content -->
            <div class="w-full md:w-2/5">
                <div class="relative group">
                    <!-- Clean Rectangular Image -->
                    <div
                        class="aspect-[4/3] overflow-hidden rounded-xl bg-surface-light transition-transform duration-500"
                    >
                        <Picture
                            src={background}
                            alt="Estudiantes de música en recital final"
                            class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700"
                            width="600"
                            height="450"
                            formats={["webp"]}
                            fallbackFormat="webp"
                            loading="lazy"
                            decoding="async"
                        />
                    </div>
                    <!-- Subtle Depth Layer -->
                    <div
                        class="absolute -bottom-6 -right-6 w-32 h-32 bg-secondary-container/10 -z-10 rounded-full blur-3xl"
                    >
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
