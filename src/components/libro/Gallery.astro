---
import { Image } from "astro:assets";
import openBook from "@assets/images/book/OpenBook.webp";
import gente from "@assets/images/book/Gente.webp";
---

<div class="max-w-7xl mx-auto px-4 lg:px-8 my-8">
  <div
    class="h-px w-full bg-gradient-to-r from-transparent via-border-light to-transparent"
  >
  </div>
</div>
<section class="py-16 bg-surface-dark transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2
        class="font-display text-3xl lg:text-4xl font-bold text-text-light mb-4"
      >
        Una mirada al interior
      </h2>
      <p class="text-text-light max-w-2xl mx-auto font-serif">
        Descubre fotografías inéditas, anécdotas de la agrupación y el legado
        cultural que hemos construido juntos.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[300px]">
      <div
        class="md:col-span-2 row-span-2 group relative rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300"
      >
        <Image
          alt="Libro abierto"
          class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
          src={openBook}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-90"
        >
        </div>
        <div class="absolute bottom-0 left-0 p-8">
          <span
            class="text-primary text-sm font-bold uppercase tracking-wider mb-2 block"
          >
            Capítulo 1
          </span>
          <h3 class="text-text-light font-display text-2xl font-bold">
            Los Inicios de la Sinfónica
          </h3>
        </div>
      </div>
      <div
        class="group relative rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 bg-background-dark flex items-center justify-center p-8"
      >
        <div class="text-center">
          <h4 class="font-display text-5xl text-primary font-bold mb-2">
            300+
          </h4>
          <p class="text-text-light font-medium">Páginas de Contenido</p>
        </div>
      </div>
      <div
        class="group relative rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300"
      >
        <Image
          alt="Detalle de partituras antiguas"
          class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
          src={gente}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-300"
        >
        </div>
        <div class="absolute bottom-4 left-4"></div>
      </div>
    </div>
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 lg:px-8 my-8">
  <div
    class="h-px w-full bg-gradient-to-r from-transparent via-border-light to-transparent"
  >
  </div>
</div>
