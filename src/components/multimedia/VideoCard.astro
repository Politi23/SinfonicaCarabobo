---
interface Props {
  title: string;
  excerpt?: string;
  thumbnail: string;
  youtubeId: string | null;
  youtubeUrl: string;
  category?: string;
  date?: string;
}

const { title, excerpt, thumbnail, youtubeId, youtubeUrl, category } = Astro.props;
---

<article
  class="group flex gap-5 bg-white border border-gray-100 hover:border-primary/30 hover:shadow-md transition-all duration-300 cursor-pointer overflow-hidden rounded-sm"
  data-youtube-id={youtubeId}
  data-youtube-url={youtubeUrl}
  data-title={title}
  data-excerpt={excerpt || ""}
>
  <!-- Thumbnail -->
  <div class="relative shrink-0 w-56 sm:w-64 md:w-72 aspect-video overflow-hidden bg-gray-900">
    {thumbnail ? (
      <img
        src={thumbnail}
        alt={title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gray-800">
        <i class="ph ph-video text-gray-600 text-3xl"></i>
      </div>
    )}
    <div class="absolute inset-0 bg-black/25 group-hover:bg-black/40 transition-colors duration-300"></div>
    <!-- Botón play -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-12 h-12 rounded-full bg-primary/90 group-hover:bg-primary flex items-center justify-center shadow-lg group-hover:scale-110 transition-all duration-300">
        <i class="ph ph-play text-white text-xl ml-0.5"></i>
      </div>
    </div>
  </div>

  <!-- Info -->
  <div class="flex flex-col justify-center py-4 pr-5 gap-2 min-w-0">
    {category && (
      <span class="text-primary text-xs font-bold uppercase tracking-widest">{category}</span>
    )}
    <h3 class="text-gray-900 font-serif font-bold text-lg leading-snug line-clamp-2 group-hover:text-primary transition-colors">
      {title}
    </h3>
    {excerpt && (
      <p class="text-gray-500 text-sm leading-relaxed line-clamp-3">{excerpt}</p>
    )}
    <span class="mt-1 inline-flex items-center gap-1 text-primary text-xs font-bold uppercase tracking-wider">
      <i class="ph ph-play-circle text-base"></i> Ver video
    </span>
  </div>
</article>
