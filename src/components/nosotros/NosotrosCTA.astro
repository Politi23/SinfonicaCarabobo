---
import SecondaryButton from "../ui/SecondaryButton.astro";
import PrimaryButton from "../ui/PrimaryButton.astro";
---

<!-- CTAS -->
<section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6 max-w-5xl">
        <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-white border border-gray-200 rounded-xl p-8 md:p-10">
                <h3
                    class="text-2xl font-display font-bold mb-4 text-gray-900 uppercase tracking-tight"
                >
                    Únete
                </h3>
                <div class="w-16 h-1 bg-secondary mb-6"></div>
                <p class="text-gray-700 mb-8 leading-relaxed">
                    Ya sea como patrocinante corporativo, benefactor o
                    estudiante, tu presencia es vital para nuestra misión. Todo
                    apoyo es invaluable.
                </p>
                <SecondaryButton href="/contacto" fullWidth
                    >Contactanos</SecondaryButton
                >
            </div>
            <div class="bg-white border border-gray-200 rounded-xl p-8 md:p-10">
                <h3
                    class="text-2xl font-display font-bold mb-4 text-gray-900 uppercase tracking-tight"
                >
                    Academia
                </h3>
                <div class="w-16 h-1 bg-primary mb-6"></div>
                <p class="text-gray-700 mb-8 leading-relaxed">
                    Explora las oportunidades académicas y conviértete en parte
                    de la nueva generación de músicos de élite de nuestro país.
                </p>
                <PrimaryButton href="/academia" fullWidth
                    >Programas Académicos</PrimaryButton
                >
            </div>
        </div>
    </div>
</section>
