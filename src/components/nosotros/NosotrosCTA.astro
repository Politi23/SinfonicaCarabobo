<!-- CTAS: BOLD BLOCKS -->
<section class="py-32 bg-gray-100">
    <div class="container mx-auto px-6 max-w-5xl">
        <div
            class="grid md:grid-cols-2 gap-1 border-4 border-black bg-black shadow-2xl"
        >
            <div class="bg-white p-8 md:p-12">
                <h3
                    class="text-3xl font-display font-bold mb-6 text-black uppercase tracking-tight italic border-b-4 border-secondary pb-2 inline-block"
                >
                    Únete
                </h3>
                <p class="text-gray-500 mb-10 font-light leading-relaxed">
                    Ya sea como patrocinante corporativo, benefactor o
                    estudiante, tu presencia es vital para nuestra misión.
                </p>
                <a
                    href="/contacto"
                    class="block w-auto mx-auto md:w-full py-5 bg-secondary text-white text-center text-xs font-bold uppercase tracking-[0.4em] hover:bg-black transition-colors"
                >
                    Contacto Directo
                </a>
            </div>
            <div class="bg-white p-8 md:p-12">
                <h3
                    class="text-3xl font-display font-bold mb-6 text-black uppercase tracking-tight italic border-b-4 border-primary pb-2 inline-block"
                >
                    Academia
                </h3>
                <p class="text-gray-500 mb-10 font-light leading-relaxed">
                    Explora las oportunidades académicas y conviértete en parte
                    de la nueva generación de músicos de élite.
                </p>
                <a
                    href="/academia"
                    class="block w-auto mx-auto md:w-full py-5 bg-black text-white text-center text-xs font-bold uppercase tracking-[0.4em] hover:bg-secondary transition-colors"
                >
                    Programas Académicos
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .shadow-2xl {
        box-shadow: 20px 20px 0px rgba(0, 0, 0, 0.1);
    }
</style>
