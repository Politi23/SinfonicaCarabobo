---

---

<!-- FORMATION & PRODUCTION -->
<section class="py-16 md:py-24 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="max-w-4xl mx-auto mb-12">
            <span
                class="text-secondary text-xs font-bold tracking-[0.4em] uppercase mb-4 block italic"
                >Modelo Integral</span
            >
            <h2
                class="text-3xl md:text-5xl font-display font-bold text-gray-900 leading-tight"
            >
                Formación y <br /><span class="text-secondary italic"
                    >Excelencia</span
                >
            </h2>
            <div class="mt-6 border-l-4 border-secondary pl-6">
                <p class="text-gray-700 leading-relaxed italic">
                    Nuestra estructura garantiza que el talento joven se
                    encuentre con la experiencia profesional en un ciclo de
                    aprendizaje continuo.
                </p>
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <!-- Academy Card -->
            <div
                class="bg-white border border-gray-200 rounded-xl shadow-lg p-8"
            >
                <div class="mb-6">
                    <h3
                        class="text-2xl font-display font-bold text-gray-900 uppercase tracking-tight"
                    >
                        Academia
                    </h3>
                    <div class="w-16 h-1 bg-primary mt-2"></div>
                </div>
                <p
                    class="text-gray-700 font-medium mb-6 italic leading-relaxed"
                >
                    Programa de Formación Musical <br />
                    <span class="text-secondary">"Maestro José Calabrese"</span>
                </p>
                <ul class="space-y-4">
                    {
                        [
                            {
                                title: "Becas Directas",
                                desc: "Más de 80 niños y jóvenes beneficiados",
                            },
                            {
                                title: "Dotación",
                                desc: "Asignación de instrumentos para iniciación",
                            },
                            {
                                title: "Inclusión",
                                desc: "Programas especializados para Síndrome de Down",
                            },
                            {
                                title: "Acreditación",
                                desc: "Aval internacional de la UNESCO",
                            },
                        ].map((item) => (
                            <li class="flex items-start gap-3">
                                <div class="w-2 h-2 mt-1.5 bg-primary shrink-0 rounded-full" />
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-0.5">
                                        {item.title}
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        {item.desc}
                                    </p>
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Production Card -->
            <div
                class="bg-white border border-gray-200 rounded-xl shadow-lg p-8"
            >
                <div class="mb-6">
                    <h3
                        class="text-2xl font-display font-bold text-gray-900 uppercase tracking-tight"
                    >
                        Producción
                    </h3>
                    <div class="w-16 h-1 bg-secondary mt-2"></div>
                </div>
                <p
                    class="text-gray-700 font-medium mb-6 italic leading-relaxed"
                >
                    Eventos de impacto <br /><span class="text-gray-900">
                        masivo y profesional</span
                    >
                </p>
                <ul class="space-y-4">
                    {
                        [
                            {
                                title: "Historial",
                                desc: "Más de 2.400 músicos formados en 49 años",
                            },
                            {
                                title: "Afluencia",
                                desc: "1.500 personas por concierto en promedio",
                            },
                            {
                                title: "Repertorio",
                                desc: "Galas sinfónicas y eventos de alto nivel",
                            },
                            {
                                title: "Continuidad",
                                desc: "Múltiples eventos temáticos anuales",
                            },
                        ].map((item) => (
                            <li class="flex items-start gap-3">
                                <div class="w-2 h-2 mt-1.5 bg-secondary shrink-0 rounded-full" />
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-gray-900 mb-0.5">
                                        {item.title}
                                    </p>
                                    <p class="text-sm text-gray-600">
                                        {item.desc}
                                    </p>
                                </div>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</section>
