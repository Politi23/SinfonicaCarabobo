---
import oscTtc from "@assets/images/organizacion/OSC en TTC.webp";
import SecondaryButton from "../ui/SecondaryButton.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
---

<!-- HISTORY SECTION: TIMELINE -->
<section class="py-16 md:py-24 bg-gray-50">
    <div class="container mx-auto px-6 max-w-6xl relative">
        <div class="max-w-4xl mx-auto">
            <SectionTitle
                variant="red"
                class="text-3xl md:text-5xl font-display font-bold text-gray-900 leading-tight"
                wrapperClass="text-left"
                dividerClass="h-1 w-16 mt-2"
            >
                Historia <span class="text-secondary"
                    >y Prestigio</span
                >
            </SectionTitle>
        </div>

        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto pt-8">
            <div class="bg-white p-8 rounded shadow-md">
                <span
                    class="text-primary font-display text-3xl mb-4 block font-bold"
                    >1976</span
                >
                <SectionTitle dividerClass="h-1 w-16 mb-4" wrapperClass="" variant="red" />
                <h3
                    class="text-xl font-bold uppercase tracking-tight mb-3 text-gray-900"
                >
                    Fundación
                </h3>
                <p class="text-gray-700 leading-relaxed">
                    Nacemos en octubre de 1976 para convertirnos en el eje
                    fundamental de la cultura carabobeña, iniciando un camino de
                    excelencia ininterrumpida.
                </p>
            </div>
            <div class="bg-white p-8 rounded shadow-md">
                <span
                    class="text-primary font-display text-3xl mb-4 block font-bold"
                    >1998</span
                >
                <SectionTitle dividerClass="h-1 w-16 mb-4" wrapperClass="" variant="red" />
                <h3
                    class="text-xl font-bold uppercase tracking-tight mb-3 text-gray-900"
                >
                    Hito Universal
                </h3>
                <p class="text-gray-700 leading-relaxed">
                    Acompañamos al legendario tenor Luciano Pavarotti en su
                    única presentación en Venezuela, consolidando nuestra
                    calidad interpretativa a nivel mundial.
                </p>
            </div>
            <div class="bg-white p-8 rounded shadow-md">
                <span
                    class="text-primary font-display text-3xl mb-4 block font-bold"
                    >2021</span
                >
                <SectionTitle dividerClass="h-1 w-16 mb-4" wrapperClass="" variant="red" />
                <h3
                    class="text-xl font-bold uppercase tracking-tight mb-3 text-gray-900"
                >
                    UNESCO
                </h3>
                <p class="text-gray-700 leading-relaxed">
                    Fuimos reconocidos por la UNESCO como "Embajadores de la
                    Paz", un honor que ratifica nuestra labor social y
                    compromiso con la humanidad.
                </p>
            </div>
            <div
                class="bg-gray-50 rounded border border-gray-200 overflow-hidden relative shadow-md"
            >
                <img
                    src={oscTtc.src}
                    alt="Orquesta Sinfónica de Carabobo en TTC"
                    class="w-full h-auto object-cover"
                />
            </div>
        </div>
    </div>

    <!-- Leer Historia Completa Button -->
    <div class="text-center mt-12">
        <SecondaryButton href="/nosotros/historia">
            Leer historia completa
        </SecondaryButton>
    </div>
</section>
