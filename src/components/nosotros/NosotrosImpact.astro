---
import orchestra1 from "@assets/images/orchestra/orchestra1.webp";
---

<!-- IMPACT: CIFRAS -->
<section class="py-16 md:py-24 bg-gray-50 relative overflow-hidden">
    <div
        class="absolute inset-0 opacity-5 bg-cover bg-center"
        style={`background-image: url('${orchestra1.src}');`}
    >
    </div>
    <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div class="text-center mb-12">
            <span
                class="text-primary text-xs font-bold tracking-[0.4em] uppercase mb-4 block italic"
            >
                Impacto Social</span
            >
            <h2
                class="text-3xl md:text-5xl font-display font-bold text-gray-900 leading-tight"
            >
                Nuestras <span class="text-primary italic">Cifras</span>
            </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
            <div class="bg-white p-6 md:p-8 rounded text-center">
                <div
                    class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
                >
                    49
                </div>
                <p
                    class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
                >
                    Años de Trayectoria
                </p>
            </div>
            <div class="bg-white p-6 md:p-8 rounded text-center">
                <div
                    class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
                >
                    2.4K
                </div>
                <p
                    class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
                >
                    Músicos Formados
                </p>
            </div>
            <div class="bg-white p-6 md:p-8 rounded text-center">
                <div
                    class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
                >
                    1.5K
                </div>
                <p
                    class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
                >
                    Personas por Conciertos
                </p>
            </div>
            <div class="bg-white p-6 md:p-8 rounded text-center">
                <div
                    class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
                >
                    17K
                </div>
                <p
                    class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
                >
                    Alcance Digital
                </p>
            </div>
        </div>
    </div>
</section>
