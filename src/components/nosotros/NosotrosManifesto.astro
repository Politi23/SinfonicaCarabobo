---
import orchestra1 from "@assets/images/orchestra/orchestra1.webp";
---

<!-- INTRO SECTION: MANIFESTO -->
<section
    class="py-16 md:py-24 relative overflow-hidden border-b border-gray-100"
>
    <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div class="max-w-4xl mx-auto">
            <span
                class="text-secondary text-xs font-bold tracking-[0.4em] uppercase mb-6 block italic"
                >Manifiesto</span
            >
            <h2
                class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-10 leading-tight"
            >
                Una institución <br /><span class="text-secondary italic"
                    >cultural integral</span
                >
            </h2>
            <div
                class="relative bg-white p-8 md:p-12 border border-gray-200 rounded overflow-hidden"
            >
                <div
                    class="absolute inset-0 z-0 opacity-10 bg-cover bg-center"
                    style={`background-image: url('${orchestra1.src}');`}
                >
                </div>
                <div class="relative z-10">
                    <p
                        class="text-lg md:text-2xl text-gray-700 leading-relaxed font-serif italic"
                    >
                        "Desde hace 49 años, hemos unido en un mismo propósito
                        la formación académica, la producción artística de alto
                        nivel y el compromiso social inquebrantable."
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
