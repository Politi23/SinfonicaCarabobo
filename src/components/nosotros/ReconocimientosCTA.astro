---
import sinfonica from "@assets/images/orchestra/sinfonica.webp";
import SecondaryButton from "../ui/SecondaryButton.astro";
import PrimaryButton from "../ui/PrimaryButton.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
---

<!-- Final CTA section -->
<section class="py-16 md:py-24 bg-black text-white relative">
    <div
        class="absolute inset-0 opacity-10 bg-cover bg-fixed bg-center filter grayscale contrast-150"
        style={`background-image: url('${sinfonica.src}');`}
    >
    </div>

    <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
        <SectionTitle
            variant="red"
            class="text-3xl md:text-5xl font-display font-bold leading-tight text-white italic"
            wrapperClass="text-center"
            dividerClass="h-1 w-16 mx-auto mb-8"
        >
            ¡Sé parte de nuestra Melodía!
        </SectionTitle>
        <p
            class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto font-light leading-relaxed italic"
        >
            Nuestra historia se escribe junto al apoyo de quienes creen en el
            poder transformador de la música.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <SecondaryButton href="/apoyanos/donaciones">
                Donaciones
            </SecondaryButton>
            <PrimaryButton href="/academia"> Academia </PrimaryButton>
        </div>
    </div>
</section>
