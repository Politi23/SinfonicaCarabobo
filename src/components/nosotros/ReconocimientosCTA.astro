---
import sinfonica from "@assets/images/orchestra/sinfonica.webp";
---

<!-- Final CTA section (Structured) -->
<section class="py-40 bg-black text-white relative">
    <div
        class="absolute inset-0 opacity-10 bg-cover bg-fixed bg-center filter grayscale contrast-150"
        style={`background-image: url('${sinfonica.src}');`}
    >
    </div>

    <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
        <h2
            class="text-3xl md:text-5xl font-display font-bold mb-12 leading-tight"
        >
            Únase al <br />
            <span class="font-bold text-secondary italic">Movimiento</span>
        </h2>
        <div class="w-16 h-1 bg-secondary mx-auto mb-16"></div>
        <p
            class="text-xl text-gray-700 mb-20 max-w-2xl mx-auto font-light leading-relaxed"
        >
            Nuestra historia se escribe con el apoyo de quienes creen en el
            poder transformador de la música.
        </p>

        <div class="flex flex-col sm:flex-row gap-0 justify-center">
            <a
                href="/apoyanos/empresarial"
                class="px-8 md:px-16 py-6 bg-secondary text-white font-bold text-[11px] uppercase tracking-[0.4em] transition-all hover:bg-black border border-secondary hover:border-black active:scale-95"
            >
                Alianza Empresarial
            </a>
            <a
                href="/academia"
                class="px-8 md:px-16 py-6 bg-black text-white font-bold text-[11px] uppercase tracking-[0.4em] transition-all hover:bg-secondary border border-black hover:border-secondary active:scale-95"
            >
                Academia
            </a>
        </div>
    </div>
</section>
