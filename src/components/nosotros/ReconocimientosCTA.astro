---
import sinfonica from "@assets/images/orchestra/sinfonica.webp";
import SecondaryButton from "../ui/SecondaryButton.astro";
import PrimaryButton from "../ui/PrimaryButton.astro";
---

<!-- Final CTA section -->
<section class="py-16 md:py-24 bg-black text-white relative">
    <div
        class="absolute inset-0 opacity-10 bg-cover bg-fixed bg-center filter grayscale contrast-150"
        style={`background-image: url('${sinfonica.src}');`}
    >
    </div>

    <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center">
        <h2
            class="text-3xl md:text-5xl font-display font-bold mb-8 leading-tight text-white"
        >
            Únase al <br />
            <span class="font-bold text-secondary italic">Movimiento</span>
        </h2>
        <div class="w-16 h-1 bg-secondary mx-auto mb-8"></div>
        <p
            class="text-xl text-gray-300 mb-12 max-w-2xl mx-auto font-light leading-relaxed"
        >
            Nuestra historia se escribe con el apoyo de quienes creen en el
            poder transformador de la música.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <SecondaryButton href="/apoyanos/empresarial">
                Alianza Empresarial
            </SecondaryButton>
            <PrimaryButton href="/academia"> Academia </PrimaryButton>
        </div>
    </div>
</section>
