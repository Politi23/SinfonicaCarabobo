<!-- Intro Section with sober aesthetic -->
<section class="py-32 relative overflow-hidden bg-white">
    <div class="container mx-auto px-6 max-w-5xl relative z-10">
        <div class="max-w-3xl">
            <span
                class="text-secondary text-xs font-bold uppercase tracking-[0.4em] mb-6 block italic"
                >Trayectoria Institucional</span
            >
            <h2
                class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-12 leading-tight"
            >
                Un Legado <br />
                <span class="font-bold text-secondary italic"
                    >Incontestable.</span
                >
            </h2>
            <div class="border-l-[6px] border-secondary pl-10 py-2">
                <p
                    class="text-2xl text-gray-700 leading-relaxed font-serif italic mb-4"
                >
                    "La Orquesta Sinfónica de Carabobo es custodia del
                    patrimonio musical del estado."
                </p>
                <p class="text-gray-600 font-light leading-relaxed max-w-2xl">
                    A lo largo de cinco décadas, nuestra institución ha sido
                    honrada con múltiples distinciones que avalan su impacto en
                    la cultura, la educación y el tejido social de Venezuela.
                    Cada reconocimiento es un compromiso renovado con la
                    excelencia.
                </p>
            </div>
        </div>
    </div>
</section>
