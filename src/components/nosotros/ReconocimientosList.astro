---
const { institutionalRecognitions } = Astro.props;
---

<!-- Timeline / List section (Minimalist) -->
<section class="py-32 bg-white">
    <div class="container mx-auto px-6 max-w-6xl">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between mb-24 gap-8 px-4"
        >
            <div class="max-w-2xl">
                <h3
                    class="text-5xl font-display font-bold text-black uppercase tracking-tight"
                >
                    Menciones y <br /><span class="text-secondary italic"
                        >Distinciones</span
                    >
                </h3>
            </div>
            <div class="h-px flex-grow bg-gray-100 mb-4 hidden md:block"></div>
            <span
                class="text-gray-400 text-[10px] font-bold uppercase tracking-[0.5em] mb-4"
                >Registro Histórico</span
            >
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0">
            {
                institutionalRecognitions.map((item: any) => (
                    <div class="group flex items-baseline gap-6 py-6 border-b border-gray-100 hover:border-secondary transition-all duration-300">
                        <span class="text-sm font-bold text-secondary uppercase tracking-widest min-w-[60px]">
                            {item.year}
                        </span>
                        <p class="text-[15px] text-gray-700 font-medium leading-[1.6] group-hover:text-black transition-colors">
                            {item.event}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
