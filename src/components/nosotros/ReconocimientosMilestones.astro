---
import orchestra1 from "@assets/images/orchestra/orchestra1.webp";
import orchestra2 from "@assets/images/galeria/academia/coro6.webp";
---

<!-- Milestones Grid with sharp edges -->
<section class="py-16 md:py-24">
    <div class="container mx-auto px-6 max-w-7xl">
        <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-stretch">
            <!-- Pavarotti Section -->
            <div
                class="group relative overflow-hidden bg-black text-white w-full min-h-[600px] lg:min-h-[700px] flex flex-col justify-end p-8 md:p-14 lg:p-20"
            >
                <!-- Background Image & Gradient -->
                <div
                    class="absolute inset-0 z-0 opacity-40 bg-cover bg-center grayscale filter contrast-125 transition-transform duration-1000 group-hover:scale-105"
                    style={`background-image: url('${orchestra1.src}');`}
                >
                </div>
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent z-10"
                >
                </div>

                <!-- Content -->
                <div class="relative z-20 mt-auto flex flex-col gap-6">
                    <h3
                        class="text-4xl md:text-5xl lg:text-5xl font-display font-bold uppercase tracking-wider leading-tight"
                    >
                        <span class="block text-primary mb-2">Pavarotti</span>
                        <span class="block text-white">en Valencia</span>
                    </h3>

                    <p
                        class="text-gray-300 leading-relaxed text-base md:text-lg font-light max-w-md mt-4"
                    >
                        Seleccionados como la orquesta acompañante oficial para
                        el concierto único del tenor Luciano Pavarotti en
                        Venezuela.
                    </p>
                </div>
            </div>

            <!-- UNESCO Section -->
            <div
                class="group relative overflow-hidden bg-secondary text-white w-full min-h-[600px] lg:min-h-[700px] flex flex-col justify-end p-8 md:p-14 lg:p-20"
            >
                <!-- Background Image & Gradient -->
                <div
                    class="absolute inset-0 z-0 opacity-90 bg-cover bg-center mix-blend-overlay transition-transform duration-1000 group-hover:scale-105"
                    style={`background-image: url('${orchestra2.src}');`}
                >
                </div>
                <div
                    class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/80 to-transparent z-10"
                >
                </div>

                <!-- Content -->
                <div class="relative z-20 mt-auto flex flex-col gap-6">
                    <h3
                        class="text-4xl md:text-5xl lg:text-5xl font-display font-bold uppercase tracking-wider leading-tight"
                    >
                        <span class="block text-white mb-2">UNESCO</span>
                        <span class="block text-primary">Paz y Cultura</span>
                    </h3>

                    <p
                        class="text-white/90 leading-relaxed text-base md:text-lg font-light max-w-md mt-4"
                    >
                        Designación como Embajadores de la Paz por nuestra
                        contribución ininterrumpida al desarrollo cultural
                        latinoamericano.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
