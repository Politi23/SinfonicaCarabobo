---

---

<!-- Milestones Grid with sharp edges -->
<section class="py-24 bg-gray-50">
    <div class="container mx-auto px-6 max-w-7xl">
        <div class="grid md:grid-cols-2 gap-8 items-stretch">
            <!-- Pavarotti Section -->
            <div
                class="group relative overflow-hidden bg-black text-white h-full min-h-[500px] flex flex-col border border-black hover:border-secondary transition-colors duration-500"
            >
                <div
                    class="absolute inset-0 z-0 opacity-40 bg-[url('/orchestra1.webp')] bg-cover bg-center grayscale filter contrast-125"
                >
                </div>
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent z-1"
                >
                </div>

                <div class="relative z-10 p-12 mt-auto">
                    <div
                        class="inline-block px-4 py-2 border border-primary text-primary text-[10px] font-bold uppercase tracking-[0.3em] mb-8"
                    >
                        Hito Histórico — 1998
                    </div>
                    <h3
                        class="text-5xl font-display font-bold mb-6 uppercase tracking-wider"
                    >
                        Pavarotti <br />
                        <span class="text-primary">en Valencia</span>
                    </h3>
                    <p
                        class="text-gray-400 leading-relaxed text-lg font-light max-w-md"
                    >
                        Seleccionados como la orquesta acompañante oficial para
                        el concierto único del tenor Luciano Pavarotti en
                        Venezuela.
                    </p>
                </div>
            </div>

            <!-- UNESCO Section -->
            <div
                class="group relative overflow-hidden bg-secondary text-white h-full min-h-[500px] flex flex-col border border-secondary transition-all duration-500"
            >
                <div
                    class="absolute inset-0 z-0 opacity-10 bg-[url('/image-grid.webp')] bg-cover bg-center mix-blend-overlay"
                >
                </div>
                <div class="relative z-10 p-12 mt-auto">
                    <div
                        class="inline-block px-4 py-2 border border-white/30 text-white text-[10px] font-bold uppercase tracking-[0.3em] mb-8"
                    >
                        Aval Continental
                    </div>
                    <h3
                        class="text-5xl font-display font-bold mb-6 uppercase tracking-wider"
                    >
                        UNESCO <br />
                        <span class="text-white/60">Paz y Cultura</span>
                    </h3>
                    <p
                        class="text-white/80 leading-relaxed text-lg font-light max-w-md"
                    >
                        Designación como Embajadores de la Paz por nuestra
                        contribución ininterrumpida al desarrollo cultural
                        latinoamericano.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
