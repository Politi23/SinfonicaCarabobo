---
import academiaImg from "@assets/images/organizacion/academia.webp";
import PrimaryButton from "@components/ui/PrimaryButton.astro";
---

<!-- Academia Maestro José Calabrese -->
<section class="py-20 bg-white">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <span
          class="text-secondary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
          >PROGRAMA EDUCATIVO</span
        >
        <h2
          class="text-4xl md:text-5xl font-display font-bold text-text-dark mb-6"
        >
          Academia Internacional de Música Maestro José Calabrese
        </h2>
        <p class="text-gray-600 text-lg mb-6 leading-relaxed">
          Desde 2019, formamos a más de 500 estudiantes, incluyendo niños con
          Síndrome de Down, con el aval de la UNESCO. Una verdadera escuela de
          vida.
        </p>
        <ul class="space-y-4 mb-8">
          <li class="flex items-start">
            <span class="text-secondary mr-3 mt-1">●</span>
            <span class="text-gray-600"
              >Formación musical integral para niños y jóvenes</span
            >
          </li>
          <li class="flex items-start">
            <span class="text-secondary mr-3 mt-1">●</span>
            <span class="text-gray-600"
              >Inclusión de estudiantes con capacidades especiales</span
            >
          </li>
          <li class="flex items-start">
            <span class="text-secondary mr-3 mt-1">●</span>
            <span class="text-gray-600">Certificación avalada por UNESCO</span>
          </li>
          <li class="flex items-start">
            <span class="text-secondary mr-3 mt-1">●</span>
            <span class="text-gray-600">Más de 500 estudiantes impactados</span>
          </li>
        </ul>
        <PrimaryButton
          variant="solid"
          href="http://www.academiajosecalabrese.com"
        >
          Visitar Sitio Oficial
        </PrimaryButton>
      </div>
      <div class="relative">
        <img
          src={academiaImg.src}
          alt="Estudiantes de la Academia Internacional de Música Maestro José Calabrese"
          class="w-full h-96 object-cover rounded shadow-xl"
          width={academiaImg.width}
          height={academiaImg.height}
        />
      </div>
    </div>
  </div>
</section>
