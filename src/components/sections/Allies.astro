---
import { Image } from "astro:assets";
import allyHesperia from "@assets/images/allies/ally-hesperia.webp";
import allyUjap from "@assets/images/allies/ally-ujap.webp";
import allyMultimax from "@assets/images/allies/ally-multimax.webp";
import allyClxSamsung from "@assets/images/allies/ally-clxsamsung.webp";
import allyAlcaldia from "@assets/images/allies/ally-alcaldia-sandiego.webp";
import allyScgc from "@assets/images/allies/ally-scgc.webp";
---

<!-- ALIADOS / CARRUSEL -->
<section class="py-24 bg-background-light overflow-hidden">
  <div class="container mx-auto px-6 mb-12 text-center">
    <span class="text-text-muted text-sm font-bold tracking-[0.2em] uppercase"
      >Confían en Nosotros</span
    >
  </div>

  <!-- Carousel Wrapper -->
  <div class="relative w-full overflow-hidden">
    <div
      class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-background-light to-transparent z-10"
    >
    </div>
    <div
      class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-background-light to-transparent z-10"
    >
    </div>

    <div class="flex items-center gap-16 animate-infinite-scroll">
      <!-- First set of logos -->
      <div class="logo-container">
        <Image
          src={allyHesperia}
          alt="HesperiaWTC"
          class="logo-image"
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="logo-container">
        <Image
          src={allyUjap}
          alt="UJAP"
          class="logo-image"
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="logo-container">
        <Image
          src={allyMultimax}
          alt="Multimax"
          class="logo-image"
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="logo-container">
        <Image
          src={allyClxSamsung}
          alt="CLXSamsung"
          class="logo-image"
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="logo-container">
        <img
          src={allyAlcaldia.src}
          alt="Alcaldía de San Diego"
          class="logo-image"
          width={allyAlcaldia.width}
          height={allyAlcaldia.height}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="logo-container">
        <Image
          src={allyScgc}
          alt="Secretaría de Cultura Gobernación de Carabobo"
          class="logo-image"
          width="112"
          height="112"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Second set for seamless infinite scroll -->
      <div class="logo-container">
        <Image
          src={allyHesperia}
          alt="HesperiaWTC"
          class="logo-image"
          width="112"
