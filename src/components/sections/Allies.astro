<style>
  @keyframes infinite-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-75%);
    }
  }

  .logo-container {
    @apply flex-shrink-0 w-20 h-20 md:w-28 md:h-28 flex items-center justify-center;
  }

  .logo-image {
    @apply max-h-full max-w-full object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100;
  }

  .animate-infinite-scroll {
    /* Mobile Version */
    animation: infinite-scroll 15s linear infinite;
  }

  @media (min-width: 768px) {
    .animate-infinite-scroll {
      /* Desktop Version */
      animation: infinite-scroll 40s linear infinite;
    }
  }
</style>
