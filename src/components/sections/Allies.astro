---
import { Picture } from "astro:assets";
import allyHesperia from "@assets/images/allies/ally-hesperia.webp";
import allyUjap from "@assets/images/allies/ally-ujap.webp";
import allyMultimax from "@assets/images/allies/ally-multimax.webp";
import allyClxSamsung from "@assets/images/allies/ally-clxsamsung.webp";
import allyAlcaldia from "@assets/images/allies/ally-alcaldia-sandiego.webp";
import allyScgc from "@assets/images/allies/ally-scgc.webp";
import allyUnesco from "@assets/images/allies/ally-unesco.webp";
import { addIssueToContext } from "astro:schema";

const allies = [
  { src: allyUjap, alt: "UJAP" },
  { src: allyHesperia, alt: "HesperiaWTC" },
  {
    src: allyMultimax,
    alt: "Multimax",
    class: "max-w-[10rem]",
  },
  { src: allyClxSamsung, alt: "CLXSamsung", class: "max-w-[10rem]" },
  { src: allyAlcaldia, alt: "Alcaldía de San Diego" },
  { src: allyUnesco, alt: "Unesco" },
  { src: allyScgc, alt: "Secretaría de Cultura Gobernación de Carabobo" },
];
---

<section class="py-12 md:py-24 bg-background-light overflow-hidden">
  <div class="container mx-auto px-6 mb-12 text-center">
    <span class="text-zinc-500 text-sm font-bold tracking-[0.2em] uppercase">
      Confían en Nosotros
    </span>
  </div>

  <div class="container mx-auto px-6">
    <div class="flex flex-wrap items-center justify-center gap-10 md:gap-16">
      {
        allies.map((ally) => (
          <div
            class={`flex items-center justify-center transition-transform duration-300 hover:scale-110 ${ally.class || "w-24 md:w-32"}`}
          >
            <Picture
              src={ally.src}
              alt={ally.alt}
              width={250}
              height={150}
              class="w-full h-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
              formats={["webp"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
