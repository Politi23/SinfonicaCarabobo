---
import { Picture } from "astro:assets";
import allyHesperia from "@assets/images/allies/ally-hesperia.webp";
import allyUjap from "@assets/images/allies/ally-ujap.webp";
import allyMultimax from "@assets/images/allies/ally-multimax.webp";
import allyClxSamsung from "@assets/images/allies/ally-clxsamsung.webp";
import allyAlcaldia from "@assets/images/allies/ally-alcaldia-sandiego.webp";
import allyScgc from "@assets/images/allies/ally-scgc.webp";
import allyUnesco from "@assets/images/allies/ally-unesco.webp";

const allies = [
  { src: allyUjap, alt: "UJAP" },
  { src: allyHesperia, alt: "HesperiaWTC" },
  { src: allyMultimax, alt: "Multimax" },
  { src: allyClxSamsung, alt: "CLXSamsung" },
  { src: allyAlcaldia, alt: "Alcaldía de San Diego" },
  { src: allyUnesco, alt: "Unesco" },
  { src: allyScgc, alt: "Secretaría de Cultura Gobernación de Carabobo" },
];
---

<section class="py-12 md:py-16 bg-background-light overflow-hidden">
  <div class="container mx-auto px-6 mb-8 md:mb-10 text-center">
    <span class="text-zinc-700 text-sm font-bold tracking-[0.2em] uppercase">
      Confían en Nosotros
    </span>
  </div>

  <div class="w-full">
    <div
      class="w-full max-w-6xl mx-auto px-4 sm:px-4 lg:px-6 flex flex-wrap justify-center gap-6 sm:gap-8 md:gap-12"
    >
      {
        allies.map((ally) => (
          <div class="flex items-center justify-center">
            <Picture
              src={ally.src}
              alt={ally.alt}
              width="112"
              height="112"
              class="max-w-full max-h-full object-contain grayscale opacity-60 transition-all duration-300 hover:grayscale-0 hover:opacity-100"
              formats={["webp"]}
              fallbackFormat="webp"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
