---
const benefits = [
    {
        title: "Difusión de Marca",
        description:
            "Presencia destacada como patrocinante oficial en nuestras redes sociales y plataformas digitales.",
    },
    {
        title: "Puestos Preferenciales",
        description:
            "Acceso exclusivo a los mejores asientos en todos nuestros conciertos de la temporada.",
    },
    {
        title: "Activación de Stand",
        description:
            "Espacio para stands y activación de marca en la entrada de las salas de conciertos.",
    },
    {
        title: "Contenido Audiovisual",
        description:
            "Diseño y promoción de video tipo Reel informativo vinculando tu marca con la OSC.",
    },
    {
        title: "Reconocimiento en Vivo",
        description:
            "Mención especial de tu empresa como patrocinante durante el desarrollo de los conciertos.",
    },
    {
        title: "Vinculación Artística",
        description:
            "Realización de pendón de vinculación para difusión en conciertos y actividades artísticas.",
    },
];
---

<section id="empresas" class="py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-16">
            <span
                class="text-secondary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                >Alianzas Corporativas</span
            >
            <h2
                class="text-4xl md:text-5xl font-display font-bold text-gray-900 mb-6"
            >
                ¿Qué tenemos para tu Empresa?
            </h2>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto font-serif">
                Unirse a la Orquesta Sinfónica de Carabobo es vincular su marca
                con la excelencia, la cultura y el impacto social positivo.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
            {
                benefits.map((benefit) => (
                    <div class="group p-8 rounded-2xl bg-[#FDFBF7] border border-gray-100 hover:border-primary transition-all duration-300 hover:shadow-xl">
                        <div class="w-8 h-1 bg-primary mb-6 transform group-hover:w-16 transition-all duration-300" />
                        <h3 class="text-xl font-bold text-gray-900 mb-3">
                            {benefit.title}
                        </h3>
                        <p class="text-gray-600 leading-relaxed text-sm">
                            {benefit.description}
                        </p>
                    </div>
                ))
            }
        </div>

        <div
            class="bg-gray-900 rounded-3xl p-8 md:p-12 text-white relative overflow-hidden"
        >
            <div
                class="absolute top-0 right-0 w-64 h-64 bg-primary opacity-10 rounded-full -mr-32 -mt-32"
            >
            </div>

            <div
                class="relative z-10 flex flex-col md:flex-row items-center gap-12"
            >
                <div class="flex-1">
                    <h3
                        class="text-3xl font-display font-bold mb-6 text-primary"
                    >
                        Flexibilidad en tu Aporte
                    </h3>
                    <p class="text-gray-300 text-lg mb-6 leading-relaxed">
                        Los aportes pueden ser <span
                            class="text-white font-bold italic"
                            >únicos, mensuales, bimensuales o trimestrales</span
                        >. Cada contribución va dirigida directamente a cubrir
                        los gastos de nuestros músicos y artistas.
                    </p>
                    <p class="text-gray-400">
                        Aseguramos así el funcionamiento continuo de la Orquesta
                        durante todo el año, garantizando la excelencia en cada
                        nota.
                    </p>
                </div>

                <div class="flex-shrink-0">
                    <a
                        href="/#contacto"
                        class="inline-block bg-primary text-black px-10 py-4 rounded-full font-bold hover:bg-white transition-colors shadow-lg"
                    >
                        Quiero ser Aliado
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
