---
import sinfonica from "@assets/images/orchestra/OSC gala Puccini 2.webp";

interface Props {
    title: string;
    titleHighlight?: string;
    subtitle?: string;
    bgImage?: string;
}

const {
    title,
    titleHighlight,
    subtitle,
    bgImage = sinfonica.src,
} = Astro.props;
---

<section
    class="relative h-[30vh] flex items-center justify-center bg-gray-900 overflow-hidden"
>
    <div
        class="absolute inset-0 z-0 opacity-30 bg-cover bg-center"
        style={`background-image: url('${bgImage}');`}
    >
    </div>
    <div
        class="absolute inset-0 bg-gradient-to-b from-black/90 via-gray-black/60 to-zinc-500/50 z-0"
    >
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center flex-column">
        <!-- {
            subtitle && (
                <p class="text-2xl md:text-3xl italic text-zinc-300 font-display font-light">
                    "{subtitle}"
                </p>
            )
        } -->

        <h1
            class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white"
        >
            {title}
            {titleHighlight && <span>{titleHighlight}</span>}
        </h1>
    </div>
</section>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }
</style>
