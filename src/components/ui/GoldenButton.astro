---
interface Props {
    href: string;
    class?: string;
    [key: string]: any;
}

const { href, class: className, ...rest } = Astro.props;
---

<a
    href={href}
    class:list={[
        "inline-block px-8 py-3 border-2 border-primary text-primary font-bold bg-transparent hover:bg-primary hover:text-white transition-colors duration-300",
        className,
    ]}
    {...rest}
>
    <slot />
</a>
