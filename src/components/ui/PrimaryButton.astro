---
interface Props {
    href?: string;
    class?: string;
    fullWidth?: boolean;
    [key: string]: any;
}

const {
    href = "/academia",
    class: className,
    fullWidth = false,
    ...rest
} = Astro.props;
---

<a
    href={href}
    class:list={[
        fullWidth
            ? "block w-full py-4 bg-primary text-white text-center text-xs font-bold uppercase tracking-[0.3em] hover:bg-secondary transition-colors rounded-lg"
            : "inline-block px-8 py-4 bg-primary text-white text-center text-xs font-bold uppercase tracking-[0.3em] hover:bg-secondary transition-colors rounded-lg",
        className,
    ]}
    {...rest}
>
    <slot />
</a>
