---
interface Props {
    href?: string;
    class?: string;
    fullWidth?: boolean;
    variant?: "solid" | "outline";
    [key: string]: any;
}

const {
    href = "/nosotros/academia",
    class: className,
    fullWidth = false,
    variant = "solid",
    ...rest
} = Astro.props;
---

<a
    href={href}
    class:list={[
        fullWidth
            ? "block w-full py-4 text-center text-xs font-bold uppercase tracking-[0.2rem] transition-colors rounded"
            : "inline-block px-8 py-4 text-center text-xs font-bold uppercase tracking-[0.2rem] transition-colors rounded",
        variant === "outline"
            ? "border border-primary text-primary hover:bg-primary hover:text-white"
            : "bg-primary text-white hover:bg-primary-dark",
        className,
    ]}
    {...rest}
>
    <slot />
</a>
