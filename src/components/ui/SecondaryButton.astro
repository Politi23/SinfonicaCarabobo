---
interface Props {
    href?: string;
    class?: string;
    fullWidth?: boolean;
    variant?: "solid" | "outline";
    [key: string]: any;
}

const {
    href = "/contacto",
    class: className,
    fullWidth = false,
    variant = "solid",
    ...rest
} = Astro.props;
---

<a
    href={href}
    class:list={[
        fullWidth
            ? "block w-full py-4 text-center text-xs font-bold uppercase tracking-[0.3em] transition-colors rounded"
            : "inline-block px-8 py-4 text-center text-xs font-bold uppercase tracking-[0.3em] transition-colors rounded",
        variant === "outline"
            ? "border border-secondary text-secondary hover:bg-secondary-light hover:text-white"
            : "bg-secondary text-white hover:bg-secondary-light",
        className,
    ]}
    {...rest}
>
    <slot />
</a>
