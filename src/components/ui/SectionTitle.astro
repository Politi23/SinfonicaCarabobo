---
export interface Props {
  title?: string;
  variant?: "default" | "red";
  class?: string;
  wrapperClass?: string;
  dividerClass?: string;
}

const { title, class: titleClass = "" } = Astro.props;
const hasSlot = Astro.slots.has("default");
---

<h2
  class={`text-3xl md:text-[2.6rem] font-titles font-semibold text-gray-900 tracking-tight my-2 ${titleClass}`}
>
  {hasSlot ? <slot /> : title}
</h2>
