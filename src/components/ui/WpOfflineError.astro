---
interface Props {
    title?: string;
    message?: string;
    homeLink?: string;
    homeLinkText?: string;
}

const {
    title = "Error de Conexión",
    message = "No pudimos cargar el contenido. Por favor, inténtalo más tarde.",
    homeLink = "/",
    homeLinkText = "Volver al inicio",
} = Astro.props;
---

<div class="text-center py-16 px-6 bg-white rounded-lg border border-gray-200">
    <div class="w-16 h-16 mx-auto mb-6 bg-gray-100 rounded-full flex items-center justify-center">
        <svg
            class="w-8 h-8 text-gray-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"
            />
        </svg>
    </div>
    
    <h2 class="text-2xl font-bold text-gray-800 mb-3">
        {title}
    </h2>
    
    <p class="text-gray-600 mb-6 max-w-md mx-auto">
        {message}
    </p>
    
    <a
        href={homeLink}
        class="inline-block px-6 py-3 bg-secondary text-white font-bold text-sm uppercase tracking-wider hover:bg-primary-dark transition-colors rounded"
    >
        {homeLinkText}
    </a>
</div>
