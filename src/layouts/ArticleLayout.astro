---
import BaseLayout from "./BaseLayout.astro";
const { title } = Astro.props;
---

<BaseLayout title={`${title} · Sinfónica`} bodyClass="items-center">
  <slot name="head" slot="head" />
  <div class="layout-container flex h-full grow flex-col items-center w-full">
    <slot />
  </div>
</BaseLayout>
