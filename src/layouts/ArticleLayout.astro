---
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Sinfónica</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class="bg-background-light dark:bg-background-dark text-text-dark dark:text-text-secondary transition-colors duration-200 font-display antialiased">
    <Header active="blog" />

    <main class="layout-container flex h-full grow flex-col items-center">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>

  .article-content {

    @apply text-lg leading-relaxed;

  }



  /*

    ================================================================

    == ESTILOS PARA ENCABEZADOS (H1-H6)

    ================================================================

    - Elementos: <h1>, <h2>, <h3>, etc.

    - Estilos: Clases de Tailwind para tamaño, peso y márgenes.

  */

  .article-content h1,

  .article-content h2,

  .article-content h3,

  .article-content h4,

  .article-content h5,

  .article-content h6 {

    @apply font-bold leading-tight my-6;

  }

  .article-content h1 { @apply text-4xl lg:text-5xl; }

  .article-content h2 { @apply text-3xl lg:text-4xl mt-12; }

  .article-content h3 { @apply text-2xl lg:text-3xl mt-10; }

  .article-content h4 { @apply text-xl lg:text-2xl mt-8; }

  .article-content h5 { @apply text-lg lg:text-xl mt-6; }

  .article-content h6 { @apply text-base lg:text-lg mt-4; }



  /*

    ================================================================

    == ESTILOS PARA PÁRRAFOS Y ENLACES

    ================================================================

  */

  .article-content p {

    @apply my-4;

  }

  .article-content a {

    @apply text-primary hover:underline;

  }



  /*

    ================================================================

    == ESTILOS PARA LISTAS

    ================================================================

  */

  .article-content ul,

  .article-content ol {

    @apply my-6 pl-8;

  }

  .article-content ul {

    @apply list-disc;

  }

  .article-content ol {

    @apply list-decimal;

  }

  .article-content li {

    @apply my-2;

  }



  /*

    ================================================================

    == ESTILOS PARA CITAS (CON Y SIN AUTOR)

    ================================================================

    - Elemento: <blockquote> para el contenedor.

    - Estilos: Borde izquierdo, espaciado, etc.

    - `p` dentro del blockquote es el texto de la cita.

    - `cite` dentro del blockquote es el autor de la cita.

  */

  .article-content blockquote {

    @apply my-8 relative py-4 px-6 lg:-mx-8;

    border-left: 2px solid theme('colors.primary');

  }

  .article-content blockquote p {

    @apply text-xl font-medium leading-relaxed italic;

  }

  .article-content blockquote cite {

    @apply block text-right text-base not-italic font-semibold mt-4;

  }



  /* Images, Media, and Figures */

  .article-content img,

  .article-content video,

  .article-content figure,

  .article-content table,

  .article-content .wp-calendar-table,

  .article-content ul,

  .article-content ol,

  .article-content pre,

  .article-content blockquote {

    @apply my-8;

  }

  .article-content img,

  .article-content video {

    @apply rounded-lg shadow-md max-w-full h-auto;

  }

  .article-content figure img,

  .article-content figure video,

  .article-content figure table,

  .article-content figure .wp-calendar-table,

  .article-content figure ul,

  .article-content figure ol,

  .article-content figure pre,

  .article-content figure blockquote {

    @apply my-0;

  }

  .article-content .aligncenter {

    @apply block mx-auto;

  }

  .article-content figcaption {

      @apply text-center text-sm text-[#898361] mt-3;

    }

  .article-content audio {

    @apply w-full my-8;

  }



  /* Tables */

  .article-content table,

  .article-content .wp-calendar-table {

    @apply w-full border-collapse text-left;

  }

  .article-content table th,

  .article-content .wp-calendar-table th,

  .article-content table td,

  .article-content .wp-calendar-table td {

    @apply border border-border-light p-3;

  }

  .article-content table thead th,

  .article-content .wp-calendar-table thead th {

    @apply font-bold bg-background-light;

  }



  /* Preformatted & Code */

  .article-content pre {

    @apply bg-background-light p-4 rounded-lg my-8 overflow-x-auto text-sm;

  }

</style>