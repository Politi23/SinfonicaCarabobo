---
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import "../styles/global.css";
import { Font } from "astro:assets";

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
}

const defaultTitle = "Orquesta Sinfónica de Carabobo";
const defaultDescription =
  "Fundación Orquesta Sinfónica de Carabobo - Más de 40 años llevando la música clásica a Venezuela. Conciertos, academia, eventos culturales y más.";

const {
  title = defaultTitle,
  description = defaultDescription,
  canonicalPath,
  ogTitle,
  ogDescription,
  ogImage,
  bodyClass = "",
} = Astro.props;

const fullTitle =
  title === defaultTitle ? defaultTitle : `${title} - ${defaultTitle}`;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.url).toString();
const resolvedOgTitle = ogTitle ?? fullTitle;
const resolvedOgDescription = ogDescription ?? description;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description}
    />
    <meta
      name="keywords"
      content="orquesta, música clásica, Carabobo, Venezuela, conciertos, academia de música, cultura"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wdth,wght@0,18..144,87..112,300..900;1,18..144,87..112,300..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />

    <Font cssVariable="--font-cinzel" />

    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
  </head>

  <body
    class={`bg-background-light text-text-dark font-serif transition-colors duration-300 min-h-screen antialiased flex flex-col ${bodyClass}`}
  >
    <Header />

    <main class="flex-grow w-full flex flex-col">
      <slot />
    </main>

    <Footer />
  </body>
</html>
