---
import BaseLayout from "./BaseLayout.astro";
import LatestBlogPosts from "../components/global/LatestBlogPosts.astro";

export interface Props {
  title?: string;
  is404?: boolean;
}

const { title, is404 = false } = Astro.props;

// Helper to clean up the logic in the template
const showLatestPosts =
  Astro.url.pathname !== "/" &&
  Astro.url.pathname !== "" &&
  !Astro.url.pathname.startsWith("/blog/page/") &&
  !is404;
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <slot />

  {showLatestPosts && <LatestBlogPosts />}
</BaseLayout>
