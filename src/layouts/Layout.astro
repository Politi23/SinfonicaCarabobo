---
import BaseLayout from "./BaseLayout.astro";
import LatestBlogPosts from "../components/global/LatestBlogPosts.astro";

export interface Props {
  title?: string;
  is404?: boolean;
  showLatestPosts?: boolean;
}

const { title, is404 = false, showLatestPosts = true } = Astro.props;
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <slot />

  {showLatestPosts && <LatestBlogPosts />}
</BaseLayout>
