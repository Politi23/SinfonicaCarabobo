---
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import logo from "@assets/images/logo/logo.webp";
---

<Layout title="Página no encontrada" is404>
  <main
    class="min-h-screen bg-background-dark flex items-center justify-center"
  >
    <div class="text-center">
      <Picture
        src={logo}
        alt="Logo de la Orquesta Sinfónica de Carabobo"
        class="mx-auto"
        style="width: 26rem; height: auto;"
        width="416"
        height="166"
        formats={["webp"]}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
      />
      <h1 class="text-3xl font-bold text-text-light">
        ¡Ups! Parece que esta página no existe.
      </h1>
    </div>
  </main>
</Layout>
