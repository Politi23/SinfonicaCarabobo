---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/global/Footer.astro";

// Datos de las agrupaciones
const agrupaciones = [
    {
        nombre: "Orquesta Sinfónica de Carabobo",
        imagen: "https://images.unsplash.com/photo-1465847899084-d164df4dedc6?w=800&q=80",
        descripcion: "Orquesta sinfónica conformada por 60 músicos, para repertorios y eventos que requieran este formato musical.",
        tiposEventos: "Para conciertos de artistas académicos y populares, eventos sociales y/o culturales, sesiones de grabación, documentales, piezas publicitarias, entre otros. Cubre todo el repertorio de los grandes compositores y obras de estreno por encargo.",
        reverse: false
    },
    {
        nombre: "Orquesta de Cámara Sinfocarabobo",
        imagen: "https://images.unsplash.com/photo-1567619822659-2094d3ebef04?w=800&auto=format&fit=crop&q=80",
        descripcion: "Agrupación musical conformada entre 10 y 17 músicos, de las secciones de cuerdas, vientos, percusión, bajo eléctrico y voz, para repertorios que requieran este formato musical.",
        tiposEventos: "Para todo tipo de eventos artísticos, sociales, eclesiásticos, culturales y personales, con un amplio repertorio sacro, popular y académico, adaptado a la naturaleza del evento o actividad.",
        reverse: true
    },
    {
        nombre: "Sinfocarabobo Jazz Ensamble",
        imagen: "https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=800&q=80",
        descripcion: "Agrupación musical, conformada por diferentes instrumentos acústicos, eléctricos, electrónicos y voz, en diferentes formatos instrumentales, según el requerimiento del evento.",
        tiposEventos: "Presenta para todos los eventos sociales, culturales y personales, un amplio repertorio de los grandes temas musicales universales, latinoamericanos, afrocaribeños y venezolanos.",
        reverse: false
    },
    {
        nombre: "Cuarteto Sinfocarabobo",
        imagen: "https://media.istockphoto.com/id/1300767412/es/foto/cuarteto-de-cuerdas-vista-desde-arriba.webp?a=1&b=1&s=612x612&w=0&k=20&c=_7SuK7kpbdE8uXFPAJJtePQOEs_Q_r1fZeYZ0NSgdps=",
        descripcion: "Cuarteto de cuerdas conformado por dos violines, viola y violonchelo, con amplia experiencia musical y artística.",
        tiposEventos: "Para ceremonias eclesiásticas, recepciones, apertura de eventos sociales, de negocios y cualquier otro tipo de actividad cultural y artística que requiera este formato musical, con un amplio repertorio académico y popular universal, latinoamericano y venezolano.",
        reverse: true
    },
    {
        nombre: "Trío Sinfocarabobo",
        imagen: "https://plus.unsplash.com/premium_photo-1703618159093-497aacd99241?w=800&auto=format&fit=crop&q=80",
        descripcion: "Trío musical conformado por violín, viola y violonchelo, donde se combina la técnica y la elegancia de la música clásica, con la creatividad y la innovación de la música moderna.",
        tiposEventos: "Para eventos sociales, culturales y personales, con un amplio repertorio de los grandes compositores universales, latinoamericanos y venezolanos.",
        reverse: false
    },
    {
        nombre: "Dúo Sinfocarabobo",
        imagen: "https://plus.unsplash.com/premium_photo-1661434240769-dc337a3e2b3f?w=800&auto=format&fit=crop&q=80",
        descripcion: "Dúo formado por violín, acompañado por piano o acordeón, especializado en la interpretación de los distintos compositores clásicos y populares.",
        tiposEventos: "Amplio repertorio para ceremonias eclesiásticas, recepciones, eventos sociales, de negocios, y cualquier otro tipo de actividad cultural y artística que requiera este formato musical.",
        reverse: true
    },
    {
        nombre: "Saxo Sinfocarabobo",
        imagen: "https://images.unsplash.com/photo-1415201364774-f6f0bb35f28f?w=800&q=80",
        descripcion: "Saxofonista en vivo acompañado por pistas musicales, en los distintos géneros populares, clásicos y del jazz.",
        tiposEventos: "Para todos los tipos de eventos corporativos, sociales, eclesiásticos, culturales y personales, con un amplio repertorio musical adaptado a la naturaleza de la actividad.",
        reverse: false
    },
    {
        nombre: "Acordeón Sinfocarabobo",
        imagen: "https://images.unsplash.com/photo-1682715601026-bcbbd23ac438?w=800&auto=format&fit=crop&q=80",
        descripcion: "Acordeonista en vivo con acompañamiento de pistas musicales, cuya versatilidad permite la presentación de diferentes géneros musicales.",
        tiposEventos: "Repertorio adaptado para ceremonias eclesiásticas, recepciones, eventos sociales, de negocios, y cualquier otro tipo de actividad cultural y artística.",
        reverse: true
    }
];
---

<Layout>
    <Header />
    
    <!-- Hero Section -->
    <section class="relative min-h-[50vh] flex items-center justify-center bg-gray-900 overflow-hidden">
        <div class="absolute inset-0 z-0 opacity-30 bg-[url('/sinfonica.jpg')] bg-fixed bg-cover bg-center"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/80 z-0"></div>
        
        <!-- Decoración de esquinas -->
        <div class="absolute top-4 left-4 w-24 h-24 border-l-4 border-t-4 border-primary opacity-60"></div>
        <div class="absolute top-4 right-4 w-24 h-24 border-r-4 border-t-4 border-primary opacity-60"></div>
        
        <div class="container mx-auto px-6 relative z-10 text-center pt-24">
            <p class="text-2xl md:text-3xl italic text-gray-300 font-serif mb-6 animate-fade-in">
                "Somos la música para tu evento"
            </p>
            
            <div class="flex justify-center mb-8">
                <img 
                    src="/logo.png" 
                    alt="Fundación Orquesta Sinfónica de Carabobo" 
                    class="h-28 md:h-36 object-contain drop-shadow-2xl"
                />
            </div>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white">
                Nuestras <span class="text-primary">Agrupaciones</span>
            </h1>
        </div>
    </section>
    
    <!-- Agrupaciones -->
    <main class="bg-white">
        {agrupaciones.map((agrupacion, index) => (
            <section class={`py-16 md:py-24 ${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
                <div class="container mx-auto px-6 max-w-6xl">
                    <div class={`flex flex-col ${agrupacion.reverse ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-8 md:gap-16`}>
                        <!-- Imagen -->
                        <div class="w-full md:w-1/2">
                            <img 
                                src={agrupacion.imagen} 
                                alt={agrupacion.nombre}
                                class="w-full aspect-[4/3] object-cover rounded-xl shadow-xl"
                            />
                        </div>
                        
                        <!-- Contenido -->
                        <div class="w-full md:w-1/2 space-y-6">
                            <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900 relative">
                                {agrupacion.nombre}
                                <div class="absolute -bottom-2 left-0 w-20 h-1 bg-primary"></div>
                            </h2>
                            
                            <div class="space-y-4">
                                <div>
                                    <h3 class="text-lg font-bold text-secondary mb-2">Descripción:</h3>
                                    <p class="text-gray-700 leading-relaxed">{agrupacion.descripcion}</p>
                                </div>
                                
                                <div>
                                    <h3 class="text-lg font-bold text-secondary mb-2">Tipos de eventos:</h3>
                                    <p class="text-gray-600 leading-relaxed">{agrupacion.tiposEventos}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        ))}
        
        <!-- Nota importante -->
        <section class="py-12 bg-gray-100">
            <div class="container mx-auto px-6 max-w-4xl">
                <div class="bg-white border-l-4 border-primary p-6 rounded-r-lg shadow-lg">
                    <p class="text-gray-700">
                        <span class="font-bold text-gray-900">Importante:</span> Si necesita alguna agrupación en un formato musical que no esté aquí especificado, la podemos organizar para usted con el repertorio necesario.
                    </p>
                </div>
            </div>
        </section>
        
        <!-- Barra de contacto -->
        <section class="bg-primary py-6">
            <div class="container mx-auto px-6 max-w-4xl">
                <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-white">
                    <span class="font-bold text-xl">Para contrataciones:</span>
                    <a href="mailto:produccion.sinfocarabobo@gmail.com" class="flex items-center gap-2 text-lg hover:underline transition-all hover:scale-105">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        </svg>
                        <span>produccion.sinfocarabobo@gmail.com</span>
                    </a>
                </div>
            </div>
        </section>


        <!-- Nota legal -->
        <section class="py-8 bg-primary">
            <div class="container mx-auto px-6 max-w-5xl">
                <p class="text-white text-sm md:text-base text-center leading-relaxed">
                    <span class="font-bold">Importante:</span> Para consultar sobre las condiciones que aplican, para la contratación de alguno de los servicios musicales aquí descritos o alguna agrupación en un formato musical que no esté aquí especificado, por favor contactarnos. Con gusto le atenderemos.
                </p>
            </div>
        </section>
    </main>
    
    <Footer />
</Layout>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }
</style>
