---
import { Image } from 'astro:assets';
import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";

import orquestaSinfonica from "@assets/images/orchestra/orquesta-sinfonica.webp";
import orquestaCamara from "@assets/images/orchestra/orquesta-camara.webp";
import bailable from "@assets/images/orchestra/bailable.webp";
import estudiantina from "@assets/images/orchestra/estudiantina.webp";
import jazzEnsamble from "@assets/images/orchestra/jazz-ensamble.webp";
import coro from "@assets/images/orchestra/coro.webp";
import camara from "@assets/images/orchestra/camara.webp";
import cuartetoCuerdas from "@assets/images/orchestra/cuarteto-cuerdas.webp";
import trioSinfocarabobo from "@assets/images/orchestra/trio-sinfocarabobo.webp";
import duoSinfocarabobo from "@assets/images/orchestra/duo-sinfocarabobo.webp";
import saxoSinfocarabobo from "@assets/images/orchestra/saxo-sinfocarabobo.webp";
import acordeonSinfocarabobo from "@assets/images/orchestra/acordeon-sinfocarabobo.webp";

// Datos de las agrupaciones
const agrupaciones = [
    {
        nombre: "Orquesta Sinfónica de Carabobo",
        imagen: orquestaSinfonica,
        descripcion: "Orquesta Sinfónica conformada por músicos profesionales, para repertorios y eventos que requieran este formato musical.",
        tiposEventos: "Para conciertos de artistas académicos y populares, eventos sociales y/o culturales, sesiones de grabación, documentales, piezas publicitarias, entre otros. Cubre todo el repertorio de los grandes compositores y obras de estreno por encargo.",
        reverse: false
    },
    {
        nombre: "Orquesta de Cámara Sinfocarabobo",
        imagen: orquestaCamara,
        descripcion: "Agrupación musical conformada entre 15 y 25 músicos, de las secciones de cuerdas, vientos, percusión, bajo eléctrico y voz, para repertorios que requieran este formato musical.",
        tiposEventos: "Para todo tipo de eventos artísticos, sociales, eclesiásticos, culturales y personales, con un amplio repertorio sacro, popular y académico, adaptado a la naturaleza del evento o actividad.",
        reverse: true
    },
    {
        nombre: "Orquesta Bailable Sinfocarabobo",
        imagen: bailable,
        descripcion: "Conformada por 11 músicos con amplia trayectoria musical latina caribeña.",
        tiposEventos: "Eventos sociales tales como: matrimonios, 15 años, graduaciones, anniversarios y empresariales.",
        reverse: false
    },
    {
        nombre: "Estudiantina José Calabrese",
        imagen: estudiantina,
        descripcion: "Conformada entre 15 y 20 ejecutantes de instrumentos venezolanos y clásicos, con un amplio repertorio de música venezolana, latinoamericana y popular universal.",
        tiposEventos: "Para eventos académicos, culturales, sociales y corporativos.",
        reverse: true
    },
    {
        nombre: "Sinfocarabobo Jazz Ensamble",
        imagen: jazzEnsamble,
        descripcion: "Agrupación musical, conformada por differentes instrumentos acústicos, eléctricos, electrónicos y voz, en diferentes formatos instrumentales, según el requerimiento del evento.",
        tiposEventos: "Presenta para todos los eventos sociales, culturales y personales, un amplio repertorio de los grandes temas musicales universales, latinoamericanos, afrocaribeños y venezolanos.",
        reverse: false
    },
    {
        nombre: "Coro Académico José Calabrese",
        imagen: coro,
        descripcion: "Coro conformada desde 8 voces en adelante. Entre cantantes masculinos y femeninos, jóvenes y adultos.",
        tiposEventos: "Para misas, actividades culturales o artísticas, con un amplio repertorio académico, eclesiástico y popular universal.",
        reverse: true
    },
    {
        nombre: "Agrupaciones de Cámara",
        imagen: camara,
        descripcion: "Agrupaciones de entre 5 y 14 músicos de instrumentos de cuerdas, vientos o combinados, con amplia experiencia musical y artística.",
        tiposEventos: "Para ceremonias eclesiásticas, aper tura de eventos sociales, de negocios y cualquier otro tipo de actividad cultural o artística que requiera este formato musical, con un amplio repertorio académico, popular universal, latinoamericano y venezolano.",
        reverse: false
    },
    {
        nombre: "Cuarteto Sinfocarabobo",
        imagen: cuartetoCuerdas,
        descripcion: "Cuarteto de cuerdas conformado por dos violines, viola y violonchelo, con amplia experiencia musical y artística.",
        tiposEventos: "Para ceremonias eclesiásticas, recepciones, apertura de eventos sociales, de negocios y cualquier otro tipo de actividad cultural y artística que requiera este formato musical, con un amplio repertorio académico y popular universal, latinoamericano y venezolano.",
        reverse: true
    },
    {
        nombre: "Trío Sinfocarabobo",
        imagen: trioSinfocarabobo,
        descripcion: "Trío musical conformado por violín, viola y violonchelo, donde se combina la técnica y la elegancia de la música clásica, con la creatividad y la innovación de la música moderna.",
        tiposEventos: "Para eventos sociales, culturales y personales, con un amplio repertorio de los grandes compositores universales, latinoamericanos y venezolanos.",
        reverse: false
    },
    {
        nombre: "Dúo Sinfocarabobo",
        imagen: duoSinfocarabobo,
        descripcion: "Dúo formado por violín, acompañado por piano o acordeón, especializado en la interpretación de los distintos compositores clásicos y populares.",
        tiposEventos: "Amplio repertorio para ceremonias eclesiásticas, recepciones, eventos sociales, de negocios, y cualquier otro tipo de actividad cultural y artística que requiera este formato musical.",
        reverse: true
    },
    {
        nombre: "Saxo Sinfocarabobo",
        imagen: saxoSinfocarabobo,
        descripcion: "Saxofonista en vivo acompañado por pistas musicales, en los distintos géneros populares, clásicos y del jazz.",
        tiposEventos: "Para todos los tipos de eventos corporativos, sociales, eclesiásticos, culturales y personales, con un amplio repertorio musical adaptado a la naturaleza de la actividad.",
        reverse: false
    },
    {
        nombre: "Acordeón Sinfocarabobo",
        imagen: acordeonSinfocarabobo,
        descripcion: "Acordeonista en vivo con acompañamiento de pistas musicales, cuya versatilidad permite la presentación de diferentes géneros musicales.",
        tiposEventos: "Repertorio adaptado para ceremonias eclesiásticas, recepciones, eventos sociales, de negocios, y cualquier otro tipo de actividad cultural y artística.",
        reverse: true
    }
];
---

<Layout>
    <MainHero
        title="Nuestras"
        titleHighlight="Agrupaciones"
        subtitle="Somos la música para tu evento"
    />

    <!-- Agrupaciones -->
    <main class="bg-white">
        {agrupaciones.map((agrupacion, index) => (
            <section class={`py-16 md:py-24 ${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
                <div class="container mx-auto px-6 max-w-6xl">
                    <div class={`flex flex-col ${agrupacion.reverse ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-8 md:gap-16`}>
                        <!-- Imagen -->
                        <div class="w-full md:w-1/2">
                            <Image
                                src={agrupacion.imagen}
                                alt={agrupacion.nombre}
                                class="w-full aspect-[4/3] object-cover rounded-xl"
                                width="800"
                                height="600"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>

                        <!-- Contenido -->
                        <div class="w-full md:w-1/2 space-y-6">
                            <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900 relative">
                                {agrupacion.nombre}
                                <div class="absolute -bottom-2 left-0 w-20 h-1 bg-primary"></div>
                            </h2>

                            <div class="space-y-4">
                                <div>
                                    <h3 class="text-lg font-bold text-secondary mb-2">Descripción:</h3>
                                    <p class="text-gray-700 leading-relaxed">{agrupacion.descripcion}</p>
                                </div>

                                <div>
                                    <h3 class="text-lg font-bold text-secondary mb-2">Tipos de eventos:</h3>
                                    <p class="text-gray-600 leading-relaxed">{agrupacion.tiposEventos}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        ))}

        <!-- Nota importante -->
        <section class="py-16 bg-white">
            <div class="container mx-auto px-6 max-w-4xl">
                <div class="bg-white border-l-4 border-secondary p-8">
                    <p class="text-gray-700 text-xl leading-relaxed">
                        <span class="font-bold text-gray-900">Nota:</span> Contamos con flexibilidad total. Si busca una agrupación o formato musical distinto a los listados, podemos diseñarlo a su medida con el repertorio ideal.
                    </p>
                </div>
            </div>
        </section>

        <!-- Sección de contacto -->
        <section class="py-20 bg-gray-50 border-y border-gray-100">
            <div class="container mx-auto px-6 max-w-4xl text-center">
                <h2 class="text-2xl md:text-3xl font-display font-bold text-gray-900 mb-8">
                    ¿Deseas contratar alguna de nuestras agrupaciones?
                </h2>

                <div class="flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">
                    <a href="mailto:gerencia@sinfocarabobo.com" class="group flex flex-col items-center gap-3 transition-all hover:scale-105">
                        <div class="w-14 h-14 rounded-full bg-gray-900 flex items-center justify-center text-white mb-2 shadow-lg group-hover:bg-primary transition-colors">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                            </svg>
                        </div>
                        <span class="text-sm uppercase tracking-widest text-gray-500 font-bold">Email</span>
                        <span class="text-lg text-gray-900 font-medium">gerencia@sinfocarabobo.com</span>
                    </a>

                    <div class="hidden md:block w-px h-20 bg-gray-200"></div>

                    <a href="tel:04143410642" class="group flex flex-col items-center gap-3 transition-all hover:scale-105">
                        <div class="w-14 h-14 rounded-full bg-gray-900 flex items-center justify-center text-white mb-2 shadow-lg group-hover:bg-primary transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                        </div>
                        <span class="text-sm uppercase tracking-widest text-gray-500 font-bold">Teléfono</span>
                        <span class="text-lg text-gray-900 font-medium">04143410642</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Nota legal -->
    </main>
</Layout>
