---
import Layout from "../layouts/Layout.astro";
import Header from "../components/global/Header.astro";
import HeroHeader from "../components/HeroHeader.astro";
---

<Layout>
    <Header />

    <main class="bg-background-light text-text-dark">
        <!-- HERO SECTION -->
        <!-- <HeroHeader /> -->
         <!-- qwen --resume f0bbdf1c-c4d8-4a64-b086-8990a087ea2a -->

        <!-- SUPPORT SECTION -->
        <section
            class="py-24 md:py-32 relative overflow-hidden"
            id="como-apoyar"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Apóyanos</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        FORMAS DE UNIRSE O<br /><span
                            class="text-primary italic">APOYAR A LA OSC</span
                        >
                    </h2>
                </div>

                <!-- Support Options Grid -->
                <div class="grid md:grid-cols-2 gap-8 mb-32">
                    <!-- Patrocinio a conciertos -->
                    <div
                        class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light"
                    >
                        <div
                            class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-text-dark"
                        >
                            Patrocinio a conciertos
                        </h3>
                        <p class="text-text-dark leading-relaxed">
                            Empresas o instituciones privadas y públicas que
                            estén dispuestas a financiar los gastos implicados
                            en la realización de los espectáculos o conciertos a
                            nivel local, nacional e internacional.
                        </p>
                    </div>

                    <!-- Patrocinio al programa OSC -->
                    <div
                        class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light"
                    >
                        <div
                            class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-text-dark"
                        >
                            Patrocinio al programa OSC
                        </h3>
                        <p class="text-text-dark leading-relaxed">
                            Empresas o instituciones privadas y públicas que
                            estén dispuestas a financiar los gastos implicados
                            en la adquisición de mobiliario y equipos y/o
                            reparación y mantenimiento del existente, así como
                            la adquisición de los accesorios que requieren los
                            instrumentos de la orquesta y la dotación de nuevos
                            instrumentos.
                        </p>
                    </div>

                    <!-- Donación -->
                    <div
                        class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light"
                    >
                        <div
                            class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-text-dark"
                        >
                            Donación
                        </h3>
                        <p class="text-text-dark leading-relaxed">
                            Empresas o instituciones privadas y públicas que
                            estén dispuestas a entregar en donación dinero en
                            moneda fuerte y/o equipos, mobiliario e
                            instrumentos.
                        </p>
                    </div>

                    <!-- Membrecías -->
                    <div
                        class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light"
                    >
                        <div
                            class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-text-dark"
                        >
                            Membrecías
                        </h3>
                        <p class="text-text-dark leading-relaxed">
                            Las empresas o instituciones pagan una cuota que
                            puede ser anual, semestral o trimestral y la FOSC
                            ofrece membrecías o puestos honorarios dentro de la
                            OSC, con ciertos beneficios, como por ejemplo:
                            reservas y asientos VIP dentro de los conciertos,
                            exoneración de entradas, becas para sus hijos dentro
                            de la Academia Internacional de Música "Maestro José
                            Calabrese", presentaciones de las agrupaciones de
                            cámara de la OSC en eventos corporativos y/o
                            sociales, entre otros.
                        </p>
                    </div>
                </div>

                <!-- Call to Action -->
                <div
                    class="bg-surface-light rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-border-light text-center"
                >
                    <h3
                        class="text-3xl font-display font-bold mb-6 text-text-dark"
                    >
                        Únete a Nuestro Proyecto
                    </h3>
                    <p
                        class="text-text-dark leading-relaxed text-lg mb-8 max-w-2xl mx-auto"
                    >
                        Tu apoyo es fundamental para continuar nuestra labor
                        cultural y educativa. Juntos podemos seguir llevando la
                        música a todos los rincones de Venezuela.
                    </p>
                    <a
                        href="/contacto"
                        class="inline-block bg-primary text-white px-10 py-4 rounded-full font-bold hover:bg-opacity-90 transition-transform hover:scale-105 shadow-xl"
                    >
                        Contáctanos
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>
