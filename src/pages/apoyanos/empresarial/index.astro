---
import Layout from "../../../layouts/Layout.astro";
import MainHero from "../../../components/sections/MainHero.astro";
import CorporateProgram from "../../../components/apoyanos/CorporateProgram.astro";
import BenefitsList from "../../../components/apoyanos/BenefitsList.astro";
import SponsorshipTiers from "../../../components/apoyanos/SponsorshipTiers.astro";
import CustomImpactCTA from "../../../components/apoyanos/CustomImpactCTA.astro";
import conductorImage from "@assets/images/orquesta/_DSC0124.webp";
---

<Layout title="Programa Empresarial" showApoyanosSection={false}>
  <main class="bg-white text-gray-800 min-h-screen">
    <MainHero
      title="Alianza"
      titleHighlight="Empresarial"
      subtitle="Inversión social a través del arte y la cultura"
    />

    <section class="py-16 bg-whiteg border-t border-gray-100 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="flex flex-col md:flex-row items-center gap-16 max-h-[50vh]">
          <div class="relative z-10 bg-white">
            <h3
              class="text-3xl md:text-4xl font-display font-bold mb-8 uppercase tracking-tighter text-black"
            >
              Nuestra <span class="font-bold text-secondary">Propuesta</span>
            </h3>

            <p class="text-gray-600 mb-6 leading-relaxed text-lg font-light">
              Forjar una alianza estratégica que impulse el desarrollo a través
              de iniciativas <strong class="font-medium text-gray-900"
                >artísticas, académicas y sociales</strong
              >.
            </p>

            <p class="text-gray-600 leading-relaxed text-lg font-light">
              Con su respaldo, transformamos el futuro de cientos de talentosos
              jóvenes venezolanos, consolidando a su empresa como un <strong
                class="font-medium text-gray-900">pilar fundamental</strong
              > de la cultura en nuestra región.
            </p>
          </div>

          <!-- Visual/Image Area -->
          <div class="w-full relative mt-12 md:mt-0">
            <!-- Image -->
            <div
              class="relative z-0 mb-8 overflow-hidden rounded-sm aspect-[4/3]"
            >
              <img
                src={conductorImage.src}
                alt="Director de la Orquesta Sinfónica de Carabobo en concierto"
                class="w-full object-center shadow-lg relative -top-36"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="mx-auto max-w-[70rem]">
        <!-- <h2
          class="text-3xl md:text-4xl font-display font-bold text-black mb-12 leading-none tracking-tighter"
        >
          Programa <span class="text-secondary font-bold">Aliados</span>
        </h2> -->

        <ul class="grid grid-cols-3">
          <li
            class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
          >
            <div class="pt-1">
              <div class="w-2 h-2 bg-secondary"></div>
            </div>
            <div>
              <h4
                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
              >
                15% Descuento en Presentaciones
              </h4>
              <p class="text-gray-500 text-base leading-relaxed max-w-md">
                En contrataciones de la Orquesta o sus ensambles para eventos
                corporativos o sociales.
              </p>
            </div>
          </li>

          <li
            class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
          >
            <div class="pt-1">
              <div class="w-2 h-2 bg-secondary"></div>
            </div>
            <div>
              <h4
                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
              >
                50% Descuento Académico
              </h4>
              <p class="text-gray-500 text-base leading-relaxed max-w-md">
                Beca en nuestro programa académico musical para los hijos del
                personal de su empresa.
              </p>
            </div>
          </li>

          <li
            class="flex items-start gap-6 p-8 border-l-4 border-transparent hover:border-secondary hover:bg-gray-50 transition-all duration-300"
          >
            <div class="pt-1">
              <div class="w-2 h-2 bg-secondary"></div>
            </div>
            <div>
              <h4
                class="text-xl font-bold text-black uppercase tracking-tight mb-2"
              >
                Beneficios Fiscales
              </h4>
              <p class="text-gray-500 text-base leading-relaxed max-w-md">
                Deducción de impuestos en el marco de la responsabilidad social
                empresarial.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <BenefitsList />
    <SponsorshipTiers />
    <CustomImpactCTA />
  </main>
</Layout>
