---
import Layout from "../../../layouts/Layout.astro";
import MainHero from "../../../components/sections/MainHero.astro";
import CorporateProgram from "../../../components/apoyanos/CorporateProgram.astro";
import BenefitsList from "../../../components/apoyanos/BenefitsList.astro";
import SponsorshipTiers from "../../../components/apoyanos/SponsorshipTiers.astro";
---

<Layout title="Programa Empresarial - Fundación Orquesta Sinfónica de Carabobo">
  <main class="bg-white text-gray-800 min-h-screen">
    <MainHero
      title="Alianza"
      titleHighlight="Empresarial"
      subtitle="Inversión social a través del arte y la cultura"
    />
    <div class="flex justify-center -mt-6 relative z-20">
      <a
        href="#niveles"
        class="py-4 px-10 bg-[#800020] text-white text-[10px] font-bold uppercase tracking-[0.2em] shadow-2xl hover:bg-black transition-all active:scale-95"
      >
        Explorar Niveles de Patrocinio
      </a>
    </div>
    <CorporateProgram />
    <BenefitsList />
    <SponsorshipTiers />
  </main>
</Layout>
