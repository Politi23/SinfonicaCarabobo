---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import AuditionInfo from "@components/audiciones/AuditionInfo.astro";
import AudicionesRepertoire from "@components/audiciones/AudicionesRepertoire.astro";
import AuditionsCTA from "@components/audiciones/AuditionsCTA.astro";
import {
    getAudicionesState,
    groupAudicionesByInstrument,
} from "@config/wp-audiciones";

const { audiciones, offline } = await getAudicionesState();
const instruments = groupAudicionesByInstrument(audiciones);
---

<Layout
    title="Audiciones"
    description="Audiciones abiertas de la Orquesta Sinfónica de Carabobo: repertorio, niveles y materiales de preparación."
    canonicalPath="/audiciones"
    showApoyanosSection={false}
>
    <MainHero title="Audiciones" />
    <AuditionInfo />
    <AudicionesRepertoire instruments={instruments} offline={offline} />
    <AuditionsCTA basePath="/audiciones" />
</Layout>
