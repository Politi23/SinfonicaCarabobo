---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import ArticleContent from "../../components/blog/ArticleContent.astro";
import { getAllPostsSlugs } from "../../config/wp";

export async function getStaticPaths() {
  const posts = await getAllPostsSlugs();
  
  console.log("CUANTOS POSTS ENCONTRÉ:", posts.length);
  if (posts.length > 0) {
    console.log("PRIMER SLUG:", posts[0].slug);
  }

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

if (!post) {
  const posts = await getAllPostsSlugs();
  console.log("CUANTOS POSTS ENCONTRÉ:", posts.length);
  if (posts.length > 0) {
    console.log("PRIMER SLUG:", posts[0].slug);
  }
  return Astro.redirect('/404');
}
---

<Layout title={post.title}>
  <head>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  </head>
  
  <main class="bg-background-light min-h-screen pt-20">
    <article class="layout-content-container flex flex-col max-w-[960px] w-full flex-1 px-4 lg:px-20 py-10 lg:py-16 mx-auto">
      
      {/* Category */}
      <div class="flex gap-3 mb-6">
        {post.category && (
          <div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/20 px-3">
            <p class="text-black text-xs font-bold uppercase tracking-wide leading-normal">
              {post.category}
            </p>
          </div>
        )}
      </div>

      {/* Title & Excerpt */}
      <div class="flex flex-col gap-4 mb-8">
        <h1 class="text-4xl lg:text-5xl font-bold leading-[1.1] tracking-[-0.02em] text-text-dark">
          {post.title}
        </h1>

        {post.excerpt && (
          <div class="text-[#898361] text-xl lg:text-2xl font-normal leading-relaxed italic">
            {post.excerpt}
          </div>
        )}
      </div>

      {/* Meta */}
      <div class="flex items-center justify-between border-t border-b border-[#e5e5e0] py-6 mb-10">
        <div class="flex gap-4 items-center">
          <div class="flex flex-col justify-center">
            <p class="text-lg font-bold text-text-dark">
              {post.author || "Equipo Sinfónica"}
            </p>
            <div class="flex items-center gap-2 text-[#898361] text-lg">
              <span>
                {new Date(post.date).toLocaleDateString("es-ES", {
                  year: "numeric", month: "long", day: "numeric"
                })}
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Featured Image */}
      {post.image && (
        <div class="w-full mb-12">
          <div
            class="w-full bg-center bg-no-repeat bg-cover flex flex-col justify-end overflow-hidden rounded-lg min-h-[400px] lg:min-h-[500px] shadow-sm relative"
            style={`background-image: url('${post.image}')`}
          >
            <div class="absolute inset-0 bg-black/10" />
          </div>
          {post.imageCaption && (
            <figcaption
              class="mt-3 text-xs text-[#898361] text-center"
              set:html={post.imageCaption}
            />
          )}
        </div>
      )}

      {/* Content */}
      <ArticleContent set:html={post.content} />

    </article>
  </main>
</Layout>