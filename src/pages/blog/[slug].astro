---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ArticleContent from "../../components/blog/ArticleContent.astro";
import WpOfflineError from "../../components/ui/WpOfflineError.astro";

import { getBlogBySlugState } from "../../config/wp-blogs";
import Image from "astro/components/Image.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const { blog, offline } = await getBlogBySlugState(slug);

if (!blog && !offline) {
  return Astro.redirect("/404");
}

const pageTitle = blog?.title ?? "Blog";
const pageDescription =
  blog?.excerpt ??
  "No pudimos cargar esta entrada por una falla temporal de conexión.";
const pageCanonicalPath = blog ? `/blog/${blog.slug}` : Astro.url.pathname;
const pageOgImage = blog?.image;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={pageCanonicalPath}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={pageOgImage}
  showApoyanosSection={false}
  showLatestPosts={true}
>
  {
    blog ? (
      <>
        <div class="w-full h-[70vh]">
          {blog.image && (
            <Image
              src={blog.image}
              alt={blog.excerpt}
              width={1000}
              height={1000}
              loading="eager"
              class={"w-full h-full object-cover"}
            />
          )}
          <div class="absolute inset-0 bg-gradient-to- from-red-800 via-transparent to-transparent h-[50vh]"></div>
        </div>

        <main class="bg-background-light min-h-screen">
          <article class="layout-content-container flex flex-col max-w-[960px] w-full flex-1 px-4 lg:px-20 py-10 lg:py-16 mx-auto">
            <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-text-dark mb-8 leading-tight">
              {blog.title}
            </h1>

            <div class="flex items-center justify-between border-t border-b border-border-light py-6 mb-10">
              <div class="flex gap-4 items-center">
                <div class="flex flex-col justify-center">
                  <div class="flex items-center gap-2 text-text-muted text-lg">
                    <i class="ph ph-calendar-blank" />
                    <span>
                      {new Date(blog.date).toLocaleDateString("es-VE", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <ArticleContent set:html={blog.content} />
          </article>
        </main>
      </>
    ) : (
      <WpOfflineError
        title="Conexión temporalmente no disponible"
        message="No pudimos cargar esta entrada por una falla temporal en WordPress. Intentalo de nuevo en unos minutos."
        homeLink="/blog"
        homeLinkText="Volver al blog"
      />
    )
  }
</Layout>
