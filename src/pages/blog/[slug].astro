---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import ArticleContent from "../../components/blog/ArticleContent.astro";

import { getBlogBySlug } from "../../config/wp-blogs";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const blog = await getBlogBySlug(slug);

if (!blog) {
  return Astro.redirect("/404");
}
---

<Layout title={blog.title}>
  <head>
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
  </head>

  <main class="bg-background-light min-h-screen pt-20">
    <article
      class="layout-content-container flex flex-col max-w-[960px] w-full flex-1 px-4 lg:px-20 py-10 lg:py-16 mx-auto"
    >
      {/* Header: Categoría y Título */}
      <div class="flex gap-3 mb-6">
        {
          blog.category && (
            <div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/20 pl-3 pr-3">
              <p class="text-black text-xs font-bold uppercase tracking-wide leading-normal">
                {blog.category}
              </p>
            </div>
          )
        }
      </div>

      <h1
        class="text-3xl md:text-5xl lg:text-6xl font-black text-text-dark mb-8 leading-tight"
      >
        {blog.title}
      </h1>

      <div class="flex flex-col gap-4 mb-10">
        {
          blog.excerpt && (
            <div class="text-xl text-text-dark/80 leading-relaxed italic border-l-4 border-primary pl-4">
              {blog.excerpt}
            </div>
          )
        }
      </div>

      {/* Meta Data: Autor y Fecha */}
      <div
        class="flex items-center justify-between border-t border-b border-border-light py-6 mb-10"
      >
        <div class="flex gap-4 items-center">
          <div class="flex flex-col justify-center">
            <p class="text-lg font-bold text-text-dark">
              {blog.author || "Equipo Sinfónica"}
            </p>
            <div class="flex items-center gap-2 text-text-muted text-lg">
              <span class="material-icons text-base">calendar_today</span>
              <span>
                {
                  new Date(blog.date).toLocaleDateString("es-VE", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                }
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Featured Image */}
      {
        blog.image && (
          <div class="w-full mb-12">
            <div
              class="w-full bg-center bg-no-repeat bg-cover flex flex-col justify-end overflow-hidden rounded-lg min-h-[300px] md:min-h-[400px] lg:min-h-[500px] shadow-sm relative"
              style={`background-image: url('${blog.image}')`}
            >
              <div class="absolute inset-0 bg-black/10" />
            </div>
            {blog.imageCaption && (
              <figcaption
                class="mt-3 text-sm text-gray-500 text-center italic"
                set:html={blog.imageCaption}
              />
            )}
          </div>
        )
      }

      {/* Contenido Principal */}
      <ArticleContent set:html={blog.content} />
    </article>
  </main>
</Layout>
