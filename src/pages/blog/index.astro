    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {posts.map((p) => (
        <BlogCard title={p.title} excerpt={p.excerpt} image={p.image} date={p.date} category={p.category} />
      ))}
    </div>

