---
import Layout from "../../layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import Pagination from "../../components/blog/Pagination.astro";
import SearchBar from "../../components/ui/SearchBar.astro";
import WpOfflineError from "../../components/ui/WpOfflineError.astro";
import {
  getBlogs,
  getBlogsPagination,
  type WPBlog,
} from "../../config/wp-blogs";

const ordenFilter = Astro.url.searchParams.get("orden") ?? "";
const desdeFilter = Astro.url.searchParams.get("desde") ?? "";
const hastaFilter = Astro.url.searchParams.get("hasta") ?? "";

const parsedQueryPage = Number.parseInt(
  Astro.url.searchParams.get("page") ?? "1",
  10,
);
const normalizedQueryPage =
  Number.isFinite(parsedQueryPage) && parsedQueryPage > 0 ? parsedQueryPage : 1;

if (normalizedQueryPage > 1 && !ordenFilter && !desdeFilter && !hastaFilter) {
  return Astro.redirect(`/blog/page/${normalizedQueryPage}`, 301);
}

type OrderBy = "date" | "modified" | "comment_count" | "title";
type Order = "asc" | "desc";

const ordenMap: Record<string, { orderby: OrderBy; order: Order }> = {
  recientes:    { orderby: "date",          order: "desc" },
  antiguos:     { orderby: "date",          order: "asc"  },
  valorados:    { orderby: "comment_count", order: "desc" },
  actualizados: { orderby: "modified",      order: "desc" },
  az:           { orderby: "title",         order: "asc"  },
};

const { orderby, order } = ordenMap[ordenFilter] ?? { orderby: "date", order: "desc" };

// Build WP date params (ISO 8601)
const afterParam  = desdeFilter ? new Date(desdeFilter).toISOString() : undefined;
const beforeParam = hastaFilter
  ? new Date(new Date(hastaFilter).getTime() + 86400000).toISOString()
  : undefined;

let blogs: WPBlog[] = [];
let totalPages = 1;
let currentPage = 1;
const hasDateFilter = Boolean(desdeFilter || hastaFilter);

try {
  if (hasDateFilter) {
    // Fetch all and filter (WP API before/after may vary; fetch large batch)
    const allBlogs = await getBlogs({ page: 1, perPage: 100, orderby, order, after: afterParam, before: beforeParam });
    blogs = allBlogs;
  } else {
    const pagination = await getBlogsPagination({ page: 1, perPage: 6 });
    currentPage = pagination.currentPage;
    totalPages = pagination.totalPages;
    blogs = await getBlogs({ page: currentPage, perPage: 6, orderby, order });
  }
} catch (error) {
  console.error("Error cargando blogs:", error);
}

---

<Layout
  title={currentPage > 1 ? `Blog - Página ${currentPage}` : "Blog"}
  description="Noticias, novedades y artículos de la Orquesta Sinfónica de Carabobo."
  canonicalPath={currentPage > 1 ? `/blog/page/${currentPage}` : "/blog"}
  ogTitle="Blog"
  ogDescription="Noticias, novedades y artículos de la Orquesta Sinfónica de Carabobo."
  showApoyanosSection={false}
>
  <MainHero
    title="Noticias y"
    titleHighlight="Actualidad"
    subtitle="Explora nuestras últimas noticias, eventos y experiencias musicales"
  />

  <main class="bg-white text-gray-800 min-h-screen py-12">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

      <SearchBar
        placeholder="Buscar noticias..."
        showDates={true}
        desdeValue={desdeFilter}
        hastaValue={hastaFilter}
      />


      {
        blogs.length > 0 ? (
          <>
            <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
              {blogs.map((b) => (
                <div
                  data-search-card
                  data-search-text={`${b.title} ${b.excerpt} ${b.category}`.toLowerCase()}
                >
                  <BlogCard
                    title={b.title}
                    excerpt={b.excerpt}
                    image={b.image}
                    date={b.date}
                    category={b.category}
                    slug={b.slug}
                  />
                </div>
              ))}
            </div>

            {!ordenFilter && !hasDateFilter && totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl="/blog"
              />
            )}
          </>
        ) : (
          <WpOfflineError
            title="No hay publicaciones disponibles"
            message="Lo sentimos, no hay publicaciones disponibles en este momento. Por favor, inténtalo más tarde."
          />
        )
      }
    </section>
  </main>
</Layout>
