---
import Layout from "../../layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import Pagination from "../../components/blog/Pagination.astro";
import WpOfflineError from "../../components/ui/WpOfflineError.astro";
import { getBlogs, getBlogsPagination, type WPBlog } from "../../config/wp-blogs";

const parsedQueryPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const normalizedQueryPage = Number.isFinite(parsedQueryPage) && parsedQueryPage > 0 ? parsedQueryPage : 1;

if (normalizedQueryPage > 1) {
  return Astro.redirect(`/blog/page/${normalizedQueryPage}`, 301);
}

const requestedPage = 1;

let blogs: WPBlog[] = [];
let totalPages = 1;
let currentPage = 1;

try {
  const pagination = await getBlogsPagination({ page: requestedPage, perPage: 6 });
  currentPage = pagination.currentPage;
  totalPages = pagination.totalPages;
  blogs = await getBlogs({ page: currentPage, perPage: 6 });
} catch (error) {
  console.error("Error cargando blogs:", error);
}
---

<Layout title={`Blog - Página ${currentPage}`} showLatestPosts={false}>
  <MainHero
    title="Noticias y"
    titleHighlight="Actualidad"
    subtitle="Explora nuestras últimas noticias, eventos y experiencias musicales"
  />

  <main class="bg-white text-gray-800 min-h-screen py-12">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      {
        blogs.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
              {blogs.map((b) => (
                <BlogCard
                  title={b.title}
                  excerpt={b.excerpt}
                  image={b.image}
                  date={b.date}
                  category={b.category}
                  slug={b.slug}
                />
              ))}
            </div>

            {totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl="/blog"
              />
            )}
          </>
        ) : (
          <WpOfflineError
            title="No hay publicaciones disponibles"
            message="Lo sentimos, no hay publicaciones disponibles en este momento. Por favor, inténtalo más tarde."
          />
        )
      }
    </section>
  </main>
</Layout>
