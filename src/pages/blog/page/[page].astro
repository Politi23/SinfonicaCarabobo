---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import MainHero from "../../../components/sections/MainHero.astro";
import BlogCard from "../../../components/blog/BlogCard.astro";
import Pagination from "../../../components/blog/Pagination.astro";
import WpOfflineError from "../../../components/ui/WpOfflineError.astro";
import { getBlogs, getBlogsPagination, type WPBlog } from "../../../config/wp-blogs";

const parsedPage = Number.parseInt(Astro.params.page ?? "1", 10);
const safePage = Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;

if (safePage === 1) {
  return Astro.redirect("/blog", 301);
}

let blogs: WPBlog[] = [];
let totalPages = 1;
let currentPage = safePage;

try {
  const pagination = await getBlogsPagination({ page: safePage, perPage: 6 });
  currentPage = pagination.currentPage;
  totalPages = pagination.totalPages;
  blogs = await getBlogs({ page: currentPage, perPage: 6 });

  if (safePage > totalPages && totalPages > 0) {
    return Astro.redirect(`/blog/page/${totalPages}`, 301);
  }
} catch (error) {
  console.error("Error cargando blogs:", error);
}
---

<Layout
  title={`Blog - Página ${currentPage}`}
  description="Noticias, novedades y artículos de la Orquesta Sinfónica de Carabobo."
  canonicalPath={`/blog/page/${currentPage}`}
  ogTitle={`Blog - Página ${currentPage}`}
  ogDescription="Noticias, novedades y artículos de la Orquesta Sinfónica de Carabobo."
  showLatestPosts={false}
>
  <MainHero
    title="Noticias y"
    titleHighlight="Actualidad"
    subtitle="Explora nuestras últimas noticias, eventos y experiencias musicales"
  />

  <main class="bg-white text-gray-800 min-h-screen py-12">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      {
        blogs.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
              {blogs.map((b) => (
                <BlogCard
                  title={b.title}
                  excerpt={b.excerpt}
                  image={b.image}
                  date={b.date}
                  category={b.category}
                  slug={b.slug}
                />
              ))}
            </div>

            {totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl="/blog"
              />
            )}
          </>
        ) : (
          <WpOfflineError
            title="No hay publicaciones disponibles"
            message="Lo sentimos, no hay publicaciones disponibles en este momento. Por favor, inténtalo más tarde."
          />
        )
      }
    </section>
  </main>
</Layout>
