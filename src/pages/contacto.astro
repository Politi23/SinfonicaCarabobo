---
import Layout from "../layouts/Layout.astro";

const contactInfo = {
    address: "Salón MZ-08, Hotel Hesperia WTC, Naguanagua, Estado Carabobo",
    mapLink: "https://maps.app.goo.gl/SJNfCHHdVyTuy3hL6",
    phone: "+58 0414-341-0642",
    phoneLink: "tel:04143410642",
    email: "sinfocarabobo@gmail.com",
    emailLink: "mailto:sinfocarabobo@gmail.com",
};

const socialLinks = [
    {
        href: "https://www.facebook.com/sinfonicarabobo/",
        label: "Facebook",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
    },
    {
        href: "https://www.instagram.com/sinfocarabobo",
        label: "Instagram",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
    },
    {
        href: "https://x.com/SinfoniCarabobo",
        label: "X",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
    },
    {
        href: "https://www.youtube.com/@sinfocarabobo",
        label: "YouTube",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
    },
];
---

<Layout title="Contacto | Orquesta Sinfónica de Carabobo">
    <!-- HERO MINIMALISTA -->
    <section class="relative bg-black overflow-hidden">
        <div
            class="absolute inset-0 opacity-20 bg-[url('/sinfonica.webp')] bg-cover bg-center"
        >
        </div>
        <div
            class="absolute inset-0 bg-gradient-to-b from-black via-black/95 to-background-dark"
        >
        </div>

        <div
            class="relative z-10 container mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-24 text-center"
        >
            <div class="max-w-3xl mx-auto">
                <div class="flex items-center justify-center gap-4 mb-6">
                    <div class="w-16 h-[2px] bg-primary"></div>
                    <span
                        class="text-primary text-sm tracking-[0.2em] uppercase font-medium"
                        >Contacto</span
                    >
                    <div class="w-16 h-[2px] bg-primary"></div>
                </div>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight mb-6"
                >
                    Comunícate con la<br />
                    <span class="text-primary">Orquesta Sinfónica</span>
                </h1>
                <p
                    class="text-lg text-gray-400 font-serif leading-relaxed max-w-xl mx-auto"
                >
                    Para consultas sobre conciertos, audiciones, alianzas
                    institucionales o propuestas culturales, nuestro equipo está
                    a tu disposición.
                </p>
            </div>
        </div>
    </section>

    <!-- INFORMACIÓN DE CONTACTO - BARRA HORIZONTAL -->
    <section class="bg-surface-dark border-y border-primary/10">
        <div class="container mx-auto px-6">
            <div
                class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-primary/10"
            >
                <!-- Teléfono -->
                <div class="py-8 md:py-10 md:pr-8">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-10 h-10 border border-primary/30 rounded flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                class="text-primary"
                                ><path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs text-gray-500 uppercase tracking-wider mb-1"
                            >
                                Teléfono
                            </p>
                            <a
                                href={contactInfo.phoneLink}
                                class="text-white font-medium hover:text-primary transition-colors"
                            >
                                {contactInfo.phone}
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Correo -->
                <div class="py-8 md:py-10 md:px-8">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-10 h-10 border border-primary/30 rounded flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                class="text-primary"
                                ><path
                                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                ></path><polyline points="22,6 12,13 2,6"
                                ></polyline></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs text-gray-500 uppercase tracking-wider mb-1"
                            >
                                Correo Electrónico
                            </p>
                            <a
                                href={contactInfo.emailLink}
                                class="text-white font-medium hover:text-primary transition-colors"
                            >
                                {contactInfo.email}
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Dirección -->
                <div class="py-8 md:py-10 md:pl-8">
                    <div class="flex items-center gap-4">
                        <div
                            class="w-10 h-10 border border-primary/30 rounded flex items-center justify-center"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                class="text-primary"
                                ><path
                                    d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                                ></path><circle cx="12" cy="10" r="3"
                                ></circle></svg
                            >
                        </div>
                        <div>
                            <p
                                class="text-xs text-gray-500 uppercase tracking-wider mb-1"
                            >
                                Sede
                            </p>
                            <a
                                href={contactInfo.mapLink}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-white font-medium hover:text-primary transition-colors text-sm"
                            >
                                Hotel Hesperia WTC, Naguanagua
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTENIDO PRINCIPAL -->
    <section class="py-20 md:py-28 bg-background-dark">
        <div class="container mx-auto px-6 max-w-6xl">
            <div class="grid lg:grid-cols-5 gap-16">
                <!-- FORMULARIO (3 columnas) -->
                <div class="lg:col-span-3">
                    <div class="mb-10">
                        <h2
                            class="text-2xl md:text-3xl font-display font-bold text-white mb-4"
                        >
                            Envíanos un mensaje
                        </h2>
                        <p class="text-gray-400 font-serif leading-relaxed">
                            Si deseas información sobre nuestras temporadas de
                            conciertos, programas educativos, oportunidades de
                            patrocinio o cualquier otra consulta, completa el
                            siguiente formulario.
                        </p>
                    </div>

                    <form class="space-y-6" onsubmit="event.preventDefault();">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="contact-name"
                                    class="block text-sm text-gray-400 mb-2"
                                    >Nombre completo <span class="text-primary"
                                        >*</span
                                    ></label
                                >
                                <input
                                    type="text"
                                    id="contact-name"
                                    name="name"
                                    required
                                    class="w-full px-0 py-3 bg-transparent border-0 border-b border-gray-700 text-white placeholder-gray-600 focus:outline-none focus:border-primary transition-colors font-serif"
                                    placeholder="Ingresa tu nombre"
                                />
                            </div>
                            <div>
                                <label
                                    for="contact-email"
                                    class="block text-sm text-gray-400 mb-2"
                                    >Correo electrónico <span
                                        class="text-primary">*</span
                                    ></label
                                >
                                <input
                                    type="email"
                                    id="contact-email"
                                    name="email"
                                    required
                                    class="w-full px-0 py-3 bg-transparent border-0 border-b border-gray-700 text-white placeholder-gray-600 focus:outline-none focus:border-primary transition-colors font-serif"
                                    placeholder="tucorreo@ejemplo.com"
                                />
                            </div>
                        </div>

                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="contact-phone"
                                    class="block text-sm text-gray-400 mb-2"
                                    >Teléfono</label
                                >
                                <input
                                    type="tel"
                                    id="contact-phone"
                                    name="phone"
                                    class="w-full px-0 py-3 bg-transparent border-0 border-b border-gray-700 text-white placeholder-gray-600 focus:outline-none focus:border-primary transition-colors font-serif"
                                    placeholder="+58 0000-0000000"
                                />
                            </div>
                            <div>
                                <label
                                    for="contact-subject"
                                    class="block text-sm text-gray-400 mb-2"
                                    >Asunto</label
                                >
                                <select
                                    id="contact-subject"
                                    name="subject"
                                    class="w-full px-0 py-3 bg-transparent border-0 border-b border-gray-700 text-white focus:outline-none focus:border-primary transition-colors font-serif cursor-pointer"
                                >
                                    <option value="" class="bg-surface-dark"
                                        >Selecciona un asunto</option
                                    >
                                    <option
                                        value="conciertos"
                                        class="bg-surface-dark"
                                        >Información sobre conciertos</option
                                    >
                                    <option
                                        value="audiciones"
                                        class="bg-surface-dark"
                                        >Audiciones y convocatorias</option
                                    >
                                    <option
                                        value="patrocinio"
                                        class="bg-surface-dark"
                                        >Patrocinio y alianzas</option
                                    >
                                    <option
                                        value="educacion"
                                        class="bg-surface-dark"
                                        >Programas educativos</option
                                    >
                                    <option
                                        value="prensa"
                                        class="bg-surface-dark"
                                        >Prensa y medios</option
                                    >
                                    <option value="otro" class="bg-surface-dark"
                                        >Otro</option
                                    >
                                </select>
                            </div>
                        </div>

                        <div>
                            <label
                                for="contact-message"
                                class="block text-sm text-gray-400 mb-2"
                                >Mensaje <span class="text-primary">*</span
                                ></label
                            >
                            <textarea
                                id="contact-message"
                                name="message"
                                rows="4"
                                required
                                class="w-full px-0 py-3 bg-transparent border-0 border-b border-gray-700 text-white placeholder-gray-600 focus:outline-none focus:border-primary transition-colors font-serif resize-none"
                                placeholder="Describe tu consulta o propuesta..."
                            ></textarea>
                        </div>

                        <div class="pt-4">
                            <button
                                type="submit"
                                class="group inline-flex items-center gap-4 px-8 py-4 bg-primary text-black font-semibold hover:bg-primary-light transition-all duration-300"
                            >
                                <span>Enviar mensaje</span>
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    class="group-hover:translate-x-1 transition-transform"
                                    ><line x1="5" y1="12" x2="19" y2="12"
                                    ></line><polyline points="12 5 19 12 12 19"
                                    ></polyline></svg
                                >
                            </button>
                        </div>
                    </form>
                </div>

                <!-- SIDEBAR (2 columnas) -->
                <div class="lg:col-span-2 space-y-10">
                    <!-- Horario de Atención -->
                    <div>
                        <h3
                            class="text-lg font-display font-semibold text-white mb-4 flex items-center gap-3"
                        >
                            <div class="w-8 h-[1px] bg-primary"></div>
                            Horario de Atención
                        </h3>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between text-gray-400">
                                <span>Lunes a Viernes</span>
                                <span class="text-white">9:00 AM - 5:00 PM</span
                                >
                            </div>
                            <div class="flex justify-between text-gray-400">
                                <span>Sábados</span>
                                <span class="text-white"
                                    >9:00 AM - 12:00 PM</span
                                >
                            </div>
                            <div class="flex justify-between text-gray-400">
                                <span>Domingos</span>
                                <span class="text-gray-500">Cerrado</span>
                            </div>
                        </div>
                    </div>

                    <!-- Ubicación con Mapa -->
                    <div>
                        <h3
                            class="text-lg font-display font-semibold text-white mb-4 flex items-center gap-3"
                        >
                            <div class="w-8 h-[1px] bg-primary"></div>
                            Nuestra Ubicación
                        </h3>
                        <p class="text-gray-400 text-sm mb-4 leading-relaxed">
                            {contactInfo.address}
                        </p>
                        <div
                            class="rounded overflow-hidden border border-gray-800"
                        >
                            <iframe
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3926.313463878644!2d-68.00552392415714!3d10.236254789882208!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e805d762174c81d%3A0xe549bd84f22af505!2sHotel%20Hesperia%20WTC%20Valencia!5e0!3m2!1ses!2sve!4v1709080000000!5m2!1ses!2sve"
                                width="100%"
                                height="180"
                                style="border:0;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                class="block grayscale hover:grayscale-0 transition-all duration-500"
                            ></iframe>
                        </div>
                        <a
                            href={contactInfo.mapLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 text-primary text-sm mt-3 hover:underline"
                        >
                            <span>Ver en Google Maps</span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                ><path
                                    d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                                ></path><polyline points="15 3 21 3 21 9"
                                ></polyline><line x1="10" y1="14" x2="21" y2="3"
                                ></line></svg
                            >
                        </a>
                    </div>

                    <!-- Redes Sociales -->
                    <div>
                        <h3
                            class="text-lg font-display font-semibold text-white mb-4 flex items-center gap-3"
                        >
                            <div class="w-8 h-[1px] bg-primary"></div>
                            Redes Sociales
                        </h3>
                        <div class="flex gap-3">
                            {
                                socialLinks.map((social) => (
                                    <a
                                        href={social.href}
                                        aria-label={social.label}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="w-10 h-10 border border-gray-700 rounded flex items-center justify-center text-gray-400 hover:border-primary hover:text-primary transition-all duration-300"
                                    >
                                        <Fragment set:html={social.icon} />
                                    </a>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
