            name: "Sede Central",
            location:
                "Salón MZ-08, Hotel Hesperia WTC, Naguanagua, Estado Carabobo",
            mapLink: "https://maps.app.goo.gl/SJNfCHHdVyTuy3hL6",
        },
        {
            name: "Sede Cultural",
            location:
                "Teatro Municipal de Valencia, Plaza Bolívar, Valencia, Edo. Carabobo",
            mapLink: "https://maps.app.goo.gl/example1",
        },
        {
            name: "Centro de Ensayos",
            location:
                "Casa de la Cultura, Av. Universidad, San Diego, Edo. Carabobo",
            mapLink: "https://maps.app.goo.gl/example2",
        },
        {
            name: "Oficina Administrativa",
            location:
                "Av. Universidad, Edificio Sinfónica, PB, Valencia, Edo. Carabobo",
            mapLink: "https://maps.app.goo.gl/example3",
        },
    ],
    phones: [
        {
            name: "Gerencia",
            number: "+58 0414-341-0642",
            link: "tel:04143410642",
        },
        {
            name: "Administración",
            number: "+58 0241-832-5678",
            link: "tel:02418325678",
        },
        {
            name: "Audiciones",
