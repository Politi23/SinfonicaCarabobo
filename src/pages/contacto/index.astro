---
import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import Schedule from "@components/contact/Schedule.astro";
import Locations from "@components/contact/Locations.astro";
import SocialMedia from "@components/contact/SocialMedia.astro";
import SectionTitle from "@components/contact/SectionTitle.astro";

const contactInfo = {
    addresses: [
        {
            name: "Sede Central",
            location:
                "Salón MZ-08, Hotel Hesperia WTC, Naguanagua, Estado Carabobo.",
            mapLink: "https://maps.app.goo.gl/SJNfCHHdVyTuy3hL6",
        },
        {
            name: "Extensión",
            location:
                "Universidad José Antonio Páez, Edif. 4, Piso 1, Ofic. 4164.",
            mapLink: "https://maps.app.goo.gl/WvifFzfKyH92J3xf7",
        },
    ],
    phones: [
        {
            name: "Administración",
            number: "+58 0414-341-0642",
            link: "tel:02418325678",
        },
    ],
    emails: [
        {
            name: "Gerencia",
            email: "gerencia@sinfocarabobo.com",
            link: "mailto:gerencia@sinfocarabobo.com",
        },
        {
            name: "Administración",
            email: "admin@sinfocarabobo.com",
            link: "mailto:admin@sinfocarabobo.com",
        },
    ],
};

const socialLinks = [
    {
        href: "https://www.facebook.com/sinfonicarabobo/",
        label: "Facebook",
        icon: "ph-facebook-logo",
    },
    {
        href: "https://www.instagram.com/sinfocarabobo",
        label: "Instagram",
        icon: "ph-instagram-logo",
    },
    {
        href: "https://www.youtube.com/@sinfocarabobo",
        label: "YouTube",
        icon: "ph-youtube-logo",
    },
    {
        href: "https://open.spotify.com",
        label: "Spotify",
        icon: "ph-spotify-logo",
    },
];
---

<Layout title="Contacto" showApoyanosSection={false}>
    <main class="bg-background-dark text-text-light">
        <MainHero
            title="Contáctanos"
            subtitle="Para mayor información, dudas o sugerencias"
        />

        <section class="py-20 md:py-28 bg-background-dark">
            <div class="container mx-auto px-6 max-w-5xl">
                <div class="space-y-16">
                    <Locations addresses={contactInfo.addresses} />

                    <div class="grid md:grid-cols-2 gap-16">
                        <Schedule />
                    </div>

                    <div>
                        <SectionTitle title="Teléfonos" />

                        <div class="flex flex-col">
                            {
                                contactInfo.phones.map((phone: any) => (
                                    <div>
                                        <h4 class="text-white font-medium mb-2">
                                            {phone.name}
                                        </h4>
                                        <p class="text-gray-400 text-sm mb-3 leading-relaxed">
                                            {phone.number}
                                        </p>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <div>
                        <SectionTitle title="Correos Electrónicos" />

                        <div class="flex flex-col">
                            {
                                contactInfo.emails.map((mail: any) => (
                                    <div>
                                        <h4 class="text-white font-medium mb-2">
                                            {mail.name}
                                        </h4>
                                        <p class="text-gray-400 text-sm mb-3 leading-relaxed">
                                            {mail.email}
                                        </p>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <SocialMedia socialLinks={socialLinks} />
                </div>
            </div>
        </section>
    </main></Layout
>
