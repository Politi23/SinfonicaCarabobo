---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { getEventoBySlugState } from "../../config/wp-eventos";
import type { WPEvento } from "../../config/wp-eventos"; // Importamos desde el archivo modificado
import { Image } from "astro:assets";
import ArticleContentDark from "@components/blog/ArticleContentDark.astro";
import EventDetailsCard from "@components/eventos/EventDetailsCard.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const { evento, offline } = await getEventoBySlugState(slug);

if (!evento && !offline) {
  return Astro.redirect("/404");
}

// --- HELPERS (CON PROTECCIÓN DE ERRORES) ---

// Formatear fecha
const formatAcfDate = (dateString: string) => {
  if (!dateString || dateString.length !== 8) return dateString;
  const year = dateString.substring(0, 4);
  const month = dateString.substring(4, 6);
  const day = dateString.substring(6, 8);
  const dateObj = new Date(Number(year), Number(month) - 1, Number(day));
  return dateObj.toLocaleDateString("es-VE", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

// Obtener imagen de forma segura (sin que rompa la página si no hay imagen)
const getImageUrl = (e: WPEvento) => {
  // Los signos ?. significan: "Si esto existe, continúa. Si no, detente y devuelve undefined"
  return e._embedded?.["wp:featuredmedia"]?.[0]?.source_url;
};

const featuredImage = evento ? getImageUrl(evento) || "" : "";
const eventDate = evento?.acf?.event_date
  ? formatAcfDate(evento.acf.event_date)
  : "Por confirmar";
const eventTime = evento?.acf?.event_time
  ? `${evento.acf.event_time.slice(0, 5)} hrs`
  : "Por confirmar";
const eventVenue = evento?.acf?.event_venue || "Por confirmar";
const eventPrice = evento?.acf?.event_price || "";
const hasContent = Boolean(evento?.content?.rendered?.trim());
const pageTitle = evento?.title.rendered ?? "Evento";
const pageDescription =
  evento?.acf?.event_description ??
  "No pudimos cargar este evento por una falla temporal de conexión.";
const pageCanonicalPath = evento
  ? `/eventos/${evento.slug}`
  : Astro.url.pathname;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={pageCanonicalPath}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogImage={featuredImage}
  showApoyanosSection={false}
  showLatestPosts={true}
>
  {
    evento ? (
      <>
        <div class="relative w-full h-[70vh] min-h-[400px] bg-gray-900 flex items-end overflow-hidden">
          <div class="absolute inset-0">
            {featuredImage ? (
              <Image
                src={featuredImage}
                alt={evento.title.rendered}
                class="w-full h-full object-cover"
                transition:name={`image-${evento.slug}`}
                width={1000}
                height={500}
                loading="eager"
              />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-black via-gray-900 to-black">
                <div class="absolute top-10 left-10 w-72 h-72 bg-primary rounded-full blur-[128px] opacity-20" />
                <div class="absolute bottom-10 right-10 w-96 h-96 bg-secondary rounded-full blur-[128px] opacity-20" />
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/10"></div>
          </div>

          <div class="container mx-auto px-4 pb-12 relative z-10">
            <a
              href="/eventos"
              class="inline-flex items-center gap-2 text-sm font-semibold text-primary-light hover:text-white transition-colors mb-6"
            >
              <i class="ph ph-arrow-left" aria-hidden="true" />
              Volver a eventos
            </a>
            <h1 class="text-4xl md:text-6xl font-display font-bold text-white mb-4">
              {evento.title.rendered}
            </h1>
            <p class="text-lg md:text-xl font-serif font-light text-zinc-200 max-w-2xl">
              {evento.acf?.event_description}
            </p>
          </div>
        </div>

        <div class="w-full bg-background-dark flex-grow">
          <main class="container mx-auto px-4 py-16">
            {hasContent ? (
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <div class="lg:col-span-2">
                  <ArticleContentDark>
                    <div set:html={evento.content.rendered} />
                  </ArticleContentDark>
                </div>

                <div class="space-y-8 z-20 lg:sticky lg:top-28 lg:self-start">
                  <EventDetailsCard
                    date={eventDate}
                    time={eventTime}
                    venue={eventVenue}
                    price={eventPrice}
                    contactHref="/contacto"
                  />
                </div>
              </div>
            ) : (
              <div class="max-w-md mx-auto">
                <EventDetailsCard
                  date={eventDate}
                  time={eventTime}
                  venue={eventVenue}
                  price={eventPrice}
                  contactHref="/contacto"
                />
              </div>
            )}
          </main>
        </div>
      </>
    ) : (
      <WpOfflineError
        title="Conexión temporalmente no disponible"
        message="No pudimos cargar este evento por una falla temporal en WordPress. Intentalo de nuevo en unos minutos."
        homeLink="/eventos"
        homeLinkText="Volver a eventos"
      />
    )
  }
</Layout>
