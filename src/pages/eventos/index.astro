---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import EventoCard from "@components/eventos/EventoCard.astro";
import Pagination from "@components/blog/Pagination.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";
import { getEventos, getEventosPagination } from "@config/wp-eventos";

const desdeFilter     = Astro.url.searchParams.get("desde")     ?? "";
const hastaFilter     = Astro.url.searchParams.get("hasta")     ?? "";
const ubicacionFilter = Astro.url.searchParams.get("ubicacion") ?? "";

const parsedQueryPage = Number.parseInt(
  Astro.url.searchParams.get("page") ?? "1",
  10,
);
const normalizedQueryPage =
  Number.isFinite(parsedQueryPage) && parsedQueryPage > 0 ? parsedQueryPage : 1;

const hasExtraFilter = Boolean(desdeFilter || hastaFilter || ubicacionFilter);

if (normalizedQueryPage > 1 && !hasExtraFilter) {
  return Astro.redirect(`/eventos/page/${normalizedQueryPage}`, 301);
}

const perPage = 6;

const desdeACF = desdeFilter ? desdeFilter.replace(/-/g, "") : "";
const hastaACF = hastaFilter ? hastaFilter.replace(/-/g, "") : "";

const truncateExcerpt = (text: string, wordLimit: number = 25): string => {
  if (!text) return "";
  const words = text.split(" ");
  if (words.length <= wordLimit) return text;
  return words.slice(0, wordLimit).join(" ") + "...";
};

let eventos: Array<{
  title: string;
  excerpt: string;
  image: string;
  date: string;
  time: string;
  venue: string;
  slug: string;
}> = [];
let totalPages = 1;
let currentPage = 1;
let allVenues: string[] = [];

try {
  if (hasExtraFilter) {
    const all = await getEventos(100, 1);
    allVenues = [...new Set(all.map((e) => e.acf.event_venue).filter(Boolean))].sort();

    const filtered = all.filter((e) => {
      if (desdeACF && e.acf.event_date < desdeACF) return false;
      if (hastaACF && e.acf.event_date > hastaACF) return false;
      if (ubicacionFilter && e.acf.event_venue !== ubicacionFilter) return false;
      return true;
    });

    eventos = filtered.map((e) => ({
      title:   e.title.rendered,
      excerpt: truncateExcerpt(e.acf.event_description, 25),
      image:   e._embedded?.["wp:featuredmedia"]?.[0]?.source_url || "",
      date:    e.acf.event_date,
      time:    e.acf.event_time,
      venue:   e.acf.event_venue,
      slug:    e.slug,
    }));
    totalPages = 1;
    currentPage = 1;
  } else {
    const allForVenues = await getEventos(100, 1);
    allVenues = [...new Set(allForVenues.map((e) => e.acf.event_venue).filter(Boolean))].sort();

    const pagination = await getEventosPagination(1, perPage);
    currentPage = pagination.currentPage;
    totalPages = pagination.totalPages;
    const eventosToShow = await getEventos(perPage, currentPage);
    eventos = eventosToShow.map((e) => ({
      title:   e.title.rendered,
      excerpt: truncateExcerpt(e.acf.event_description, 25),
      image:   e._embedded?.["wp:featuredmedia"]?.[0]?.source_url || "",
      date:    e.acf.event_date,
      time:    e.acf.event_time,
      venue:   e.acf.event_venue,
      slug:    e.slug,
    }));
  }
} catch (error) {
  console.error("Error cargando eventos:", error);
}
---

<Layout
  title={currentPage > 1 ? `Eventos - Página ${currentPage}` : "Eventos"}
  description="Conciertos, recitales y actividades de la Orquesta Sinfónica de Carabobo."
  canonicalPath={currentPage > 1 ? `/eventos/page/${currentPage}` : "/eventos"}
  ogTitle="Eventos"
  ogDescription="Conciertos, recitales y actividades de la Orquesta Sinfónica de Carabobo."
  showApoyanosSection={false}
>
  <MainHero
    title="Próximos"
    titleHighlight="Eventos"
    subtitle="Explora nuestros próximos eventos, conciertos y actividades musicales"
  />

  <main class="bg-white text-gray-800 min-h-screen py-16">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

      <SearchBar
        placeholder="Buscar eventos..."
        showDates={true}
        showVenue={true}
        venues={allVenues}
        desdeValue={desdeFilter}
        hastaValue={hastaFilter}
        venueValue={ubicacionFilter}
      />

      {
        eventos.length > 0 ? (
          <>
            <div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
              {eventos.map((e) => (
                <div
                  data-search-card
                  data-search-text={`${e.title} ${e.excerpt} ${e.venue}`.toLowerCase()}
                >
                  <EventoCard
                    title={e.title}
                    excerpt={e.excerpt}
                    image={e.image}
                    date={e.date}
                    time={e.time}
                    venue={e.venue}
                    slug={e.slug}
                  />
                </div>
              ))}
            </div>

            {!hasExtraFilter && totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl="/eventos"
              />
            )}
          </>
        ) : (
          <WpOfflineError
            title="No hay eventos disponibles"
            message="Lo sentimos, no hay eventos disponibles en este momento. Por favor, inténtalo más tarde."
          />
        )
      }
    </section>
  </main>
</Layout>
