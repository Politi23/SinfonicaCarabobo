---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import StaticGallerySection from "../../components/global/StaticGallerySection.astro";
import { getAlbums } from "../../config/wp-albums";

const albums = await getAlbums();

// Importar imágenes estáticas por categoría
const orquestaImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/galeria/orquesta/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG,WEBP,GIF}",
  { eager: true },
);

const fundacionImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/galeria/fundacion/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG,WEBP,GIF}",
  { eager: true },
);

const academiaImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/galeria/academia/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG,WEBP,GIF}",
  { eager: true },
);

// Función helper para convertir imágenes
const processImages = (images: Record<string, { default: ImageMetadata }>) => {
  return Object.values(images).map((img) => ({
    src: img.default,
    alt: "Foto de galería",
  }));
};

const orquestaGallery = processImages(orquestaImages);
const fundacionGallery = processImages(fundacionImages);
const academiaGallery = processImages(academiaImages);
---

<Layout title="Galería Multimedia">
  <MainHero
    title="Nuestra"
    titleHighlight="Galería"
    subtitle="Momentos capturados en el tiempo"
  />

  <main class="bg-white text-gray-800">
    <!-- Dynamic Gallery Section (WordPress Albums) -->
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="container mx-auto px-6 max-w-7xl">
        <div class="max-w-4xl mx-auto mb-12">
          <span
            class="text-secondary text-xs font-bold uppercase tracking-[0.4em] mb-4 block italic"
          >
            Eventos Musicales
          </span>
          <h2
            class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-4"
          >
            Álbumes de Eventos
          </h2>
          <div class="w-16 h-1 bg-secondary"></div>
          <p class="text-gray-600 mt-6 text-lg leading-relaxed">
            Explora nuestra colección de álbumes fotográficos de conciertos,
            presentaciones y eventos musicales especiales.
          </p>
        </div>

        {
          albums.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {albums.map((album) => (
                <a
                  href={`/galeria/${album.slug}`}
                  class="group block bg-white rounded-xl overflow-hidden shadow-lg transition-all duration-300 hover:shadow-xl"
                >
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <img
                      src={album.coverImage}
                      alt={album.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-black/30 group-hover:bg-black/10 transition-colors duration-300" />

                    <div class="absolute bottom-3 right-3 bg-black/80 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1 shadow-lg">
                      <span class="material-icons text-sm">photo_library</span>
                      {album.photos.length}
                    </div>
                  </div>

                  <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors leading-tight mb-2">
                      {album.title}
                    </h3>
                    <p class="text-gray-500 text-sm font-medium flex items-center gap-1">
                      <span class="material-icons text-sm">event</span>
                      {new Date(album.date).toLocaleDateString("es-VE", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="text-center py-16 bg-white rounded-xl border border-gray-200">
              <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4">
                No se pudieron cargar los álbumes
              </h2>
              <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Lo sentimos, hubo un problema al intentar acceder a los álbumes
                de nuestra galería. Por favor, inténtalo más tarde.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Static Gallery - Orchestra Section -->
    {
      orquestaGallery.length > 0 && (
        <StaticGallerySection
          images={orquestaGallery}
          columns={3}
          title="Orquesta Sinfónica"
          subtitle="Música en Escena"
          sectionId="orquesta"
        />
      )
    }

    <!-- Static Gallery - Foundation Section -->
    {
      fundacionGallery.length > 0 && (
        <StaticGallerySection
          images={fundacionGallery}
          columns={3}
          title="Fundación y Eventos Institucionales"
          subtitle="Nuestra Institución"
          sectionId="fundacion"
        />
      )
    }

    <!-- Static Gallery - Academy Section -->
    {
      academiaGallery.length > 0 && (
        <StaticGallerySection
          images={academiaGallery}
          columns={3}
          title="Academia y Estudiantes"
          subtitle="Formación Musical"
          sectionId="academia"
        />
      )
    }
  </main>
</Layout>
