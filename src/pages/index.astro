---
import HeroHeader from "../components/home/HeroHeader.astro";
import ConciertosSection from "../components/home/ConciertosSection.astro";
import ConciertosSectionFallback from "../components/home/ConciertosSectionFallback.astro";
import Layout from "../layouts/Layout.astro";
import Allies from "../components/sections/Allies.astro";
import SocialImpact from "../components/home/SocialImpact.astro";
import BookLink from "../components/home/BookLink.astro";
import LatestBlogPosts from "../components/global/LatestBlogPostsIndex.astro";
import LatestBlogPostsIndexFallback from "../components/global/LatestBlogPostsIndexFallback.astro";
import ReconocimientosCTA from "@components/nosotros/ReconocimientosCTA.astro";
import EnsemblesSection from "../components/home/EnsemblesSection.astro";
import DonationCTA from "../components/apoyanos/DonationCTA.astro";
---

<Layout>
    <!-- Sección de Conciertos -->
    <HeroHeader />

    <!-- Sección de Conciertos -->
    <ConciertosSection server:defer>
      <ConciertosSectionFallback slot="fallback" />
    </ConciertosSection>

    <!-- Sección de últimas entradas del blog -->
    <LatestBlogPosts server:defer>
      <LatestBlogPostsIndexFallback slot="fallback" />
    </LatestBlogPosts>

    <!-- Seccion de la academia -->
    <SocialImpact />

    <!-- Sección de agrupaciones -->
    <EnsemblesSection />

    <!-- Sección de donaciones -->
    <!-- <DonationCTA /> -->

    <!-- Sección del libro conmemorativo -->
    <BookLink />

    <!-- Sección de Aliados -->
    <Allies />

    <!-- Sección de reconocimientos -->
    <ReconocimientosCTA />
</Layout>
