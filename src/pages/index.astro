---
import HeroHeader from "../components/home/HeroHeader.astro";
import ConciertosSection from "../components/home/ConciertosSection.astro";
import Layout from "../layouts/Layout.astro";
import Allies from "../components/sections/Allies.astro";
import SocialImpact from "../components/home/SocialImpact.astro";
import BookLink from "../components/home/BookLink.astro";
---

<Layout>
    <!-- Sección de Conciertos -->
    <HeroHeader />

    <!-- Sección de Conciertos -->
    <ConciertosSection perPage={9} itemsPerSlideDesktop={3} itemsPerSlideTablet={2} itemsPerSlideMobile={1} />

    <!-- Seccion de la academia -->
    <SocialImpact />

    <!-- Sección del libro conmemorativo -->
    <BookLink />

    <!-- Sección de Aliados -->
    <Allies />
</Layout>
