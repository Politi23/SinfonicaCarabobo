---
import Layout from "@layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import Gallery from "@components/libro/Gallery.astro";
import Quote from "@components/libro/Quote.astro";
import { getFoundationYears } from "../../utils/foundation";

const yearsOfHistory = getFoundationYears();
---

<Layout>
  <main class="bg-background-dark text-text-light pb-16">
    <MainHero
      title={`${yearsOfHistory} Años de`}
      titleHighlight="Historia"
      subtitle="Testimonio vivo de pasión y excelencia"
    />
    <Gallery />
    <Quote />
  </main>
</Layout>
