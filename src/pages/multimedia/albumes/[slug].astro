---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import ArticleContent from "@components/blog/ArticleContent.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";
import { getAlbumBySlug } from "@config/wp-albums";
import { Image } from "astro:assets";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

const album = await getAlbumBySlug(slug);

if (!album) {
	return Astro.redirect("/404");
}
---

<Layout title={album.title} showLatestPosts={true} showApoyanosSection={false}>
	<main class="bg-background-light min-h-screen">
		{album.coverImage && (
			<div class="w-full h-[70vh] grayscale">
				<Image
					src={album.coverImage}
					alt={album.excerpt}
					loading={"eager"}
					width={1000}
					height={1000}
					class={"w-full h-full object-top object-cover"}
				/>
				<div
					class="absolute inset-0 bg-gradient-to-bl from-black/60 via-black/25 to-transparent h-[70vh]"
				>
				</div>
				<div
					class="absolute inset-0 bg-gradient-to-bl from-black/50 via-transparent to-transparent h-[70vh]"
				>
				</div>
				<div
					class="absolute inset-0 bg-gradient-to-tr from-white/25 via-transparent to-transparent h-[70vh]"
				>
				</div>
			</div>
		)}

		<article
			class="layout-content-container flex flex-col w-full flex-1 px-4 lg:px-20 lg:py-8"
		>
			<div class="flex gap-3 mb-6">
				{
					album.category && (
						<div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/20 pl-3 pr-3">
							<p class="text-black text-xs font-bold uppercase tracking-wide leading-normal">
								{album.category}
							</p>
						</div>
					)
				}
			</div>

			<h1
				class="text-3xl md:text-5xl lg:text-6xl font-black text-text-dark mb-8 leading-tight"
			>
				{album.title}
			</h1>

			{
				album.excerpt && (
					<div class="flex flex-col gap-4 mb-10">
						<div class="text-xl text-text-dark/80 leading-relaxed italic border-l-4 border-primary pl-4">
							{album.excerpt}
						</div>
					</div>
				)
			}

			{
				album.content ? (
					<ArticleContent
						class="album-content"
						set:html={album.content}
					/>
				) : (
					<WpOfflineError
						title="No hay contenido disponible"
						message="Este album no tiene contenido publicado por ahora."
					/>
				)
			}
		</article>
	</main>

	<!-- Lightbox modal -->
	<div
		id="lightbox"
		class="fixed inset-0 z-[2000] bg-black/95 flex items-center justify-center opacity-0 invisible transition-all duration-300"
		role="dialog"
		aria-modal="true"
		aria-label="Vista de imagen"
	>
		<!-- Cerrar -->
		<button
			id="lightbox-close"
			class="absolute top-4 right-4 z-10 w-11 h-11 flex items-center justify-center text-white/70 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-all"
			aria-label="Cerrar"
		>
			<i class="ph ph-x text-2xl"></i>
		</button>

		<!-- Anterior -->
		<button
			id="lightbox-prev"
			class="absolute left-3 md:left-6 z-10 w-11 h-11 flex items-center justify-center text-white/70 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-all"
			aria-label="Imagen anterior"
		>
			<i class="ph ph-caret-left text-2xl"></i>
		</button>

		<!-- Siguiente -->
		<button
			id="lightbox-next"
			class="absolute right-3 md:right-6 z-10 w-11 h-11 flex items-center justify-center text-white/70 hover:text-white bg-black/40 hover:bg-black/60 rounded-full transition-all"
			aria-label="Imagen siguiente"
		>
			<i class="ph ph-caret-right text-2xl"></i>
		</button>

		<!-- Imagen -->
		<div class="w-full h-full flex flex-col items-center justify-center px-16 md:px-24">
			<img
				id="lightbox-img"
				src=""
				alt=""
				class="max-w-full max-h-[85vh] object-contain rounded-sm shadow-2xl select-none"
			/>
			<p id="lightbox-caption" class="mt-3 text-white/70 text-sm text-center max-w-2xl"></p>
			<p id="lightbox-counter" class="mt-1 text-white/40 text-xs"></p>
		</div>
	</div>

	<style is:global>
		.article-content.album-content
			:is(.wp-block-gallery, .blocks-gallery-grid) {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.6rem;
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.article-content.album-content
			:is(.wp-block-gallery, .blocks-gallery-grid)
			:is(.blocks-gallery-item, .wp-block-image, .wp-caption, figure) {
			margin: 0;
			width: 100% !important;
			text-shadow: 2px 2px 5px black;
		}

		.article-content.album-content
			:is(.blocks-gallery-item, .wp-block-image, .wp-caption, figure) {
			max-width: 100% !important;
		}

		.article-content.album-content
			:is(
				.blocks-gallery-item,
				.wp-block-image,
				.wp-caption,
				figure.wp-block-image
			) {
			position: relative;
			height: 100%;
			overflow: hidden;
			border-radius: 2px;
			cursor: pointer;
		}

		.article-content.album-content
			:is(
				.blocks-gallery-item img,
				.wp-block-image img,
				.wp-caption img,
				figure img
			) {
			display: block;
			width: 100% !important;
			height: 100% !important;
			object-fit: cover;
			max-width: 100% !important;
			margin: 0 !important;
			border-radius: 0px;
			transition: transform 0.3s ease, filter 0.3s ease;
		}

		.article-content.album-content
			:is(
				.blocks-gallery-item,
				.wp-block-image,
				.wp-caption,
				figure.wp-block-image
			):hover img {
			transform: scale(1.03);
			filter: brightness(1.1);
		}

		.article-content.album-content
			:is(
				.wp-caption figcaption,
				.wp-block-image figcaption,
				.blocks-gallery-item figcaption,
				figcaption.wp-element-caption,
				.wp-caption-text
			) {
			display: block !important;
			visibility: visible !important;
			opacity: 1 !important;
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 1;
			margin: 0 !important;
			padding: 0.75rem 0.1rem;
			color: #fff !important;
			font-size: 0.875rem;
			line-height: 1.35;
			text-align: left;
			background: linear-gradient(
				to top,
				rgba(0, 0, 0, 0.72),
				rgba(0, 0, 0, 0)
			);
		}

		@media (max-width: 600px) {
			.article-content.album-content
				:is(.wp-block-gallery, .blocks-gallery-grid) {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<script>
		const lightbox = document.getElementById("lightbox");
		const lbImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
		const lbCaption = document.getElementById("lightbox-caption");
		const lbCounter = document.getElementById("lightbox-counter");
		const lbClose = document.getElementById("lightbox-close");
		const lbPrev = document.getElementById("lightbox-prev");
		const lbNext = document.getElementById("lightbox-next");

		let images: { src: string; caption: string }[] = [];
		let current = 0;

		const show = (index: number) => {
			if (!lbImg || !lightbox) return;
			current = (index + images.length) % images.length;
			lbImg.src = images[current].src;
			lbImg.alt = images[current].caption;
			if (lbCaption) lbCaption.textContent = images[current].caption;
			if (lbCounter) lbCounter.textContent = `${current + 1} / ${images.length}`;
		};

		const open = (index: number) => {
			show(index);
			lightbox?.classList.remove("opacity-0", "invisible");
			lightbox?.classList.add("opacity-100", "visible");
			document.body.style.overflow = "hidden";
		};

		const close = () => {
			lightbox?.classList.add("opacity-0", "invisible");
			lightbox?.classList.remove("opacity-100", "visible");
			document.body.style.overflow = "";
		};

		// Collect all images from the album content after DOM is ready
		const init = () => {
			const content = document.querySelector(".album-content");
			if (!content) return;

			const imgs = content.querySelectorAll<HTMLImageElement>("img");
			images = Array.from(imgs).map((img) => {
				const caption =
					img.closest("figure")?.querySelector("figcaption")?.textContent?.trim() || "";
				return { src: img.src, caption };
			});

			imgs.forEach((img, i) => {
				const wrapper = img.closest("figure, .blocks-gallery-item, .wp-block-image, .wp-caption");
				if (wrapper) {
					(wrapper as HTMLElement).addEventListener("click", () => open(i));
				} else {
					img.style.cursor = "pointer";
					img.addEventListener("click", () => open(i));
				}
			});
		};

		lbClose?.addEventListener("click", close);
		lbPrev?.addEventListener("click", () => show(current - 1));
		lbNext?.addEventListener("click", () => show(current + 1));

		lightbox?.addEventListener("click", (e) => {
			if (e.target === lightbox) close();
		});

		document.addEventListener("keydown", (e) => {
			if (!lightbox?.classList.contains("visible")) return;
			if (e.key === "Escape") close();
			if (e.key === "ArrowLeft") show(current - 1);
			if (e.key === "ArrowRight") show(current + 1);
		});

		// Touch swipe support
		let touchStartX = 0;
		lightbox?.addEventListener("touchstart", (e) => {
			touchStartX = e.touches[0].clientX;
		});
		lightbox?.addEventListener("touchend", (e) => {
			const dx = e.changedTouches[0].clientX - touchStartX;
			if (Math.abs(dx) > 50) dx < 0 ? show(current + 1) : show(current - 1);
		});

		document.addEventListener("DOMContentLoaded", init);
		// Fallback for Astro view transitions
		document.addEventListener("astro:page-load", init);
		init();
	</script>
</Layout>
