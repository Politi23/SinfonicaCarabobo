---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import ArticleContent from "@components/blog/ArticleContent.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";
import { getAlbumBySlug } from "@config/wp-albums";
import { Image } from "astro:assets";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

const album = await getAlbumBySlug(slug);

if (!album) {
	return Astro.redirect("/404");
}
---

<Layout title={album.title} showLatestPosts={true} showApoyanosSection={false}>
	<main class="bg-background-light min-h-screen">
		<div class="w-full h-[50vh]">
			<Image
				src={album.coverImage}
				alt={album.excerpt}
				loading={"eager"}
				width={1000}
				height={1000}
				class={"w-full h-full object-top object-cover"}
			/>
			<div
				class="absolute inset-0 bg-gradient-to- from-red-800 via-transparent to-transparent h-[50vh]"
			>
			</div>
		</div>

		<article
			class="layout-content-container flex flex-col w-full flex-1 px-4 lg:px-20 lg:py-16"
		>
			<div class="flex gap-3 mb-6">
				{
					album.category && (
						<div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded-full bg-primary/20 pl-3 pr-3">
							<p class="text-black text-xs font-bold uppercase tracking-wide leading-normal">
								{album.category}
							</p>
						</div>
					)
				}
			</div>

			<h1
				class="text-3xl md:text-5xl lg:text-6xl font-black text-text-dark mb-8 leading-tight"
			>
				{album.title}
			</h1>

			{
				album.excerpt && (
					<div class="flex flex-col gap-4 mb-10">
						<div class="text-xl text-text-dark/80 leading-relaxed italic border-l-4 border-primary pl-4">
							{album.excerpt}
						</div>
					</div>
				)
			}

			{
				album.content ? (
					<ArticleContent
						class="album-content"
						set:html={album.content}
					/>
				) : (
					<WpOfflineError
						title="No hay contenido disponible"
						message="Este album no tiene contenido publicado por ahora."
					/>
				)
			}
		</article>
	</main>

	<style is:global>
		.article-content.album-content
			:is(.wp-block-gallery, .blocks-gallery-grid) {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.6rem;
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.article-content.album-content
			:is(.wp-block-gallery, .blocks-gallery-grid)
			:is(.blocks-gallery-item, .wp-block-image, .wp-caption, figure) {
			margin: 0;
			width: 100% !important;
		}

		.article-content.album-content
			:is(.blocks-gallery-item, .wp-block-image, .wp-caption, figure) {
			max-width: 100% !important;
		}

		.article-content.album-content
			:is(
				.blocks-gallery-item,
				.wp-block-image,
				.wp-caption,
				figure.wp-block-image
			) {
			position: relative;
			overflow: hidden;
			border-radius: 2px;
		}

		.article-content.album-content
			:is(
				.blocks-gallery-item img,
				.wp-block-image img,
				.wp-caption img,
				figure img
			) {
			display: block;
			width: 100% !important;
			height: 350px !important;
			object-fit: cover;
			max-width: 100% !important;
			margin: 0 !important;
			border-radius: 0px;
		}

		.article-content.album-content
			:is(
				.wp-caption figcaption,
				.wp-block-image figcaption,
				.blocks-gallery-item figcaption,
				figcaption.wp-element-caption,
				.wp-caption-text
			) {
			display: block !important;
			visibility: visible !important;
			opacity: 1 !important;
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 1;
			margin: 0 !important;
			padding: 0.75rem 0.1rem;
			color: #fff !important;
			font-size: 0.875rem;
			line-height: 1.35;
			text-align: left;
			background: linear-gradient(
				to top,
				rgba(0, 0, 0, 0.72),
				rgba(0, 0, 0, 0)
			);
		}

		@media (max-width: 600px) {
			.article-content.album-content
				:is(.wp-block-gallery, .blocks-gallery-grid) {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Layout>
