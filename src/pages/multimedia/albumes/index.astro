---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import Pagination from "@components/blog/Pagination.astro";
import FilterBar from "@components/ui/FilterBar.astro";
import SearchBar from "@components/ui/SearchBar.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";
import AlbumCard from "@components/galeria/AlbumCard.astro";
import {
	getAlbums,
	getAllAlbums,
	getAlbumCategories,
	getAlbumsPagination,
	type WPAlbum,
} from "@config/wp-albums";

const ordenFilter     = Astro.url.searchParams.get("orden")     ?? "";
const categoriaFilter = Astro.url.searchParams.get("categoria") ?? "";
const desdeFilter     = Astro.url.searchParams.get("desde")     ?? "";
const hastaFilter     = Astro.url.searchParams.get("hasta")     ?? "";

const parsedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const requestedPage = Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;

type OrderBy = "date" | "title" | "modified";
type Order   = "asc"  | "desc";

const ordenMap: Record<string, { orderby: OrderBy; order: Order }> = {
	recientes: { orderby: "date",  order: "desc" },
	antiguos:  { orderby: "date",  order: "asc"  },
	az:        { orderby: "title", order: "asc"  },
	za:        { orderby: "title", order: "desc" },
};

const { orderby, order } = ordenMap[ordenFilter] ?? { orderby: "date", order: "desc" };

const hasDateFilter = Boolean(desdeFilter || hastaFilter);

let albums: WPAlbum[] = [];
let totalPages = 1;
let currentPage = 1;

try {
	if (categoriaFilter || hasDateFilter) {
		const all = await getAllAlbums();
		let filtered = all;

		if (categoriaFilter) {
			filtered = filtered.filter(
				(a) => a.category.toLowerCase() === categoriaFilter.toLowerCase(),
			);
		}

		if (desdeFilter) {
			filtered = filtered.filter((a) => a.date >= desdeFilter);
		}
		if (hastaFilter) {
			filtered = filtered.filter((a) => a.date <= hastaFilter + "T23:59:59");
		}

		albums = filtered;
	} else {
		const pagination = await getAlbumsPagination(requestedPage, 9);
		currentPage = pagination.currentPage;
		totalPages = pagination.totalPages;
		albums = await getAlbums(currentPage, 9, orderby, order);
	}
} catch (error) {
	console.error("Error cargando albums:", error);
}

const albumCategories = await getAlbumCategories();

const categoryOptions = albumCategories.map((c) => ({ label: c, value: c }));
---

<Layout
	title={categoriaFilter ? `Álbumes · ${categoriaFilter}` : "Álbumes de Fotos"}
	showApoyanosSection={false}
>
	<MainHero title="Álbumes de" titleHighlight="Fotos" />

	<main class="bg-white text-gray-800 min-h-screen py-12">
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">

			<SearchBar
				placeholder="Buscar álbumes..."
				showDates={true}
				desdeValue={desdeFilter}
				hastaValue={hastaFilter}
			/>

			{categoryOptions.length > 0 && (
				<div class="mb-8 border-b border-gray-200 pb-6">
					<FilterBar
						options={categoryOptions}
						active={categoriaFilter}
						param="categoria"
						allLabel="Todas las categorías"
						label="Categoría"
					/>
				</div>
			)}

			{
				albums.length > 0 ? (
					<>
						<div id="cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
							{albums.map((album) => (
								<div
									data-search-card
									data-search-text={`${album.title} ${album.excerpt || ""} ${album.category}`.toLowerCase()}
								>
									<AlbumCard
										title={album.title}
										excerpt={album.excerpt}
										coverImage={album.coverImage}
										date={album.date}
										dateTaken={album.dateTaken}
										category={album.category}
										slug={album.slug}
										photoCount={album.photos.length}
									/>
								</div>
							))}
						</div>

						{!categoriaFilter && !hasDateFilter && totalPages > 1 && (
							<Pagination
								currentPage={currentPage}
								totalPages={totalPages}
								baseUrl="/multimedia/albumes"
								useQueryPagination={true}
							/>
						)}
					</>
				) : (
					<WpOfflineError
						title="No hay álbumes disponibles"
						message="Lo sentimos, no hay álbumes disponibles en este momento. Por favor, intentalo mas tarde."
					/>
				)
			}
		</section>
	</main>
</Layout>
