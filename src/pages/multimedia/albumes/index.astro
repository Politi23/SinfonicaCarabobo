---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import Pagination from "@components/blog/Pagination.astro";
import WpOfflineError from "@components/ui/WpOfflineError.astro";
import AlbumCard from "@components/galeria/AlbumCard.astro";
import {
	getAlbums,
	getAlbumsPagination,
	type WPAlbum,
} from "@config/wp-albums";

const parsedPage = Number.parseInt(
	Astro.url.searchParams.get("page") ?? "1",
	10,
);
const requestedPage =
	Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;

let albums: WPAlbum[] = [];
let totalPages = 1;
let currentPage = 1;

try {
	const pagination = await getAlbumsPagination(requestedPage, 9);
	currentPage = pagination.currentPage;
	totalPages = pagination.totalPages;
	albums = await getAlbums(currentPage, 9);
} catch (error) {
	console.error("Error cargando albums:", error);
}
---

<Layout title="Albums de Eventos" showApoyanosSection={false}>
	<MainHero
		title="Albumes de"
		titleHighlight="Eventos"
		subtitle="Explora los momentos destacados de nuestra historia musical"
	/>

	<main class="bg-white text-gray-800 min-h-screen py-12">
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
			{
				albums.length > 0 ? (
					<>
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
							{albums.map((album) => (
								<AlbumCard
									title={album.title}
									excerpt={album.excerpt}
									coverImage={album.coverImage}
									date={album.date}
									dateTaken={album.dateTaken}
									category={album.category}
									slug={album.slug}
									photoCount={album.photos.length}
								/>
							))}
						</div>

						{totalPages > 1 && (
							<Pagination
								currentPage={currentPage}
								totalPages={totalPages}
								baseUrl="/multimedia/albumes"
								useQueryPagination={true}
							/>
						)}
					</>
				) : (
					<WpOfflineError
						title="No hay álbumes disponibles"
						message="Lo sentimos, no hay álbumes disponibles en este momento. Por favor, intentalo mas tarde."
					/>
				)
			}
		</section>
	</main>
</Layout>
