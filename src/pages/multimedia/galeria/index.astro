---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import Pagination from "@components/blog/Pagination.astro";
import { fetchImageMedia, getImageMediaPagination } from "@config/wp-media";
import type { WPMediaImage } from "@config/wp-media";
import { Image } from "astro:assets";

const parsedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const requestedPage = Number.isFinite(parsedPage) && parsedPage > 0 ? parsedPage : 1;

let images: WPMediaImage[] = [];
let totalPages = 1;
let currentPage = 1;

try {
  const pagination = await getImageMediaPagination(requestedPage);
  currentPage = pagination.currentPage;
  totalPages = pagination.totalPages;
  images = await fetchImageMedia(currentPage);
} catch (error) {
  console.error("Error cargando galeria:", error);
}
---

<Layout title={`Imagenes - Galeria - Pagina ${currentPage}`}>
  <MainHero
    title="Galería"
    titleHighlight=""
    subtitle="Un vistazo a nuestros momentos"
  />

  <main class="bg-white p-16">
    <div class="masonry">
      {
        images.map(({ source_url, alt_text, media_details }, index) => {
          return (
            <div class="masonry-item rounded-sm bg-gray-100">
              <Image
                src={source_url}
                alt={alt_text ?? index.toString()}
                width={media_details?.width ?? 100}
                height={media_details?.height ?? 100}
                class="w-full object-cover rounded-sm"
              />
            </div>
          );
        })
      }
    </div>

    {
      totalPages > 1 && (
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          baseUrl="/multimedia/galeria"
          useQueryPagination={true}
        />
      )
    }
  </main>

  <style>
    .masonry {
      column-count: 1;
      column-gap: 0.5rem;
    }

    .masonry-item {
      break-inside: avoid;
      margin-bottom: 0.5rem;
    }

    @media (min-width: 640px) {
      .masonry {
        column-count: 2;
      }
    }

    @media (min-width: 768px) {
      .masonry {
        column-count: 3;
      }
    }

    @media (min-width: 1024px) {
      .masonry {
        column-count: 4;
      }
    }
  </style>
</Layout>
