---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroHeader from "../components/HeroHeader.astro";
---

<Layout>
    <Header />

    <main class="bg-[#FDFBF7] text-gray-800">
        <!-- HERO SECTION -->
        <HeroHeader />

        <!-- FUNDACIÓN INFO ("Quiénes Somos") -->
        <section
            class="py-24 md:py-32 relative overflow-hidden"
            id="quienes-somos"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-accent-yellow text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Esencia</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-gray-900 mb-12"
                    >
                        El Alma Musical<br /><span
                            class="text-accent-yellow italic">de Carabobo</span
                        >
                    </h2>

                    <div
                        class="max-w-4xl space-y-8 text-lg md:text-xl leading-relaxed text-gray-600 font-serif"
                    >
                        <p>
                            La Fundación Orquesta Sinfónica de Carabobo (FOSC)
                            es una organización sin fines de lucro que, desde el
                            14 de diciembre de 1993, se ha dedicado al cultivo,
                            desarrollo y divulgación de la música sinfónica.
                        </p>
                        <p>
                            Nos caracterizamos por ofrecer espectáculos de alta
                            factura en espacios convencionales y no
                            convencionales, democratizando el acceso a la
                            cultura y formando a las nuevas generaciones.
                        </p>
                    </div>
                </div>

                <!-- Cards Grid -->
                <div class="grid md:grid-cols-3 gap-8 mb-32">
                    <!-- Misión -->
                    <div
                        class="group bg-white p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-gray-100"
                    >
                        <div
                            class="w-12 h-12 bg-accent-yellow/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-accent-yellow/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-accent-yellow"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                            >
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-gray-900"
                        >
                            Misión
                        </h3>
                        <p class="text-gray-600 leading-relaxed">
                            Transformar vidas a través de la educación de
                            líderes con pensamiento crítico mediante la
                            ejecución de la música sinfónica.
                        </p>
                    </div>

                    <!-- Visión -->
                    <div
                        class="group bg-white p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-gray-100"
                    >
                        <div
                            class="w-12 h-12 bg-accent-yellow/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-accent-yellow/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-accent-yellow"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-gray-900"
                        >
                            Visión
                        </h3>
                        <p class="text-gray-600 leading-relaxed">
                            Ser vanguardia nacional e internacional en el
                            desarrollo, divulgación y enseñanza de la música
                            sinfónica.
                        </p>
                    </div>

                    <!-- Valores -->
                    <div
                        class="group bg-white p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-gray-100"
                    >
                        <div
                            class="w-12 h-12 bg-accent-yellow/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-accent-yellow/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-accent-yellow"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-gray-900"
                        >
                            Valores
                        </h3>
                        <ul class="text-gray-600 space-y-2">
                            <li class="flex items-center gap-3">
                                <span
                                    class="w-1.5 h-1.5 rounded-full bg-accent-yellow"
                                ></span> Sentido de pertenencia
                            </li>
                            <li class="flex items-center gap-3">
                                <span
                                    class="w-1.5 h-1.5 rounded-full bg-accent-yellow"
                                ></span> Excelencia y Disciplina
                            </li>
                            <li class="flex items-center gap-3">
                                <span
                                    class="w-1.5 h-1.5 rounded-full bg-accent-yellow"
                                ></span> Empatía y Respeto
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Objetivos -->
                <div
                    class="bg-white rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-gray-100"
                >
                    <div class="grid md:grid-cols-2 gap-16">
                        <div>
                            <h3
                                class="text-3xl font-display font-bold mb-6 text-gray-900"
                            >
                                Objetivo General
                            </h3>
                            <p class="text-gray-600 leading-relaxed text-lg">
                                Contribuir con el conocimiento, desarrollo y
                                divulgación masiva de la música sinfónica
                                ejecutada con altos estándares de calidad y el
                                fortalecimiento de las capacidades musicales.
                            </p>
                        </div>
                        <div class="relative">
                            <div
                                class="absolute left-0 top-0 bottom-0 w-px bg-gray-100 hidden md:block"
                            >
                            </div>
                            <div class="md:pl-16">
                                <h3
                                    class="text-3xl font-display font-bold mb-6 text-gray-900"
                                >
                                    Objetivos Específicos
                                </h3>
                                <ul class="space-y-4 text-gray-600">
                                    <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-accent-yellow shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                        Conciertos del repertorio sinfónico con excelencia.
                                    </li>
                                    <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-accent-yellow shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                        Formación y perfeccionamiento de nuevas generaciones.
                                    </li>
                                    <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-accent-yellow shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                        Proyectos de integración con la comunidad.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PROGRAMAS - Parallax Effect Background -->
        <div class="relative py-24 bg-gray-900 text-white overflow-hidden">
            <div
                class="absolute inset-0 z-0 opacity-20 bg-[url('/sinfonica.jpg')] bg-fixed bg-cover bg-center"
            >
            </div>
            <div class="absolute inset-0 bg-black/60 z-0"></div>

            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="text-center mb-16">
                    <span
                        class="text-accent-yellow text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Impacto Social</span
                    >
                    <h2 class="text-4xl md:text-5xl font-display font-bold">
                        Nuestros Programas
                    </h2>
                </div>

                <div class="grid md:grid-cols-2 gap-12 items-center">
                    <div>
                        <h3 class="text-3xl font-bold mb-6 text-accent-yellow">
                            Academia "Maestro José Calabrese"
                        </h3>
                        <p class="text-gray-300 text-lg mb-8 leading-relaxed">
                            Desde 2019, formamos a más de 500 estudiantes,
                            incluyendo niños con Síndrome de Down, con el aval
                            de la UNESCO. Una verdadera escuela de vida.
                        </p>
                        <a
                            href="http://www.academiajosecalabrese.com"
                            target="_blank"
                            class="inline-flex items-center gap-2 text-white border-b border-accent-yellow pb-1 hover:text-accent-yellow transition-colors"
                        >
                            Visitar sitio oficial
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                            >
                        </a>
                    </div>
                    <div
                        class="bg-white/10 p-8 rounded-2xl backdrop-blur-sm border border-white/10"
                    >
                        <div class="flex items-center gap-6 mb-6">
                            <span class="text-5xl font-bold text-white"
                                >1.500+</span
                            >
                            <span class="text-gray-300 leading-tight"
                                >Personas impactadas<br />por concierto</span
                            >
                        </div>
                        <div class="h-px w-full bg-white/20 mb-6"></div>
                        <div class="flex items-center gap-6">
                            <span class="text-5xl font-bold text-white"
                                >80+</span
                            >
                            <span class="text-gray-300 leading-tight"
                                >Becas otorgadas<br />anualmente</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CTA FINAL -->
        <section class="py-24 bg-accent-red text-white text-center">
            <div class="container mx-auto px-6 max-w-4xl">
                <h2 class="text-4xl md:text-5xl font-display font-bold mb-8">
                    Únete a la Excelencia
                </h2>
                <p class="text-xl text-white/90 mb-12 max-w-2xl mx-auto">
                    Ya sea como patrocinador, alumno o donante, tu apoyo es
                    vital para seguir construyendo cultura en Carabobo.
                </p>
                <div class="flex flex-col md:flex-row gap-6 justify-center">
                    <a
                        href="#contacto"
                        class="bg-white text-accent-red px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-transform hover:scale-105 shadow-xl"
                    >
                        Contáctanos
                    </a>
                    <a
                        href="#"
                        class="bg-transparent border-2 border-white text-white px-10 py-4 rounded-full font-bold hover:bg-white/10 transition-colors"
                    >
                        Ver Conciertos
                    </a>
                </div>
            </div>
        </section>

        <footer class="bg-gray-900 py-12 text-center border-t border-white/10">
            <div class="container mx-auto px-6">
                <p class="text-gray-500 text-sm">
                    &copy; {new Date().getFullYear()} Fundación Orquesta Sinfónica
                    de Carabobo.
                </p>
            </div>
        </footer>
    </main>
</Layout>
