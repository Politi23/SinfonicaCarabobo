a---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import HeroHeader from "../../components/HeroHeader.astro";
---

<Layout>
    <Header />

    <main class="bg-white text-gray-800">
        <!-- Hero Section -->
        <section
            class="relative min-h-[50vh] flex items-center justify-center bg-gray-900 overflow-hidden"
        >
            <div
                class="absolute inset-0 z-0 opacity-30 bg-[url('/sinfonica.webp')] bg-fixed bg-cover bg-center"
            >
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/80 z-0"
            >
            </div>

            <!-- Decoración de esquinas -->
            <div
                class="absolute top-4 left-4 w-24 h-24 border-l-4 border-t-4 border-primary opacity-60"
            >
            </div>
            <div
                class="absolute top-4 right-4 w-24 h-24 border-r-4 border-t-4 border-primary opacity-60"
            >
            </div>

            <!-- Floating animated musical notes -->
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-1/4 left-1/4 text-primary/30 text-6xl animate-float-1">♪</div>
                <div class="absolute top-1/3 right-1/5 text-accent-yellow/40 text-5xl animate-float-2">♫</div>
                <div class="absolute bottom-1/4 left-1/3 text-primary/20 text-7xl animate-float-3">♪</div>
                <div class="absolute bottom-1/3 right-1/4 text-accent-yellow/30 text-4xl animate-float-1">♫</div>
                <div class="absolute top-1/2 left-1/6 text-primary/25 text-5xl animate-float-2">♪</div>
                <div class="absolute top-2/3 right-1/3 text-accent-yellow/35 text-6xl animate-float-3">♫</div>
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center pt-24">
                <p
                    class="text-2xl md:text-3xl italic text-gray-300 font-serif mb-6 animate-fade-in"
                >
                    "El alma musical de Carabobo"
                </p>

                <div class="flex justify-center mb-8">
                    <div class="relative group">
                        <!-- Glow effect background -->
                        <div
                            class="absolute inset-0 bg-primary/20 rounded-full blur-2xl scale-110 opacity-60 group-hover:opacity-80 transition-opacity duration-500"
                        >
                        </div>

                        <!-- Logo container with artistic effects -->
                        <div
                            class="relative bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-sm rounded-full p-4 border border-white/20 shadow-2xl group-hover:shadow-primary/20 transition-all duration-500 group-hover:scale-105"
                        >
                            <img
                                src="/logo.webp"
                                alt="Fundación Orquesta Sinfónica de Carabobo"
                                class="h-24 md:h-32 object-contain filter brightness-110 contrast-110 drop-shadow-lg group-hover:drop-shadow-2xl transition-all duration-500"
                            />

                            <!-- Decorative elements -->
                            <div
                                class="absolute -top-2 -right-2 w-4 h-4 bg-primary rounded-full opacity-80 animate-pulse"
                            >
                            </div>
                            <div
                                class="absolute -bottom-1 -left-1 w-3 h-3 bg-accent-yellow rounded-full opacity-60 animate-pulse"
                                style="animation-delay: 0.5s;"
                            >
                            </div>
                        </div>
                    </div>
                </div>

                <h1
                    class="text-2xl md:text-4xl lg:text-4xl font-display font-bold text-white"
                >
                    Fundación Orquesta Sinfónica <span class="text-primary"> de Carabobo</span>
                </h1>
            </div>
        </section>

        <!-- FUNDACIÓN INFO ("Quiénes Somos") -->
        <section
            class="py-24 md:py-32 relative overflow-hidden bg-gradient-to-br from-surface-light/30 via-white to-surface-light/20"
            id="quienes-somos"
        >
            <!-- Decorative background pattern -->
            <div class="absolute inset-0 opacity-5">
                <svg class="w-full h-full" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="musical-pattern-fosc" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
                            <circle cx="10" cy="10" r="1" fill="currentColor"/>
                            <path d="M5 5 L15 5 M10 2 L10 18" stroke="currentColor" stroke-width="0.5"/>
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#musical-pattern-fosc)"/>
                </svg>
            </div>

            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Esencia</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        El Alma Musical<br /><span class="text-primary italic"
                            >de Carabobo</span
                        >
                    </h2>

                    <!-- Texto introductorio -->
                    <div class="relative text-center mb-24">
                        <!-- Decorative frame -->
                        <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 rounded-2xl"></div>
                        <div class="absolute top-4 left-4 w-8 h-8 border-l-2 border-t-2 border-primary/30 rounded-tl-lg"></div>
                        <div class="absolute top-4 right-4 w-8 h-8 border-r-2 border-t-2 border-primary/30 rounded-tr-lg"></div>
                        <div class="absolute bottom-4 left-4 w-8 h-8 border-l-2 border-b-2 border-primary/30 rounded-bl-lg"></div>
                        <div class="absolute bottom-4 right-4 w-8 h-8 border-r-2 border-b-2 border-primary/30 rounded-br-lg"></div>

                        <!-- Musical notes decoration -->
                        <div class="absolute -top-6 left-1/4 text-primary/20 text-4xl">♪</div>
                        <div class="absolute -top-4 right-1/4 text-primary/20 text-3xl">♫</div>
                        <div class="absolute -bottom-6 left-1/3 text-primary/20 text-2xl">♪</div>
                        <div class="absolute -bottom-4 right-1/3 text-primary/20 text-3xl">♫</div>

                        <div class="relative bg-white/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-primary/10 shadow-lg">
                            <h3 class="text-2xl md:text-3xl font-display font-bold text-text-dark mb-6">¿Quiénes somos?</h3>
                            <p class="text-lg md:text-xl text-text-dark leading-relaxed max-w-4xl mx-auto font-serif italic">
                                La FOSC es una organización sin fines de lucro fundada el 14 de diciembre de 1993, dedicada al cultivo, desarrollo y divulgación de la música sinfónica en el estado Carabobo. Su labor incluye la formación musical de niños, niñas y adolescentes, con especial atención a aquellos de escasos recursos y condiciones especiales, garantizando la continuidad de la Orquesta Sinfónica de Carabobo con altos estándares de calidad.
                            </p>
                        </div>
                    </div>
                </div>

                    <!-- Imagen de orquesta -->
                    <div class="mt-4 mb-16">
                        <img
                            src="/orchestra1.webp"
                            alt="Orquesta Sinfónica"
                            class="w-full max-w-3xl mx-auto rounded-2xl shadow-xl border border-primary/20"
                        />
                    </div>

                <!-- Objetivos -->
                <div
                    class="bg-surface-light rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-border-light"
                >
                    <div class="grid md:grid-cols-2 gap-16">
                        <div>
                            <h3
                                class="text-3xl font-display font-bold mb-6 text-text-dark"
                            >
                                Objetivo General
                            </h3>
                            <ul class="space-y-4 text-text-dark">
                                <li class="flex gap-4">
                                    <svg
                                        class="w-6 h-6 text-primary shrink-0"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                        ><path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path></svg
                                    >
                                    Contribuir al conocimiento desarrollo. 
                                </li>
                                     <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-primary shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                         Divulgación masiva de la música sinfónica.
                                    </li> 
                                                                    </li>
                                     <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-primary shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                         fortaleciendo las capacidades musicales de la comunidad carabobeña.
                                    </li>                               
                            </ul>
                        </div>
                        <div class="relative">
                            <div
                                class="absolute left-0 top-0 bottom-0 w-px bg-border-light hidden md:block"
                            >
                            </div>
                            <div class="md:pl-16">
                                <h3
                                    class="text-3xl font-display font-bold mb-6 text-text-dark"
                                >
                                    Objetivos Específicos
                                </h3>
                                <ul class="space-y-4 text-text-dark">
                                    <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-primary shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                        Conciertos del repertorio sinfónico con excelencia.
                                    </li>
                                    <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-primary shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                        Formación y perfeccionamiento de nuevas generaciones.
                                    </li>
                                    <li class="flex gap-4">
                                        <svg
                                            class="w-6 h-6 text-primary shrink-0"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                            ><path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path></svg
                                        >
                                        Proyectos de integración con la comunidad.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Programa de Formación Musical -->
                <div
                    class="bg-surface-light rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-border-light mt-16"
                >
                    <h3
                        class="text-3xl font-display font-bold mb-6 text-text-dark text-center"
                    >
                        Programa de Formación Musical "Maestro José Calabrese"
                    </h3>
                    <p class="text-text-dark leading-relaxed text-lg mb-6">
                        Fundado el 7 de octubre de 2019, es un programa académico que hoy cuenta con una matrícula de más de 200 estudiantes, entre niños, jóvenes y adultos. Ofrece:
                    </p>
                    <ul class="space-y-4 text-text-dark">
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Becas para más de 80 niños y jóvenes.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Asignación de instrumentos para quienes inician.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Programas inclusivos para niños con Síndrome de Down.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Aval nacional de la Universidad José Antonio Páez y el Conservatorio de Música Vicente Emilio Sojo.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Alianzas internacionales en Estados Unidos, Brasil y Colombia, con aval de la UNESCO.
                        </li>
                    </ul>
                </div>
            </div>
        </section>



        <!-- CTA FINAL -->
        <section
            class="py-24 background-dark text-text-light text-center bg-background-dark"
        >
            <div class="container mx-auto px-6 max-w-4xl">
                <h2
                    class="text-4xl md:text-5xl font-display font-bold mb-8 text-text-light"
                >
                    Únete a la Excelencia
                </h2>
                <p class="text-xl text-text-light/90 mb-12 max-w-2xl mx-auto">
                    Ya sea como patrocinador, alumno o donante, tu apoyo es
                    vital para seguir construyendo cultura en Carabobo.
                </p>
                <div class="flex flex-col md:flex-row gap-6 justify-center">
                    <a
                        href="#contacto"
                        class="bg-surface-light text-text-dark px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-transform hover:scale-105 shadow-xl"
                    >
                        Contáctanos
                    </a>
                    <a
                        href="#"
                        class="bg-transparent border-2 border-text-light text-text-light px-10 py-4 rounded-full font-bold hover:bg-white/10 transition-colors"
                    >
                        Ver Conciertos
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }
</style>
