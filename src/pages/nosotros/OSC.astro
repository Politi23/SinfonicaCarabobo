---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import MainHero from "../../components/sections/MainHero.astro";
---

<Layout>
    <Header />

    <main class="bg-white text-gray-800">
        <MainHero
            title="Orquesta Sinfónica"
            titleHighlight="de Carabobo"
            subtitle="El alma musical de Carabobo"
        />

        <!-- HISTORICAL REVIEW -->
        <section class="py-24 md:py-32 relative overflow-hidden">
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Historia</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        Reseña <span class="text-primary italic">Histórica</span
                        >
                    </h2>

                    <!-- Texto introductorio -->
                    <div class="relative text-center mb-24">
                        <!-- Decorative frame -->
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 rounded-2xl"
                        >
                        </div>
                        <div
                            class="absolute top-4 left-4 w-8 h-8 border-l-2 border-t-2 border-primary/30 rounded-tl-lg"
                        >
                        </div>
                        <div
                            class="absolute top-4 right-4 w-8 h-8 border-r-2 border-t-2 border-primary/30 rounded-tr-lg"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 left-4 w-8 h-8 border-l-2 border-b-2 border-primary/30 rounded-bl-lg"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 right-4 w-8 h-8 border-r-2 border-b-2 border-primary/30 rounded-br-lg"
                        >
                        </div>

                        <!-- Musical notes decoration -->
                        <div
                            class="absolute -top-6 left-1/4 text-primary/20 text-4xl"
                        >
                            ♪
                        </div>
                        <div
                            class="absolute -top-4 right-1/4 text-primary/20 text-3xl"
                        >
                            ♫
                        </div>
                        <div
                            class="absolute -bottom-6 left-1/3 text-primary/20 text-2xl"
                        >
                            ♪
                        </div>
                        <div
                            class="absolute -bottom-4 right-1/3 text-primary/20 text-3xl"
                        >
                            ♫
                        </div>

                        <div
                            class="relative bg-white/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-primary/10 shadow-lg"
                        >
                            <p
                                class="text-lg md:text-xl text-text-dark leading-relaxed max-w-4xl mx-auto font-serif italic"
                            >
                                Fundada en octubre de 1976, la OSC ha mantenido
                                una trayectoria ininterrumpida de labor cultural
                                y educativa. Bajo la dirección del Maestro José
                                Calabrese (1985-2018) y actualmente del Maestro
                                José Carmelo Calabrese, se ha consolidado como
                                referente musical en Venezuela y Latinoamérica.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Hitos destacados -->
                <div
                    class="bg-surface-light rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-border-light mb-16"
                >
                    <h3
                        class="text-3xl font-display font-bold mb-6 text-text-dark text-center"
                    >
                        Hitos Destacados
                    </h3>
                    <ul class="space-y-4 text-text-dark">
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            En 1998, acompañó al tenor Luciano Pavarotti en su única
                            presentación en Venezuela.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Primera orquesta venezolana en grabar las 9 sinfonías
                            de Beethoven en formato CD.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Considerada patrimonio cultural de Carabobo.
                        </li>
                    </ul>
                </div>

                <!-- Cifras representativas -->
                <div
                    class="bg-surface-light rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-border-light mb-16"
                >
                    <h3
                        class="text-3xl font-display font-bold mb-6 text-text-dark text-center"
                    >
                        Cifras Representativas
                    </h3>
                    <div class="grid md:grid-cols-3 gap-8">
                        <div class="text-center">
                            <div class="text-4xl font-bold text-primary mb-2">
                                2.400
                            </div>
                            <div class="text-text-dark">
                                músicos formados en 49 años
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="text-4xl font-bold text-primary mb-2">
                                17.000
                            </div>
                            <div class="text-text-dark">
                                personas impactadas en redes sociales
                            </div>
                        </div>
                        <div class="text-center">
                            <div class="text-4xl font-bold text-primary mb-2">
                                1.500
                            </div>
                            <div class="text-text-dark">
                                personas impactadas en promedio por concierto
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Últimos conciertos destacados -->
                <div
                    class="bg-surface-light rounded-2xl p-12 shadow-[0_4px_20px_rgb(0,0,0,0.03)] border border-border-light"
                >
                    <h3
                        class="text-3xl font-display font-bold mb-6 text-text-dark text-center"
                    >
                        Últimos Conciertos Destacados
                    </h3>
                    <ul class="space-y-4 text-text-dark">
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Latinoamerica le canta a Valencia con Huáscar Barradas.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Homenaje a Aldemaro Romero con María Teresa Chacín.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Bandas Sonoras de Películas, Series y Videojuegos.
                        </li>
                        <li class="flex gap-4">
                            <svg
                                class="w-6 h-6 text-primary shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.5"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path></svg
                            >
                            Mágica Navidad con orquesta, coro y cantantes profesionales.
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- CTA FINAL -->
        <section
            class="py-24 background-dark text-text-light text-center bg-background-dark"
        >
            <div class="container mx-auto px-6 max-w-4xl">
                <h2
                    class="text-4xl md:text-5xl font-display font-bold mb-8 text-text-light"
                >
                    Únete a la Excelencia
                </h2>
                <p class="text-xl text-text-light/90 mb-12 max-w-2xl mx-auto">
                    Ya sea como patrocinador, alumno o donante, tu apoyo es
                    vital para seguir construyendo cultura en Carabobo.
                </p>
                <div class="flex flex-col md:flex-row gap-6 justify-center">
                    <a
                        href="#contacto"
                        class="bg-surface-light text-text-dark px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-transform hover:scale-105 shadow-xl"
                    >
                        Contáctanos
                    </a>
                    <a
                        href="#"
                        class="bg-transparent border-2 border-text-light text-text-light px-10 py-4 rounded-full font-bold hover:bg-white/10 transition-colors"
                    >
                        Ver Conciertos
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }

    @keyframes float-1 {
        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-20px) rotate(5deg);
        }
    }

    @keyframes float-2 {
        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-15px) rotate(-5deg);
        }
    }

    @keyframes float-3 {
        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-25px) rotate(3deg);
        }
    }

    .animate-float-1 {
        animation: float-1 6s ease-in-out infinite;
    }

    .animate-float-2 {
        animation: float-2 8s ease-in-out infinite;
    }

    .animate-float-3 {
        animation: float-3 7s ease-in-out infinite;
    }
</style>
