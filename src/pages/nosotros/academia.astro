---
import Layout from "@layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import SecondaryButton from "@components/ui/SecondaryButton.astro";
import academiaImg from "@assets/images/organizacion/academia.webp";
import Picture from "astro/components/Picture.astro";
---

<Layout title="Academia">
  <main class="bg-white text-gray-800 min-h-screen">
    <MainHero
      title="Conoce la"
      titleHighlight="Academia"
      subtitle="Formando Futuras Generaciones"
    />

    <section class="py-20 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span
              class="text-secondary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
              >PROGRAMA EDUCATIVO</span
            >
            <h2
              class="text-4xl md:text-5xl font-display font-bold text-text-dark mb-6"
            >
              Academia Internacional de Música Maestro José Calabrese
            </h2>
            <p class="text-gray-600 text-lg mb-6 leading-relaxed">
              Desde 2019, formamos a más de 500 estudiantes, incluyendo niños
              con Síndrome de Down, con el aval de la UNESCO. Una verdadera
              escuela de vida.
            </p>
            <ul class="space-y-4 mb-8">
              <li class="flex items-start">
                <span class="text-secondary mr-3 mt-1">●</span>
                <span class="text-gray-600"
                  >Formación musical integral para niños y jóvenes</span
                >
              </li>
              <li class="flex items-start">
                <span class="text-secondary mr-3 mt-1">●</span>
                <span class="text-gray-600"
                  >Inclusión de estudiantes con capacidades especiales</span
                >
              </li>
              <li class="flex items-start">
                <span class="text-secondary mr-3 mt-1">●</span>
                <span class="text-gray-600"
                  >Certificación avalada por UNESCO</span
                >
              </li>
              <li class="flex items-start">
                <span class="text-secondary mr-3 mt-1">●</span>
                <span class="text-gray-600"
                  >Más de 500 estudiantes impactados</span
                >
              </li>
            </ul>
            <SecondaryButton
              variant="solid"
              href="http://www.academiajosecalabrese.com"
            >
              Visitar Sitio Oficial
            </SecondaryButton>
          </div>
          <div class="relative">
            <Picture
              src={academiaImg}
              formats={["webp"]}
              fallbackFormat="webp"
              alt="Estudiantes de la Academia Internacional de Música Maestro José Calabrese"
              class="w-full h-96 object-cover rounded shadow-xl"
              width={academiaImg.width}
              height={academiaImg.height}
              sizes="(max-width: 1024px) 100vw, 50vw"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-background-light">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-16">
          <span
            class="text-secondary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
            >IMPACTO SOCIAL</span
          >
          <h2
            class="text-4xl md:text-5xl font-display font-bold text-text-dark mb-6"
          >
            Nuestro Alcance
          </h2>
          <p class="text-gray-600 max-w-3xl mx-auto">
            Medimos nuestro éxito por el impacto positivo en la comunidad y la
            formación de nuevas generaciones.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div
            class="bg-gray-50 p-8 rounded-lg border border-border-light text-center"
          >
            <div class="text-5xl font-bold text-secondary mb-4">300+</div>
            <h3 class="text-xl font-bold text-text-dark mb-2">Estudiantes</h3>
            <p class="text-gray-600">&nbsp;</p>
          </div>

          <div
            class="bg-gray-50 p-8 rounded-lg border border-border-light text-center"
          >
            <div class="text-5xl font-bold text-secondary mb-4">30+</div>
            <h3 class="text-xl font-bold text-text-dark mb-2">Cátedras</h3>
            <p class="text-gray-600">&nbsp;</p>
          </div>

          <div
            class="bg-gray-50 p-8 rounded-lg border border-border-light text-center"
          >
            <div class="text-5xl font-bold text-secondary mb-4">49+</div>
            <h3 class="text-xl font-bold text-text-dark mb-2">
              Años de historia
            </h3>
            <p class="text-gray-600">&nbsp;</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-16">
          <span
            class="text-secondary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
            >OTROS PROGRAMAS</span
          >
          <h2
            class="text-4xl md:text-5xl font-display font-bold text-text-dark mb-6"
          >
            Iniciativas Complementarias
          </h2>
          <p class="text-gray-600 max-w-3xl mx-auto">
            Además de la Academia, desarrollamos múltiples programas para
            fortalecer la cultura musical en la región.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-gray-50 p-8 rounded-lg border border-border-light">
            <h3 class="text-2xl font-bold text-text-dark mb-4">
              Formación Musical
            </h3>
            <p class="text-gray-600 mb-4">
              Talleres y clases especializadas para diferentes niveles de
              experiencia musical.
            </p>
          </div>

          <div class="bg-gray-50 p-8 rounded-lg border border-border-light">
            <h3 class="text-2xl font-bold text-text-dark mb-4">
              Inclusión Cultural
            </h3>
            <p class="text-gray-600 mb-4">
              Programas diseñados para integrar a personas con diferentes
              capacidades.
            </p>
          </div>

          <div class="bg-gray-50 p-8 rounded-lg border border-border-light">
            <h3 class="text-2xl font-bold text-text-dark mb-4">
              Conciertos Educativos
            </h3>
            <p class="text-gray-600 mb-4">
              Presentaciones dirigidas a escolares y comunidades vulnerables.
            </p>
          </div>
        </div>

        <div class="text-center mt-12">
          <SecondaryButton href="http://www.academiajosecalabrese.com">
            Más información
          </SecondaryButton>
        </div>
      </div>
    </section>
  </main>
</Layout>
