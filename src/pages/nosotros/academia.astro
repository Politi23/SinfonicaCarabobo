---
import Layout from "@layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import SecondaryButton from "@components/ui/SecondaryButton.astro";

import landscape from "@assets/images/organizacion/academia.webp";
import picture2 from "@assets/images/academia/recitales_finales1.webp";
import picture1 from "@assets/images/academia/coro9.webp";

import { Picture } from "astro:assets";
---

<Layout title="Academia">
  <main class="bg-white text-gray-800 min-h-screen">
    <MainHero
      title="Conoce la"
      titleHighlight="Academia"
      subtitle="Formando Futuras Generaciones"
    />

    <section class="max-w-6xl mt-16 mx-auto px-6">
      <Picture
        src={landscape}
        alt="Ensayo musical de estudiantes de la Academia Internacional de Musica Maestro Jose Calabrese"
        class="w-full h-80 md:h-96 object-cover rounded-sm"
        loading="lazy"
      />
    </section>

    <section class="py-20 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="space-y-14">
          <section class="grid lg:grid-cols-2 gap-10 items-center">
            <div>
              <h2
                class="text-3xl md:text-4xl font-display font-bold text-text-dark mb-6"
              >
                Academia Internacional de Musica <span class="text-secondary"
                  >Maestro José Calabrese</span
                >
              </h2>

              <p
                class="text-zinc-800 text-justify text-lg mb-5 leading-relaxed"
              >
                La Academia Internacional de Musica Maestro Jose Calabrese nace
                el 7 de octubre de 2019, impulsada por el maestro Jose Carmelo
                Calabrese como una institucion orientada a la formacion musical
                y artistica integral de niños, niñas y adolescentes del estado
                Carabobo y de Venezuela.
              </p>
              <p class="text-zinc-800 text-justify text-lg leading-relaxed">
                La academia se proyecta como semillero de relevo para la
                Orquesta Sinfonica de Carabobo y sostiene su labor en la
                experiencia pedagógica en la enseñanza y practica sinfónica.
              </p>
            </div>
            <Picture
              src={picture2}
              alt="Ensayo musical de estudiantes de la Academia Internacional de Musica Maestro Jose Calabrese"
              class="w-full h-80 md:h-96 object-cover rounded-sm"
              loading="lazy"
            />
          </section>

          <section class="items-center">
            <div class="order-1 lg:order-2">
              <h3 class="text-2xl font-display font-bold text-text-dark mb-4">
                Misión educativa
              </h3>
              <p
                class="text-zinc-800 text-justify text-lg mb-5 leading-relaxed"
              >
                La misión es ejecutar una propuesta educativa integral en
                formación musical con niveles inicial, medio y avanzado, en un
                entorno de calidad y creatividad que fortalezca progresivamente
                las aptitudes y actitudes de sus estudiantes frente a la musica
                y la ejecucion instrumental.
              </p>
              <p class="text-zinc-800 text-justify text-lg leading-relaxed">
                Tambien se plantea preparar a sus alumnos para estudios
                profesionales o universitarios, promover la práctica
                instrumental individual y grupal desde edades tempranas, y
                desarrollar capacidades interpretativas en contextos de
                formacion orquestal con enfoque de crecimiento artístico y
                humano.
              </p>
            </div>
          </section>

          <section class="grid lg:grid-cols-2 gap-10 items-center">
            <Picture
              src={picture1}
              alt="Ensayo musical de estudiantes de la Academia Internacional de Musica Maestro Jose Calabrese"
              class="w-full h-80 md:h-96 object-cover rounded-sm"
              loading="lazy"
            />
            <div>
              <h3 class="text-2xl font-display font-bold text-text-dark mb-4">
                Legado y proyeccion institucional
              </h3>
              <p
                class="text-zinc-800 text-justify text-lg mb-5 leading-relaxed"
              >
                La institución lleva el nombre del maestro José Calabrese
                (Giuseppe Calabrese Di Stefano), director laureado de la
                Orquesta Sinfónica de Carabobo, y destaca su trayectoria como
                musico, director, compositor, arreglista, gerente cultural y
                educador.
              </p>
              <p
                class="text-zinc-800 text-justify text-lg mb-5 leading-relaxed"
              >
                Se destaca alianzas academicas y estratégicas con organizaciones
                de Venezuela, Estados Unidos, Colombia y Brasil, así como el
                aval internacional de UNESCO.
              </p>
            </div>
          </section>

          <div
            class="w-full pt-2 md:pt-4 flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-4"
          >
            <SecondaryButton href="/contacto">
              Más Información
            </SecondaryButton>

            <a
              href="http://www.academiajosecalabrese.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-lg inline-flex items-center text-zinc-850 transition-colors hover:text-secondary border-b-2 border-secondary whitespace-nowrap"
              aria-label="Ir a la página oficial de la academia (se abre en una nueva pestaña)"
            >
              Ir a la página oficial
              <i class="ph ph-caret-right ml-2"></i>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
