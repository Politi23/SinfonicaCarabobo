---
import Layout from "../../layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import SecondaryButton from "../../components/ui/SecondaryButton.astro";
import PrimaryButton from "../../components/ui/PrimaryButton.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";

const discography = [
    { year: "1998", title: "22 Aniversario" },
    { year: "1999", title: "9 Sinfonías de Beethoven" },
    { year: "2001", title: "Simón Díaz y la Orquesta Sinfónica de Carabobo" },
    { year: "2004", title: "Mi Banda; Big Band Jazz" },
    {
        year: "2008",
        title: "Los Melódicos y la Orquesta Sinfónica de Carabobo",
    },
    { year: "2012", title: "Obras para Viola" },
];
---

<Layout title="Nuestra Discografía - Orquesta Sinfónica de Carabobo">
    <main class="bg-white text-gray-800 min-h-screen">
        <MainHero
            title="Nuestra"
            titleHighlight="Discografía"
            subtitle="Cinco décadas de música inmortalizadas"
        />

        <!-- Intro Section -->
        <section class="py-16 md:py-24 relative overflow-hidden bg-white">
            <div class="container mx-auto px-6 max-w-5xl relative z-10">
                <div class="max-w-3xl">
                    <span
                        class="text-secondary text-xs font-bold uppercase tracking-[0.4em] mb-6 block italic"
                        >Legado Musical</span
                    >
                    <SectionTitle
                        variant="red"
                        class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-12 leading-tight"
                        wrapperClass="text-left"
                        dividerClass="h-1 w-16"
                    >
                        Grabaciones <br />
                        <span class="font-bold text-secondary italic"
                            >Históricas</span
                        >
                    </SectionTitle>
                    <div class="border-l-4 border-secondary pl-6 py-2">
                        <p
                            class="text-xl text-gray-700 leading-relaxed font-serif italic mb-4"
                        >
                            "Nuestro legado artístico queda plasmado en cada
                            nota, en cada interpretación, en cada grabación."
                        </p>
                        <p
                            class="text-gray-600 font-light leading-relaxed max-w-2xl"
                        >
                            A lo largo de nuestra trayectoria, hemos tenido el
                            privilegio de capturar en formato discográfico obras
                            que van desde lo clásico universal hasta lo más
                            representativo de nuestra música venezolana.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Discography List Section -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="container mx-auto px-6 max-w-6xl">
                <div class="max-w-4xl mx-auto">
                    <span
                        class="text-secondary text-xs font-bold uppercase tracking-[0.4em] mb-4 block italic"
                        >Catálogo Musical</span
                    >
                    <SectionTitle
                        variant="red"
                        class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-12"
                        wrapperClass="text-left"
                        dividerClass="h-1 w-16"
                    >
                        Álbumes <br /><span class="text-secondary italic"
                            >Publicados</span
                        >
                    </SectionTitle>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto"
                >
                    {
                        discography.map((album) => (
                            <div class="bg-white p-8 rounded shadow-md">
                                <span class="text-primary font-display text-3xl mb-4 block font-bold">
                                    {album.year}
                                </span>
                                <SectionTitle dividerClass="h-1 w-16 mb-4" wrapperClass="" variant="red" />
                                <p class="text-gray-700 font-medium text-lg leading-relaxed">
                                    {album.title}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Back to Nosotros CTA -->
        <section class="py-16 md:py-24 bg-white">
            <div class="container mx-auto px-6 max-w-4xl text-center">
                <SectionTitle
                    title="Explora Más"
                    variant="red"
                    class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-8"
                    wrapperClass="text-center"
                    dividerClass="h-1 w-16 mx-auto mb-8"
                />
                <p
                    class="text-lg text-gray-700 mb-12 max-w-2xl mx-auto font-light leading-relaxed"
                >
                    Conoce la historia completa de nuestra institución y todos
                    los reconocimientos que hemos recibido a lo largo de cinco
                    décadas.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <SecondaryButton href="/nosotros/nosotros">
                        Sobre Nosotros
                    </SecondaryButton>
                    <PrimaryButton href="/nosotros/reconocimientos">
                        Reconocimientos
                    </PrimaryButton>
                </div>
            </div>
        </section>
    </main>
</Layout>
