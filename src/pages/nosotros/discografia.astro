---
import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";

import disc1 from "@assets/images/discs/22_aniversario.png";
import disc2 from "@assets/images/discs/los_melodicos.png";
import disc3 from "@assets/images/discs/obras_para_violas.png";
import disc4 from "@assets/images/discs/simon_diaz.png";
import disc5 from "@assets/images/discs/mi_banda.png";
import { Image } from "astro:assets";

const discography = [
    { year: "1998", title: "22 Aniversario", src: disc1 },
    // { year: "1999", title: "9 Sinfonías de Beethoven", src: "" },
    {
        year: "2001",
        title: "Simón Díaz y la Orquesta Sinfónica de Carabobo",
        src: disc4,
    },
    { year: "2004", title: "Mi Banda; Big Band Jazz", src: disc5 },
    {
        year: "2008",
        title: "Los Melódicos y la Orquesta Sinfónica de Carabobo",
        src: disc2,
    },
    { year: "2012", title: "Obras para Viola", src: disc3 },
];
---

<Layout title="Nuestra Discografía - Orquesta Sinfónica de Carabobo">
    <main class="bg-white text-gray-800 min-h-screen">
        <MainHero title="Nuestra" titleHighlight="Discografía" />

        <!-- Discography List Section -->
        <section class="py-8 md:py-12">
            <div class="container mx-auto px-6 max-w-6xl">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8">
                    {
                        discography.map((album) => (
                            <div class="bg-white rounded shadow flex flex-col">
                                <Image
                                    src={album.src}
                                    alt={album.title}
                                    width={"1000"}
                                    height={"1000"}
                                    format={"webp"}
                                />

                                <p class="flex items-center h-full text-zinc-900 p-8 border-y-[0.1rem] border-black font-display font-semibold text-lg leading-relaxed">
                                    {album.title}{" "}
                                    <span class="text-zinc-600">
                                        ({album.year}){" "}
                                    </span>
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Back to Nosotros CTA -->
        <!-- <section class="py-16 md:py-24 bg-white">
            <div class="container mx-auto px-6 max-w-4xl text-center">
                <SectionTitle
                    title="Explora Más"
                    variant="red"
                    class="text-3xl md:text-5xl font-display font-bold text-gray-900 mb-8"
                    wrapperClass="text-center"
                    dividerClass="h-1 w-16 mx-auto mb-8"
                />
                <p
                    class="text-lg text-gray-700 mb-12 max-w-2xl mx-auto font-light leading-relaxed"
                >
                    Conoce la historia completa de nuestra institución y todos
                    los reconocimientos que hemos recibido a lo largo de cinco
                    décadas.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <SecondaryButton href="/nosotros">
                        Sobre Nosotros
                    </SecondaryButton>
                    <PrimaryButton href="/nosotros/reconocimientos">
                        Reconocimientos
                    </PrimaryButton>
                </div>
            </div>
        </section> -->
    </main>
</Layout>
