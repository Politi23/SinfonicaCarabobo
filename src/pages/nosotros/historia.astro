---
import Layout from "../../layouts/Layout.astro";
import MainHero from "../../components/sections/MainHero.astro";
import { Picture } from "astro:assets";
import eneroOrquesta from "@assets/images/historia/23_enero_osc.webp";
import cantataCriolla1999AlfredoCelis2 from "@assets/images/historia/cantata criolla 1999 Alfredo celis_2.webp";
import cantataCriolla1999AlfredoCelis5 from "@assets/images/historia/cantata criolla 1999 Alfredo celis_5.webp";
import docFundacion from "@assets/images/historia/Documento 6_8.webp";
import documento811 from "@assets/images/historia/Documento 8_11.webp";
import documento89 from "@assets/images/historia/Documento 8_9.webp";
import joseCarmelo from "@assets/images/historia/jose_carmelo_1.webp";
import joseCarmelo2 from "@assets/images/historia/jose_carmelo_2.webp";
import joseCarmelo4 from "@assets/images/historia/jose_carmelo_4.webp";
import joseCarmelo5 from "@assets/images/historia/jose_carmelo_5.webp";
import joseCarmelo6 from "@assets/images/historia/jose_carmelo_6.webp";
import joseCarmelo7 from "@assets/images/historia/jose_carmelo_7.webp";
import joseCarmeloAccion1 from "@assets/images/historia/jose_carmelo_accion_1.webp";
import joseCarmeloAccion2 from "@assets/images/historia/jose_carmelo_accion_2.webp";
import joseCarmeloAccion3 from "@assets/images/historia/jose_carmelo_accion_3.webp";
import joseCarmeloAccion4 from "@assets/images/historia/jose_carmelo_accion_4.webp";
import joseCarmeloHijo1 from "@assets/images/historia/jose_carmelo_hijo_1.webp";
import joseCarmeloHijo2 from "@assets/images/historia/jose_carmelo_hijo_2.webp";
import pavarotti from "@assets/images/historia/pavarotti.webp";
---

<Layout title="Nuestra Historia">
    <main class="bg-white text-gray-800 min-h-screen">
        <MainHero
            title="Reseña Histórica"
            titleHighlight=""
            subtitle="Cinco décadas construyendo el alma musical de Carabobo"
        />

        <article class="container mx-auto px-6 max-w-4xl py-20">
            <div class="prose prose-lg max-w-none">
                <div
                    class="mb-12 p-8 bg-gray-50 rounded-sm border-l-4 border-secondary"
                >
                    <p
                        class="text-xl text-gray-700 leading-relaxed italic font-serif"
                    >
                        Fundada en octubre de 1976, la Orquesta Sinfónica de
                        Carabobo (OSC), posee una trayectoria ininterrumpida en
                        su labor musical, cultural, social y educativa. Se ha
                        convertido en un referente necesario tanto en el estado
                        Carabobo y en toda Venezuela, cuando de música y arte se
                        trata.
                    </p>
                </div>

                <section class="mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <span
                            class="text-5xl font-display font-bold text-primary opacity-50"
                        >
                            1976
                        </span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <h2
                        class="text-2xl font-display font-bold text-gray-900 mb-4"
                    >
                        Los Orígenes
                    </h2>
                    <p class="text-gray-700 leading-relaxed mb-4">
                        Su labor artística y de formación como parte de un
                        programa social, ha sido catalogada como el hecho más
                        importante en la vida cultural carabobeña. En sus
                        inicios como Orquesta Juvenil "Juan José Landaeta"
                        Módulo Carabobo, fue dirigida por diversos jóvenes
                        maestros de aquella época como Federico Núñez Corona,
                        Juan Tomás Martínez, Jorge Castillo, Francisco Noya,
                        Felipe Izcaray, entre otros.
                    </p>
                    <p class="text-gray-700 leading-relaxed mb-6">
                        Desde el año 1985 hasta el 2018 el podio de dirección
                        estuvo ocupado por el Maestro de Maestros, <strong
                            class="text-secondary">José Calabrese</strong
                        >, quien ya estaba ejerciendo labores en la organización
                        como Director Académico y que con su aquilatada y
                        refinada experiencia en la dirección de agrupaciones
                        musicales, logró imprimirle a la orquesta un estilo
                        propio y una musicalidad que la identifica, eso que
                        algunos críticos llaman "Personalidad". Elevándola al
                        grado de lo que conocemos hoy como: <strong
                            class="text-secondary"
                            >Orquesta Sinfónica de Carabobo</strong
                        >, y fundando así la era dorada y profesional de la
                        institución.
                    </p>
                    <div class="flex flex-col md:flex-row gap-4 my-6">
                        <div class="w-full md:w-1/2 overflow-hidden">
                            <Picture
                                src={joseCarmelo}
                                width={1000}
                                height={1000}
                                alt="Documento histórico de la fundación de la Orquesta Sinfónica de Carabobo"
                                class="w-full h-auto rounded-sm shadow-lg"
                                formats={["webp"]}
                                fallbackFormat="webp"
                            />
                        </div>
                        <div class="w-full md:w-1/2 overflow-hidden">
                            <Picture
                                src={joseCarmelo2}
                                width={1000}
                                height={1000}
                                alt="Orquesta Sinfónica de Carabobo en concierto"
                                class="w-full h-auto rounded-sm shadow-lg"
                                formats={["webp"]}
                                fallbackFormat="webp"
                            />
                        </div>
                    </div>
                </section>

                <section class="mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <span
                            class="text-5xl font-display font-bold text-primary opacity-50"
                        >
                            Legado
                        </span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <h2
                        class="text-2xl font-display font-bold text-gray-900 mb-4"
                    >
                        El Legado del Maestro Calabrese
                    </h2>
                    <p class="text-gray-700 leading-relaxed mb-6">
                        Sin duda, el Maestro Calabrese ahora <strong
                            class="text-secondary">"Director Laureado"</strong
                        > de la OSC hizo de ella una de las mejores orquestas del
                        país y de Latinoamérica, asumiendo siempre proyectos exigentes
                        que llevó a cabo con gran éxito y marcando una pauta en Venezuela.
                    </p>
                    <div class="w-full mx-auto grid grid-cols-2 gap-4">
                        <Picture
                            src={joseCarmeloAccion3}
                            alt="Documento histórico del legado del Maestro José Calabrese"
                            class="h-auto rounded-sm shadow-lg"
                            width="800"
                            height="1200"
                            formats={["webp"]}
                            fallbackFormat="webp"
                            loading="lazy"
                        />
                        <Picture
                            src={joseCarmelo4}
                            alt="Documento histórico del legado del Maestro José Calabrese"
                            class="h-auto rounded-sm shadow-lg"
                            width="800"
                            height="1200"
                            formats={["webp"]}
                            fallbackFormat="webp"
                            loading="lazy"
                        />
                    </div>
                </section>

                <section class="mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <span
                            class="text-5xl font-display font-bold text-primary opacity-50"
                        >
                            2019
                        </span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <h2
                        class="text-2xl font-display font-bold text-gray-900 mb-4"
                    >
                        Una Nueva Era
                    </h2>
                    <p class="text-gray-700 leading-relaxed mb-6">
                        En el 2019 asume la Dirección Artística y Musical el <strong
                            class="text-secondary"
                            >Maestro José Carmelo Calabrese</strong
                        >, quien actualmente es el Director carabobeño de mayor
                        proyección internacional; con diversos premios de
                        dirección orquestal ganados a nivel mundial y quien con
                        nuevos proyectos y propósitos continúa llevando a la
                        agrupación por el camino de éxito que dejó su antecesor.
                    </p>
                    <div class="flex flex-col md:flex-row gap-4 my-6">
                        <div class="w-full md:w-1/2 overflow-hidden">
                            <Picture
                                src={joseCarmeloHijo1}
                                width={1000}
                                height={1000}
                                alt="Maestro José Carmelo Calabrese, Director Artístico desde 2019"
                                class="w-full h-auto rounded-sm shadow-lg"
                                formats={["webp"]}
                                fallbackFormat="webp"
                            />
                        </div>
                        <div class="w-full md:w-1/2 overflow-hidden">
                            <Picture
                                src={joseCarmeloHijo2}
                                width={1000}
                                height={1000}
                                alt="Maestro José Carmelo Calabrese en concierto"
                                class="w-full h-auto rounded-sm shadow-lg"
                                formats={["webp"]}
                                fallbackFormat="webp"
                            />
                        </div>
                    </div>
                </section>

                <!-- Versatilidad Artística -->
                <section class="mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <span
                            class="text-5xl font-display font-bold text-primary opacity-50"
                        >
                            Arte
                        </span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <h2
                        class="text-2xl font-display font-bold text-gray-900 mb-4"
                    >
                        Versatilidad Artística
                    </h2>
                    <p class="text-gray-700 leading-relaxed mb-6">
                        La OSC en cada presentación hace gala de una inigualable
                        versatilidad, evidenciada en la amplia gama del
                        repertorio que ejecuta, el cual va desde lo clásico
                        universal hasta la música popular o bailable, pasando
                        por la mejor música venezolana y latinoamericana de
                        todos los tiempos.
                    </p>
                    <div class="w-full overflow-hidden">
                        <Picture
                            src={documento89}
                            width={1000}
                            height={1000}
                            alt="Maestro José Carmelo Calabrese en concierto"
                            class="w-full h-auto rounded-sm shadow-lg"
                            formats={["webp"]}
                            fallbackFormat="webp"
                        />
                    </div>
                </section>

                <section class="mb-12">
                    <div class="flex items-center gap-4 mb-6">
                        <span
                            class="text-5xl font-display font-bold text-primary opacity-50"
                        >
                            Hitos
                        </span>
                        <div class="flex-1 h-px bg-gray-200"></div>
                    </div>
                    <h2
                        class="text-2xl font-display font-bold text-gray-900 mb-4"
                    >
                        Momentos Históricos
                    </h2>

                    <div class="space-y-6">
                        <div
                            class="bg-gray-50 p-6 rounded-sm border-l-4 border-primary"
                        >
                            <h3
                                class="text-lg font-bold text-gray-900 mb-2 flex items-center gap-3"
                            >
                                <span class="text-2xl font-display text-primary"
                                    >1998</span
                                >
                                Luciano Pavarotti en Valencia
                            </h3>
                            <p class="text-gray-700 leading-relaxed mb-6">
                                Una demostración del reconocimiento a la alta
                                calidad de la OSC, está en el hecho histórico de
                                haber sido escogida como la orquesta acompañante
                                del famoso tenor italiano Luciano Pavarotti, en
                                el memorable concierto realizado en la ciudad de
                                Valencia en el año 1998.
                            </p>
                            <div class="w-full overflow-hidden">
                                <Picture
                                    src={pavarotti}
                                    width={1000}
                                    height={1000}
                                    alt="Concierto con Luciano Pavarotti en Valencia, 1998"
                                    class="w-full h-auto rounded-sm shadow-lg"
                                    formats={["webp"]}
                                    fallbackFormat="webp"
                                />
                            </div>
                        </div>

                        <div
                            class="bg-gray-50 p-6 rounded-sm border-l-4 border-secondary"
                        >
                            <h3
                                class="text-lg font-bold text-gray-900 mb-2 flex items-center gap-3"
                            >
                                Primera Orquesta en Venezuela
                            </h3>
                            <p class="text-gray-700 leading-relaxed mb-6">
                                También es reconocida como la primera orquesta
                                en Venezuela en grabar en formato de CD las 9
                                sinfonías de L. v. Beethoven.
                            </p>
                            <div class="w-full mx-auto overflow-hidden">
                                <Picture
                                    src={eneroOrquesta}
                                    alt="Documento histórico de la grabación de las 9 sinfonías de Beethoven"
                                    class="w-full h-auto rounded-sm shadow-lg"
                                    width="800"
                                    height="1200"
                                    formats={["webp"]}
                                    fallbackFormat="webp"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Cierre -->
                <section class="mb-12">
                    <div
                        class="mb-12 p-8 bg-gray-50 rounded-sm border-l-4 border-secondary"
                    >
                        <p
                            class="text-xl text-gray-700 leading-relaxed italic font-serif"
                        >
                            Cinco décadas de trabajo fructífero e
                            ininterrumpido, le ha permitido un sólido sitial en
                            el ámbito musical del país, distinguida con
                            múltiples reconocimientos de los diversos sectores
                            representativos de nuestra sociedad.
                        </p>
                    </div>
                </section>
            </div>
        </article>
    </main>
</Layout>

<style>
    .prose {
        font-family: var(--font-serif);
    }

    .prose strong {
        color: var(--color-secondary);
        font-weight: 600;
    }
</style>
