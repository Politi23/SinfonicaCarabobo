r---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
---

<Layout>
    <Header />

    <main class="bg-background-light text-text-dark">
        <!-- HERO SECTION -->
        <main class="bg-white text-gray-800">
            <!-- Hero Section -->
            <section
                class="relative min-h-[50vh] flex items-center justify-center bg-gray-900 overflow-hidden"
            >
                <div
                    class="absolute inset-0 z-0 opacity-30 bg-[url('/sinfonica.webp')] bg-fixed bg-cover bg-center"
                >
                </div>
                <div
                    class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/80 z-0"
                >
                </div>

            <!-- Decoración de esquinas -->
            <div
                class="absolute top-4 left-4 w-24 h-24 border-l-4 border-t-4 border-primary opacity-60"
            >
            </div>
            <div
                class="absolute top-4 right-4 w-24 h-24 border-r-4 border-t-4 border-primary opacity-60"
            >
            </div>

            <!-- Floating animated musical notes -->
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-1/4 left-1/4 text-primary/30 text-6xl animate-float-1">♪</div>
                <div class="absolute top-1/3 right-1/5 text-accent-yellow/40 text-5xl animate-float-2">♫</div>
                <div class="absolute bottom-1/4 left-1/3 text-primary/20 text-7xl animate-float-3">♪</div>
                <div class="absolute bottom-1/3 right-1/4 text-accent-yellow/30 text-4xl animate-float-1">♫</div>
                <div class="absolute top-1/2 left-1/6 text-primary/25 text-5xl animate-float-2">♪</div>
                <div class="absolute top-2/3 right-1/3 text-accent-yellow/35 text-6xl animate-float-3">♫</div>
            </div>

                <div
                    class="container mx-auto px-6 relative z-10 text-center pt-24"
                >
                    <p
                        class="text-2xl md:text-3xl italic text-gray-300 font-serif mb-6 animate-fade-in"
                    >
                        "El alma musical de Carabobo"
                    </p>

                    <div class="flex justify-center mb-8">
                        <div class="relative group">
                            <!-- Glow effect background -->
                            <div
                                class="absolute inset-0 bg-primary/20 rounded-full blur-2xl scale-110 opacity-60 group-hover:opacity-80 transition-opacity duration-500"
                            >
                            </div>

                            <!-- Logo container with artistic effects -->
                            <div
                                class="relative bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-sm rounded-full p-4 border border-white/20 shadow-2xl group-hover:shadow-primary/20 transition-all duration-500 group-hover:scale-105"
                            >
                                <img
                                    src="/logo.webp"
                                    alt="Fundación Orquesta Sinfónica de Carabobo"
                                    class="h-24 md:h-32 object-contain filter brightness-110 contrast-110 drop-shadow-lg group-hover:drop-shadow-2xl transition-all duration-500"
                                />

                                <!-- Decorative elements -->
                                <div
                                    class="absolute -top-2 -right-2 w-4 h-4 bg-primary rounded-full opacity-80 animate-pulse"
                                >
                                </div>
                                <div
                                    class="absolute -bottom-1 -left-1 w-3 h-3 bg-accent-yellow rounded-full opacity-60 animate-pulse"
                                    style="animation-delay: 0.5s;"
                                >
                                </div>
                            </div>
                        </div>
                    </div>

                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white"
                    >
                        Sobre <span class="text-primary">Nosotros</span>
                    </h1>
                </div>
            </section>

            <!-- ABOUT SECTIONS -->
            <section
                class="py-24 md:py-32 relative overflow-hidden bg-gradient-to-br from-surface-light/30 via-white to-surface-light/20"
                id="quienes-somos"
            >
                <div class="container mx-auto px-6 max-w-6xl relative z-10">
                    <!-- Texto introductorio -->
                    <div class="relative text-center mb-24">
                        <!-- Decorative frame -->
                        <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 rounded-2xl"></div>
                        <div class="absolute top-4 left-4 w-8 h-8 border-l-2 border-t-2 border-primary/30 rounded-tl-lg"></div>
                        <div class="absolute top-4 right-4 w-8 h-8 border-r-2 border-t-2 border-primary/30 rounded-tr-lg"></div>
                        <div class="absolute bottom-4 left-4 w-8 h-8 border-l-2 border-b-2 border-primary/30 rounded-bl-lg"></div>
                        <div class="absolute bottom-4 right-4 w-8 h-8 border-r-2 border-b-2 border-primary/30 rounded-br-lg"></div>

                        <!-- Musical notes decoration -->
                        <div class="absolute -top-6 left-1/4 text-primary/20 text-4xl">♪</div>
                        <div class="absolute -top-4 right-1/4 text-primary/20 text-3xl">♫</div>
                        <div class="absolute -bottom-6 left-1/3 text-primary/20 text-2xl">♪</div>
                        <div class="absolute -bottom-4 right-1/3 text-primary/20 text-3xl">♫</div>

                        <div class="relative bg-white/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-primary/10 shadow-lg">
                            <p class="text-lg md:text-xl text-text-dark leading-relaxed max-w-4xl mx-auto font-serif italic">
                                Durante 49 años, hemos construido cultura y difundido el arte y la música en todas sus vertientes, conservando tradiciones y liderando proyectos innovadores. Nos dedicamos a crear espacios de sano esparcimiento, elevación espiritual y desarrollo social a través de la cultura, con más de 2.400 músicos formados y un impacto anual que alcanza a miles de personas.
                            </p>
                        </div>
                    </div>

                    <!-- Golden separator -->
                    <div class="flex items-center justify-center mb-16">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
                        <div class="mx-8 text-primary text-4xl">♪</div>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
                    </div>

                    <!-- Misión, Visión, Valores -->
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-12 mb-24">
                        <!-- Misión -->
                        <div class="relative text-center group md:col-span-1">
                            <!-- Decorative background -->
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-accent-yellow/5 rounded-3xl transform rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>
                            <div class="absolute inset-0 bg-gradient-to-tl from-primary/3 to-transparent rounded-3xl transform -rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>

                            <!-- Musical staff lines -->
                            <div class="absolute top-8 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-12 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-16 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-20 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-24 left-4 right-4 h-px bg-primary/20"></div>

                            <div class="relative bg-white/70 backdrop-blur-sm p-6 md:p-8 rounded-3xl border border-primary/20 shadow-xl group-hover:shadow-2xl transition-all duration-500">
                                <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-primary/20 to-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 shadow-lg">
                                    <svg class="w-7 h-7 md:w-8 md:h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-xl md:text-2xl font-display font-bold text-text-dark mb-3 md:mb-4">Misión</h3>
                                <p class="text-sm md:text-base text-text-dark leading-relaxed">
                                    Contribuir a la transformación social a través de la formación de líderes con pensamiento crítico, mediante la ejecución de la música sinfónica.
                                </p>
                            </div>
                        </div>

                        <!-- Visión -->
                        <div class="relative text-center group md:col-span-1 lg:col-span-1">
                            <!-- Decorative background -->
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-accent-yellow/5 rounded-3xl transform rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>
                            <div class="absolute inset-0 bg-gradient-to-tl from-primary/3 to-transparent rounded-3xl transform -rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>

                            <!-- Corner decorations -->
                            <div class="absolute top-2 left-2 w-6 h-6 border-l-2 border-t-2 border-primary/40 rounded-tl-lg"></div>
                            <div class="absolute top-2 right-2 w-6 h-6 border-r-2 border-t-2 border-primary/40 rounded-tr-lg"></div>
                            <div class="absolute bottom-2 left-2 w-6 h-6 border-l-2 border-b-2 border-primary/40 rounded-bl-lg"></div>
                            <div class="absolute bottom-2 right-2 w-6 h-6 border-r-2 border-b-2 border-primary/40 rounded-br-lg"></div>

                            <!-- Musical staff lines -->
                            <div class="absolute top-8 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-12 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-16 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-20 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-24 left-4 right-4 h-px bg-primary/20"></div>

                            <div class="relative bg-white/70 backdrop-blur-sm p-6 md:p-8 rounded-3xl border border-primary/20 shadow-xl group-hover:shadow-2xl transition-all duration-500">
                                <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-primary/20 to-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 shadow-lg">
                                    <svg class="w-7 h-7 md:w-8 md:h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-xl md:text-2xl font-display font-bold text-text-dark mb-3 md:mb-4">Visión</h3>
                                <p class="text-sm md:text-base text-text-dark leading-relaxed">
                                    Ser reconocidos como una institución de vanguardia en el desarrollo, divulgación y enseñanza de la música sinfónica, consolidándonos como la máxima expresión de la cultura carabobeña en Venezuela y el mundo.
                                </p>
                            </div>
                        </div>

                        <!-- Valores -->
                        <div class="relative text-center group md:col-span-2 lg:col-span-1">
                            <!-- Decorative background -->
                            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-accent-yellow/5 rounded-3xl transform rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>
                            <div class="absolute inset-0 bg-gradient-to-tl from-primary/3 to-transparent rounded-3xl transform -rotate-1 group-hover:rotate-0 transition-transform duration-500"></div>

                            <!-- Musical staff lines -->
                            <div class="absolute top-8 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-12 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-16 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-20 left-4 right-4 h-px bg-primary/20"></div>
                            <div class="absolute top-24 left-4 right-4 h-px bg-primary/20"></div>

                            <div class="relative bg-white/70 backdrop-blur-sm p-6 md:p-8 rounded-3xl border border-primary/20 shadow-lg group-hover:shadow-xl transition-all duration-500">
                                <div class="w-14 h-14 md:w-16 md:h-16 bg-gradient-to-br from-primary/20 to-primary/10 rounded-full flex items-center justify-center mx-auto mb-4 md:mb-6 shadow-lg">
                                    <svg class="w-7 h-7 md:w-8 md:h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-xl md:text-2xl font-display font-bold text-text-dark mb-3 md:mb-4">Valores</h3>
                                <p class="text-sm md:text-base text-text-dark leading-relaxed">
                                    Sentido de pertenencia, respeto, disciplina, empatía, corresponsabilidad y tolerancia.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Golden separator -->
                    <div class="flex items-center justify-center mb-16">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
                        <div class="mx-8 text-primary text-4xl">♫</div>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
                    </div>

                    <div class="flex flex-col items-center text-center mb-24">
                        <span
                            class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                            >Nuestra Organización</span
                        >
                        <h2
                            class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                        >
                            Conoce Nuestros<br /><span
                                class="text-primary italic">Componentes</span
                            >
                        </h2>
                    </div>

                    <!-- Cards Grid -->
                    <div class="grid md:grid-cols-2 gap-8 mb-32">
                        <!-- FOSC Card -->
                        <a
                            href="/nosotros/FOSC"
                            class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light block"
                        >
                            <div
                                class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-primary"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-display font-bold mb-4 text-text-dark"
                            >
                                Fundación Orquesta Sinfónica de Carabobo (FOSC)
                            </h3>
                            <p class="text-text-dark leading-relaxed">
                                Organización sin fines de lucro dedicada al
                                cultivo, desarrollo y divulgación de la música
                                sinfónica.
                            </p>
                            <div
                                class="mt-6 text-primary font-bold flex items-center gap-2"
                            >
                                Conoce más
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 5l7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>

                        <!-- OSC Card -->
                        <a
                            href="/nosotros/OSC"
                            class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 hover:scale-105 border border-border-light block"
                        >
                            <div
                                class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-primary"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-display font-bold mb-4 text-text-dark"
                            >
                                Orquesta Sinfónica de Carabobo (OSC)
                            </h3>
                            <p class="text-text-dark leading-relaxed">
                                La prestigiosa orquesta fundada en 1976 con una
                                trayectoria ininterrumpida en su labor cultural
                                y educativa.
                            </p>
                            <div
                                class="mt-6 text-primary font-bold flex items-center gap-2"
                            >
                                Conoce más
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 5l7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>
                    </div>
                </div>
            </section>
        </main>
    </main>
</Layout>
