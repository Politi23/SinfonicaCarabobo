---
import Layout from "@layouts/Layout.astro";
import MainHero from "@components/sections/MainHero.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import SecondaryButton from "@components/ui/SecondaryButton.astro";
import { Picture } from "astro:assets";
import document1 from "@assets/images/historia/Documento 6_8.webp";
import document2 from "@assets/images/historia/Documento 8_11.webp";
import violin from "@assets/images/orquesta/violin.webp";
import oscTtc from "@assets/images/orquesta/OSC en TTC.webp";
---

<Layout
  title="Sobre Nosotros"
  showLatestPosts={true}
  showApoyanosSection={true}
>
  <main class="bg-white text-gray-950 min-h-screen">
    <MainHero
      title="Sobre"
      titleHighlight="Nosotros"
      subtitle="Medio siglo construyendo el alma musical de una región."
    />

    <section
      class="py-6 md:py-12 relative overflow-hidden max-w-4xl bg-white grid grid-cols-2 items-center gap-12 mx-auto"
    >
      <div class="text-justify font-[350] text-lg/6">
        50 años difundiendo el arte y la música en todas sus vertientes,
        conservando las tradiciones pero siempre a la vanguardia de los
        proyectos en la actualidad; procurando la creación de espacios de sano
        esparcimiento, elevación espiritual y contribución al desarrollo social
        a través de la cultura.
      </div>

      <div
        class="bg-gray-50 rounded-sm border border-gray-200 overflow-hidden relative"
      >
        <Picture
          src={oscTtc}
          formats={["webp"]}
          fallbackFormat="webp"
          alt="Orquesta Sinfónica de Carabobo en TTC"
          class="w-full h-auto object-cover"
          width={oscTtc.width}
          height={oscTtc.height}
          sizes="(max-width: 768px) 100vw, 50vw"
        />
      </div>
    </section>

    <section class="py-6 md:py-12 relative overflow-hidden">
      <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div class="max-w-4xl mx-auto">
          <SectionTitle
            variant="red"
            class="text-3xl md:text-5xl font-display font-bold text-gray-900 leading-tight mb-6"
            wrapperClass="text-left"
            dividerClass="h-1 w-16 mt-2"
          >
            Nuestra Historia
          </SectionTitle>

          <div
            class="relative bg-white p-8 md:p-12 border border-gray-200 rounded overflow-hidden"
          >
            <div
              class="absolute inset-0 z-0 opacity-10 bg-cover bg-center"
              style={`background-image: url('${document2.src}');`}
            >
            </div>
            <div class="relative z-10">
              <p
                class="text-lg md:text-2xl text-gray-700 leading-relaxed font-serif italic"
              >
                "Desde hace 50 años, hemos unido en un mismo propósito la
                formación académica, la producción artística de alto nivel y el
                compromiso social inquebrantable."
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto pt-8">
        <div class="bg-white p-8 rounded-sm border border-zinc-200">
          <span class="text-primary font-display text-3xl mb-4 block font-bold"
            >1976</span
          >
          <SectionTitle
            dividerClass="h-1 w-16 mb-4"
            wrapperClass=""
            variant="red"
          />
          <h3
            class="text-xl font-bold uppercase tracking-tight mb-3 text-gray-900"
          >
            Fundación
          </h3>
          <p class="text-gray-700 leading-relaxed">
            Nacemos en octubre de 1976 para convertirnos en el eje fundamental
            de la cultura carabobeña, iniciando un camino de excelencia
            ininterrumpida.
          </p>
        </div>
        <div class="bg-white p-8 rounded-sm border border-zinc-200">
          <span class="text-primary font-display text-3xl mb-4 block font-bold"
            >1998</span
          >
          <SectionTitle
            dividerClass="h-1 w-16 mb-4"
            wrapperClass=""
            variant="red"
          />
          <h3
            class="text-xl font-bold uppercase tracking-tight mb-3 text-gray-900"
          >
            Hito Universal
          </h3>
          <p class="text-gray-700 leading-relaxed">
            Acompañamos al legendario tenor Luciano Pavarotti en su única
            presentación en Venezuela, consolidando nuestra calidad
            interpretativa a nivel mundial.
          </p>
        </div>
        <div class="bg-white p-8 rounded-sm border border-zinc-200">
          <span class="text-primary font-display text-3xl mb-4 block font-bold"
            >2021</span
          >
          <SectionTitle
            dividerClass="h-1 w-16 mb-4"
            wrapperClass=""
            variant="red"
          />
          <h3
            class="text-xl font-bold uppercase tracking-tight mb-3 text-gray-900"
          >
            UNESCO
          </h3>
          <p class="text-gray-700 leading-relaxed">
            Fuimos reconocidos por la UNESCO como "Embajadores de la Paz", un
            honor que ratifica nuestra labor social y compromiso con la
            humanidad.
          </p>
        </div>
        <div
          class="bg-gray-50 rounded border border-gray-200 overflow-hidden relative shadow-md"
        >
          <Picture
            src={document1}
            formats={["webp"]}
            fallbackFormat="webp"
            alt="Orquesta Sinfónica de Carabobo en TTC"
            class="w-full h-auto object-cover"
            width={oscTtc.width}
            height={oscTtc.height}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>
      </div>

      <div class="text-center mt-12">
        <SecondaryButton href="/nosotros/historia">
          Leer historia completa
        </SecondaryButton>
      </div>
    </section>

    <section class="py-8 md:py-16">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-12">
          <h2
            class="text-3xl md:text-4xl font-display font-bold text-gray-900 leading-tight"
          >
            Misión, Visión y Valores
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          <div
            class="bg-white p-8 pt-16 rounded-sm border border-t-4 border-primary"
          >
            <h3
              class="text-xl font-display font-bold text-primary mb-4 uppercase tracking-wider text-center"
            >
              Misión
            </h3>
            <p class="text-gray-700 text leading-relaxed">
              Contribuir a la transformación social a través de la formación de
              líderes con pensamiento crítico, mediante la ejecución de la
              música sinfónica.
            </p>
          </div>

          <div
            class="bg-white p-8 pt-16 rounded-sm border border-t-4 border-secondary"
          >
            <h3
              class="text-xl font-display font-bold text-secondary mb-4 uppercase tracking-wider text-center"
            >
              Visión
            </h3>
            <p class="text-gray-700 text leading-relaxed">
              Ser la institución de vanguardia en el desarrollo y enseñanza de
              la música sinfónica, consolidándose como máxima expresión de la
              cultura carabobeña para Venezuela y el mundo.
            </p>
          </div>

          <div
            class="bg-white p-8 pt-16 rounded-sm border border-t-4 border-gray-900"
          >
            <h3
              class="text-xl font-display font-bold text-gray-900 mb-4 uppercase tracking-wider text-center"
            >
              Valores
            </h3>
            <p class="text-gray-700 text leading-relaxed">
              Sentido de pertenencia, respeto, disciplina, empatía,
              corresponsabilidad y tolerancia.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-gray-50 relative overflow-hidden">
      <div
        class="absolute inset-0 opacity-5 bg-cover bg-center"
        style={`background-image: url('${violin.src}');`}
      >
      </div>
      <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div class="text-center mb-12">
          <h2
            class="text-3xl md:text-5xl font-display font-bold text-gray-900 leading-tight"
          >
            Nuestras Cifras
          </h2>
        </div>

        <div
          class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 max-w-6xl mx-auto"
        >
          <div class="bg-white p-6 md:p-8 rounded text-center">
            <div
              class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
            >
              49
            </div>
            <p
              class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
            >
              Años de Trayectoria
            </p>
          </div>
          <div class="bg-white p-6 md:p-8 rounded text-center">
            <div
              class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
            >
              70
            </div>
            <p
              class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
            >
              Músicos Activos
            </p>
          </div>
          <div class="bg-white p-6 md:p-8 rounded text-center">
            <div
              class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
            >
              50
            </div>
            <p
              class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
            >
              Eventos Anuales
            </p>
          </div>
          <div class="bg-white p-6 md:p-8 rounded text-center">
            <div
              class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
            >
              2.4K
            </div>
            <p
              class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
            >
              Músicos Formados
            </p>
          </div>
          <div class="bg-white p-6 md:p-8 rounded text-center">
            <div
              class="text-3xl md:text-5xl font-display font-bold text-primary mb-2"
            >
              1.5K
            </div>
            <p
              class="text-xs font-bold tracking-[0.2em] uppercase text-gray-600"
            >
              Personas por Conciertos
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-8 md:py-16 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="max-w-4xl mx-auto mb-12 text-center">
          <h2
            class="text-3xl md:text-4xl font-display font-bold text-gray-900 leading-tight"
          >
            Últimos Conciertos de Impacto Masivo
          </h2>
        </div>

        <div class="grid md:grid-cols-1 gap-6 max-w-3xl mx-auto">
          {
            [
              {
                title: '"Latinoamérica le canta a Valencia"',
                desc: "Con la participación del flautista Huáscar Barradas.",
              },
              {
                title: "Bandas sonoras de películas, series y videojuegos",
                desc: "Experiencia sinfónica pensada para audiencias multigeneracionales.",
              },
              {
                title: '"Homenaje a Aldemaro Romero"',
                desc: "Con la participación especial de María Teresa Chacín.",
              },
              {
                title: '"Mágica Navidad"',
                desc: "Formato con orquesta, cantantes y coro para grandes aforos.",
              },
            ].map((concert, index) => (
              <article class="relative bg-gray-50 border border-gray-200 rounded p-7 overflow-hidden">
                <div class="absolute top-0 left-0 h-full w-1 bg-primary" />
                <h3 class="text-xl font-display font-bold text-gray-900 mb-3 leading-snug">
                  {concert.title}
                </h3>
                <p class="text-gray-700 leading-relaxed">{concert.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
