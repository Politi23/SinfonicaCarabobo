---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import HeroHeader from "../../components/HeroHeader.astro";
---

<Layout>
    <Header />

    <main class="bg-background-light text-text-dark">
        <!-- HERO SECTION -->
        <HeroHeader />

        <!-- ABOUT SECTIONS -->
        <section
            class="py-24 md:py-32 relative overflow-hidden"
            id="quienes-somos"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Organización</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        Conoce Nuestros<br /><span class="text-primary italic"
                            >Componentes</span
                        >
                    </h2>
                </div>

                <!-- Cards Grid -->
                <div class="grid md:grid-cols-2 gap-8 mb-32">
                    <!-- FOSC Card -->
                    <a 
                        href="/nosotros/FOSC"
                        class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light block"
                    >
                        <div
                            class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-text-dark"
                        >
                            Fundación Orquesta Sinfónica de Carabobo (FOSC)
                        </h3>
                        <p class="text-text-dark leading-relaxed">
                            Organización sin fines de lucro dedicada al cultivo, desarrollo y divulgación de la música sinfónica.
                        </p>
                        <div class="mt-6 text-primary font-bold flex items-center gap-2">
                            Conoce más
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"
                                ></path>
                            </svg>
                        </div>
                    </a>

                    <!-- OSC Card -->
                    <a 
                        href="/nosotros/OSC"
                        class="group bg-surface-light p-10 rounded-xl shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-[0_10px_40px_rgb(0,0,0,0.08)] transition-all duration-500 hover:-translate-y-2 border border-border-light block"
                    >
                        <div
                            class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors"
                        >
                            <svg
                                class="w-6 h-6 text-primary"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                                ></path>
                            </svg>
                        </div>
                        <h3
                            class="text-2xl font-display font-bold mb-4 text-text-dark"
                        >
                            Orquesta Sinfónica de Carabobo (OSC)
                        </h3>
                        <p class="text-text-dark leading-relaxed">
                            La prestigiosa orquesta fundada en 1976 con una trayectoria ininterrumpida en su labor cultural y educativa.
                        </p>
                        <div class="mt-6 text-primary font-bold flex items-center gap-2">
                            Conoce más
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5l7 7-7 7"
                                ></path>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>