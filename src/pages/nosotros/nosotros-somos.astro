---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import MainHero from "../../components/sections/MainHero.astro";
---

<Layout title="Nosotros Somos - Fundación Orquesta Sinfónica de Carabobo">
    <Header />

    <main class="bg-white text-gray-950 min-h-screen">
        <MainHero
            title="Nosotros"
            titleHighlight="Somos"
            subtitle="Casi medio siglo construyendo el alma musical de una región."
        />

        <!-- INTRO SECTION: ARCHITECTURAL QUOTE -->
        <section
            class="py-24 md:py-32 relative overflow-hidden border-b border-gray-100"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="grid md:grid-cols-12 gap-12 items-center">
                    <div
                        class="md:col-span-1 border-l-4 border-[#800020] h-full hidden md:block"
                    >
                    </div>
                    <div class="md:col-span-10">
                        <span
                            class="text-[#800020] text-xs font-bold tracking-[0.4em] uppercase mb-8 block italic"
                            >Manifesto</span
                        >
                        <h2
                            class="text-4xl md:text-7xl font-display font-medium text-black mb-12 leading-none tracking-tighter uppercase"
                        >
                            Una institución <br /><span
                                class="text-[#800020] font-bold italic"
                                >cultural integral</span
                            >
                        </h2>
                        <div
                            class="relative bg-black p-10 md:p-16 border border-black shadow-2xl overflow-hidden group"
                        >
                            <div
                                class="absolute inset-0 z-0 opacity-20 bg-[url('/orchestra1.webp')] bg-cover bg-center grayscale scale-110 group-hover:scale-100 transition-transform duration-1000"
                            >
                            </div>
                            <div class="relative z-10">
                                <p
                                    class="text-xl md:text-3xl text-white leading-tight font-display font-light italic"
                                >
                                    "Desde hace 49 años, hemos unido en un mismo
                                    propósito la formación académica, la
                                    producción artística de alto nivel y el
                                    compromiso social inquebrantable."
                                </p>
                            </div>
                        </div>
                    </div>
                    <div
                        class="md:col-span-1 border-r-4 border-gray-200 h-full hidden md:block"
                    >
                    </div>
                </div>
            </div>
        </section>

        <!-- HISTORY SECTION: TIMELINE ELEMENTS -->
        <section class="py-32 bg-gray-50 relative overflow-hidden">
            <!-- Subtle Background watermark -->
            <div
                class="absolute top-10 right-10 text-[12rem] md:text-[18rem] font-display font-bold text-gray-100 pointer-events-none select-none leading-none opacity-50"
            >
                49
            </div>

            <div class="container mx-auto px-6 max-w-6xl relative">
                <div class="mb-24">
                    <span
                        class="text-[#800020] text-xs font-bold tracking-[0.4em] uppercase mb-4 block italic"
                        >Nuestra Trayectoria</span
                    >
                    <h2
                        class="text-5xl md:text-8xl font-display font-medium text-black leading-none tracking-tighter uppercase"
                    >
                        Historia <br /><span
                            class="text-[#800020] font-bold italic"
                            >y Prestigio</span
                        >
                    </h2>
                </div>

                <div
                    class="grid md:grid-cols-2 gap-1 bg-gray-200 border border-gray-200 shadow-xl"
                >
                    <div
                        class="bg-white p-12 border-l-4 border-transparent hover:border-[#800020] transition-colors duration-500"
                    >
                        <span
                            class="text-[#d19d2e] font-display text-4xl mb-6 block font-bold"
                            >1976</span
                        >
                        <h3
                            class="text-2xl font-bold uppercase tracking-tight mb-4 text-black"
                        >
                            Fundación
                        </h3>
                        <p class="text-gray-500 leading-relaxed font-light">
                            Nacemos en octubre de 1976 para convertirnos en el
                            eje fundamental de la cultura carabobeña, iniciando
                            un camino de excelencia ininterrumpida.
                        </p>
                    </div>
                    <div
                        class="bg-white p-12 border-l-4 border-transparent hover:border-[#800020] transition-colors duration-500"
                    >
                        <span
                            class="text-[#d19d2e] font-display text-4xl mb-6 block font-bold"
                            >1998</span
                        >
                        <h3
                            class="text-2xl font-bold uppercase tracking-tight mb-4 text-black"
                        >
                            Hito Universal
                        </h3>
                        <p class="text-gray-500 leading-relaxed font-light">
                            Acompañamos al legendario tenor Luciano Pavarotti en
                            su única presentación en Venezuela, consolidando
                            nuestra calidad interpretativa a nivel mundial.
                        </p>
                    </div>
                    <div
                        class="bg-white p-12 border-l-4 border-transparent hover:border-[#800020] transition-colors duration-500"
                    >
                        <span
                            class="text-[#d19d2e] font-display text-4xl mb-6 block font-bold"
                            >2021</span
                        >
                        <h3
                            class="text-2xl font-bold uppercase tracking-tight mb-4 text-black"
                        >
                            UNESCO
                        </h3>
                        <p class="text-gray-500 leading-relaxed font-light">
                            Fuimos reconocidos por la UNESCO como "Embajadores
                            de la Paz", un honor que ratifica nuestra labor
                            social y compromiso con la humanidad.
                        </p>
                    </div>
                    <div
                        class="bg-white p-12 text-center flex flex-col justify-center items-center overflow-hidden relative grayscale hover:grayscale-0 transition-all duration-700"
                    >
                        <div
                            class="absolute inset-0 z-0 opacity-10 bg-[url('/estudiantina.webp')] bg-cover bg-center"
                        >
                        </div>
                        <div class="relative z-10">
                            <h3
                                class="text-3xl font-display font-medium text-black uppercase italic mb-2 tracking-tighter"
                            >
                                Patrimonio
                            </h3>
                            <p
                                class="text-[10px] font-bold tracking-[0.3em] uppercase text-[#800020]"
                            >
                                Inmaterial de Carabobo
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FORMATION & PRODUCTION: SOPHISTICATED GRID -->
        <section class="py-32 bg-white">
            <div class="container mx-auto px-6 max-w-6xl">
                <div
                    class="flex flex-col md:flex-row justify-between items-start gap-12 mb-24"
                >
                    <div class="max-w-2xl">
                        <span
                            class="text-[#800020] text-xs font-bold tracking-[0.4em] uppercase mb-4 block italic"
                            >Modelo Integral</span
                        >
                        <h2
                            class="text-5xl md:text-7xl font-display font-medium text-black leading-none tracking-tighter uppercase"
                        >
                            Formación y <br /><span
                                class="text-[#800020] font-bold italic"
                                >Excelencia</span
                            >
                        </h2>
                    </div>
                    <div class="md:max-w-sm border-l-4 border-gray-100 pl-8">
                        <p class="text-gray-500 font-light leading-relaxed">
                            Nuestra estructura garantiza que el talento joven se
                            encuentre con la experiencia profesional en un ciclo
                            de aprendizaje continuo.
                        </p>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-12">
                    <!-- Academy Card -->
                    <div
                        class="border border-black bg-white shadow-2xl relative"
                    >
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-black/5 flex items-center justify-center text-black/20 text-4xl font-display italic"
                        >
                            A
                        </div>
                        <div class="p-12 h-full flex flex-col">
                            <h3
                                class="text-3xl font-display font-bold mb-8 text-black uppercase tracking-tighter border-b-2 border-[#800020] pb-4 inline-block self-start"
                            >
                                Academia
                            </h3>
                            <p
                                class="text-gray-900 font-medium mb-8 italic leading-relaxed text-lg"
                            >
                                Programa de Formación Musical <br />
                                <span class="text-[#800020]"
                                    >"Maestro José Calabrese"</span
                                >
                            </p>
                            <ul class="space-y-6 flex-grow">
                                {
                                    [
                                        {
                                            title: "Becas Directas",
                                            desc: "Más de 80 niños y jóvenes beneficiados",
                                        },
                                        {
                                            title: "Dotación",
                                            desc: "Asignación de instrumentos para iniciación",
                                        },
                                        {
                                            title: "Inclusión",
                                            desc: "Programas especializados para Síndrome de Down",
                                        },
                                        {
                                            title: "Acreditación",
                                            desc: "Aval internacional de la UNESCO",
                                        },
                                    ].map((item) => (
                                        <li class="flex items-start gap-5">
                                            <div class="w-2 h-2 mt-1.5 bg-[#800020] shrink-0" />
                                            <div>
                                                <p class="text-[10px] font-bold uppercase tracking-widest text-black mb-1">
                                                    {item.title}
                                                </p>
                                                <p class="text-sm font-light text-gray-500 uppercase tracking-tighter">
                                                    {item.desc}
                                                </p>
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Production Card -->
                    <div
                        class="border border-[#800020] bg-white shadow-2xl relative"
                    >
                        <div
                            class="absolute top-0 right-0 w-24 h-24 bg-[#800020]/5 flex items-center justify-center text-[#800020]/20 text-4xl font-display italic"
                        >
                            P
                        </div>
                        <div class="p-12 h-full flex flex-col">
                            <h3
                                class="text-3xl font-display font-bold mb-8 text-black uppercase tracking-tighter border-b-2 border-black pb-4 inline-block self-start"
                            >
                                Producción
                            </h3>
                            <p
                                class="text-gray-900 font-medium mb-8 italic leading-relaxed text-lg"
                            >
                                Eventos de impacto <br /><span
                                    class="text-black"
                                >
                                    masivo y profesional</span
                                >
                            </p>
                            <ul class="space-y-6 flex-grow">
                                {
                                    [
                                        {
                                            title: "Historial",
                                            desc: "Más de 2.400 músicos formados en 49 años",
                                        },
                                        {
                                            title: "Afluencia",
                                            desc: "1.500 personas por concierto en promedio",
                                        },
                                        {
                                            title: "Repertorio",
                                            desc: "Galas sinfónicas y eventos de alto nivel",
                                        },
                                        {
                                            title: "Continuidad",
                                            desc: "Múltiples eventos temáticos anuales",
                                        },
                                    ].map((item) => (
                                        <li class="flex items-start gap-5">
                                            <div class="w-2 h-2 mt-1.5 bg-black shrink-0" />
                                            <div>
                                                <p class="text-[10px] font-bold uppercase tracking-widest text-[#800020] mb-1">
                                                    {item.title}
                                                </p>
                                                <p class="text-sm font-light text-gray-500 uppercase tracking-tighter">
                                                    {item.desc}
                                                </p>
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- IMPACT: ARCHITECTURAL NUMBERS -->
        <section class="py-32 bg-black text-white relative overflow-hidden">
            <div
                class="absolute inset-0 opacity-10 bg-[url('/orchestra1.webp')] bg-cover bg-center grayscale"
            >
            </div>
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="text-center mb-24">
                    <span
                        class="text-[#d19d2e] text-xs font-bold tracking-[0.4em] uppercase mb-6 block italic"
                    >
                        Impacto Social</span
                    >
                    <h2
                        class="text-5xl md:text-8xl font-display font-medium leading-none tracking-tighter uppercase mb-4"
                    >
                        Nuestras <span class="text-[#d19d2e] italic"
                            >Cifras</span
                        >
                    </h2>
                </div>

                <div
                    class="grid grid-cols-2 md:grid-cols-4 border border-white/20"
                >
                    <div
                        class="p-12 border-r border-b md:border-b-0 border-white/20 text-center hover:bg-[#d19d2e] group transition-colors duration-500"
                    >
                        <div
                            class="text-6xl font-display font-bold text-[#d19d2e] group-hover:text-black transition-colors mb-2"
                        >
                            49
                        </div>
                        <p
                            class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/60 group-hover:text-black"
                        >
                            Años de Trayectoria
                        </p>
                    </div>
                    <div
                        class="p-12 border-r border-b md:border-b-0 border-white/20 text-center hover:bg-[#d19d2e] group transition-colors duration-500"
                    >
                        <div
                            class="text-6xl font-display font-bold text-[#d19d2e] group-hover:text-black transition-colors mb-2"
                        >
                            2.4K
                        </div>
                        <p
                            class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/60 group-hover:text-black"
                        >
                            Músicos Formados
                        </p>
                    </div>
                    <div
                        class="p-12 border-r border-white/20 text-center hover:bg-[#d19d2e] group transition-colors duration-500"
                    >
                        <div
                            class="text-6xl font-display font-bold text-[#d19d2e] group-hover:text-black transition-colors mb-2"
                        >
                            200+
                        </div>
                        <p
                            class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/60 group-hover:text-black"
                        >
                            Alumnos Activos
                        </p>
                    </div>
                    <div
                        class="p-12 text-center hover:bg-[#d19d2e] group transition-colors duration-500"
                    >
                        <div
                            class="text-6xl font-display font-bold text-[#d19d2e] group-hover:text-black transition-colors mb-2"
                        >
                            17K
                        </div>
                        <p
                            class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/60 group-hover:text-black"
                        >
                            Alcance Digital
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTAS: BOLD BLOCKS -->
        <section class="py-32 bg-gray-100">
            <div class="container mx-auto px-6 max-w-5xl">
                <div
                    class="grid md:grid-cols-2 gap-1 border-4 border-black bg-black shadow-2xl"
                >
                    <div class="bg-white p-12">
                        <h3
                            class="text-3xl font-display font-bold mb-6 text-black uppercase tracking-tight italic border-b-4 border-[#800020] pb-2 inline-block"
                        >
                            Únete
                        </h3>
                        <p
                            class="text-gray-500 mb-10 font-light leading-relaxed"
                        >
                            Ya sea como patrocinante corporativo, benefactor o
                            estudiante, tu presencia es vital para nuestra
                            misión.
                        </p>
                        <a
                            href="/contacto"
                            class="block w-full py-5 bg-[#800020] text-white text-center text-xs font-bold uppercase tracking-[0.4em] hover:bg-black transition-colors"
                        >
                            Contacto Directo
                        </a>
                    </div>
                    <div class="bg-white p-12">
                        <h3
                            class="text-3xl font-display font-bold mb-6 text-black uppercase tracking-tight italic border-b-4 border-[#d19d2e] pb-2 inline-block"
                        >
                            Academia
                        </h3>
                        <p
                            class="text-gray-500 mb-10 font-light leading-relaxed"
                        >
                            Explora las oportunidades académicas y conviértete
                            en parte de la nueva generación de músicos de élite.
                        </p>
                        <a
                            href="/academia"
                            class="block w-full py-5 bg-black text-white text-center text-xs font-bold uppercase tracking-[0.4em] hover:bg-[#800020] transition-colors"
                        >
                            Programas Académicos
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    /* Architectural Sharp Edges & Shadows */
    .shadow-2xl {
        box-shadow: 20px 20px 0px rgba(0, 0, 0, 0.1);
    }
</style>
