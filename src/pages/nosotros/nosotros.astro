import NosotrosImpact from "../../components/nosotros/NosotrosImpact.astro";
import NosotrosCTA from "../../components/nosotros/NosotrosCTA.astro";
---

<Layout title="Sobre Nosotros - Fundación Orquesta Sinfónica de Carabobo">
