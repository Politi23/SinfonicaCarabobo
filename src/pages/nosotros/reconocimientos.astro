---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
---

<Layout>
    <Header />

    <main class="bg-white text-gray-800">
        <!-- Hero Section -->
        <section
            class="relative min-h-[50vh] flex items-center justify-center bg-gray-900 overflow-hidden"
        >
            <div
                class="absolute inset-0 z-0 opacity-30 bg-[url('/sinfonica.webp')] bg-fixed bg-cover bg-center"
            >
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/80 z-0"
            >
            </div>

            <!-- Decoración de esquinas -->
            <div
                class="absolute top-4 left-4 w-24 h-24 border-l-4 border-t-4 border-primary opacity-60"
            >
            </div>
            <div
                class="absolute top-4 right-4 w-24 h-24 border-r-4 border-t-4 border-primary opacity-60"
            >
            </div>

            <!-- Floating animated musical notes -->
            <div class="absolute inset-0 pointer-events-none">
                <div class="absolute top-1/4 left-1/4 text-primary/30 text-6xl animate-float-1">♪</div>
                <div class="absolute top-1/3 right-1/5 text-primary/40 text-5xl animate-float-2">♫</div>
                <div class="absolute bottom-1/4 left-1/3 text-primary/20 text-7xl animate-float-3">♪</div>
                <div class="absolute bottom-1/3 right-1/4 text-primary/30 text-4xl animate-float-1">♫</div>
                <div class="absolute top-1/2 left-1/6 text-primary/25 text-5xl animate-float-2">♪</div>
                <div class="absolute top-2/3 right-1/3 text-primary/35 text-6xl animate-float-3">♫</div>
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center pt-24">
                <p
                    class="text-2xl md:text-3xl italic text-gray-300 font-serif mb-6 animate-fade-in"
                >
                    "Excelencia y Compromiso"
                </p>

                <div class="flex justify-center mb-8">
                    <div class="relative group">
                        <!-- Glow effect background -->
                        <div
                            class="absolute inset-0 bg-primary/20 rounded-full blur-2xl scale-110 opacity-60 group-hover:opacity-80 transition-opacity duration-500"
                        >
                        </div>

                        <!-- Logo container with artistic effects -->
                        <div
                            class="relative bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-sm rounded-full p-4 border border-white/20 shadow-2xl group-hover:shadow-primary/20 transition-all duration-500 group-hover:scale-105"
                        >
                            <img
                                src="/logo.webp"
                                alt="Orquesta Sinfónica de Carabobo"
                                class="h-24 md:h-32 object-contain filter brightness-110 contrast-110 drop-shadow-lg group-hover:drop-shadow-2xl transition-all duration-500"
                            />

                            <!-- Decorative elements -->
                            <div
                                class="absolute -top-2 -right-2 w-4 h-4 bg-primary rounded-full opacity-80 animate-pulse"
                            >
                            </div>
                            <div
                                class="absolute -bottom-1 -left-1 w-3 h-3 bg-primary rounded-full opacity-60 animate-pulse"
                                style="animation-delay: 0.5s;"
                            >
                            </div>
                        </div>
                    </div>
                </div>

                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white"
                >
                    <span class="text-primary">Reconocimientos</span>
                </h1>
            </div>
        </section>

        <!-- RECONOCIMIENTOS CONTENT -->
        <section
            class="py-24 md:py-32 relative overflow-hidden bg-gradient-to-br from-surface-light/30 via-white to-surface-light/20"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Trayectoria</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        49 Años de <span class="text-primary italic">Excelencia</span>
                    </h2>

                    <!-- Texto introductorio -->
                    <div class="relative text-center mb-24">
                        <!-- Decorative frame -->
                        <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 rounded-2xl"></div>
                        <div class="absolute top-4 left-4 w-8 h-8 border-l-2 border-t-2 border-primary/30 rounded-tl-lg"></div>
                        <div class="absolute top-4 right-4 w-8 h-8 border-r-2 border-t-2 border-primary/30 rounded-tr-lg"></div>
                        <div class="absolute bottom-4 left-4 w-8 h-8 border-l-2 border-b-2 border-primary/30 rounded-bl-lg"></div>
                        <div class="absolute bottom-4 right-4 w-8 h-8 border-r-2 border-b-2 border-primary/30 rounded-br-lg"></div>

                        <!-- Musical notes decoration -->
                        <div class="absolute -top-6 left-1/4 text-primary/20 text-4xl">♪</div>
                        <div class="absolute -top-4 right-1/4 text-primary/20 text-3xl">♫</div>
                        <div class="absolute -bottom-6 left-1/3 text-primary/20 text-2xl">♪</div>
                        <div class="absolute -bottom-4 right-1/3 text-primary/20 text-3xl">♫</div>

                        <div class="relative bg-white/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-primary/10 shadow-lg">
                            <p class="text-lg md:text-xl text-text-dark leading-relaxed max-w-4xl mx-auto font-serif italic">
                                La Fundación Orquesta Sinfónica de Carabobo (FOSC) y la Orquesta Sinfónica de Carabobo (OSC) han recibido a lo largo de sus 49 años de trayectoria múltiples reconocimientos por su contribución a la cultura, la educación y el desarrollo social en Venezuela y el mundo. Estos premios y distinciones reflejan el impacto, la excelencia y el compromiso de nuestra institución.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Golden separator -->
                <div class="flex items-center justify-center mb-16">
                    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
                    <div class="mx-8 text-primary text-4xl">♪</div>
                    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"></div>
                </div>

                <!-- Reconocimientos Institucionales Destacados -->
                <div class="mb-24">
                    <h3 class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12">
                        Reconocimientos <span class="text-primary italic">Institucionales Destacados</span>
                    </h3>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2021</span>
                            </div>
                            <p class="text-text-dark font-medium">Institución UNESCO; Embajadores de la Paz</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2019</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento del Consejo Legislativo del Estado Carabobo</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2019</span>
                            </div>
                            <p class="text-text-dark font-medium">Orden al Mérito Ejecutivo – Asociación de Ejecutivos de Carabobo</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2019</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Alcaldía Municipio Naguanagua</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2012</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Alcaldía Municipio San Diego</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2011</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Alcaldía Municipio Carlos Arvelo</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2011</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Universidad Arturo Michelena</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2011</span>
                            </div>
                            <p class="text-text-dark font-medium">Premio Festival Internacional de Solistas Aldemaro Romero</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2008</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento Latinoamérica Sinfónica</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2007</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Universidad de Carabobo</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2007</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Red de Bibliotecas Públicas</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2005</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de Sokka Gakkai Internacional</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2005 & 2021</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de Rotary Internacional</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">2004</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Contraloría del Estado Carabobo</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1999</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Asamblea Nacional Constituyente</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1998</span>
                            </div>
                            <p class="text-text-dark font-medium">Orden Ciudad de Valencia</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1999</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Sociedad Amigos de Valencia</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1998</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Alcaldía de Valencia, Tibor Rudas APM Shows</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1998</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Cámara Municipal de Valencia</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1998</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de Hogares Crea de Venezuela</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1998</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de Gente y Eventos, Diario El Carabobeño</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1993</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento del Palacio de las Convenciones de Cuba y Cubanacan, S.A.</p>
                        </div>
                        <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="w-3 h-3 bg-primary rounded-full"></div>
                                <span class="text-sm font-bold text-primary">1992</span>
                            </div>
                            <p class="text-text-dark font-medium">Reconocimiento de la Fundación Festivales del Cabriales</p>
                        </div>
                    </div>
                </div>

                <!-- Hito Histórico -->
                <div class="mb-24">
                    <h3 class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12">
                        Hito Histórico como <span class="text-primary italic">Reconocimiento Implícito</span>
                    </h3>
                    <div class="bg-surface-light rounded-2xl p-12 shadow-lg border border-border-light">
                        <div class="flex flex-col md:flex-row items-center gap-8">
                            <div class="flex-1">
                                <p class="text-lg text-text-dark leading-relaxed mb-6">
                                    En 1998, la Orquesta Sinfónica de Carabobo fue seleccionada como orquesta acompañante del famoso tenor italiano <strong class="text-primary">Luciano Pavarotti</strong> en su único concierto en Venezuela, realizado en Valencia. Este hecho es considerado un reconocimiento a la calidad artística de la OSC.
                                </p>
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                                        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="font-bold text-text-dark">1998</p>
                                        <p class="text-sm text-text-dark/70">Concierto con Luciano Pavarotti</p>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>
                <!-- Reconocimiento Internacional -->
                <div class="mb-24">
                    <h3 class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12">
                        Reconocimiento <span class="text-primary italic">Internacional</span>
                    </h3>
                    <div class="bg-gradient-to-r from-primary/5 to-primary/5 rounded-2xl p-12 shadow-lg border border-primary/10">
                        <div class="text-center">
                            <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6">
                                <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"></path>
                                </svg>
                            </div>
                            <h4 class="text-2xl font-bold text-text-dark mb-4">Aval y apoyo de la UNESCO</h4>
                            <p class="text-lg text-text-dark leading-relaxed max-w-3xl mx-auto">
                                Como institución educativa y cultural de impacto social, la FOSC y OSC cuentan con el aval y apoyo de la UNESCO, reconociendo su contribución al desarrollo cultural y educativo en Venezuela y Latinoamérica.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA FINAL -->
        <section
            class="py-24 background-dark text-text-light text-center bg-background-dark"
        >
            <div class="container mx-auto px-6 max-w-4xl">
                <h2
                    class="text-4xl md:text-5xl font-display font-bold mb-8 text-text-light"
                >
                    Continuando la <span class="text-primary">Excelencia</span>
                </h2>
                <p class="text-xl text-text-light/90 mb-12 max-w-2xl mx-auto">
                    Estos reconocimientos nos motivan a seguir trabajando por la cultura y la educación musical en Carabobo y Venezuela.
                </p>
                <div class="flex flex-col md:flex-row gap-6 justify-center">
                    <a
                        href="/nosotros"
                        class="bg-surface-light text-text-dark px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-transform hover:scale-105 shadow-xl"
                    >
                        Conoce Nuestra Historia
                    </a>
                    <a
                        href="/nosotros/FOSC"
                        class="bg-transparent border-2 border-text-light text-text-light px-10 py-4 rounded-full font-bold hover:bg-white/10 transition-colors"
                    >
                        Fundación FOSC
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }

    @keyframes float-1 {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }

    @keyframes float-2 {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(-5deg); }
    }

    @keyframes float-3 {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-25px) rotate(3deg); }
    }

    .animate-float-1 {
        animation: float-1 6s ease-in-out infinite;
    }

    .animate-float-2 {
        animation: float-2 8s ease-in-out infinite;
    }

    .animate-float-3 {
        animation: float-3 7s ease-in-out infinite;
    }
</style>
