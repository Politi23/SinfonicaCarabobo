---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import MainHero from "../../components/sections/MainHero.astro";
---

<Layout>
    <Header />

    <main class="bg-white text-gray-800">
        <MainHero
            title="Nuestros"
            titleHighlight="Reconocimientos"
            subtitle="Excelencia y Compromiso"
        />
        <section
            class="py-24 md:py-32 relative overflow-hidden bg-gradient-to-br from-surface-light/30 via-white to-surface-light/20"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-0">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Trayectoria</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        49 Años de <span class="text-primary italic"
                            >Excelencia</span
                        >
                    </h2>
                    <div class="relative text-center mb-24">
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 rounded-2xl"
                        >
                        </div>
                        <div
                            class="absolute top-4 left-4 w-8 h-8 border-l-2 border-t-2 border-primary/30 rounded-tl-lg"
                        >
                        </div>
                        <div
                            class="absolute top-4 right-4 w-8 h-8 border-r-2 border-t-2 border-primary/30 rounded-tr-lg"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 left-4 w-8 h-8 border-l-2 border-b-2 border-primary/30 rounded-bl-lg"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 right-4 w-8 h-8 border-r-2 border-b-2 border-primary/30 rounded-br-lg"
                        >
                        </div>
                        <div
                            class="absolute -top-6 left-1/4 text-primary/20 text-4xl"
                        >
                            ♪
                        </div>
                        <div
                            class="absolute -top-4 right-1/4 text-primary/20 text-3xl"
                        >
                            ♫
                        </div>
                        <div
                            class="absolute -bottom-6 left-1/3 text-primary/20 text-2xl"
                        >
                            ♪
                        </div>
                        <div
                            class="absolute -bottom-4 right-1/3 text-primary/20 text-3xl"
                        >
                            ♫
                        </div>

                        <div
                            class="relative bg-white/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-primary/10 shadow-lg"
                        >
                            <p
                                class="text-lg md:text-xl text-text-dark leading-relaxed max-w-4xl mx-auto font-serif italic"
                            >
                                La Fundación Orquesta Sinfónica de Carabobo
                                (FOSC) y la Orquesta Sinfónica de Carabobo (OSC)
                                han recibido a lo largo de sus 49 años de
                                trayectoria múltiples reconocimientos por su
                                contribución a la cultura, la educación y el
                                desarrollo social en Venezuela y el mundo. Estos
                                premios y distinciones reflejan el impacto, la
                                excelencia y el compromiso de nuestra
                                institución.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="flex items-center justify-center mb-16">
                    <div
                        class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"
                    >
                    </div>
                    <div class="mx-8 text-primary text-4xl">♪</div>
                    <div
                        class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"
                    >
                    </div>
                </div>
                <div class="mb-24">
                    <h3
                        class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12"
                    >
                        Reconocimientos <span class="text-primary italic"
                            >Institucionales Destacados</span
                        >
                    </h3>
                    <ul class="space-y-4 max-w-4xl mx-auto">
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2021</span
                            >
                            <p class="text-text-dark font-medium">
                                Institución UNESCO; Embajadores de la Paz
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2019</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento del Consejo Legislativo del
                                Estado Carabobo
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2019</span
                            >
                            <p class="text-text-dark font-medium">
                                Orden al Mérito Ejecutivo – Asociación de
                                Ejecutivos de Carabobo
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2019</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Alcaldía Municipio
                                Naguanagua
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2012</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Alcaldía Municipio San
                                Diego
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2011</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Alcaldía Municipio Carlos
                                Arvelo
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2011</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Universidad Arturo
                                Michelena
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2011</span
                            >
                            <p class="text-text-dark font-medium">
                                Premio Festival Internacional de Solistas
                                Aldemaro Romero
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2008</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento Latinoamérica Sinfónica
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2007</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Universidad de Carabobo
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2007</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Red de Bibliotecas Públicas
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2005</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de Sokka Gakkai Internacional
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2005 & 2021</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de Rotary Internacional
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >2004</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Contraloría del Estado
                                Carabobo
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1999</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Asamblea Nacional
                                Constituyente
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1998</span
                            >
                            <p class="text-text-dark font-medium">
                                Orden Ciudad de Valencia
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1999</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Sociedad Amigos de Valencia
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1998</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Alcaldía de Valencia, Tibor
                                Rudas APM Shows
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1998</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Cámara Municipal de
                                Valencia
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1998</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de Hogares Crea de Venezuela
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1998</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de Gente y Eventos, Diario El
                                Carabobeño
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1993</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento del Palacio de las Convenciones
                                de Cuba y Cubanacan, S.A.
                            </p>
                        </li>
                        <li class="flex items-start gap-3">
                            <span
                                class="text-sm font-bold text-primary min-w-[60px]"
                                >1992</span
                            >
                            <p class="text-text-dark font-medium">
                                Reconocimiento de la Fundación Festivales del
                                Cabriales
                            </p>
                        </li>
                    </ul>
                </div>
                <div class="mb-24">
                    <h3
                        class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12"
                    >
                        Hito Histórico como <span class="text-primary italic"
                            >Reconocimiento Implícito</span
                        >
                    </h3>
                    <div
                        class="bg-surface-light rounded-2xl p-12 shadow-lg border border-border-light"
                    >
                        <div
                            class="flex flex-col md:flex-row items-center gap-8"
                        >
                            <div class="flex-1">
                                <p
                                    class="text-lg text-text-dark leading-relaxed mb-6"
                                >
                                    En 1998, la Orquesta Sinfónica de Carabobo
                                    fue seleccionada como orquesta acompañante
                                    del famoso tenor italiano <strong
                                        class="text-primary"
                                        >Luciano Pavarotti</strong
                                    > en su único concierto en Venezuela, realizado
                                    en Valencia. Este hecho es considerado un reconocimiento
                                    a la calidad artística de la OSC.
                                </p>
                                <div class="flex items-center gap-4">
                                    <div
                                        class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center"
                                    >
                                        <svg
                                            class="w-6 h-6 text-primary"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="font-bold text-text-dark">
                                            1998
                                        </p>
                                        <p class="text-sm text-text-dark/70">
                                            Concierto con Luciano Pavarotti
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mb-24">
                    <h3
                        class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12"
                    >
                        Reconocimiento <span class="text-primary italic"
                            >Internacional</span
                        >
                    </h3>
                    <div
                        class="bg-gradient-to-r from-primary/5 to-primary/5 rounded-2xl p-12 shadow-lg border border-primary/10"
                    >
                        <div class="text-center">
                            <div
                                class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6"
                            >
                                <svg
                                    class="w-10 h-10 text-primary"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"
                                    ></path>
                                </svg>
                            </div>
                            <h4 class="text-2xl font-bold text-text-dark mb-4">
                                Aval y apoyo de la UNESCO
                            </h4>
                            <p
                                class="text-lg text-text-dark leading-relaxed max-w-3xl mx-auto"
                            >
                                Como institución educativa y cultural de impacto
                                social, la FOSC y OSC cuentan con el aval y
                                apoyo de la UNESCO, reconociendo su contribución
                                al desarrollo cultural y educativo en Venezuela
                                y Latinoamérica.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section
            class="py-24 background-dark text-text-light text-center bg-background-dark relative"
        >
            <div class="container mx-auto px-6 max-w-4xl relative">
                <div class="absolute top-8 left-8 text-primary/10 text-2xl">
                    ♪
                </div>
                <div class="absolute top-16 right-12 text-primary/15 text-3xl">
                    ♫
                </div>
                <div
                    class="absolute bottom-16 left-1/4 text-primary/20 text-4xl"
                >
                    ♬
                </div>
                <div
                    class="absolute bottom-24 right-1/3 text-primary/10 text-2xl"
                >
                    ♪
                </div>
                <h2
                    class="text-4xl md:text-5xl font-display font-bold mb-8 text-text-light"
                >
                    Únete a Nuestra Misión
                </h2>
                <p class="text-xl text-text-light/90 mb-12 max-w-2xl mx-auto">
                    Ya sea como patrocinador, alumno o donante, tu apoyo es
                    vital para seguir construyendo cultura en Carabobo.
                </p>
                <div class="flex flex-col md:flex-row gap-6 justify-center">
                    <a
                        href="/contacto"
                        class="bg-primary text-black px-10 py-4 font-bold hover:bg-primary-dark transition-all duration-300 shadow-xl"
                    >
                        Contáctanos
                    </a>
                    <a
                        href="/academia"
                        class="bg-primary text-black px-10 py-4 font-bold hover:bg-primary-dark transition-all duration-300 shadow-xl"
                    >
                        Ver programas
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style></style>
