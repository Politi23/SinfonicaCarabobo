---

<Layout title="Nuestros Reconocimientos - Orquesta Sinfónica de Carabobo">
    <main class="bg-white text-gray-800 overflow-x-hidden">
        <MainHero
            title="Nuestros"
            titleHighlight="Reconocimientos"
            subtitle="Medio siglo de excelencia y compromiso artístico"
            bgImage={orquesta.src}
        />

        <!-- <ReconocimientosIntro /> -->
        <ReconocimientosMilestones />

        <ReconocimientosList
            institutionalRecognitions={institutionalRecognitions}
        />
        <!-- <ReconocimientosCTA /> -->
    </main>
</Layout>

<style>
    /* Focus on crisp, architectural lines handled in components where applicable */
    main {
        text-rendering: optimizeLegibility;
    }
</style>
