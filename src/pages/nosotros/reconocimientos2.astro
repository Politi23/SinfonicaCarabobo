---
import Layout from "@layouts/Layout.astro";
import Header from "../../components/global/Header.astro";
import { getReconocimientos } from "src/config/wp-reconocimientos";
import type { WPReconocimiento } from "src/config/wp-reconocimientos";

// 1. Llamamos a la función
const reconocimientos = await getReconocimientos();

// Helper para obtener la imagen de forma segura
const getImageUrl = (post: WPReconocimiento) => {
    if (post._embedded && post._embedded["wp:featuredmedia"]) {
        return post._embedded["wp:featuredmedia"][0].source_url;
    }
    return "/logosimple.webp";
};
---

<Layout title="Reconocimientos | La Orquesta">
    <Header />

    <main class="bg-white text-gray-800">
        <!-- Hero Section -->
        <section
            class="relative min-h-[50vh] flex items-center justify-center bg-gray-900 overflow-hidden"
        >
            <div
                class="absolute inset-0 z-0 opacity-30 bg-[url('/sinfonica.webp')] bg-fixed bg-cover bg-center"
            >
            </div>
            <div
                class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/80 z-0"
            >
            </div>

            <!-- Decoración de esquinas -->
            <div
                class="absolute top-4 left-4 w-24 h-24 border-l-4 border-t-4 border-primary opacity-60"
            >
            </div>
            <div
                class="absolute top-4 right-4 w-24 h-24 border-r-4 border-t-4 border-primary opacity-60"
            >
            </div>

            <!-- Floating animated musical notes -->
            <div class="absolute inset-0 pointer-events-none">
                <div
                    class="absolute top-1/4 left-1/4 text-primary/30 text-6xl animate-float-1"
                >
                    ♪
                </div>
                <div
                    class="absolute top-1/3 right-1/5 text-primary/40 text-5xl animate-float-2"
                >
                    ♫
                </div>
                <div
                    class="absolute bottom-1/4 left-1/3 text-primary/20 text-7xl animate-float-3"
                >
                    ♪
                </div>
                <div
                    class="absolute bottom-1/3 right-1/4 text-primary/30 text-4xl animate-float-1"
                >
                    ♫
                </div>
                <div
                    class="absolute top-1/2 left-1/6 text-primary/25 text-5xl animate-float-2"
                >
                    ♪
                </div>
                <div
                    class="absolute top-2/3 right-1/3 text-primary/35 text-6xl animate-float-3"
                >
                    ♫
                </div>
            </div>

            <div class="container mx-auto px-6 relative z-10 text-center pt-24">
                <p
                    class="text-2xl md:text-3xl italic text-gray-300 font-serif mb-6 animate-fade-in"
                >
                    "Excelencia y Compromiso"
                </p>

                <div class="flex justify-center mb-8">
                    <div class="relative group">
                        <!-- Glow effect background -->
                        <div
                            class="absolute inset-0 bg-primary/20 rounded-full blur-2xl scale-110 opacity-60 group-hover:opacity-80 transition-opacity duration-500"
                        >
                        </div>

                        <!-- Logo container with artistic effects -->
                        <div
                            class="relative bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-sm rounded-full p-4 border border-white/20 shadow-2xl group-hover:shadow-primary/20 transition-all duration-500 group-hover:scale-105"
                        >
                            <img
                                src="/logo.webp"
                                alt="Orquesta Sinfónica de Carabobo"
                                class="h-24 md:h-32 object-contain filter brightness-110 contrast-110 drop-shadow-lg group-hover:drop-shadow-2xl transition-all duration-500"
                            />

                            <!-- Decorative elements -->
                            <div
                                class="absolute -top-2 -right-2 w-4 h-4 bg-primary rounded-full opacity-80 animate-pulse"
                            >
                            </div>
                            <div
                                class="absolute -bottom-1 -left-1 w-3 h-3 bg-primary rounded-full opacity-60 animate-pulse"
                                style="animation-delay: 0.5s;"
                            >
                            </div>
                        </div>
                    </div>
                </div>

                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white"
                >
                    <span class="text-primary">Reconocimientos</span>
                </h1>
            </div>
        </section>

        <!-- RECONOCIMIENTOS CONTENT -->
        <section
            class="py-24 md:py-32 relative overflow-hidden bg-gradient-to-br from-surface-light/30 via-white to-surface-light/20"
        >
            <div class="container mx-auto px-6 max-w-6xl relative z-10">
                <div class="flex flex-col items-center text-center mb-24">
                    <span
                        class="text-primary text-sm font-bold tracking-[0.2em] uppercase mb-4 block"
                        >Nuestra Trayectoria</span
                    >
                    <h2
                        class="text-4xl md:text-6xl font-display font-bold text-text-dark mb-12"
                    >
                        49 Años de <span class="text-primary italic"
                            >Excelencia</span
                        >
                    </h2>

                    <!-- Texto introductorio -->
                    <div class="relative text-center mb-24">
                        <!-- Decorative frame -->
                        <div
                            class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-primary/5 rounded-2xl"
                        >
                        </div>
                        <div
                            class="absolute top-4 left-4 w-8 h-8 border-l-2 border-t-2 border-primary/30 rounded-tl-lg"
                        >
                        </div>
                        <div
                            class="absolute top-4 right-4 w-8 h-8 border-r-2 border-t-2 border-primary/30 rounded-tr-lg"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 left-4 w-8 h-8 border-l-2 border-b-2 border-primary/30 rounded-bl-lg"
                        >
                        </div>
                        <div
                            class="absolute bottom-4 right-4 w-8 h-8 border-r-2 border-b-2 border-primary/30 rounded-br-lg"
                        >
                        </div>

                        <!-- Musical notes decoration -->
                        <div
                            class="absolute -top-6 left-1/4 text-primary/20 text-4xl"
                        >
                            ♪
                        </div>
                        <div
                            class="absolute -top-4 right-1/4 text-primary/20 text-3xl"
                        >
                            ♫
                        </div>
                        <div
                            class="absolute -bottom-6 left-1/3 text-primary/20 text-2xl"
                        >
                            ♪
                        </div>
                        <div
                            class="absolute -bottom-4 right-1/3 text-primary/20 text-3xl"
                        >
                            ♫
                        </div>

                        <div
                            class="relative bg-white/50 backdrop-blur-sm p-8 md:p-12 rounded-2xl border border-primary/10 shadow-lg"
                        >
                            <p
                                class="text-lg md:text-xl text-text-dark leading-relaxed max-w-4xl mx-auto font-serif italic"
                            >
                                La Fundación Orquesta Sinfónica de Carabobo
                                (FOSC) y la Orquesta Sinfónica de Carabobo (OSC)
                                han recibido a lo largo de sus 49 años de
                                trayectoria múltiples reconocimientos por su
                                contribución a la cultura, la educación y el
                                desarrollo social en Venezuela y el mundo. Estos
                                premios y distinciones reflejan el impacto, la
                                excelencia y el compromiso de nuestra
                                institución.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Golden separator -->
                <div class="flex items-center justify-center mb-16">
                    <div
                        class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"
                    >
                    </div>
                    <div class="mx-8 text-primary text-4xl">♪</div>
                    <div
                        class="flex-1 h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent"
                    >
                    </div>
                </div>

                <!-- Dynamic Recognition Items -->
                <div class="mb-24">
                    <h3
                        class="text-3xl md:text-4xl font-display font-bold text-text-dark text-center mb-12"
                    >
                        Reconocimientos <span class="text-primary italic"
                            >Destacados</span
                        >
                    </h3>

                    {
                        reconocimientos.length > 0 ? (
                            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {reconocimientos.map((item) => (
                                    <div class="bg-surface-light rounded-xl p-6 shadow-lg border border-border-light hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                                        <div class="flex items-center gap-3 mb-3">
                                            <div class="w-3 h-3 bg-primary rounded-full" />
                                            <span class="text-sm font-bold text-primary">
                                                {new Date(
                                                    item.date,
                                                ).toLocaleDateString("es-VE", {
                                                    year: "numeric",
                                                })}
                                            </span>
                                        </div>

                                        <h2
                                            class="text-text-dark font-medium"
                                            set:html={item.title.rendered}
                                        />

                                        {/* <!-- IMAGE SECTION - COMMENTED OUT AS REQUESTED -->
                                        {item.featured_media !== 0 && (
                                            <div class="aspect-video w-full overflow-hidden mt-4">
                                                <img
                                                    src={getImageUrl(item)}
                                                    alt={item.title.rendered}
                                                    class="w-full h-full object-cover"
                                                    loading="lazy"
                                                />
                                            </div>
                                        )} --> */}

                                        <div class="prose max-w-none text-gray-700 mt-4">
                                            <div
                                                set:html={item.content.rendered}
                                            />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <p class="text-center text-text-dark">
                                No hay reconocimientos cargados aún.
                            </p>
                        )
                    }
                </div>
            </div>
        </section>

        <!-- CTA FINAL -->
        <section
            class="py-24 background-dark text-text-light text-center bg-background-dark"
        >
            <div class="container mx-auto px-6 max-w-4xl">
                <h2
                    class="text-4xl md:text-5xl font-display font-bold mb-8 text-text-light"
                >
                    Continuando la <span class="text-primary">Excelencia</span>
                </h2>
                <p class="text-xl text-text-light/90 mb-12 max-w-2xl mx-auto">
                    Estos reconocimientos nos motivan a seguir trabajando por la
                    cultura y la educación musical en Carabobo y Venezuela.
                </p>
                <div class="flex flex-col md:flex-row gap-6 justify-center">
                    <a
                        href="/nosotros"
                        class="bg-surface-light text-text-dark px-10 py-4 rounded-full font-bold hover:bg-gray-100 transition-transform hover:scale-105 shadow-xl"
                    >
                        Conoce Nuestra Historia
                    </a>
                    <a
                        href="/nosotros/FOSC"
                        class="bg-transparent border-2 border-text-light text-text-light px-10 py-4 rounded-full font-bold hover:bg-white/10 transition-colors"
                    >
                        Fundación FOSC
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out;
    }

    @keyframes float-1 {
        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-20px) rotate(5deg);
        }
    }

    @keyframes float-2 {
        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-15px) rotate(-5deg);
        }
    }

    @keyframes float-3 {
        0%,
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-25px) rotate(3deg);
        }
    }

    .animate-float-1 {
        animation: float-1 6s ease-in-out infinite;
    }

    .animate-float-2 {
        animation: float-2 8s ease-in-out infinite;
    }

    .animate-float-3 {
        animation: float-3 7s ease-in-out infinite;
    }
</style>
